## Pipeline-board demo bot — exercises the /pipelines board end to end with
## ZERO LLM calls (tool / compute / human / subbot only, so it runs free and
## fast on any machine):
##
##   plan ─> dispatch(fan_out_each) ─> produce_episode(subbot, isolated ×3 in
##   parallel) ─> collect(wait_all) ─> final_review(HUMAN) ─> finish ─> done
##
## What to watch on /pipelines while it runs:
##   - the card sits In progress with tree progress + "+3 children";
##   - each child writes a real PNG cover + a real WAV track + a tiny MP4
##     into its own artifact area, then PAUSES on its own human review —
##     the card's sidebar shows "Review 1 of 3"; the Produced elements
##     section aggregates every child's outputs;
##   - answer the three child reviews from the sidebar (Approve), then the
##     PARENT's final review appears — approve it too;
##   - the card lands in Done with the final_answer summary + all produced
##     elements (parent brief + 3×{cover,track,clip}).
schema plan_out:
  episodes: json

schema episode_out:
  episode: string
  verdict: string

schema collect_out:
  produced: bool

schema final_gate:
  approved: bool
  release_notes: string

schema final_out:
  final_answer: string

## Writes the parent's own produced element (the season brief), then emits
## the episode list the router fans out over.
tool plan:
  command: `mkdir -p "$ITERION_ARTIFACT_FILES_DIR" && printf '# Season brief\n\nThree demo episodes, one sub-bot each.\nEach child produces a cover image + an audio track, then waits for your review.\n' > "$ITERION_ARTIFACT_FILES_DIR/season-brief.md" && printf '{"episodes":[{"id":"ep1"},{"id":"ep2"},{"id":"ep3"}]}'`
  output: plan_out

router dispatch:
  mode: fan_out_each
  over: "{{outputs.plan.episodes}}"
  as: ep

## One child run per episode, concurrently. `isolated:` asserts each child
## confines its writes to its own run store, which is what makes the parallel
## fan-out legal (see docs/groups-iteration-subbots.md).
subbot produce_episode:
  source: "episode.bot"
  with { episode: "{{outputs.dispatch.ep.id}}" }
  output: episode_out
  isolated: true

compute collect:
  await: wait_all
  output: collect_out
  expr:
    produced: "true"

## The PARENT's own human gate, after every child was reviewed.
human final_review:
  output: final_gate

## `publish:` persists the output as an artifact — that's where the pipeline
## board's Done card reads its `final_answer` from.
compute finish:
  output: final_out
  publish: final_answer
  expr:
    final_answer: "outputs.final_review.release_notes"

workflow pipeline_board_demo:
  entry: plan
  budget:
    max_parallel_branches: 3
  plan          -> dispatch
  dispatch      -> produce_episode
  produce_episode -> collect
  collect       -> final_review
  final_review  -> finish when approved
  final_review  -> fail when not approved
  finish        -> done
