## Child bot run by the parent's `subbot` node (tool-only, no API keys).

dsl: 2

vars:
  ticket: string = "none"

schema out:
  validated: bool
  echoed: string

tool work:
  command: "printf '{\"validated\":true,\"echoed\":\"%s\"}' {{vars.ticket}}"
  output: out

workflow child:

  entry: work

  work -> done
