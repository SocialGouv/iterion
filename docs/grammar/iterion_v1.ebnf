(* Iterion .bot language — current parser surface.

   This grammar describes syntax. The IR compiler adds semantic constraints:
   uniqueness, reference/type checks, router-mode property rules, graph
   reachability, exhaustive routing, cycle declarations, budgets, and so on.

   INDENT/DEDENT are virtual tokens emitted by the indentation-aware lexer.
   Comments open with # (## is the same comment) and, like blank lines, are
   ignored between constructs; inside a string, a prompt body or a block
   scalar a # is text.
*)

file = [ dsl_header ] { top_level_decl } ;

(* The syntax profile (ADR-098). The header, when present, is the file's
   first significant line — after blank lines and comments; absent means
   profile 1, today's grammar, frozen. The profile governs changes of
   MEANING only: under profile 2 a "…" string reads the standard escapes
   (\" \\ \n \t \r \0) with no directive, a blank line inside a prompt body
   is kept as a paragraph break, and the profile-1 `## strict-escape: on`
   directive and `project_root:` are refused. Every other form below is read
   the same in both profiles. `iterion dsl migrate --to 2` rewrites a file. *)
dsl_header = "dsl" ":" INT_LIT NEWLINE ;

top_level_decl = vars_decl | presets_decl | attachments_decl | secrets_decl
               | mcp_server_decl | prompt_decl | schema_decl
               | cursor_decl | supervisor_decl
               | agent_decl | judge_decl | router_decl | human_decl
               | tool_decl | compute_decl | emit_decl | wait_decl
               | await_answers_decl | subbot_decl
               | fail_decl
               | group_decl | use_decl | workflow_decl ;

(* ---------- Values and collections ---------- *)

(* Every block — vars, presets, attachments, secrets, and the nested
   mcp/auth/cursors/compaction/memory/recovery/budget/resources/sandbox
   (and its build/network) blocks below — may stand as a bare header: at
   the end of its parent (a DEDENT or the end of the file), or before a
   BLANK LINE and a sibling. That is the empty block, kept as such; a
   header followed directly by an unindented line is still an error. Same
   rule as the empty declarations (see prompt_decl); fallbacks_block is the
   exception, see there. *)
vars_decl = "vars" ":" NEWLINE [ INDENT { var_field } DEDENT ] ;
var_field = IDENT ":" type_expr [ enum_constraint ] [ "=" literal ] NEWLINE ;

type_expr = "string" | "bool" | "int" | "float" | "json" | "string[]" ;
literal = STRING_LIT | INT_LIT | FLOAT_LIT | BOOL_LIT ;
enum_constraint = "[" "enum" ":" STRING_LIT { "," STRING_LIT } "]" ;

presets_decl = "presets" ":" NEWLINE [ INDENT { preset_entry } DEDENT ] ;
preset_entry = IDENT ":" NEWLINE INDENT { preset_value } DEDENT ;
preset_value = IDENT ":" literal NEWLINE ;

attachments_decl = "attachments" ":" NEWLINE [ INDENT
                     { attachment_field }
                   DEDENT ] ;
attachment_field = IDENT ":" attachment_type NEWLINE
                   [ INDENT { attachment_prop } DEDENT ] ;
attachment_type = "file" | "image" ;
attachment_prop = "description" ":" str_value NEWLINE
                | "accept_mime" ":" string_list NEWLINE
                | "required" ":" BOOL_LIT NEWLINE ;

secrets_decl = "secrets" ":" NEWLINE [ INDENT { secret_field } DEDENT ] ;
secret_field = IDENT ":" [ STRING_LIT ] NEWLINE
               [ INDENT { secret_prop } DEDENT ] ;
secret_prop = "value" ":" str_value NEWLINE
            | "as" ":" string_or_ident NEWLINE
            | "mount_path" ":" str_value NEWLINE
            | "env" ":" string_or_ident NEWLINE
            | "optional" ":" BOOL_LIT NEWLINE
            | "hosts" ":" string_list NEWLINE
            | "description" ":" str_value NEWLINE ;

(* A prompt, schema, mcp_server, cursor, supervisor, group or workflow
   header may stand with no body at all — followed by a BLANK LINE and
   another declaration, or by the end of the file — and declares an EMPTY
   one: the studio saves a declaration the moment it is created. The blank
   line is the discriminant: a header followed directly by an unindented
   line (a body at the wrong indentation) is still an error. *)

prompt_decl = "prompt" IDENT ":" NEWLINE [ INDENT prompt_body DEDENT ] ;
(* A blank or space-only line under the header is skipped, not a text line:
   a paragraph break does not survive, and a body never ends with a
   newline; a CR before the newline is folded away with it. The first text
   line's indentation is the body's: a deeper line keeps the difference, a
   shallower one ends the body. *)
prompt_body = { PROMPT_TEXT_LINE } ;

schema_decl = "schema" IDENT ":" NEWLINE [ INDENT { schema_field } DEDENT ] ;
schema_field = IDENT ":" type_expr [ enum_constraint ] NEWLINE ;

(* ---------- MCP ---------- *)

mcp_server_decl = "mcp_server" IDENT ":" NEWLINE [ INDENT
                    { mcp_server_prop }
                  DEDENT ] ;
mcp_server_prop = "transport" ":" mcp_transport NEWLINE
                | "command" ":" str_value NEWLINE
                | "args" ":" string_list NEWLINE
                | "url" ":" str_value NEWLINE
                | mcp_auth_block ;
mcp_transport = "stdio" | "http" | "sse" ;

mcp_auth_block = "auth" ":" NEWLINE [ INDENT { mcp_auth_prop } DEDENT ] ;
mcp_auth_prop = "type" ":" str_value NEWLINE
              | "auth_url" ":" str_value NEWLINE
              | "token_url" ":" str_value NEWLINE
              | "revoke_url" ":" str_value NEWLINE
              | "client_id" ":" str_value NEWLINE
              | "scopes" ":" string_list NEWLINE ;

mcp_config_block = "mcp" ":" NEWLINE [ INDENT { mcp_config_prop } DEDENT ] ;
mcp_config_prop = "autoload_project" ":" BOOL_LIT NEWLINE
                | "inherit" ":" BOOL_LIT NEWLINE
                | "servers" ":" ident_list NEWLINE
                | "disable" ":" ident_list NEWLINE ;

(* ---------- Cursors and supervisors ---------- *)

cursor_decl = "cursor" IDENT ":" NEWLINE [ INDENT { cursor_prop } DEDENT ] ;
cursor_prop = "description" ":" str_value NEWLINE
            | "values" ":" NEWLINE INDENT { cursor_value } DEDENT
            | "bands" ":" NEWLINE INDENT { cursor_band } DEDENT ;
cursor_value = IDENT ":" str_value NEWLINE ;
cursor_band = STRING_LIT ":" str_value NEWLINE ;

cursors_block = "cursors" ":" NEWLINE [ INDENT { cursor_setting } DEDENT ] ;
cursor_setting = IDENT ":" cursor_setting_value NEWLINE ;
cursor_setting_value = IDENT | STRING_LIT | INT_LIT | FLOAT_LIT | BOOL_LIT ;

supervisor_decl = "supervisor" IDENT ":" NEWLINE [ INDENT
                    { supervisor_prop }
                  DEDENT ] ;
supervisor_prop = "watches" ":" ident_list NEWLINE
                | "model" ":" str_value NEWLINE
                | "system" ":" prompt_ref NEWLINE
                | "cooldown" ":" str_value NEWLINE
                | "max_evals" ":" INT_LIT NEWLINE
                | "monitors" ":" string_list NEWLINE ;

(* ---------- LLM nodes ---------- *)

(* A node's ordered fallback routes (ADR-087). Entries are NAMED rather
   than an anonymous sequence because the lexer has no list-item token,
   and because the name is the stable id a fall-through is reported by. *)
(* The one block that may not stand bare: a chain with no route is refused
   by name (the AST has no empty chain to carry). *)
fallbacks_block = "fallbacks" ":" NEWLINE INDENT { fallback_entry } DEDENT ;
fallback_entry  = IDENT ":" NEWLINE INDENT { fallback_prop } DEDENT ;
fallback_prop   = "backend" ":" str_value NEWLINE
                | "model" ":" str_value NEWLINE
                | "provider" ":" str_value NEWLINE
                | "on" ":" ident_list NEWLINE
                | "metered" ":" BOOL_LIT NEWLINE
                | "action" ":" ( "skip" | STRING_LIT ) NEWLINE
                | "when" ":" str_value NEWLINE ;

agent_decl = "agent" IDENT ":" NEWLINE INDENT { llm_prop } DEDENT ;
judge_decl = "judge" IDENT ":" NEWLINE INDENT { llm_prop } DEDENT ;

llm_prop = "description" ":" str_value NEWLINE
         | fallbacks_block
         | "model" ":" str_value NEWLINE
         | "backend" ":" str_value NEWLINE
         | "provider" ":" str_value NEWLINE
         | "command" ":" str_value NEWLINE
         | "input" ":" IDENT NEWLINE
         | "output" ":" IDENT NEWLINE
         | "publish" ":" IDENT NEWLINE
         | "artifact_labels" ":" tool_ref_list NEWLINE
         | "system" ":" prompt_ref NEWLINE
         | "user" ":" prompt_ref NEWLINE
         | "session" ":" session_mode NEWLINE
         | "tools" ":" tool_ref_list NEWLINE
         | "tool_policy" ":" tool_ref_list NEWLINE
         | "capabilities" ":" tool_ref_list NEWLINE
         | "skills" ":" skill_ref_list NEWLINE
         | "tool_max_steps" ":" INT_LIT NEWLINE
         | "max_tokens" ":" INT_LIT NEWLINE
         | "reasoning_effort" ":" reasoning_effort NEWLINE
         | "timeout" ":" str_value NEWLINE
         | "readonly" ":" BOOL_LIT NEWLINE
         | "full_access" ":" BOOL_LIT NEWLINE
         | "images" ":" string_list NEWLINE
         | "interaction" ":" interaction_mode NEWLINE
         | "interaction_prompt" ":" IDENT NEWLINE
         | "interaction_model" ":" str_value NEWLINE
         | "await" ":" await_mode NEWLINE
         | "compress" ":" compress_mode NEWLINE
         | "auto_memory" ":" auto_memory_mode NEWLINE
         | "permission" ":" permission_mode NEWLINE
         | "needs" ":" needs_value NEWLINE
         | mcp_config_block | compaction_block | memory_block
         | sandbox_decl | cursors_block ;

session_mode = "fresh" | "inherit" | "inherit_if_available"
             | "fork" | "artifacts_only" | "persist" ;
reasoning_effort = "low" | "medium" | "high" | "xhigh" | "max"
                 | "ultracode" | STRING_LIT ;
await_mode = "wait_all" | "best_effort" ;
interaction_mode = "none" | "human" | "llm" | "llm_or_human" | "review" ;
compress_mode = "off" | "on" | "ultra" ;
auto_memory_mode = "off" | "on" ;
loop_budget_guard_mode = "off" | "on" ;
repo_devbox_mode = "off" | "on" ;
permission_mode = "off" | "ask" | "deny" ;

compaction_block = "compaction" ":" NEWLINE [ INDENT
                     { compaction_prop }
                   DEDENT ] ;
compaction_prop = "threshold" ":" NUMBER_LIT NEWLINE
                | "preserve_recent" ":" INT_LIT NEWLINE ;

memory_block = "memory" ":" NEWLINE [ INDENT { memory_prop } DEDENT ] ;
memory_prop = "enabled" ":" BOOL_LIT NEWLINE
            | "scope" ":" str_value NEWLINE
            | "autoload" ":" string_list NEWLINE
            | "read" ":" BOOL_LIT NEWLINE
            | "write" ":" BOOL_LIT NEWLINE
            | "pre_compact_inject" ":" BOOL_LIT NEWLINE
            | "project_root" ":" BOOL_LIT NEWLINE
            | "visibility" ":" str_value NEWLINE ;

(* ---------- Routers and non-LLM nodes ---------- *)

router_decl = "router" IDENT ":" NEWLINE INDENT { router_prop } DEDENT ;
router_prop = "description" ":" str_value NEWLINE
            | "mode" ":" router_mode NEWLINE
            | "model" ":" str_value NEWLINE
            | "backend" ":" str_value NEWLINE
            | "provider" ":" str_value NEWLINE
            | "system" ":" prompt_ref NEWLINE
            | "user" ":" prompt_ref NEWLINE
            | "multi" ":" BOOL_LIT NEWLINE
            | "reasoning_effort" ":" reasoning_effort NEWLINE
            | "over" ":" str_value NEWLINE
            | "as" ":" IDENT NEWLINE
            | "key" ":" IDENT NEWLINE
            | "depends_on" ":" IDENT NEWLINE
            | "needs" ":" needs_value NEWLINE ;
router_mode = "fan_out_all" | "fan_out_each" | "condition"
            | "round_robin" | "llm" ;

human_decl = "human" IDENT ":" NEWLINE INDENT { human_prop } DEDENT ;
human_prop = "description" ":" str_value NEWLINE
           | "input" ":" IDENT NEWLINE
           | "output" ":" IDENT NEWLINE
           | "publish" ":" IDENT NEWLINE
           | "artifact_labels" ":" tool_ref_list NEWLINE
           | "instructions" ":" prompt_ref NEWLINE
           | "interaction" ":" interaction_mode NEWLINE
           | "interaction_prompt" ":" IDENT NEWLINE
           | "interaction_model" ":" str_value NEWLINE
           | "model" ":" str_value NEWLINE
           | "system" ":" prompt_ref NEWLINE
           | "min_answers" ":" INT_LIT NEWLINE
           | "await" ":" await_mode NEWLINE
           | "review_url" ":" str_value NEWLINE
           | "posture" ":" string_or_ident NEWLINE
           | "merge_strategy" ":" string_or_ident NEWLINE
           | "merge_into" ":" string_or_ident NEWLINE
           | "max_turns" ":" INT_LIT NEWLINE ;

tool_decl = "tool" IDENT ":" NEWLINE INDENT { tool_prop } DEDENT ;
tool_prop = "description" ":" str_value NEWLINE
          | "command" ":" str_value NEWLINE
          | "script" ":" str_value NEWLINE
          | "language" ":" script_language NEWLINE
          | "input" ":" IDENT NEWLINE
          | "output" ":" IDENT NEWLINE
          | "publish" ":" IDENT NEWLINE
          | "artifact_labels" ":" tool_ref_list NEWLINE
          | "await" ":" await_mode NEWLINE
          | "compress" ":" compress_mode NEWLINE
          | "permission" ":" permission_mode NEWLINE
          | "needs" ":" needs_value NEWLINE
          | "parallel_safe" ":" BOOL_LIT NEWLINE
          | "goal" ":" str_value NEWLINE
          | "postcondition" ":" str_value NEWLINE
          | "policy" ":" action_policy NEWLINE
          | "action" ":" connector_op_id NEWLINE
          | "connection" ":" connection_alias NEWLINE
          | "retry" ":" scalar_text NEWLINE
          | "timeout" ":" scalar_text NEWLINE
          | action_params_block
          | recovery_block | sandbox_decl ;
script_language = "js" | "py" | "sh" | "bash" ;
action_policy = "required" | "recover" | "best_effort" ;
(* A connector operation id: connector.resource.verb (ADR-098, C260). A
   quoted form is accepted too: an author who writes it unambiguously is not
   corrected for it. *)
connector_op_id = IDENT "." IDENT "." IDENT { "." IDENT } | STRING_LIT ;
(* The alias an operator chose at `iterion connections add --alias`, where a
   dash is ordinary — so the quoted form is what makes `forge-main` nameable. *)
connection_alias = IDENT | STRING_LIT ;
action_params_block = "params" ":" NEWLINE [ INDENT { action_param } DEDENT ] ;
(* The key is the VENDOR's wire name, which is routinely not an identifier —
   `activity-id` and `user-id` are required path parameters of the shipped
   Forgejo package — so the quoted form is what makes those operations
   callable at all. *)
action_param = ( IDENT | STRING_LIT ) ":" scalar_text NEWLINE ;
(* A quoted string, or a bare scalar for the values naturally written
   unquoted. The optional IDENT after a number is a DURATION's unit: the
   lexer splits `30s` into `30` and `s`, and only a number takes one — two
   bare words are a quoting error, not one value, since joining them would
   send `hello world` as `helloworld`. *)
scalar_text = STRING_LIT | NUMBER_LIT [ IDENT ] | IDENT ;
recovery_block = "recovery" ":" NEWLINE [ INDENT { recovery_prop } DEDENT ] ;
recovery_prop = "max_repair_attempts" ":" INT_LIT NEWLINE
              | "max_agent_attempts" ":" INT_LIT NEWLINE
              | "model" ":" str_value NEWLINE
              | "agent_tools" ":" tool_ref_list NEWLINE ;

compute_decl = "compute" IDENT ":" NEWLINE INDENT { compute_prop } DEDENT ;
compute_prop = "description" ":" str_value NEWLINE
             | "input" ":" IDENT NEWLINE
             | "output" ":" IDENT NEWLINE
             | "publish" ":" IDENT NEWLINE
             | "artifact_labels" ":" tool_ref_list NEWLINE
             | "await" ":" await_mode NEWLINE
             | compute_expr_block ;
compute_expr_block = "expr" ":" NEWLINE INDENT { compute_expr } DEDENT ;
compute_expr = IDENT ":" str_value NEWLINE ;

emit_decl = "emit" IDENT ":" NEWLINE INDENT { emit_prop } DEDENT ;
emit_prop = "description" ":" str_value NEWLINE
          | "event" ":" str_value NEWLINE
          | with_block NEWLINE ;

wait_decl = "wait" IDENT ":" NEWLINE INDENT { wait_prop } DEDENT ;
wait_prop = "description" ":" str_value NEWLINE
          | "event" ":" str_value NEWLINE
          | "timeout" ":" str_value NEWLINE
          | "output" ":" IDENT NEWLINE ;

(* The deterministic sync point for async human questions (ADR-081): parks
   its branch until every pending ask_user_async question of the `from:`
   node (or the whole run) is answered. The timeout is mandatory. *)
await_answers_decl = "await_answers" IDENT ":" NEWLINE INDENT
                       { await_answers_prop }
                     DEDENT ;
await_answers_prop = "description" ":" str_value NEWLINE
                   | "from" ":" ( IDENT | STRING_LIT ) NEWLINE
                   | "timeout" ":" str_value NEWLINE ;

(* A NAMED terminal failure node. The bare "fail" target stays reserved and
   untyped; a declaration is how a workflow carries its own diagnosis onto
   the run (failure_code / error), one node per reason it refuses. *)
fail_decl = "fail" IDENT ":" NEWLINE INDENT { fail_prop } DEDENT ;
fail_prop = "description" ":" str_value NEWLINE
          | "code" ":" ( IDENT | STRING_LIT ) NEWLINE
          | "message" ":" str_value NEWLINE
          | "resumable" ":" BOOL_LIT NEWLINE ;

subbot_decl = "subbot" IDENT ":" NEWLINE INDENT { subbot_prop } DEDENT ;
subbot_prop = "description" ":" str_value NEWLINE
            | "source" ":" str_value NEWLINE
            | with_block NEWLINE
            | "output" ":" IDENT NEWLINE
            | "needs" ":" needs_value NEWLINE
            | "isolated" ":" BOOL_LIT NEWLINE ;

(* ---------- Compile-time groups ---------- *)

group_decl = "group" IDENT [ "(" [ IDENT { "," IDENT } ] ")" ] ":"
             NEWLINE [ INDENT { group_member } DEDENT ] ;
group_member = agent_decl | judge_decl | router_decl | human_decl
             | tool_decl | compute_decl | edge ;

use_decl = "use" IDENT "as" IDENT [ with_block ] NEWLINE ;

(* ---------- Workflows ---------- *)

(* The body is optional like a prompt's or a schema's: a bare header is the
   empty workflow (see the note above prompt_decl). *)
workflow_decl = "workflow" IDENT ":" NEWLINE [ INDENT
                  { workflow_member }
                DEDENT ] ;
workflow_member = vars_decl | attachments_decl | mcp_config_block
                | "entry" ":" node_ref NEWLINE
                | "default_backend" ":" str_value NEWLINE
                | "tool_policy" ":" tool_ref_list NEWLINE
                | "capabilities" ":" tool_ref_list NEWLINE
                | "skills" ":" skill_ref_list NEWLINE
                | budget_block | resources_block | compaction_block
                | "interaction" ":" interaction_mode NEWLINE
                | "worktree" ":" worktree_mode NEWLINE
                | "compress" ":" compress_mode NEWLINE
                | "auto_memory" ":" auto_memory_mode NEWLINE
                | "loop_budget_guard" ":" loop_budget_guard_mode NEWLINE
                | "repo_devbox" ":" repo_devbox_mode NEWLINE
                | "workspace_checkpoint" ":" ( "on" | "off" ) NEWLINE
                | "permission" ":" permission_mode NEWLINE
                | "allow" ":" string_list NEWLINE
                | "ask" ":" string_list NEWLINE
                | "deny" ":" string_list NEWLINE
                | sandbox_decl | edge ;

worktree_mode = "auto" | "none" ;

budget_block = "budget" ":" NEWLINE [ INDENT { budget_prop } DEDENT ] ;
budget_prop = "max_parallel_branches" ":" INT_LIT NEWLINE
            | "max_duration" ":" str_value NEWLINE
            | "max_cost_usd" ":" NUMBER_LIT NEWLINE
            | "max_tokens" ":" INT_LIT NEWLINE
            | "warn_tokens" ":" INT_LIT NEWLINE
            | "max_iterations" ":" INT_LIT NEWLINE ;

resources_block = "resources" ":" NEWLINE [ INDENT
                    { IDENT ":" resource_capacity NEWLINE }
                  DEDENT ] ;
resource_capacity = INT_LIT | string_list ;
needs_value = IDENT | ident_list ;

(* ---------- Sandbox ---------- *)

sandbox_decl = "sandbox" ":" sandbox_mode NEWLINE
             | "sandbox" ":" NEWLINE [ INDENT { sandbox_prop } DEDENT ] ;
(* The bare block form is the inline block with nothing in it — which the
   compiler refuses (C044) until it carries an image: or a build:. *)
sandbox_mode = "auto" | "none" | "inline" ;
sandbox_prop = "mode" ":" sandbox_mode NEWLINE
             | "image" ":" str_value NEWLINE
             | sandbox_build_block
             | "user" ":" str_value NEWLINE
             | "workspace_folder" ":" str_value NEWLINE
             | "host_state" ":" IDENT NEWLINE
             | "post_create" ":" str_value NEWLINE
             | "env" ":" string_map
             | "mounts" ":" string_or_ident_list NEWLINE
             | sandbox_network_block ;

sandbox_build_block = "build" ":" NEWLINE [ INDENT
                        { sandbox_build_prop }
                      DEDENT ] ;
sandbox_build_prop = "dockerfile" ":" str_value NEWLINE
                   | "context" ":" str_value NEWLINE
                   | "args" ":" string_map ;

sandbox_network_block = "network" ":" NEWLINE [ INDENT
                          { sandbox_network_prop }
                        DEDENT ] ;
sandbox_network_prop = "mode" ":" IDENT NEWLINE
                     | "preset" ":" string_or_ident NEWLINE
                     | "inherit" ":" IDENT NEWLINE
                     | "rules" ":" string_or_ident_list NEWLINE ;

string_map = "{" [ IDENT ":" string_or_ident
                   { "," IDENT ":" string_or_ident } ] "}" NEWLINE
           | NEWLINE INDENT { IDENT ":" string_or_ident NEWLINE } DEDENT ;

(* ---------- Edges ---------- *)

(* A chain `a -> b -> c` reads as the edges it names; the clauses at the end
   of the line belong to the LAST segment (a clause before a further arrow
   is refused, E032). *)
edge = node_ref "->" node_ref { "->" node_ref } { edge_clause } NEWLINE ;
edge_clause = when_clause | else_clause | iteration_clause | with_block ;
when_clause = "when" ( [ "not" ] IDENT | STRING_LIT ) ;
else_clause = "else" ;

iteration_clause = "as" ( loop_spec | foreach_spec ) ;
loop_spec = IDENT "(" loop_cap ")" ;
loop_cap = INT_LIT | STRING_LIT | "unbounded" [ INT_LIT ] ;
foreach_spec = "foreach" IDENT "(" IDENT "in" STRING_LIT ")" ;

with_block = "with" "{" { with_mapping } "}" ;
(* A number or a bool in a with map is the string it spells. *)
with_mapping = IDENT ":" ( STRING_LIT | INT_LIT | FLOAT_LIT | BOOL_LIT ) [ "," ] [ NEWLINE ] ;

node_ref = IDENT { "." IDENT } | "done" | "fail" ;

(* A prompt reference names a declared prompt, or IS the prompt's text: a
   string — quoted, raw, or a `|` block scalar — becomes an inline prompt of
   the file, named after its body. *)
prompt_ref = IDENT | STRING_LIT ;

(* ---------- Embedded expression language ---------- *)

expression = or_expr ;
or_expr = and_expr { ( "||" | "or" ) and_expr } ;
and_expr = not_expr { ( "&&" | "and" ) not_expr } ;
not_expr = ( "!" | "not" ) not_expr | comparison ;
comparison = additive [ ( "==" | "!=" | "<" | "<=" | ">" | ">=" ) additive ] ;
additive = multiplicative { ( "+" | "-" ) multiplicative } ;
multiplicative = unary { ( "*" | "/" | "%" ) unary } ;
unary = "-" unary | postfix ;
postfix = primary { "[" expression "]" } ;
primary = NUMBER_LIT | EXPR_STRING | BOOL_LIT | path | function_call
        | lambda_combinator | "(" expression ")" ;
path = IDENT { "." IDENT } ;
function_call = IDENT "(" [ expression { "," expression } ] ")" ;
lambda_combinator = ( "map" | "filter" ) "(" expression "," lambda ")"
                  | "reduce" "(" expression "," expression "," lambda ")" ;
lambda = ( IDENT | "(" IDENT { "," IDENT } ")" ) "=>" expression ;

(* `compute` expressions and quoted `when` clauses carry this language inside
   a DSL STRING_LIT. Standard namespaces are vars, input, outputs, artifacts,
   loop, and run. Built-ins are length, concat, unique, contains, join, tail,
   if, sort, keys, values, slice, sum, min, max, flatten, map, filter, reduce. *)

(* ---------- Template references ---------- *)

template_ref = "{{" [ "!" ] template_path "}}" ;
template_path = template_namespace "." IDENT { "." IDENT } ;
template_namespace = "vars" | "input" | "outputs" | "artifacts"
                   | "attachments" | "secrets" | "loop" | "each" | "run" ;

(* `{{!…}}` requests raw, non-shell-escaped substitution only in tool command
   rendering. Group expansion additionally recognises `{{params.<name>}}` at
   compile time before normal template-reference parsing. *)

(* ---------- Lexical forms ---------- *)

(* A string-valued property takes a quoted string, or one plain bare word
   (`backend: claw`, `hosts: [github.com]`): additive in every profile, since
   a bare word there used to be an error. A value that is not one plain
   word — two words, a number with a unit — is still an error (E002). *)
str_value = STRING_LIT | IDENT ;

(* Every list may be written inline, or as one `- item` per line indented
   under the property (comment lines allowed between items); both read as
   the same list. `[]` is the empty list's only form. *)
ident_list = "[" [ IDENT { "," IDENT } ] "]"
           | NEWLINE INDENT { "-" IDENT NEWLINE } DEDENT ;
string_list = "[" [ str_value { "," str_value } ] "]"
            | NEWLINE INDENT { "-" str_value NEWLINE } DEDENT ;
string_or_ident_list = "[" [ string_or_ident { "," string_or_ident } ] "]"
                     | NEWLINE INDENT { "-" string_or_ident NEWLINE } DEDENT ;
tool_ref_list = "[" [ tool_ref_elem { "," tool_ref_elem } ] "]"
              | NEWLINE INDENT { "-" tool_ref_elem NEWLINE } DEDENT ;
tool_ref_elem = tool_ref | STRING_LIT ;  (* a quoted element is the literal name *)
skill_ref_list = "[" [ skill_ref { "," skill_ref } ] "]"
               | NEWLINE INDENT { "-" skill_ref NEWLINE } DEDENT ;

tool_ref = IDENT { "." IDENT } [ "." "*" ] ;
skill_ref = STRING_LIT | tool_ref ;
string_or_ident = STRING_LIT | IDENT ;

IDENT = LETTER { LETTER | DIGIT | "_" } ;
STRING_LIT = QUOTED_STRING | RAW_STRING | BLOCK_SCALAR ;
QUOTED_STRING = '"' { ESCAPED_OR_PLAIN_CHAR } '"' ;
RAW_STRING = "`" { NON_BACKTICK_CHAR } "`" ;
BLOCK_SCALAR = "|" NEWLINE INDENT { TEXT_LINE } DEDENT ;

INT_LIT = DIGIT { DIGIT } ;
FLOAT_LIT = DIGIT { DIGIT } "." DIGIT { DIGIT } ;
NUMBER_LIT = INT_LIT | FLOAT_LIT ;
BOOL_LIT = "true" | "false" ;
EXPR_STRING = ( '"' { EXPR_CHAR } '"' ) | ( "'" { EXPR_CHAR } "'" ) ;

LETTER = "a".."z" | "A".."Z" | "_" ;
DIGIT = "0".."9" ;
NEWLINE = "\n" ;
INDENT = (* indentation increases *) ;
DEDENT = (* indentation decreases *) ;
PROMPT_TEXT_LINE = (* one indented prompt line, templates allowed *) ;
