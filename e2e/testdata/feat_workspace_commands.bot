## feat_workspace_commands.bot — backend parity for `.claude/commands/`.
##
## The first two nodes send the SAME prompt, `/parity-probe`, which is an
## invocation of a command the workspace contributes. Neither node has a
## tool (`tools: []`), so the only way the token in that file can reach a
## model is the invocation being resolved into the file's body — on
## claude_code natively, on claw through the in-process resolver.
##
## The third node's prompt does NOT open with the invocation: the MODEL must
## reach for the command itself, mid-conversation, through claw's `command`
## tool (#1716) — the parity half of claude_code's SlashCommand tool (which
## iterion withholds headless, since a command there can be Bash-backed;
## here the body is inert text and executing it takes the node's own tools).

dsl: 2

prompt sys:
  You are a terse assistant. Answer with a single line.

prompt invoke:
  /parity-probe

prompt invoke_via_tool:
  There is a workspace command named "parity-probe". Invoke it with the command tool now, then do exactly what its body says.

schema answer:
  text: string

agent via_claude_code:
  backend: claude_code
  model: "anthropic/claude-sonnet-4-6"
  tools: []
  output: answer
  system: sys
  user: invoke

agent via_claw:
  backend: claw
  provider: "openai"
  model: "openai/gpt-5.4-mini"
  tools: []
  output: answer
  system: sys
  user: invoke

agent via_claw_model_tool:
  backend: claw
  provider: "openai"
  model: "openai/gpt-5.4-mini"
  tools: [command]
  output: answer
  system: sys
  user: invoke_via_tool

workflow main:
  entry: via_claude_code
  via_claude_code -> via_claw
  via_claw -> via_claw_model_tool
  via_claw_model_tool -> done
