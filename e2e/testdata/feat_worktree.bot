## Feature fixture: worktree:auto finalization.
## A tool-only workflow (no LLM) that commits inside the auto-created
## worktree, so finalizeWorktree must produce a persistent FinalBranch.

tool make_commit:
  ## No `cd`: a tool node already runs with the run workspace as its cwd
  ## (executor cmd.Dir), and ${PROJECT_DIR} is only expanded in a bot var
  ## default -- inside a command it stays literal and `cd ""` fails.
  command: "printf 'hi\n' > created.txt && git add created.txt && git commit -m 'feat: add created.txt'"

workflow main:
  worktree: auto
  entry: make_commit
  make_commit -> done
