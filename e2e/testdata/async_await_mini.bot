## async_await_mini.bot — deterministic fixture for the await_answers
## node (ADR-081). A fan_out_all router spawns two parallel branches:
##   - side:  a compute that finishes immediately (proves siblings are
##            never frozen by pending questions)
##   - gate:  an await_answers node parked until every pending async
##            interaction of the run is answered
## The test seeds/answers async interactions directly in the store —
## no LLM, no shell.

schema num:
  n: int

compute prep:
  output: num
  expr:
    n: "21 + 21"

router fork:
  mode: fan_out_all

compute side:
  output: num
  expr:
    n: "outputs.prep.n"

## Timeout is well ABOVE the 5s awaitAnswersPollInterval so the level-poll
## fallback wins the select over the deadline even under timer starvation
## on a loaded pod (a same-duration timeout races the poll ticker and, at
## coincident firing times, `select` picks randomly — a 50/50 timeout on
## an already-answered question). The in-process doorbell (rung by the
## test's NotifyInteractionAnswered) still releases the branch within ms
## on the happy path; this bound only matters as the belt-and-braces.
await_answers gate:
  timeout: "30s"

compute gather:
  await: wait_all
  output: num
  publish: gathered
  expr:
    n: "outputs.side.n"

workflow async_await_mini:
  budget:
    max_parallel_branches: 4
  entry: prep
  prep -> fork
  fork -> side
  fork -> gate
  side -> gather
  gate -> gather
  gather -> done
