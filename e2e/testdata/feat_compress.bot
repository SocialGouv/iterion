## Feature fixture: command-output compression (node-level opt-in).
## The tool node opts into compression; the active rewriter plugin chain (rtk
## by default) rewrites `git status` to its compressed equivalent before
## running it. The test asserts the node runs cleanly with compress on
## (skipped when no rewriter binary is present).

tool compress_probe:
  compress: on
  ## No `cd`: see feat_worktree.bot -- the node already runs in the run
  ## workspace, and ${PROJECT_DIR} does not expand inside a command.
  command: "git status"

workflow main:
  entry: compress_probe
  compress_probe -> done
