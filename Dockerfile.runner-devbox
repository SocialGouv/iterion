# syntax=docker/dockerfile:1.26@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32
#
# Devbox-first-class runner image (experiment, jo's direction 2026-07-08).
#
# WHY. The cloud runner pod already provides ISOLATION on Kubernetes (namespace,
# cgroups, network policy) — so the per-run sandbox SIBLING pod is redundant
# there. The only thing a build-needing bot (Billy / branch-improve, feature-dev)
# lacks in the base runner image (debian-slim + node + LLM CLIs) is the target
# repo's TOOLCHAIN (e.g. Go). Rather than bake one stack in, this runner ships
# Nix + devbox: a bot runs `devbox run -- <build>` and the target repo's own
# devbox.json provisions its EXACT tools + versions — cross-language,
# cross-version, per-repo. iterion itself is devbox-first, so `devbox run -- task
# build` gives Billy Go 1.26 for free.
#
# Base: jetpackio/devbox (Nix + devbox + git), the same foundation as
# sandbox/slim, plus the FULL runner toolset (node/claude/codex, gh/glab/kubectl,
# python3/jq) and the static iterion binary + bot catalog.
#
# DEPLOY NOTE (2nd step, not here): this image runs as uid 1000 (devbox) so Nix
# works — the runner Helm securityContext.runAsUser must match (base runner is
# 10001). And an ephemeral pod has an empty Nix store, so first `devbox run`
# re-downloads the toolchain; a persistent Nix store (PVC or a warm binary
# cache) keeps it fast across runs.

ARG ITERION_IMAGE=ghcr.io/socialgouv/iterion:edge@sha256:56c3471904ad66705eb6b72989ebb97c18801585c49a3aaf1c9e8c8433abb24a
FROM ${ITERION_IMAGE} AS iterion-bin

FROM jetpackio/devbox:latest@sha256:3446246d7fbadd0fb0fa53f434593d01b5711148e7608accee74ac448137169e

USER root

# Runner toolset — mirrors the root Dockerfile runtime stage: git + certs + tini
# + procps + curl + passwd + python3 + jq, and node 24 for the LLM CLIs.
# apt cache mounts keep the downloaded .deb archives + package lists warm on
# the operator daemon (dropping docker-clean so apt doesn't purge them); the
# mounts never land in the image layer, so no rm -rf cleanup is needed.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg jq procps tini git python3 passwd \
 && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
 && apt-get install -y --no-install-recommends nodejs

# Pre-install the firecrawl MCP server (shipped `firecrawl` builtin plugin) so
# the runtime `npx -y firecrawl-mcp@<ver>` starts INSTANTLY from the warm global
# install instead of downloading on a cold pod. A cold `npx` download races the
# MCP tools/list discovery → the server answers with [] before its tools
# register → the plugin's `mcp.firecrawl.*` wildcard resolves to nothing.
# Baking it in makes discovery deterministic. The version is PINNED (supply-
# chain: never resolve a moving `latest` at build OR run time) and MUST match
# pkg/plugin/builtin/firecrawl/plugin.yaml's `npx` arg so runtime reuses this
# exact global install instead of fetching another version. The npm cache is a
# build mount (not an image layer), so no `npm cache clean` is needed — and
# keeping it warm is the point.
# renovate: datasource=npm depName=firecrawl-mcp versioning=npm
ARG FIRECRAWL_MCP_VERSION=3.22.3
RUN --mount=type=cache,target=/root/.npm \
    npm install -g "firecrawl-mcp@${FIRECRAWL_MCP_VERSION}"

# Pre-install codeindex (shipped `codeindex` builtin plugin) for the same
# cold-start reason as firecrawl above: its MCP server must answer tools/list
# immediately, and its `lifecycle` index runs before the workflow starts.
# The global install ALSO puts `codeindex` on PATH, which is what the plugin's
# rewriter locates — without it the rewriter degrades to passthrough (harmless,
# but it contributes nothing). Version PINNED and MUST match all three pins in
# pkg/plugin/builtin/codeindex/plugin.yaml.
# renovate: datasource=npm depName=@maxgfr/codeindex versioning=npm
ARG CODEINDEX_VERSION=2.17.1
RUN --mount=type=cache,target=/root/.npm \
    npm install -g "@maxgfr/codeindex@${CODEINDEX_VERSION}"

# gh + glab (Revi posts reviews from the runner pod) + kubectl (parity with the
# base runner image; also used by the k8s sandbox driver if ever enabled).
ARG GLAB_VERSION=1.102.0
ARG GH_VERSION=2.65.0
ARG KUBECTL_VERSION=v1.36.0
RUN set -eux; ARCH="$(dpkg --print-architecture)"; \
    curl -fsSL "https://gitlab.com/gitlab-org/cli/-/releases/v${GLAB_VERSION}/downloads/glab_${GLAB_VERSION}_linux_${ARCH}.tar.gz" | tar -xz -C /usr/local/bin --strip-components=1 bin/glab; \
    curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${ARCH}.tar.gz" | tar -xz -C /usr/local/bin --strip-components=2 "gh_${GH_VERSION}_linux_${ARCH}/bin/gh"; \
    case "$ARCH" in amd64) KARCH=amd64;; arm64) KARCH=arm64;; *) echo "unsupported arch $ARCH" >&2; exit 1;; esac; \
    curl -fsSL -o /usr/local/bin/kubectl "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${KARCH}/kubectl"; \
    chmod +x /usr/local/bin/glab /usr/local/bin/gh /usr/local/bin/kubectl

# Warm the Nix store with the dominant toolchain (Go + go-task) so the FIRST
# `devbox run` on a Go repo — iterion itself, and most SocialGouv repos — reuses
# the baked store paths instead of re-downloading ~500MB from cache.nixos.org on
# every ephemeral pod's cold start (the DEPLOY NOTE's "first run re-downloads").
# A target repo's devbox.json requesting the SAME go@1.26 (same pinned nixpkgs)
# hits these store paths directly. Best-effort: `|| true` so a transient
# resolver/network blip never breaks the image build — an un-warmed store just
# falls back to today's on-demand download. The scalable, stack-agnostic fix
# remains a shared binary-cache substituter (S3/attic) or a persistent /nix PVC;
# this bakes the 80% case without standing up a service.
#
# Placed ABOVE the iterion-bin COPYs on purpose: those COPYs change on every
# push (the iterion:edge digest), while this ~15-min/~500MB layer depends only
# on the pinned base + toolchain pins — ordered here it stays cache-hit across
# pushes. Runs as uid 1000 (the Nix store and devbox global profile are owned
# by the devbox user).
USER 1000
RUN timeout 900 sh -c 'devbox global add go@1.26 go-task@latest && devbox global install' >/dev/null 2>&1 || true
USER root

# Static iterion binary + pinned LLM CLIs (claude + codex) + bot catalog, from
# the iterion image (all built there; static CGO_ENABLED=0 runs on this base).
COPY --from=iterion-bin /usr/local/bin/iterion /usr/local/bin/iterion
COPY --from=iterion-bin /opt/iterion/llm-clis/node_modules /opt/iterion/llm-clis/node_modules
COPY --from=iterion-bin /opt/iterion/bots /opt/iterion/bots
RUN ln -sf /opt/iterion/llm-clis/node_modules/.bin/claude /usr/local/bin/claude \
 && ln -sf /opt/iterion/llm-clis/node_modules/.bin/codex  /usr/local/bin/codex

# System git identity for in-pod commits (bots pushing to PR branches).
RUN git config --system user.email "iterion-runner@bot.iterion.invalid" \
 && git config --system user.name "iterion-runner[bot]"

ENV ITERION_BOTS_PATH=/opt/iterion/bots \
    PATH="/opt/iterion/llm-clis/node_modules/.bin:/usr/local/bin:/usr/bin:/bin"

# Run as the devbox user (uid 1000) so Nix + devbox work (the base's Nix store is
# owned by devbox). Differs from the base runner's uid 10001 — see DEPLOY NOTE.
USER 1000
WORKDIR /home/devbox

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/iterion"]
CMD ["runner"]
