# Normalize line endings to LF on checkout for all text files.
# Without this, a Windows clone with autocrlf=true would rewrite .bot
# and shell scripts with CRLF, breaking parser indentation rules and
# any `#!/bin/sh` shebang.
* text=auto eol=lf

# Source code — always LF.
*.go        text eol=lf
*.bot       text eol=lf
*.botz      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.sh        text eol=lf
*.bash      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.toml      text eol=lf
Taskfile.yml text eol=lf
Dockerfile  text eol=lf
.envrc      text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Windows-only files that legitimately need CRLF (none today, but
# reserve the convention).
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary assets — never normalize.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tgz       binary
*.tar       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.otf       binary

# Generated / vendored artifacts: leave alone for diffs.
# -text: store vendor byte-exact (no eol normalization). Without this the
# global `* text=auto eol=lf` + per-extension rules (e.g. *.ps1 eol=crlf)
# fight `go mod vendor`, which writes each module's NATIVE line endings —
# producing perpetual drift on the CI vendor-check for files like the
# azure-sdk *.ps1, wails *.go, and go-toast *.md.
vendor/**          -text linguist-vendored
pnpm-lock.yaml     linguist-generated
go.sum             linguist-generated

# The repository maps are rewritten by `iterion map gen` on nearly every
# landing. The reading corpus (internal/corpusreading) pins no file marked
# linguist-generated: such a pin pins churn, and makes every change that
# regenerates the file collide with the next one in the merge queue.
docs/references/map-*.md linguist-generated
