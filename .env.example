# API keys for live e2e tests
# Copy this file to .env and fill in your keys.
# .env is gitignored and will not be committed.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI-compatible gateway: base URL of the gateway serving openai_compatible/<model id> routes (docs/backends.md).
OPENAI_COMPATIBLE_BASE_URL=
# API key for that gateway; leave unset when it sits behind network auth alone.
OPENAI_COMPATIBLE_API_KEY=
# Optional: what the gateway's ids cost and how big they are (strict JSON;
# prices as a pair or not at all) — wins over the catalog provider below.
#OPENAI_COMPATIBLE_MODELS={"<gateway id>":{"context_window":131072,"max_output_tokens":8192,"input_usd_per_mtok":0.1,"output_usd_per_mtok":0.3}}
# Optional: the models.dev provider whose EXACT keys answer the gateway's
# ids (exact after lower-casing; the embedded snapshot answers offline).
#OPENAI_COMPATIBLE_CATALOG_PROVIDER=scaleway
