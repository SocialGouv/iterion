# API keys for live e2e tests
# Copy this file to .env and fill in your keys.
# .env is gitignored and will not be committed.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI-compatible gateway: base URL of the gateway serving openai_compatible/<model id> routes (docs/backends.md).
OPENAI_COMPATIBLE_BASE_URL=
# API key for that gateway; leave unset when it sits behind network auth alone.
OPENAI_COMPATIBLE_API_KEY=
