## ─────────────────────────────────────────────────────────────────
## vuln_watch — "Senti", an inventory-scoped vulnerability sentinel.
##
## One deterministic run mode (mode=watch, hourly), ZERO LLM: the
## compiled workflow contains no agent/judge node, so a run can neither
## spend a token nor show a project name to a model. The techno→projects
## join happens in the deterministic notify step.
##
##   mode=watch
##     plan             (tool) read + validate the workspace config and
##                             the technology inventory; fail loudly
##                             BEFORE any network work
##     poll_dependabot  (tool) GitHub org Dependabot alerts (lane A):
##                             new alerts since the per-org cursor,
##                             grouped by advisory
##     poll_advisories  (tool) advisory feeds (lane B, CERT-FR-style):
##                             new publications + their structured JSON
##                             (cves, affected systems) when available
##     poll_exploit     (tool) CISA KEV catalog (lane C half 1)
##     match_policy     (tool) the brain: match units against the
##                             inventory, join EPSS scores (lane C half
##                             2), apply the exploitation-driven alert
##                             policy, dedup against the seen state,
##                             RE-FIRE observed CVEs whose exploitation
##                             signal just lit up, compute the next
##                             state (nothing persisted yet)
##     notify           (tool) render label-templated messages (any
##                             language via config) and POST them to the
##                             webhook sinks; also announces sources
##                             silent for too long
##     commit_state     (tool) persist the new state under flock and —
##                             with state_commit=true — commit+push it
##                             (git as the state store, required on
##                             ephemeral cloud runners)
##
## Alert policy (the anti-noise core): a matched vulnerability alerts
## immediately ONLY on an exploitation signal — a CISA KEV entry, an
## alert-class advisory (CERT-FR "alerte"), or EPSS ≥ threshold.
## Everything else is recorded in an observation window and re-fires
## the day its signal lights up (the Metabase scenario: the CVE lands
## quietly, KEV picks it up two weeks later → THAT is when the alert
## goes out). Optional floors re-enable severity-driven alerting per
## deployment (dependabot_alert_floor, certfr_avis).
##
## State lives in `<state_dir>/` inside the workspace:
##   state.json      seen CVEs/units + per-source cursors + health
##   alertlog.jsonl  append-only history of every alert posted
##
## Universal by design: no org, feed, webhook, techno or language is
## baked in — everything comes from the workspace config
## (vuln-watch.json) + inventory (inventory.json) + the `webhooks` and
## `dependabot_tokens` secrets. The KEV/EPSS defaults point at the
## public CISA/FIRST endpoints (neutral standards infrastructure) and
## are overridable. Requires python3 (stdlib only) on the execution
## host. See skills/senti-config.md.
## ─────────────────────────────────────────────────────────────────

secrets:
  ## JSON map of webhook name → incoming-webhook URL (same contract as
  ## feed-watch). Config sinks reference entries by NAME so URLs never
  ## appear in the repo. Optional: dry-run and sink-less runs need none.
  webhooks:
    as: file
    optional: true

  ## JSON map of github org login (lowercase) → API token able to read
  ## that org's Dependabot alerts. On an iterion cloud deployment the
  ## forge refresh worker maintains this secret from the GitHub App
  ## (connection security_read_enabled — see docs/forge-security-read.md);
  ## anywhere else, set it by hand with fine-grained PATs
  ## ("Dependabot alerts: read"). Mounted read-only as a FILE, read only
  ## by the poll step — never into a prompt (there is no prompt).
  ## Optional so feed/KEV-only deployments run with no binding; a
  ## CONFIGURED org with no usable token FAILS the run explicitly.
  dependabot_tokens:
    as: file
    optional: true

  ## Forge API token, mounted read-only as a FILE (path/env only). Used
  ## by state_commit=true runs so the cloud runner injects it into the
  ## clone URL and the bot's `git push` of the state dir authenticates.
  ## optional: true — a local/host run authenticates git via the host.
  forge_token:
    as: file
    optional: true

vars:
  workspace_dir: string = "${PROJECT_DIR}"

  ## watch = poll sources, match inventory, alert, commit state.
  ## (Single mode today; the enum leaves room for refresh/recap modes.)
  mode: string [enum: "watch"] = "watch"

  ## Workspace-relative config file (JSON). See skills/senti-config.md.
  config_path: string = "vuln-watch.json"

  ## Workspace-relative technology inventory (JSON): technologies →
  ## match keywords + projects; projects → repos. Overridable from the
  ## config's own `inventory_path` field; this var is the fallback.
  inventory_path: string = "inventory.json"

  ## Workspace-relative state root (gitignore it, or set
  ## state_commit=true to version it — required on ephemeral runners).
  state_dir: string = ".vuln-watch"

  ## Prepare + print every message and payload, deliver nothing, persist
  ## nothing (the next real run recomputes the same alerts).
  dry_run: bool = false

  ## Commit (and push) the state dir after each mutation. Needs the
  ## state_dir NOT gitignored and push credentials on the workspace.
  state_commit: bool = false

  ## Ceiling on advisory + Dependabot lookups the version confirmation may
  ## spend in one run. The confirmation is a precision nicety: it must never
  ## be the reason an hourly tick hangs or hammers the forge.
  max_version_lookups: int = 40

  ## ...and a COUNT of lookups is not a wall-clock bound. At the defaults, 40
  ## sequential requests x a 20s per-request timeout is 800s against a 900s
  ## max_duration — before DNS, body reads, and the three polling lanes that
  ## run first. confirm_versions sits upstream of BOTH notify and
  ## commit_state, so overrunning the workflow budget means no message
  ## delivered and no state consumed: the bot goes silent for exactly as long
  ## as GitHub is slow, which is plausibly when it matters most. This deadline
  ## is what makes the "never the reason a tick hangs" contract above true.
  ## 0 disables it (the lookup ceiling then bounds the node on its own).
  max_version_seconds: int = 120

  ## Per-request HTTP timeout (feeds, APIs).
  fetch_timeout_secs: int = 20

  ## SSRF posture for every outbound fetch (feeds, GitHub API, KEV,
  ## EPSS, advisory JSON). Default (false) is strict: http/https only,
  ## and any host resolving to a private / loopback / link-local /
  ## cloud-metadata address is refused, up-front and on every redirect
  ## hop. true relaxes it (private hosts + file:// sources) for trusted
  ## on-prem deployments and hermetic tests ONLY.
  allow_private_sources: bool = false

  ## Per-run cap on posted alerts. Overflow units stay OBSERVED (they
  ## re-fire next run) and the overflow is announced explicitly — never
  ## a silent truncation.
  max_alerts_per_run: int = 20

  ## Days a non-alerted CVE stays in the observation window, re-scored
  ## against KEV/EPSS every run (the re-fire mechanism).
  observe_window_days: int = 60

  ## Age belt on the KEV lane: a catalog entry older than this is never
  ## treated as fresh, whatever the state says. Bounds the blast radius of
  ## a lost/corrupted cursor (which would otherwise replay the whole
  ## catalog) while leaving a long outage room to catch up.
  kev_max_age_days: int = 90

  ## Hours without a successful poll of a configured source before the
  ## bot announces the silence on the sinks (at most once per window) —
  ## the "finished is not delivered" lesson. 0 disables.
  source_stale_hours: int = 24

  ## Out-of-tree scratch for the inter-node handoff files.
  scratch_dir: string = "${PROJECT_SCRATCH_DIR}/vuln-watch"

## ─── Schemas ────────────────────────────────────────────────────

schema plan_output:
  ## Normalized config, ready for the poll/match nodes.
  github_orgs: string[]
  github_api_base: string
  ## [{url, kind}] — kind: "alert" (exploitation signal by itself,
  ## e.g. CERT-FR alerte) or "advisory" (observe by default).
  advisory_feeds: json
  kev_url: string
  epss_url: string
  ## -1 disables the EPSS signal.
  epss_threshold: float
  ## exploited | critical | high — when a new Dependabot advisory may
  ## alert WITHOUT an exploitation signal.
  dependabot_alert_floor: string
  ## observe | alert — whether a matched non-alert advisory posts.
  certfr_avis: string
  sinks: json
  ## Message labels: built-in English defaults merged with the config's
  ## `labels` map (any language without touching the bot).
  labels: json
  inventory_path: string
  summary: string

schema dependabot_input:
  orgs: string[]
  api_base: string
  timeout_secs: int
  scratch_dir: string
  allow_private: bool
  workspace: string
  state_dir: string

schema dependabot_output:
  ## Scratch file holding the raw new alerts (page-walked per org until
  ## the per-org cursor).
  alerts_file: string
  new_alerts: int
  orgs_ok: int
  orgs_failed: int
  ## [{org, error}] — transient failures; auth/config failures already
  ## hard-failed the node.
  errors: json

schema advisories_input:
  feeds: json
  timeout_secs: int
  scratch_dir: string
  allow_private: bool
  workspace: string
  state_dir: string

schema advisories_output:
  units_file: string
  new_units: int
  feeds_ok: int
  feeds_failed: int
  errors: json

schema exploit_input:
  kev_url: string
  timeout_secs: int
  scratch_dir: string
  allow_private: bool

schema exploit_output:
  kev_file: string
  kev_count: int
  kev_ok: bool
  error: string

schema match_input:
  alerts_file: string
  units_file: string
  kev_file: string
  dependabot_errors: json
  advisory_errors: json
  kev_error: string
  epss_url: string
  epss_threshold: float
  dependabot_alert_floor: string
  certfr_avis: string
  github_orgs: string[]
  advisory_feeds: json
  kev_url: string
  inventory_path: string
  workspace: string
  state_dir: string
  scratch_dir: string
  timeout_secs: int
  allow_private: bool
  max_alerts: int
  kev_max_age_days: int
  observe_window_days: int
  source_stale_hours: int

schema match_output:
  ## Alert units to post, fully joined (ids, title, signals, severity,
  ## fix, projects, repos, links, refire info).
  alerts: json
  alert_count: int
  overflow_count: int
  observed_count: int
  suppressed_count: int
  refire_count: int
  ## [{source, hours, last_ok}] — sources silent beyond the window and
  ## not yet announced this window.
  stale_sources: json
  bootstrap: bool
  ## The next state, staged out-of-tree; commit_state persists it only
  ## after delivery so a failed post replays instead of losing alerts.
  state_next_file: string
  alertlog_file: string
  summary: string

schema confirm_input:
  ## The alerts match_policy decided to post, enriched in place.
  alerts: json
  github_orgs: string[]
  github_api_base: string
  timeout_secs: int
  allow_private: bool
  ## Hard ceiling on advisory+alert lookups for one run: the confirmation
  ## is a nicety, never a reason for the tick to hang or to hammer the API.
  max_lookups: int
  ## ...and the wall-clock half of that promise, which the count alone
  ## cannot make (a slow API turns 40 lookups into 800s). 0 disables.
  max_seconds: int

schema confirm_output:
  alerts: json
  ## Units whose affected packages could be resolved at all. A deployed
  ## product (Metabase, GitLab, a WordPress install) has NO package in any
  ## dependency manifest, so it can never be confirmed this way — that is
  ## reported, not silently rendered as "nothing found".
  confirmable: int
  confirmed: int
  lookups: int
  errors: json
  summary: string

schema notify_input:
  alerts: json
  overflow_count: int
  stale_sources: json
  sinks: json
  labels: json
  dry_run: bool

schema notify_output:
  posted: bool
  dry_run: bool
  ## The rendered messages (webhook/channel/text) — the run artifact IS
  ## the dry-run review surface. Stdout carries ONLY the final JSON: the
  ## engine parses the whole stream as one object, so diagnostics go to
  ## stderr, never stdout.
  messages: json
  delivered: int
  ## True when the run may persist the staged state: not a dry-run, and
  ## either nothing needed posting or something was actually delivered.
  ## A run that computed alerts but delivered none keeps the old state,
  ## so the next run recomputes the SAME alerts (at-least-once).
  consume: bool
  targets: string[]
  summary: string

schema commit_input:
  state_next_file: string
  alertlog_file: string
  state_commit: bool
  workspace: string
  state_dir: string

schema commit_output:
  committed: bool
  summary: string

## ─── Nodes ──────────────────────────────────────────────────────

## Deterministic entry: validate mode + config + inventory, normalize
## defaults, merge message labels. Config problems fail HERE, loudly,
## before any network work.
tool plan:
  output: plan_output
  language: py
  script: |
    import json, os
    ws = {{vars.workspace_dir}}
    cfg_path = {{vars.config_path}}
    inv_fallback = {{vars.inventory_path}}
    mode = {{vars.mode}}
    os.chdir(ws)
    if mode != 'watch':
        raise SystemExit('vuln-watch: invalid mode ' + repr(mode) + ' -- only mode=watch exists')
    if not os.path.exists(cfg_path):
        raise SystemExit('vuln-watch: config file ' + repr(cfg_path) + ' not found in ' + os.getcwd() +
                         ' -- create it (see the senti-config skill) or pass --var config_path=...')
    cfg = json.load(open(cfg_path, encoding='utf-8'))

    orgs = [str(o).strip().lower() for o in (cfg.get('github_orgs') or []) if str(o).strip()]
    feeds = []
    for f in (cfg.get('advisory_feeds') or []):
        if isinstance(f, str):
            feeds.append({'url': f, 'kind': 'advisory'})
        elif isinstance(f, dict) and f.get('url'):
            kind = f.get('kind') or 'advisory'
            if kind not in ('alert', 'advisory'):
                raise SystemExit('vuln-watch: advisory_feeds[].kind must be "alert" or "advisory", got ' + repr(kind))
            feeds.append({'url': f['url'], 'kind': kind})
        else:
            raise SystemExit('vuln-watch: advisory_feeds entries must be a URL string or {url, kind}')
    ## Neutral public defaults (CISA / FIRST — standards infrastructure),
    ## overridable per deployment; "" (explicit empty) disables the lane.
    kev_url = cfg.get('kev_url')
    if kev_url is None:
        kev_url = 'https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json'
    epss_url = cfg.get('epss_url')
    if epss_url is None:
        epss_url = 'https://api.first.org/data/v1/epss'
    thr = cfg.get('epss_threshold')
    thr = -1.0 if thr is None and not epss_url else float(thr if thr is not None else 0.5)
    if not epss_url:
        thr = -1.0
    floor = cfg.get('dependabot_alert_floor') or 'exploited'
    if floor not in ('exploited', 'critical', 'high'):
        raise SystemExit('vuln-watch: dependabot_alert_floor must be exploited|critical|high, got ' + repr(floor))
    avis = cfg.get('certfr_avis') or 'observe'
    if avis not in ('observe', 'alert'):
        raise SystemExit('vuln-watch: certfr_avis must be observe|alert, got ' + repr(avis))
    if not orgs and not feeds and not kev_url:
        raise SystemExit('vuln-watch: config declares no source at all (github_orgs, advisory_feeds and kev_url all empty)')

    inv_path = cfg.get('inventory_path') or inv_fallback
    if not os.path.exists(inv_path):
        raise SystemExit('vuln-watch: inventory file ' + repr(inv_path) + ' not found -- generate it (see the senti-config skill) or set inventory_path')
    inv = json.load(open(inv_path, encoding='utf-8'))
    techs = inv.get('technologies') or {}
    projects = inv.get('projects') or {}
    if not isinstance(techs, dict) or not isinstance(projects, dict):
        raise SystemExit('vuln-watch: inventory must carry technologies + projects maps (see the senti-config skill)')
    if (feeds or kev_url) and not any((t or {}).get('match') for t in techs.values()):
        raise SystemExit('vuln-watch: advisory/KEV lanes are configured but no inventory technology has match keywords -- nothing could ever match')
    for key, p in projects.items():
        if not isinstance(p, dict):
            raise SystemExit('vuln-watch: inventory project ' + repr(key) + ' must be an object')
    for key, t in techs.items():
        for pref in (t or {}).get('projects') or []:
            if pref not in projects:
                raise SystemExit('vuln-watch: inventory technology ' + repr(key) + ' references unknown project ' + repr(pref))

    ## English defaults; the config's `labels` map overrides any subset —
    ## this bot bakes in no language (deterministic messages included).
    labels = {
        'exploited': 'actively exploited vulnerability',
        'alert': 'security alert',
        'signal': 'Signal',
        'severity': 'severity',
        'fix': 'Fix',
        'no_fix': 'none published yet',
        'fix_see_source': 'see the advisory',
        'projects': 'Affected projects',
        'confirmed_projects': 'Vulnerable — confirmed',
        'fixed_projects': 'Was vulnerable — already fixed',
        'declared_projects': 'Declares this technology — to verify',
        'not_a_package': 'no dependency package to check against (deployed product): version not verifiable automatically',
        'check_unavailable': 'version NOT verified this run (no advisory match, lookup budget or API error) — assume nothing',
        'none_found': 'no vulnerable dependency found in the watched orgs',
        'fixed_window': 'was vulnerable {since} → {until}',
        'open_since': 'since {since}',
        'repos': 'repo(s)',
        'via_dependabot': 'flagged by Dependabot in {n} repo(s)',
        'sources': 'Sources',
        'more': 'more',
        'refire': 'first observed {date} (kept silent) — alerted now: {signal}',
        'overflow': '{n} more alert(s) exceeded the per-run cap; they stay pending and will fire on the next run',
        'stale': 'source silent: {source} without a successful poll for {hours}h (last OK: {last})',
        'kev_signal': 'CISA KEV {date}',
        'ale_signal': 'alert-class advisory',
        'epss_signal': 'EPSS {pct}%',
        'sev_signal': 'severity floor {sev}',
    }
    for k, v in (cfg.get('labels') or {}).items():
        if k in labels and isinstance(v, str) and v:
            labels[k] = v

    sinks = cfg.get('sinks') or []
    summary = ('watch: ' + str(len(orgs)) + ' org(s), ' + str(len(feeds)) + ' feed(s), KEV ' +
               ('on' if kev_url else 'off') + ', EPSS ' + (('>=' + str(thr)) if thr >= 0 else 'off') +
               ', floor=' + floor + ', ' + str(len(techs)) + ' technologies / ' + str(len(projects)) + ' projects')
    print(json.dumps({'github_orgs': orgs,
                      'github_api_base': (cfg.get('github_api_base') or 'https://api.github.com').rstrip('/'),
                      'advisory_feeds': feeds, 'kev_url': kev_url, 'epss_url': epss_url,
                      'epss_threshold': thr, 'dependabot_alert_floor': floor, 'certfr_avis': avis,
                      'sinks': sinks, 'labels': labels, 'inventory_path': inv_path,
                      'summary': summary}, ensure_ascii=False))

## Lane A: GitHub org Dependabot alerts. Walks each org's open alerts
## (sorted created desc) until the per-org cursor from the state; the
## cursor itself only advances in commit_state, after delivery. A
## configured org with no usable token, or a 401/403, HARD-FAILS the
## run (credential problems are actionable now, and a silent skip would
## be a zero-alert façade). Transient failures (5xx, timeout) are
## collected per org; the health net announces a source silent >24h.
tool poll_dependabot:
  input: dependabot_input
  output: dependabot_output
  language: py
  script: |
    import json, os, socket, ipaddress, time
    import urllib.request, urllib.error
    from urllib.parse import urlsplit
    null = None; true = True; false = False  # JSON-literal shim for missing refs
    orgs = {{input.orgs}} or []
    api_base = {{input.api_base}}
    timeout = {{input.timeout_secs}}
    scratch = {{input.scratch_dir}}
    allow_private = {{input.allow_private}}
    ws = {{input.workspace}}
    state_dir = {{input.state_dir}}
    tokens_file = {{secrets.dependabot_tokens.path}}
    os.makedirs(scratch, exist_ok=True)
    out_path = os.path.join(scratch, 'dependabot.json')

    if not orgs:
        with open(out_path, 'w', encoding='utf-8') as fh:
            json.dump({}, fh)
        print(json.dumps({'alerts_file': out_path, 'new_alerts': 0, 'orgs_ok': 0, 'orgs_failed': 0, 'errors': []}))
        raise SystemExit(0)

    tokens = {}
    if tokens_file and os.path.exists(tokens_file):
        try:
            raw = open(tokens_file, encoding='utf-8').read().strip()
            tokens = json.loads(raw) if raw else {}
        except ValueError:
            raise SystemExit('vuln-watch: the dependabot_tokens secret is not a JSON map of org->token')
    missing = [o for o in orgs if not (tokens.get(o) or tokens.get('*'))]
    if missing:
        raise SystemExit('vuln-watch: no Dependabot token for configured org(s) ' + ', '.join(missing) +
                         ' -- enable security_read on the GitHub App connection (docs/forge-security-read.md)'
                         ' or set the dependabot_tokens secret to a JSON map {org: fine-grained PAT}')

    def _addr_ok(ip):
        if allow_private:
            return True
        try:
            a = ipaddress.ip_address(ip)
        except ValueError:
            return False
        if a.version == 6 and a.ipv4_mapped is not None:
            a = a.ipv4_mapped
        return (a.is_global and not (a.is_private or a.is_loopback or a.is_link_local or
                a.is_reserved or a.is_multicast or a.is_unspecified))
    def _validate_host(host):
        if allow_private or not host:
            return
        for k in ('HTTPS_PROXY', 'https_proxy', 'HTTP_PROXY', 'http_proxy'):
            v = (os.environ.get(k) or '').strip()
            if v and (urlsplit(v if '://' in v else 'http://' + v).hostname == host):
                return
        infos = socket.getaddrinfo(host, None)
        for info in infos:
            if not _addr_ok(info[4][0]):
                raise OSError('SSRF-unsafe address ' + str(info[4][0]) + ' for host ' + str(host))

    class _SafeRedirect(urllib.request.HTTPRedirectHandler):
        ## The API call carries the org's Dependabot token in an
        ## Authorization header, and urllib KEEPS that header across a
        ## cross-host redirect — a 302 from the API host would hand the
        ## token to whoever answers. Refuse any hop off the configured API
        ## host (and any non-http(s) scheme), and validate its address.
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            parts = urlsplit(newurl)
            if parts.scheme not in ('http', 'https'):
                return None
            if (parts.hostname or '') != base_host:
                raise OSError('refusing redirect off the configured API host: ' + str(newurl)[:200])
            _validate_host(parts.hostname or '')
            return super().redirect_request(req, fp, code, msg, headers, newurl)

    _opener = urllib.request.build_opener(_SafeRedirect())

    ## Read-only peek at the state for the per-org cursor (advancing it
    ## stays commit_state's job). Missing state = bootstrap: page 1 only.
    cursors = {}
    spath = os.path.join(ws, state_dir, 'state.json')
    if os.path.exists(spath):
        try:
            cursors = (json.load(open(spath, encoding='utf-8')).get('cursors') or {}).get('dependabot') or {}
        except ValueError:
            raise SystemExit('vuln-watch: state file ' + spath + ' is not valid JSON -- repair or remove it')

    ## The org token rides on this base as a bearer credential, so the
    ## scheme is part of the guard: an http:// (or file://) base would send
    ## it in clear, or somewhere it has no business going.
    _base_parts = urlsplit(api_base)
    if _base_parts.scheme != 'https' and not allow_private:
        raise SystemExit('vuln-watch: github_api_base must be an https:// URL (got ' +
                         repr(api_base) + ') -- the Dependabot token is sent to it as a bearer credential')
    if _base_parts.scheme not in ('http', 'https'):
        raise SystemExit('vuln-watch: github_api_base must be an http(s) URL, got ' + repr(api_base))
    base_host = _base_parts.hostname or ''
    _validate_host(base_host)

    def get(url, token):
        req = urllib.request.Request(url, headers={
            'Authorization': 'Bearer ' + token,
            'Accept': 'application/vnd.github+json',
            'X-GitHub-Api-Version': '2022-11-28',
            'User-Agent': 'vuln-watch/0.1 (iterion; +https://github.com/SocialGouv/iterion)'})
        last = None
        for attempt in (0, 1):
            if attempt:
                time.sleep(2)
            try:
                with _opener.open(req, timeout=timeout) as r:
                    return json.loads(r.read(8 * 1024 * 1024).decode('utf-8')), (r.headers.get('Link') or '')
            except urllib.error.HTTPError as e:
                ## GitHub answers 403 for BOTH "you may not read this" and
                ## "slow down" (secondary rate limit / abuse detection). Only
                ## the first is a credential problem worth failing an hourly
                ## run over; a rate limit is transient and must be retried,
                ## then reported as a source error like any other blip.
                body = ''
                try:
                    body = (e.read() or b'')[:500].decode('utf-8', 'replace').lower()
                except Exception:
                    pass
                rate_limited = (e.code == 403 and (
                    'rate limit' in body or 'abuse' in body or
                    (e.headers or {}).get('Retry-After') is not None or
                    (e.headers or {}).get('X-RateLimit-Remaining') == '0'))
                if e.code == 401 or (e.code == 403 and not rate_limited):
                    raise SystemExit('vuln-watch: GitHub rejected the Dependabot token (HTTP ' + str(e.code) +
                                     ') on ' + url.split('?')[0] + ' -- the token lacks Dependabot-alerts read'
                                     ' access, the org has Dependabot alerts disabled, or the token expired;'
                                     ' check the connection health (docs/forge-security-read.md). GitHub said: ' +
                                     body[:200])
                last = e
                if e.code < 500 and not rate_limited:
                    raise
            except (TimeoutError, socket.timeout, urllib.error.URLError) as e:
                last = e
        raise last

    def next_link(link_header):
        ## The pagination URL is server-supplied and re-requested WITH the
        ## Authorization header — so it is only followed when it stays on
        ## the configured API host (a rewritten Link header would otherwise
        ## exfiltrate the token in one hop).
        for part in (link_header or '').split(','):
            if 'rel="next"' in part:
                s = part.find('<'); e = part.find('>')
                if 0 <= s < e:
                    url = part[s + 1:e]
                    parts = urlsplit(url)
                    if parts.scheme not in ('http', 'https') or (parts.hostname or '') != base_host:
                        raise OSError('refusing an off-host pagination Link: ' + url[:200])
                    return url
        return ''

    by_org, errors, ok, total = {}, [], 0, 0
    MAX_PAGES = 10  # bounded walk; truncation is REPORTED, never silent
    for org in orgs:
        token = tokens.get(org) or tokens.get('*')
        cursor = cursors.get(org) or ''
        url = api_base + '/orgs/' + org + '/dependabot/alerts?state=open&sort=created&direction=desc&per_page=100'
        fresh, pages, truncated = [], 0, False
        try:
            while url:
                data, link = get(url, token)
                pages += 1
                stop = False
                for a in data:
                    created = a.get('created_at') or ''
                    ## STRICT: Dependabot bulk-creates one advisory's alerts
                    ## across many repos within the same second, so an
                    ## inclusive comparison drops whichever of them the
                    ## previous snapshot missed — and breaks the page walk
                    ## on top. Re-emitting the boundary alert is harmless
                    ## (the suppression predicate dedups it).
                    if cursor and created < cursor:
                        stop = True
                        break
                    fresh.append(a)
                ## Bootstrap (no cursor): page 1 is enough — the whole open
                ## backlog is not news, only the newest created_at matters
                ## (it arms the cursor). Walking further would page through
                ## thousands of historical alerts for nothing.
                if stop or not data or not cursor:
                    break
                url = next_link(link)
                if pages >= MAX_PAGES and url:
                    truncated = True
                    break
            by_org[org] = {'alerts': fresh, 'bootstrap': not cursor, 'truncated': truncated}
            ok += 1
            total += len(fresh)
            if truncated:
                errors.append({'org': org, 'error': 'more than ' + str(MAX_PAGES) + ' pages of new alerts; oldest not scanned this run'})
        except SystemExit:
            raise
        except Exception as e:
            errors.append({'org': org, 'error': type(e).__name__ + ': ' + str(e)[:300]})
    if orgs and ok == 0:
        raise SystemExit('vuln-watch: every org poll failed: ' + json.dumps(errors)[:1500])
    with open(out_path, 'w', encoding='utf-8') as fh:
        json.dump(by_org, fh, ensure_ascii=False)
    print(json.dumps({'alerts_file': out_path, 'new_alerts': total, 'orgs_ok': ok,
                      'orgs_failed': len(errors), 'errors': errors}, ensure_ascii=False))

## Lane B: advisory feeds. Parses each RSS/Atom feed (stdlib), keeps the
## entries whose id is not in the seen state, and enriches each new one
## through the CERT-FR-style `<link>/json/` endpoint (cves[] +
## affected_systems[]) when it answers; otherwise the entry title +
## summary carry the match text and CVE ids are regex-extracted. Same
## SSRF guard as feed-watch: config-supplied URLs are untrusted input.
tool poll_advisories:
  input: advisories_input
  output: advisories_output
  language: py
  script: |
    import json, os, re, zlib, socket, ipaddress, time
    import urllib.request, urllib.error
    from urllib.parse import urlsplit
    import xml.etree.ElementTree as ET

    MAX_INFLATED = 64 * 1024 * 1024
    def gunzip(raw, limit=MAX_INFLATED):
        ## Bounded inflate: gzip.decompress() has no output cap, and a
        ## repetitive XML body compresses ~400:1 (a zero stream ~1000:1), so
        ## an 8 MiB response expands past 3 GB in ONE allocation and kills
        ## the run — or the pod. Reachable from any feed, and from the
        ## enrichment URL the feed itself names.
        d = zlib.decompressobj(16 + zlib.MAX_WBITS)
        out = d.decompress(raw, limit)
        if d.unconsumed_tail:
            raise ValueError('refusing a body that inflates beyond ' + str(limit) + ' bytes')
        return out
    null = None; true = True; false = False  # JSON-literal shim for missing refs
    feeds = {{input.feeds}} or []
    timeout = {{input.timeout_secs}}
    scratch = {{input.scratch_dir}}
    allow_private = {{input.allow_private}}
    ws = {{input.workspace}}
    state_dir = {{input.state_dir}}
    os.makedirs(scratch, exist_ok=True)
    out_path = os.path.join(scratch, 'advisories.json')

    if not feeds:
        with open(out_path, 'w', encoding='utf-8') as fh:
            json.dump([], fh)
        print(json.dumps({'units_file': out_path, 'new_units': 0, 'feeds_ok': 0, 'feeds_failed': 0, 'errors': []}))
        raise SystemExit(0)

    seen = set()
    spath = os.path.join(ws, state_dir, 'state.json')
    if os.path.exists(spath):
        try:
            seen = set((json.load(open(spath, encoding='utf-8')).get('cursors') or {}).get('feeds_seen') or [])
        except ValueError:
            raise SystemExit('vuln-watch: state file ' + spath + ' is not valid JSON -- repair or remove it')

    _real_getaddrinfo = socket.getaddrinfo
    def _env_proxy_hosts():
        hosts = set()
        for k in ('HTTPS_PROXY', 'https_proxy', 'HTTP_PROXY', 'http_proxy', 'ALL_PROXY', 'all_proxy'):
            v = (os.environ.get(k) or '').strip()
            if not v:
                continue
            try:
                h = urlsplit(v if '://' in v else 'http://' + v).hostname
            except ValueError:
                h = None
            if h:
                hosts.add(h)
        return hosts
    _proxy_hosts = _env_proxy_hosts()
    _behind_proxy = bool(_proxy_hosts)
    def _addr_ok(ip):
        if allow_private:
            return True
        try:
            a = ipaddress.ip_address(ip)
        except ValueError:
            return False
        if a.version == 6 and a.ipv4_mapped is not None:
            a = a.ipv4_mapped
        return (a.is_global and not (a.is_private or a.is_loopback or a.is_link_local or
                a.is_reserved or a.is_multicast or a.is_unspecified))
    def _guarded_getaddrinfo(host, port, *a, **k):
        infos = _real_getaddrinfo(host, port, *a, **k)
        for info in infos:
            if not _addr_ok(info[4][0]):
                raise OSError('SSRF-unsafe address ' + str(info[4][0]) + ' for host ' + str(host))
        return infos
    def _validate_host(host):
        if allow_private or not host or host in _proxy_hosts:
            return
        infos = _real_getaddrinfo(host, None)
        for info in infos:
            if not _addr_ok(info[4][0]):
                raise OSError('SSRF-unsafe address ' + str(info[4][0]) + ' for host ' + str(host))
    class _SafeRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            if urlsplit(newurl).scheme not in ('http', 'https'):
                return None
            _validate_host(urlsplit(newurl).hostname or '')
            return super().redirect_request(req, fp, code, msg, headers, newurl)
    _opener = urllib.request.build_opener(_SafeRedirect())

    def fetch(url):
        parts = urlsplit(url)
        schemes = ('http', 'https', 'file') if allow_private else ('http', 'https')
        if parts.scheme not in schemes:
            raise ValueError('unsupported URL scheme ' + repr(parts.scheme))
        if parts.scheme in ('http', 'https'):
            if parts.username or parts.password:
                raise ValueError('URL must not carry embedded credentials')
            if not parts.hostname:
                raise ValueError('URL has no host')
            _validate_host(parts.hostname)
        req = urllib.request.Request(url, headers={
            'User-Agent': 'vuln-watch/0.1 (iterion; +https://github.com/SocialGouv/iterion)',
            'Accept': 'application/rss+xml, application/atom+xml, application/xml, application/json, text/xml, */*',
            'Accept-Encoding': 'gzip, identity'})
        last = None
        for attempt in (0, 1):
            if attempt:
                time.sleep(2)
            try:
                with _opener.open(req, timeout=timeout) as r:
                    raw = r.read(8 * 1024 * 1024)
                if raw[:2] == b'\x1f\x8b':
                    raw = gunzip(raw)
                return raw
            except urllib.error.HTTPError as e:
                last = e
                if e.code < 500:
                    raise
            except (TimeoutError, socket.timeout, urllib.error.URLError) as e:
                last = e
        raise last

    def local(tag):
        return tag.rsplit('}', 1)[-1] if isinstance(tag, str) else ''
    def text(el):
        return (el.text or '').strip() if el is not None else ''
    def strip_html(s):
        s = re.sub(r'<[^>]+>', ' ', s or '')
        s = re.sub(r'&#?\w+;', ' ', s)
        return re.sub(r'\s+', ' ', s).strip()
    def entry_from(el):
        d = {'id': '', 'url': '', 'title': '', 'summary': '', 'published': ''}
        for ch in el:
            n = local(ch.tag)
            if n == 'title':
                d['title'] = strip_html(text(ch))
            elif n == 'link':
                ## An Atom entry carries SEVERAL <link>s (alternate, related,
                ## enclosure, replies). Taking the last one lands on a
                ## non-page URL, which breaks both the enrichment fetch and
                ## the id fallback. Prefer rel="alternate" (the entry's own
                ## page), and never let a later link overwrite it.
                href = (ch.get('href') or '').strip() or text(ch)
                rel = (ch.get('rel') or 'alternate').strip() or 'alternate'
                if href and (rel == 'alternate' or not d['url']):
                    if rel == 'alternate' or not d.get('_url_alt'):
                        d['url'] = href
                        if rel == 'alternate':
                            d['_url_alt'] = True
            elif n in ('guid', 'id'):
                d['id'] = text(ch)
            elif n in ('description', 'summary') and not d['summary']:
                d['summary'] = strip_html(text(ch))[:600]
            elif n in ('pubDate', 'published', 'updated', 'date') and not d['published']:
                d['published'] = text(ch)
        if not d['id']:
            d['id'] = d['url'] or d['title']
        d.pop('_url_alt', None)
        return d
    class _NoEntityTarget(ET.TreeBuilder):
        ## A bounded inflate is undone by expat's entity expansion (roughly
        ## 100x is still permitted), so a 64 MiB ceiling becomes a multi-GB
        ## allocation. A syndication feed has no legitimate use for a
        ## DTD-declared entity: refuse the document instead of expanding it.
        def doctype(self, name, pubid, system):
            raise ValueError('refusing a feed carrying a DTD (entity expansion)')

    def parse_feed(raw):
        parser = ET.XMLParser(target=_NoEntityTarget())
        try:
            parser.parser.EntityDeclHandler = lambda *a, **k: (_ for _ in ()).throw(
                ValueError('refusing a feed declaring XML entities'))
        except AttributeError:
            pass  # non-expat backend: the doctype guard above still applies
        parser.feed(raw)
        root = parser.close()
        if local(root.tag) == 'feed':
            return [entry_from(el) for el in root if local(el.tag) == 'entry']
        return [entry_from(el) for el in root.findall('.//*') if local(el.tag) == 'item']

    CVE_RE = re.compile(r'CVE-\d{4}-\d{4,}')
    ## Enrichment is one extra request PER new entry, with no natural bound
    ## (a quiet feed catching up can hand back hundreds). Left uncapped it
    ## blows the run's duration budget — and a dead run takes the Dependabot
    ## and KEV lanes down with it, for a lane that is only an optimisation.
    ## The DEADLINE is the real bound (it is what protects the run budget);
    ## the count is only a backstop against a pathological feed. Set too
    ## tight it silently degrades a catch-up tick to title-only matching —
    ## measured: a 60-entry cap dropped the Metabase advisory out of an
    ## 80-entry backlog, because its CVE ids live in the structured
    ## document, not in the RSS title.
    ENRICH_DEADLINE = time.monotonic() + max(30, timeout * 6)
    ENRICH_MAX = 500
    enriched_count = 0
    units, errors, ok = [], [], 0
    if not _behind_proxy:
        socket.getaddrinfo = _guarded_getaddrinfo
    try:
        for f in feeds:
            furl, kind = f.get('url') or '', f.get('kind') or 'advisory'
            try:
                entries = parse_feed(fetch(furl))
                ok += 1
            except Exception as e:
                errors.append({'feed': furl, 'error': type(e).__name__ + ': ' + str(e)[:300]})
                continue
            for d in entries:
                uid = d['id']
                if not uid or uid in seen:
                    continue
                unit = {'id': uid, 'kind': kind, 'title': d['title'], 'url': d['url'],
                        'published': d['published'], 'cves': [], 'match_text': d['title'] + ' ' + d['summary'],
                        'feed': furl}
                ## CERT-FR-style structured enrichment: <link>/json/ names
                ## the CVEs and affected products. Best-effort — a feed
                ## without it falls back to title+summary matching.
                enrich_budget_left = enriched_count < ENRICH_MAX and time.monotonic() < ENRICH_DEADLINE
                if d['url'].startswith(('http://', 'https://', 'file://')) and not enrich_budget_left:
                    ## Out of budget, not broken: mark it like a failed
                    ## enrichment so the entry is retried on a later tick
                    ## (bounded) instead of being consumed with the weaker
                    ## title-only match.
                    unit['enrich_failed'] = True
                if d['url'].startswith(('http://', 'https://', 'file://')) and enrich_budget_left:
                    enriched_count += 1
                    try:
                        j = json.loads(fetch(d['url'].rstrip('/') + '/json/').decode('utf-8'))
                        unit['enriched'] = True
                        unit['cves'] = sorted({c.get('name') for c in (j.get('cves') or []) if c.get('name')})
                        prods = []
                        for a in (j.get('affected_systems') or []):
                            p = (a.get('product') or {})
                            prods.append(' '.join(x for x in (
                                (p.get('vendor') or {}).get('name') or '', p.get('name') or '',
                                a.get('description') or '') if x))
                        ## ADD to the match text, never replace it: an
                        ## advisory whose structured document carries no
                        ## affected_systems would otherwise be matched on
                        ## LESS text than an un-enriched one.
                        unit['match_text'] = ' '.join(
                            [unit['match_text'], j.get('title') or ''] + prods)
                        unit['title'] = j.get('title') or d['title']
                    except Exception:
                        ## The structured document is what carries the CVE
                        ## ids and the affected products; without it the
                        ## match degrades to the title alone. Record the
                        ## miss so match_policy does NOT consume the entry
                        ## on a transient 503 — a burned advisory is a
                        ## permanent blind spot (it never even enters the
                        ## observation window).
                        unit['enrich_failed'] = True
                if not unit['cves']:
                    unit['cves'] = sorted(set(CVE_RE.findall(unit['match_text'] + ' ' + d['summary'])))
                units.append(unit)
    finally:
        socket.getaddrinfo = _real_getaddrinfo
    if feeds and ok == 0:
        raise SystemExit('vuln-watch: all ' + str(len(feeds)) + ' advisory feed fetches failed: ' + json.dumps(errors)[:1500])
    with open(out_path, 'w', encoding='utf-8') as fh:
        json.dump(units, fh, ensure_ascii=False)
    print(json.dumps({'units_file': out_path, 'new_units': len(units), 'feeds_ok': ok,
                      'feeds_failed': len(errors), 'errors': errors}, ensure_ascii=False))

## Lane C (half 1): the CISA KEV catalog — the full set every run (the
## lookup that answers "is this CVE exploited?" for every lane) plus the
## diff-by-dateAdded that match_policy joins directly against the
## inventory (the Metabase scenario needs no other lane to have seen the
## CVE first). A fetch failure is reported, not fatal: the other lanes
## still alert, and the health net announces a KEV silent >24h.
tool poll_exploit:
  input: exploit_input
  output: exploit_output
  language: py
  script: |
    import json, os, zlib, socket, ipaddress, time
    import urllib.request, urllib.error
    from urllib.parse import urlsplit
    null = None; true = True; false = False  # JSON-literal shim for missing refs
    kev_url = {{input.kev_url}}
    timeout = {{input.timeout_secs}}
    scratch = {{input.scratch_dir}}
    allow_private = {{input.allow_private}}
    os.makedirs(scratch, exist_ok=True)
    out_path = os.path.join(scratch, 'kev.json')

    if not kev_url:
        with open(out_path, 'w', encoding='utf-8') as fh:
            json.dump({'vulnerabilities': []}, fh)
        print(json.dumps({'kev_file': out_path, 'kev_count': 0, 'kev_ok': True, 'error': ''}))
        raise SystemExit(0)

    def _addr_ok(ip):
        if allow_private:
            return True
        try:
            a = ipaddress.ip_address(ip)
        except ValueError:
            return False
        if a.version == 6 and a.ipv4_mapped is not None:
            a = a.ipv4_mapped
        return (a.is_global and not (a.is_private or a.is_loopback or a.is_link_local or
                a.is_reserved or a.is_multicast or a.is_unspecified))
    def _validate_host(host):
        if allow_private or not host:
            return
        for k in ('HTTPS_PROXY', 'https_proxy', 'HTTP_PROXY', 'http_proxy'):
            v = (os.environ.get(k) or '').strip()
            if v and (urlsplit(v if '://' in v else 'http://' + v).hostname == host):
                return
        for info in socket.getaddrinfo(host, None):
            if not _addr_ok(info[4][0]):
                raise OSError('SSRF-unsafe address ' + str(info[4][0]) + ' for host ' + str(host))

    class _SafeRedirect(urllib.request.HTTPRedirectHandler):
        ## Every hop is validated, not just the first: a public host that
        ## 302s to 169.254.169.254 would otherwise walk straight past the
        ## up-front check (the guard's whole point).
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            if urlsplit(newurl).scheme not in ('http', 'https'):
                return None
            _validate_host(urlsplit(newurl).hostname or '')
            return super().redirect_request(req, fp, code, msg, headers, newurl)

    _opener = urllib.request.build_opener(_SafeRedirect())

    parts = urlsplit(kev_url)
    schemes = ('http', 'https', 'file') if allow_private else ('http', 'https')
    error, data = '', {'vulnerabilities': []}
    try:
        if parts.scheme not in schemes:
            raise ValueError('unsupported URL scheme ' + repr(parts.scheme))
        if parts.scheme in ('http', 'https'):
            _validate_host(parts.hostname or '')
        req = urllib.request.Request(kev_url, headers={
            'User-Agent': 'vuln-watch/0.1 (iterion; +https://github.com/SocialGouv/iterion)',
            'Accept': 'application/json', 'Accept-Encoding': 'gzip, identity'})
        last = None
        for attempt in (0, 1):
            if attempt:
                time.sleep(2)
            try:
                with _opener.open(req, timeout=timeout) as r:
                    raw = r.read(32 * 1024 * 1024)
                break
            except urllib.error.HTTPError as e:
                last = e
                if e.code < 500:
                    raise
                raw = None
            except (TimeoutError, socket.timeout, urllib.error.URLError) as e:
                last = e
                raw = None
        if raw is None:
            raise last
        if raw[:2] == b'\x1f\x8b':
            ## Bounded inflate — see poll_advisories' gunzip for the why.
            _d = zlib.decompressobj(16 + zlib.MAX_WBITS)
            raw = _d.decompress(raw, 128 * 1024 * 1024)
            if _d.unconsumed_tail:
                raise ValueError('refusing a KEV body that inflates beyond 128 MiB')
        data = json.loads(raw.decode('utf-8'))
        if not isinstance(data.get('vulnerabilities'), list):
            raise ValueError('KEV payload has no vulnerabilities list')
    except Exception as e:
        error = type(e).__name__ + ': ' + str(e)[:300]
        data = {'vulnerabilities': []}
    with open(out_path, 'w', encoding='utf-8') as fh:
        json.dump(data, fh, ensure_ascii=False)
    print(json.dumps({'kev_file': out_path, 'kev_count': len(data.get('vulnerabilities') or []),
                      'kev_ok': not error, 'error': error}, ensure_ascii=False))

## The brain — pure computation over the polled files + the seen state:
## inventory matching (word-boundary keyword regexes), EPSS batch
## scoring of the candidate CVEs, the exploitation-driven alert policy,
## alias-set dedup, the re-fire scan over the observation window, the
## per-run cap (overflow reported, never silent), source-health staleness,
## and the NEXT state staged out-of-tree. Persists nothing: a failed
## delivery downstream must replay these alerts, not lose them.
tool match_policy:
  input: match_input
  output: match_output
  language: py
  script: |
    import json, os, re, datetime, socket, ipaddress
    import urllib.request, urllib.error
    from urllib.parse import urlsplit, quote
    null = None; true = True; false = False  # JSON-literal shim for missing refs
    alerts_file = {{input.alerts_file}}
    units_file = {{input.units_file}}
    kev_file = {{input.kev_file}}
    dep_errors = {{input.dependabot_errors}} or []
    adv_errors = {{input.advisory_errors}} or []
    kev_error = {{input.kev_error}}
    epss_url = {{input.epss_url}}
    epss_thr = float({{input.epss_threshold}})
    floor = {{input.dependabot_alert_floor}}
    avis_mode = {{input.certfr_avis}}
    orgs = {{input.github_orgs}} or []
    feeds = {{input.advisory_feeds}} or []
    kev_url = {{input.kev_url}}
    inv_path = {{input.inventory_path}}
    ws = {{input.workspace}}
    state_dir = {{input.state_dir}}
    scratch = {{input.scratch_dir}}
    timeout = {{input.timeout_secs}}
    allow_private = {{input.allow_private}}
    max_alerts = int({{input.max_alerts}})
    kev_max_age_days = int({{input.kev_max_age_days}})
    observe_days = int({{input.observe_window_days}})
    stale_hours = int({{input.source_stale_hours}})
    os.chdir(ws)
    now = datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0)
    now_iso = now.isoformat()

    def jload(path, default):
        if path and os.path.exists(path):
            with open(path, encoding='utf-8') as fh:
                return json.load(fh)
        return default

    dep_by_org = jload(alerts_file, {})
    adv_units = jload(units_file, [])
    kev = jload(kev_file, {'vulnerabilities': []})
    inv = jload(inv_path, {})
    techs = inv.get('technologies') or {}
    projects = inv.get('projects') or {}

    spath = os.path.join(state_dir, 'state.json')
    bootstrap = not os.path.exists(spath)
    state = jload(spath, {'version': 1, 'cves': {}, 'units': {}, 'cursors': {}, 'health': {}})
    st_cves = state.setdefault('cves', {})
    st_units = state.setdefault('units', {})
    cursors = state.setdefault('cursors', {})
    health = state.setdefault('health', {})

    ## ── inventory match machinery ───────────────────────────────────
    repo_index = {}
    for pkey, p in projects.items():
        for r in (p.get('repos') or []):
            repo_index[str(r).lower()] = pkey
    tech_res = []
    for tkey, t in techs.items():
        if not (t or {}).get('watch', True):
            continue
        kws = [k for k in ((t or {}).get('match') or []) if k]
        if not kws:
            continue
        ## The boundary excludes letters/digits (so "go" cannot fire on
        ## "django") but NOT a hyphen: product names hyphenate constantly
        ## ("Metabase-core", "Log4j-core", "next-auth"), and excluding it
        ## made every one of them unmatchable — false negatives in the only
        ## inventory join the advisory and KEV lanes have.
        pat = re.compile(r'(?<![\w])(' + '|'.join(re.escape(k.lower()) for k in kws) + r')(?![\w])')
        tech_res.append((tkey, pat))
    def match_techs(text):
        low = (text or '').lower()
        return sorted({tkey for tkey, pat in tech_res if pat.search(low)})
    def tech_projects(tkeys):
        out = []
        for tk in tkeys:
            for pk in (techs.get(tk) or {}).get('projects') or []:
                if pk not in out:
                    out.append(pk)
        return out

    ## ── KEV lookup + diff ───────────────────────────────────────────
    kev_map = {}
    for v in (kev.get('vulnerabilities') or []):
        ## A malformed catalog entry must cost its own line, never the run:
        ## the KEV lane is the one whose outage is explicitly tolerated, and
        ## an AttributeError here would fail every hourly tick instead.
        if not isinstance(v, dict):
            continue
        cid = v.get('cveID') or ''
        if cid:
            kev_map[cid] = v
    ## The KEV diff is by CVE ID, not by dateAdded: that field has DAY
    ## granularity while this bot ticks hourly, so a date cursor consumed
    ## the rest of the day's batch invisibly (and a KEV outage during the
    ## arming tick armed it against an empty catalog, losing that day
    ## outright). An id set has neither failure — same discipline as
    ## feeds_seen.
    kev_seen = set(cursors.get('kev_seen') or [])
    kev_armed = bool(kev_seen)
    ## Age belt: an entry catalogued long ago is not news whatever the state
    ## says. Without it a lost/corrupted kev_seen turns the next tick into a
    ## flood of the whole catalog (measured: 83 alerts from 1675 entries) —
    ## the one failure that teaches everyone to mute the channel. Generous
    ## enough that a long outage still catches up (default 90 days).
    kev_cutoff = (now - datetime.timedelta(days=max(1, kev_max_age_days))).date().isoformat()
    kev_fresh = [v for v in kev_map.values()
                 if kev_armed and (v.get('cveID') or '') not in kev_seen
                 and (v.get('dateAdded') or '') >= kev_cutoff]

    ## ── build this run's candidate units ────────────────────────────
    units = []
    dep_cursor_next = dict((cursors.get('dependabot') or {}))
    for org, blob in (dep_by_org or {}).items():
        newest = dep_cursor_next.get(org) or ''
        groups = {}
        for a in (blob.get('alerts') or []):
            adv = a.get('security_advisory') or {}
            gid = adv.get('ghsa_id') or adv.get('cve_id') or ''
            if not gid:
                continue
            created = a.get('created_at') or ''
            if created > newest:
                newest = created
            g = groups.setdefault(gid, {'id': gid, 'kind': 'dependabot',
                                        'title': adv.get('summary') or gid,
                                        'severity': (adv.get('severity') or '').lower(),
                                        'cves': [], 'repos': [], 'fixes': [], 'org': org,
                                        'package': '', 'ecosystem': '',
                                        ## An org with no cursor yet (freshly
                                        ## added to the config) hands back its
                                        ## whole OPEN backlog — history, not
                                        ## news. Marked so the policy observes
                                        ## it instead of alerting: it arms the
                                        ## state and can still re-fire the day
                                        ## an exploitation signal lights up.
                                        'backlog': bool(blob.get('bootstrap')),
                                        'url': 'https://github.com/advisories/' + gid if gid.startswith('GHSA-') else ''})
            cve = adv.get('cve_id') or ''
            if cve and cve not in g['cves']:
                g['cves'].append(cve)
            repo = ((a.get('repository') or {}).get('full_name') or '')
            if repo and repo not in g['repos']:
                g['repos'].append(repo)
            pkg = ((a.get('dependency') or {}).get('package') or {})
            g['package'] = g['package'] or (pkg.get('name') or '')
            g['ecosystem'] = g['ecosystem'] or (pkg.get('ecosystem') or '')
            for vv in (adv.get('vulnerabilities') or []):
                fp = vv.get('first_patched_version') or {}
                ident = fp.get('identifier') if isinstance(fp, dict) else ''
                if ident and ident not in g['fixes']:
                    g['fixes'].append(ident)
        if blob.get('bootstrap') and not newest:
            newest = now_iso
        if blob.get('truncated'):
            ## The walk stopped at the page cap, and pages are newest-first:
            ## advancing to the newest created_at would put every unscanned
            ## (older) alert behind the cursor forever. Hold the cursor —
            ## the re-scan is deduped by already_alerted.
            dep_cursor_next[org] = (cursors.get('dependabot') or {}).get(org) or ''
        else:
            dep_cursor_next[org] = newest or dep_cursor_next.get(org) or now_iso
        units.extend(groups.values())

    feed_seen_next = list((cursors.get('feeds_seen') or []))
    feed_retries = dict(cursors.get('feed_enrich_retries') or {})
    for u in adv_units:
        ## An advisory whose structured document failed is retried on the
        ## next ticks instead of being consumed — bounded, so a feed whose
        ## items simply have no JSON endpoint cannot loop forever.
        if u.get('enrich_failed') and int(feed_retries.get(u['id']) or 0) < 3:
            feed_retries[u['id']] = int(feed_retries.get(u['id']) or 0) + 1
        else:
            feed_seen_next.append(u['id'])
            feed_retries.pop(u['id'], None)
        tkeys = match_techs(u.get('match_text') or '')
        if not tkeys:
            continue
        units.append({'id': u['id'], 'kind': u.get('kind') or 'advisory', 'title': u.get('title') or u['id'],
                      'cves': u.get('cves') or [], 'techs': tkeys, 'url': u.get('url') or '',
                      'severity': '', 'repos': [], 'fixes': []})
    feed_seen_next = feed_seen_next[-2000:]

    for v in kev_fresh:
        text = ' '.join([v.get('vendorProject') or '', v.get('product') or '', v.get('vulnerabilityName') or ''])
        tkeys = match_techs(text)
        if not tkeys:
            continue
        cid = v.get('cveID') or ''
        units.append({'id': 'kev:' + cid, 'kind': 'kev', 'title': v.get('vulnerabilityName') or cid,
                      'cves': [cid] if cid else [], 'techs': tkeys,
                      'url': 'https://nvd.nist.gov/vuln/detail/' + cid if cid else '',
                      'severity': '', 'repos': [], 'fixes': [],
                      'kev_note': (v.get('shortDescription') or '')[:400]})

    ## ── EPSS batch over candidates + the observation window ─────────
    candidates = set()
    for u in units:
        candidates.update(u.get('cves') or [])
    for cid, rec in st_cves.items():
        if rec.get('status') == 'observed':
            candidates.add(cid)
    epss = {}
    epss_err = ''
    if epss_thr >= 0 and epss_url and candidates:
        def _addr_ok(ip):
            if allow_private:
                return True
            try:
                a = ipaddress.ip_address(ip)
            except ValueError:
                return False
            if a.version == 6 and a.ipv4_mapped is not None:
                a = a.ipv4_mapped
            return (a.is_global and not (a.is_private or a.is_loopback or a.is_link_local or
                    a.is_reserved or a.is_multicast or a.is_unspecified))
        def _validate_host(h):
            if allow_private or not h:
                return
            for k in ('HTTPS_PROXY', 'https_proxy', 'HTTP_PROXY', 'http_proxy'):
                v = (os.environ.get(k) or '').strip()
                if v and (urlsplit(v if '://' in v else 'http://' + v).hostname == h):
                    return
            for info in socket.getaddrinfo(h, None):
                if not _addr_ok(info[4][0]):
                    raise OSError('SSRF-unsafe address ' + str(info[4][0]) + ' for host ' + str(h))

        class _SafeRedirect(urllib.request.HTTPRedirectHandler):
            ## Same rule as the other lanes: validate EVERY hop, not only
            ## the URL the config supplied.
            def redirect_request(self, rq, fp, code, msg, headers, newurl):
                if urlsplit(newurl).scheme not in ('http', 'https'):
                    return None
                _validate_host(urlsplit(newurl).hostname or '')
                return super().redirect_request(rq, fp, code, msg, headers, newurl)

        _epss_opener = urllib.request.build_opener(_SafeRedirect())
        host = urlsplit(epss_url).hostname or ''
        try:
            if urlsplit(epss_url).scheme not in ('http', 'https'):
                raise ValueError('unsupported EPSS URL scheme ' + repr(urlsplit(epss_url).scheme))
            _validate_host(host)
            cand = sorted(candidates)
            for i in range(0, len(cand), 100):
                q = epss_url + ('&' if '?' in epss_url else '?') + 'cve=' + quote(','.join(cand[i:i + 100]))
                req = urllib.request.Request(q, headers={
                    'User-Agent': 'vuln-watch/0.1 (iterion; +https://github.com/SocialGouv/iterion)',
                    'Accept': 'application/json'})
                with _epss_opener.open(req, timeout=timeout) as r:
                    for row in (json.loads(r.read(8 * 1024 * 1024).decode('utf-8')).get('data') or []):
                        try:
                            epss[row.get('cve') or ''] = float(row.get('epss') or 0)
                        except (TypeError, ValueError):
                            pass
        except Exception as e:
            epss_err = type(e).__name__ + ': ' + str(e)[:300]

    ## ── signals + policy ────────────────────────────────────────────
    def signals_for(u):
        sig = []
        for c in (u.get('cves') or []):
            v = kev_map.get(c)
            if v:
                sig.append({'type': 'kev', 'cve': c, 'date': v.get('dateAdded') or ''})
        if u.get('kind') == 'alert':
            sig.append({'type': 'ale'})
        for c in (u.get('cves') or []):
            s = epss.get(c)
            if s is not None and epss_thr >= 0 and s >= epss_thr:
                sig.append({'type': 'epss', 'cve': c, 'score': s})
        return sig

    def signal_key(sig):
        ## A stable fingerprint of the exploitation evidence, so "the signal
        ## LIT UP" can be told apart from "the signal was already there when
        ## we chose to stay silent". Re-firing on the latter would replay a
        ## whole backlog the moment it is first observed.
        ## Identity of the evidence, NOT its magnitude: FIRST republishes
        ## EPSS daily and per-CVE scores drift, so folding the score in
        ## would make the key change on its own and replay a backlog every
        ## 24h. Crossing the threshold is what turns EPSS into a signal at
        ## all — that crossing is already captured by the signal existing.
        return ';'.join(sorted(
            s['type'] + ':' + str(s.get('cve') or '') + ':' + (s.get('date') or '')
            for s in (sig or [])))

    def alert_decision(u, sig):
        if sig:
            return True
        if u.get('kind') == 'dependabot':
            sev = u.get('severity') or ''
            if floor == 'critical' and sev == 'critical':
                return True
            if floor == 'high' and sev in ('critical', 'high'):
                return True
        if u.get('kind') == 'advisory' and avis_mode == 'alert':
            return True
        return False

    def remember_observed(u, sig):
        ## setdefault would FREEZE the first observation: an entry whose
        ## enrichment failed is stored with cves: [], and when the retry
        ## finally succeeds the richer record is dropped — so the unit can
        ## never be scored, never re-fire, and ages out silently. Keep the
        ## first-seen date, take the better facts.
        prev = st_units.get(u['id']) or {}
        rec = dict(prev, **{k: v for k, v in u.items() if v not in (None, '', [], {})})
        rec['first_seen'] = prev.get('first_seen') or now_iso
        rec['alerted_at'] = prev.get('alerted_at')
        if prev.get('deferred'):
            rec['deferred'] = True
        ## The signal baseline is only meaningful once we actually know the
        ## unit's CVEs; a baseline taken on an empty set would make the
        ## escalation test compare against nothing.
        if not prev.get('observed_signals') or (u.get('cves') and not prev.get('cves')):
            rec['observed_signals'] = signal_key(sig)
        else:
            rec['observed_signals'] = prev['observed_signals']
        st_units[u['id']] = rec

    def unit_scope(u):
        ## What an alert on this unit would actually TELL someone: the
        ## projects it names, plus the repos when it carries them (a
        ## Dependabot unit adds the repo list + the fixed version that a
        ## techno-level KEV unit cannot).
        projects = set(u.get('projects') or tech_projects(u.get('techs') or []))
        for r in (u.get('repos') or []):
            p = repo_index.get(r.lower())
            projects.add(p if p else 'repo:' + r.lower())
        return projects

    def already_alerted(u):
        ## Suppression is scoped, not global. A CERT-FR avis carries HUNDREDS
        ## of CVEs (222 on one observed Splunk avis): marking them all
        ## "alerted" outright would sterilise every one of them for every
        ## OTHER project of the inventory — an exploited CVE on another
        ## project would then never fire. So a unit is suppressed only when
        ## its CVEs are alerted AND every scope it would name is already
        ## covered by those alerts.
        cves = u.get('cves') or []
        if not cves:
            return (st_units.get(u['id']) or {}).get('alerted_at') is not None
        if not all((st_cves.get(c) or {}).get('status') == 'alerted' for c in cves):
            return False
        ## PER CVE, never a union: CVE-1 alerted for project A and CVE-2 for
        ## project B would otherwise cover a unit carrying both and scoped to
        ## both — although A was never told about CVE-2, nor B about CVE-1.
        ## Same question as the two sibling suppression sites.
        scope = unit_scope(u)
        if not scope:
            ## The empty set is a subset of EVERYTHING, so a unit whose
            ## technology maps to no project would be "covered" by anything
            ## — dropped on first sight, while the cursors advanced past it.
            ## A projects-less technology is a legal, documented shape: such
            ## a unit is judged by its CVEs alone.
            return all((st_cves.get(c) or {}).get('alerted_at') for c in cves)
        return all(scope <= set((st_cves.get(c) or {}).get('alerted_for') or []) for c in cves)

    def render_fields(u, sig, refire_of=''):
        best_epss = max([s.get('score') or 0 for s in sig if s['type'] == 'epss'] + [0])
        return {'id': u['id'], 'kind': u.get('kind') or '', 'title': u.get('title') or '',
                'cves': u.get('cves') or [], 'severity': u.get('severity') or '',
                'package': u.get('package') or '', 'ecosystem': u.get('ecosystem') or '',
                'repos': u.get('repos') or [], 'techs': u.get('techs') or [],
                'fixes': u.get('fixes') or [], 'url': u.get('url') or '',
                'signals': sig, 'epss_max': best_epss,
                'projects': ([repo_index.get(r.lower()) for r in (u.get('repos') or [])]
                             if u.get('repos') else tech_projects(u.get('techs') or [])),
                'refire_of': refire_of}

    alerts, observed_new, suppressed = [], 0, 0
    if not bootstrap:
        for u in units:
            if already_alerted(u):
                suppressed += 1
                continue
            sig = signals_for(u)
            ## The backlog rule silences HISTORY, never evidence. A freshly
            ## added org's open alerts are not news — unless one of them is
            ## already exploited (KEV / EPSS over the threshold), which is
            ## precisely what this bot exists to announce. Those fire now,
            ## bounded by the per-run cap and its deferral path; the rest
            ## are observed and re-fire the day their signal lights up.
            if alert_decision(u, sig) and (sig or not u.get('backlog')):
                alerts.append(render_fields(u, sig))
            else:
                observed_new += 1
                for c in (u.get('cves') or []):
                    st_cves.setdefault(c, {'status': 'observed', 'first_seen': now_iso})
                remember_observed(u, sig)

        ## Re-fire: an OBSERVED unit whose exploitation signal lit up since —
        ## the Metabase scenario. One alert, then it flips to alerted.
        refire = []
        for uid, u in list(st_units.items()):
            if u.get('alerted_at') is not None:
                continue
            sig = signals_for(u)
            ## Coverage is checked AFTER the escalation test, not before: a
            ## unit whose evidence just changed is news even for a scope that
            ## heard about the CVE through another unit (an advisory alert
            ## shows only its first few CVE ids, so "told" about the advisory
            ## is not "told" about this one now being exploited). Order
            ## matters — the other way round, the headline Metabase-style
            ## escalation never posts.
            escalated = sig and signal_key(sig) != (u.get('observed_signals') or '')
            if not escalated and already_alerted(u):
                continue
            ## Two ways back into the alert set: the exploitation signal
            ## CHANGED since we chose silence (the Metabase re-fire — it had
            ## none, KEV gave it one), or the per-run cap deferred the unit
            ## (which may carry no signal at all). A signal that was already
            ## there at observation time is not news: that is what keeps a
            ## newly-added org's backlog quiet instead of replaying it.
            if (escalated or u.get('deferred')) and alert_decision(u, sig):
                refire.append(render_fields(u, sig,
                                            refire_of='' if u.get('deferred') else (u.get('first_seen') or '')))
        alerts.extend(refire)
        refire_count = len(refire)
    else:
        ## Bootstrap: alert nothing — the pre-existing backlog is not news,
        ## and flooding the channel on day one teaches everyone to mute it.
        ## But the cursors DO advance, so anything merely consumed here is
        ## gone for good: record what was seen as observed, exactly like the
        ## per-org backlog path, so an exploitation signal that lights up
        ## later still re-fires. (A deployment installed the day after a CVE
        ## entered KEV would otherwise never hear about it.)
        refire_count = 0
        suppressed = len(units)
        for u in units:
            sig = signals_for(u)
            for c in (u.get('cves') or []):
                st_cves.setdefault(c, {'status': 'observed', 'first_seen': now_iso})
            remember_observed(u, sig)
            if sig and alert_decision(u, sig):
                ## Already exploited on day one. Recording that live signal as
                ## the baseline would make the escalation test false forever —
                ## the unit would be silent for good, which is precisely the
                ## case the bot exists for. Mark it OWED instead: the tick
                ## stays quiet (no flood on install), and the next one
                ## delivers it through the deferred path, capped like any
                ## other burst.
                st_units[u['id']]['deferred'] = True

    ## priority: KEV first, then alert-class, then EPSS, then severity.
    sev_rank = {'critical': 3, 'high': 2, 'medium': 1, 'low': 0}
    def prio(a):
        kinds = {s['type'] for s in a['signals']}
        return ('kev' in kinds, 'ale' in kinds, a['epss_max'], sev_rank.get(a['severity'] or '', 0))
    alerts.sort(key=prio, reverse=True)
    ## Intra-run alias dedup: two lanes can surface the SAME vulnerability
    ## in one tick (a CERT-FR avis listing the CVEs + the KEV entry for
    ## one of them — observed live: Metabase posted twice). After the
    ## priority sort, drop any unit whose CVE set is fully covered by the
    ## units already kept this run.
    covered = {}
    kept = []
    for a in alerts:
        cves = a.get('cves') or []
        ## Scope-aware, exactly like already_alerted: a unit is a duplicate
        ## only when every one of its CVEs is ALREADY being alerted FOR
        ## every scope this unit would name. A KEV entry naming ANOTHER
        ## project must survive an advisory that merely shares the CVE —
        ## otherwise that project is never told, and the KEV id cursor has
        ## already advanced past the entry, so it never comes back.
        scope = {p for p in (a.get('projects') or []) if p}
        for r in (a.get('repos') or []):
            p = repo_index.get(r.lower())
            scope.add(p if p else 'repo:' + r.lower())
        ## Same empty-scope rule as already_alerted: a scope-less unit is a
        ## duplicate only when its CVEs are ALREADY being posted this run,
        ## never by vacuous subset.
        if cves and ((scope and all(scope <= covered.get(c, set()) for c in cves))
                     or (not scope and all(c in covered for c in cves))):
            suppressed += 1
            continue
        for c in cves:
            covered[c] = covered.get(c, set()) | scope
        kept.append(a)
    alerts = kept
    overflow = max(0, len(alerts) - max_alerts)
    posted_alerts, deferred = alerts[:max_alerts], alerts[max_alerts:]
    ## Overflowed units stay eligible: record them observed, not alerted.
    for a in deferred:
        for c in a['cves']:
            st_cves.setdefault(c, {'status': 'observed', 'first_seen': now_iso})
        rec = st_units.get(a['id']) or {'id': a['id'], 'kind': a['kind'], 'title': a['title'],
                                        'cves': a['cves'], 'severity': a['severity'],
                                        'package': a['package'], 'ecosystem': a['ecosystem'],
                                        'repos': a['repos'], 'techs': a['techs'], 'fixes': a['fixes'],
                                        'url': a['url'], 'first_seen': now_iso, 'alerted_at': None}
        ## A unit that ONLY qualified through a severity floor carries no
        ## exploitation signal, so the re-fire scan would never look at it
        ## again — and its source cursor has already advanced. Mark it as
        ## owed: the overflow notice promises these fire next run, and that
        ## promise has to be true.
        rec['deferred'] = True
        rec.setdefault('observed_signals', signal_key(a.get('signals')))
        st_units[a['id']] = rec
    ## Posted units flip to alerted (applied to the STAGED state; it only
    ## persists after delivery).
    for a in posted_alerts:
        ## A repo outside the inventory maps to no project (None) — keep the
        ## scope keys strings so the sorted() below never compares None.
        scope = {p for p in (a.get('projects') or []) if p}
        for r in (a.get('repos') or []):
            p = repo_index.get(r.lower())
            scope.add(p if p else 'repo:' + r.lower())
        for c in a['cves']:
            prev = st_cves.get(c) or {}
            st_cves[c] = dict(prev, status='alerted',
                              first_seen=prev.get('first_seen') or now_iso,
                              alerted_at=now_iso,
                              ## The scopes this CVE has been alerted FOR —
                              ## read by already_alerted so the same CVE can
                              ## still fire for a project it never named.
                              alerted_for=sorted(set(prev.get('alerted_for') or []) | scope))
        rec = st_units.get(a['id']) or {'id': a['id'], 'kind': a['kind'], 'title': a['title'],
                                        'cves': a['cves'], 'severity': a['severity'],
                                        'package': a['package'], 'ecosystem': a['ecosystem'],
                                        'repos': a['repos'], 'techs': a['techs'], 'fixes': a['fixes'],
                                        'url': a['url'], 'first_seen': now_iso}
        rec['alerted_at'] = now_iso
        rec.pop('deferred', None)
        st_units[a['id']] = rec

    ## ── health + staleness ──────────────────────────────────────────
    def mark(source, ok, err=''):
        h = health.setdefault(source, {})
        if ok:
            h['last_ok'] = now_iso
            h.pop('last_error', None)
        elif err:
            h['last_error'] = err
    for org in orgs:
        err = next((e['error'] for e in dep_errors if e.get('org') == org), '')
        mark('dependabot:' + org, org in (dep_by_org or {}) and not err, err)
    for f in feeds:
        furl = f.get('url') or ''
        err = next((e['error'] for e in adv_errors if e.get('feed') == furl), '')
        mark('feed:' + furl, not err, err)
    if kev_url:
        mark('kev', not kev_error, kev_error)
    if epss_thr >= 0 and epss_url and candidates:
        ## Only when a request was actually made: stamping last_ok on a quiet
        ## tick (no candidates → no call) would keep the staleness net from
        ## ever firing for EPSS.
        mark('epss', not epss_err, epss_err)

    ## A source removed from the config must stop being watched: its health
    ## entry would otherwise announce "silent for 58267h" every window,
    ## forever. The configured set is the authority.
    configured_sources = {'dependabot:' + o for o in orgs} | {'feed:' + (f.get('url') or '') for f in feeds}
    if kev_url:
        configured_sources.add('kev')
    if epss_thr >= 0 and epss_url:
        configured_sources.add('epss')
    for source in [k for k in health if k not in configured_sources]:
        del health[source]

    stale = []
    if stale_hours > 0 and not bootstrap:
        for source, h in sorted(health.items()):
            last_ok = h.get('last_ok') or ''
            try:
                age_h = (now - datetime.datetime.fromisoformat(last_ok)).total_seconds() / 3600 if last_ok else 10 ** 6
            except ValueError:
                age_h = 10 ** 6
            if age_h < stale_hours:
                continue
            warned = h.get('last_warned') or ''
            try:
                warned_age = (now - datetime.datetime.fromisoformat(warned)).total_seconds() / 3600 if warned else 10 ** 6
            except ValueError:
                warned_age = 10 ** 6
            if warned_age < stale_hours:
                continue
            stale.append({'source': source, 'hours': int(age_h) if age_h < 10 ** 6 else -1, 'last_ok': last_ok})
            h['last_warned'] = now_iso

    ## ── prune + cursors + stage the next state ──────────────────────
    cutoff = (now - datetime.timedelta(days=observe_days)).isoformat()
    for cid in [c for c, r in st_cves.items() if r.get('status') == 'observed' and (r.get('first_seen') or '') < cutoff]:
        del st_cves[cid]
    for uid in [uid for uid, u in st_units.items()
                if u.get('alerted_at') is None and (u.get('first_seen') or '') < cutoff]:
        del st_units[uid]
    if len(st_units) > 5000:
        for uid, _ in sorted(st_units.items(), key=lambda kv: kv[1].get('first_seen') or '')[:len(st_units) - 5000]:
            del st_units[uid]
    cursors['dependabot'] = dep_cursor_next
    cursors['feeds_seen'] = feed_seen_next
    cursors['feed_enrich_retries'] = feed_retries
    ## Arm/extend the KEV id set ONLY from a catalog that actually loaded:
    ## arming against an empty one (KEV down this tick) would mark the
    ## whole real catalog as "already seen" the moment it comes back.
    if kev_map:
        ## Pruned by the same belt that bounds freshness: an id older than
        ## the window can never be "fresh" again, so remembering it buys
        ## nothing — and this state file is committed to git on every
        ## hourly tick.
        ## The catalog IS the bound: an id it no longer carries can never
        ## be evaluated as fresh anyway, so remembering it only grows a
        ## state file that git commits every hourly tick.
        cursors['kev_seen'] = sorted(kev_map)

    os.makedirs(scratch, exist_ok=True)
    state_next = os.path.join(scratch, 'state_next.json')
    with open(state_next, 'w', encoding='utf-8') as fh:
        json.dump(state, fh, ensure_ascii=False, indent=1, sort_keys=True)
    alertlog = os.path.join(scratch, 'alertlog_delta.jsonl')
    with open(alertlog, 'w', encoding='utf-8') as fh:
        for a in posted_alerts:
            fh.write(json.dumps({'at': now_iso, 'id': a['id'], 'kind': a['kind'], 'cves': a['cves'],
                                 'severity': a['severity'], 'signals': a['signals'],
                                 'projects': a['projects'], 'repos': a['repos'], 'techs': a['techs'],
                                 'title': a['title'], 'refire_of': a['refire_of']},
                                ensure_ascii=False) + chr(10))

    ## Zero-façade guard: if EVERY configured lane errored this run there
    ## is no basis to claim "no alert" — fail loudly instead.
    lanes_cfg = (1 if orgs else 0) + (1 if feeds else 0) + (1 if kev_url else 0)
    lanes_dead = ((1 if orgs and len(dep_errors) >= len(orgs) and not dep_by_org else 0) +
                  (1 if feeds and len(adv_errors) >= len(feeds) else 0) +
                  (1 if kev_url and kev_error else 0))
    if lanes_cfg and lanes_dead == lanes_cfg:
        raise SystemExit('vuln-watch: every configured source failed this run -- refusing to report a zero-alert facade')

    ## Attach project display info for notify (names resolved here so the
    ## message step stays a pure renderer).
    for a in posted_alerts:
        ## A KEYED map, not a parallel list: a Dependabot unit's `projects`
        ## carries None for every repo absent from the inventory (the common
        ## case on an org-wide poll), so a filtered list zipped against the
        ## unfiltered one shifts and labels a project with ANOTHER project's
        ## name — the alert would route the fix to the wrong team, which is
        ## this bot's headline promise inverted.
        a['project_label'] = {p: ((projects.get(p) or {}).get('name') or p)
                              for p in (a['projects'] or []) if p}
        a['project_names'] = [a['project_label'][p] for p in (a['projects'] or []) if p]
        a['project_repos'] = {p: (projects.get(p) or {}).get('repos') or [] for p in (a['projects'] or []) if p}
        a['tech_labels'] = [((techs.get(t) or {}).get('label') or t) for t in (a['techs'] or [])]

    summary = ('alerts: ' + str(len(posted_alerts)) + ' to post (' + str(refire_count) + ' refire, ' +
               str(overflow) + ' overflow), ' + str(observed_new) + ' observed, ' + str(suppressed) +
               ' suppressed' + (', BOOTSTRAP' if bootstrap else '') +
               ((' -- source errors: ' + json.dumps(dep_errors + adv_errors)[:400]) if (dep_errors or adv_errors) else '') +
               ((' -- kev: ' + kev_error) if kev_error else '') +
               ((' -- epss: ' + epss_err) if epss_err else ''))
    print(json.dumps({'alerts': posted_alerts, 'alert_count': len(posted_alerts),
                      'overflow_count': overflow, 'observed_count': observed_new,
                      'suppressed_count': suppressed, 'refire_count': refire_count,
                      'stale_sources': stale, 'bootstrap': bool(bootstrap),
                      'state_next_file': state_next, 'alertlog_file': alertlog,
                      'summary': summary}, ensure_ascii=False))

## Deterministic delivery: render each alert from the label templates
## (language comes from config, structure from here) and POST one
## message per alert + one overflow note + one staleness warning to the
## configured sinks. The techno→projects join arrives pre-resolved —
## this node is a renderer and a courier, nothing more.
tool confirm_versions:
  ## Turns "these 53 projects declare this technology" into "this repo runs
  ## a version the advisory names, and here is the fix".
  ##
  ## The inventory match is deliberately keyword-based and therefore
  ## VERSION-BLIND: it answers "who uses React", not "who is vulnerable".
  ## Measured on the first live tick: a React Server Components advisory
  ## named 53 projects; exactly ONE repository carried an affected package.
  ## An alert that over-names by 53x is the kind operators stop reading,
  ## which is the failure this whole bot exists to avoid.
  ##
  ## Two GitHub reads per alerted unit, both server-side filtered:
  ##   1. /advisories?cve_id=...  -> the packages the advisory actually names
  ##   2. /orgs/{org}/dependabot/alerts?package=...  -> who runs them
  ##
  ## GOTCHA, paid for: `state=all` is NOT a valid value for that endpoint,
  ## and GitHub answers 200 with an EMPTY list instead of an error — the
  ## confirmation would have been silently, permanently empty. Measured
  ## `state=open&package=uuid` -> 73, `state=all&package=uuid` -> 0, no state
  ## param -> 78. The REASON, per GitHub's own OpenAPI description: `state` is
  ## a comma-separated LIST over {auto_dismissed, dismissed, fixed, open}, and
  ## `all` is simply not a member — so it matches nothing rather than
  ## everything. `open,fixed` is the valid spelling of what this node wants
  ## (an exposure, and the window of a closed one), and it drops both
  ## dismissal states server-side: a dismissal is a decision, not an exposure.
  input: confirm_input
  output: confirm_output
  language: py
  script: |
    import json, os, socket, time, ipaddress
    import urllib.request
    from urllib.parse import urlsplit, quote
    null = None; true = True; false = False  # JSON-literal shim for missing refs
    alerts = {{input.alerts}} or []
    orgs = {{input.github_orgs}} or []
    api_base = ({{input.github_api_base}} or 'https://api.github.com').rstrip('/')
    timeout = int({{input.timeout_secs}} or 20)
    allow_private = {{input.allow_private}}
    max_lookups = int({{input.max_lookups}} or 40)
    max_seconds = int({{input.max_seconds}} or 0)
    ## MONOTONIC, not wall time: a clock step must not extend or collapse the
    ## window this node is allowed to spend.
    deadline = (time.monotonic() + max_seconds) if max_seconds > 0 else None
    tokens_file = {{secrets.dependabot_tokens.path}}

    tokens = {}
    if tokens_file and os.path.exists(tokens_file):
        try:
            raw = open(tokens_file, encoding='utf-8').read().strip()
            tokens = json.loads(raw) if raw else {}
        except ValueError:
            tokens = {}

    _base_parts = urlsplit(api_base)
    base_host = (_base_parts.hostname or '')
    base_scheme = _base_parts.scheme

    def _port_of(parts):
        return parts.port or (443 if parts.scheme == 'https' else 80)

    base_port = _port_of(_base_parts)

    def _addr_ok(ip):
        a = ipaddress.ip_address(ip)
        return allow_private or a.is_global

    def _origin_ok(parts):
        ## The token is a bearer credential: what may carry it is an ORIGIN,
        ## not a hostname. Pinning the host alone would still allow an
        ## https -> http hop on the same name (the token in clear on the
        ## wire) or a hop to another service on a different port.
        return (parts.scheme in ('http', 'https') and parts.scheme == base_scheme
                and (parts.hostname or '') == base_host and _port_of(parts) == base_port)

    def _addrs_ok(parts):
        for fam, _, _, _, sa in socket.getaddrinfo(parts.hostname, _port_of(parts), proto=socket.IPPROTO_TCP):
            if not _addr_ok(sa[0]):
                raise OSError('refusing a non-public address for ' + str(parts.hostname))

    class _SafeRedirect(urllib.request.HTTPRedirectHandler):
        ## urllib's default opener copies EVERY header (bar content-*) onto a
        ## redirected request and compares no hosts — so a 30x answered by the
        ## API origin would hand the org's Dependabot token to whoever the
        ## Location names, with the pre-flight address check never re-run.
        ## The polling lanes carry the same guard; this one also pins the
        ## scheme and port, so an https -> http downgrade cannot slip through.
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            parts = urlsplit(newurl)
            if not _origin_ok(parts):
                raise OSError('refusing redirect off the configured API origin: ' + str(newurl)[:200])
            _addrs_ok(parts)
            return super().redirect_request(req, fp, code, msg, headers, newurl)

    _opener = urllib.request.build_opener(_SafeRedirect())

    def get(url, token):
        ## Same egress discipline as the polling lanes: the origin is pinned to
        ## the configured API base, and a resolved address must be public
        ## unless the operator opted into private ranges.
        parts = urlsplit(url)
        if not _origin_ok(parts):
            raise OSError('refusing an off-origin request: ' + url[:200])
        ## Same guard as the polling lanes: the token rides as a bearer, so
        ## plaintext is refused unless the operator opted into private
        ## sources (which is also what a test harness uses).
        if parts.scheme != 'https' and not allow_private:
            raise OSError('refusing a plaintext request carrying a token: ' + url[:200])
        _addrs_ok(parts)
        req = urllib.request.Request(url, headers={
            'Accept': 'application/vnd.github+json',
            'X-GitHub-Api-Version': '2022-11-28',
            'User-Agent': 'iterion-vuln-watch'})
        if token:
            req.add_header('Authorization', 'Bearer ' + token)
        ## Clamp the per-request timeout to what is left of the node's window,
        ## so one hung read cannot overshoot the deadline by a whole timeout.
        t = timeout if deadline is None else max(1, min(timeout, int(deadline - time.monotonic())))
        with _opener.open(req, timeout=t) as r:
            ## Bounded like the sibling lane's read: a hostile or broken
            ## endpoint must not be able to stream this node out of memory.
            return json.loads(r.read(8 * 1024 * 1024).decode('utf-8') or '[]')

    lookups = [0]
    errors = []

    expired = [False]

    def budgeted(fn, what):
        if lookups[0] >= max_lookups:
            return None
        ## The deadline is checked BEFORE every request, so a degraded API
        ## costs this node its precision and never the run's delivery. What
        ## is left unlooked-up degrades to "not verified", never to an
        ## all-clear — see the version_check assignment below.
        if deadline is not None and time.monotonic() >= deadline:
            if not expired[0]:
                expired[0] = True
                errors.append({'what': 'deadline',
                               'error': 'version confirmation stopped after ' + str(max_seconds) +
                                        's; remaining units are reported unverified'})
            return None
        lookups[0] += 1
        try:
            return fn()
        except Exception as e:
            errors.append({'what': what, 'error': type(e).__name__ + ': ' + str(e)[:200]})
            return None

    adv_cache = {}

    def packages_for(cve):
        ## The advisory database is the authority on WHICH packages a CVE
        ## affects — and it answers THREE different things, which the message
        ## downstream must not collapse into one:
        ##   * an advisory carrying package mappings -> those packages;
        ##   * an advisory carrying NONE -> the technology genuinely has no
        ##     package in any manifest: a deployed product. Measured shape of
        ##     that answer (CVE-2023-38646, Metabase RCE) is ONE advisory whose
        ##     `vulnerabilities` array is empty;
        ##   * an EMPTY advisory list -> GitHub has no advisory indexed for
        ##     this CVE at all. Establishes nothing; measured on an unknown id.
        ## Returns (packages, status), status in indexed|not_indexed|failed.
        if cve in adv_cache:
            return adv_cache[cve]
        url = api_base + '/advisories?cve_id=' + quote(cve, safe='')
        data = budgeted(lambda: get(url, tokens.get('*') or next(iter(tokens.values()), '')), 'advisory ' + cve)
        if not isinstance(data, list):
            ## A read that failed, was never funded, or came back in a shape
            ## the endpoint does not document. None of those is an answer —
            ## and none may be CACHED, or one blip would mis-stamp every later
            ## unit sharing this CVE for the rest of the run.
            return (set(), 'failed')
        pkgs = set()
        for a in data:
            if not isinstance(a, dict):
                continue
            for v in (a.get('vulnerabilities') or []):
                pk = ((v or {}).get('package') or {})
                name, eco = pk.get('name') or '', (pk.get('ecosystem') or '').lower()
                if name and eco:
                    pkgs.add((eco, name))
        res = (pkgs, 'indexed' if data else 'not_indexed')
        adv_cache[cve] = res
        return res

    def alerts_for(org, names):
        ## Returns (alerts, checked). `checked` is False whenever NO answer was
        ## obtained — no token for the org, no budget left, an HTTP error. An
        ## org that was never asked is not an org where nothing was found, and
        ## only this flag can tell the two apart downstream.
        ##
        ## NO `ecosystem` parameter, deliberately: the advisory database's
        ## vocabulary is WIDER than this endpoint's (it returns `actions`,
        ## `erlang`, `other`, `swift`, none of which the alerts endpoint
        ## accepts), so forwarding one verbatim 422s — and a swallowed 422
        ## reads as an all-clear. The `package` filter narrows server-side on
        ## its own (measured: `package=uuid` -> 78), one request per org
        ## instead of one per ecosystem, and the (ecosystem, name) pair is
        ## re-checked on the way back so nothing is lost by dropping it.
        ##
        ## `state=open,fixed` — NEVER `state=all`; see the GOTCHA in this
        ## node's header for why the latter silently matches nothing.
        token = tokens.get(org) or tokens.get('*')
        if not token:
            return ([], False)
        url = (api_base + '/orgs/' + quote(org, safe='') + '/dependabot/alerts?per_page=100&state=' +
               quote('open,fixed', safe=',') + '&package=' + quote(','.join(sorted(names)), safe=','))
        data = budgeted(lambda: get(url, token), 'alerts ' + org)
        if not isinstance(data, list):
            return ([], False)
        return (data, True)

    confirmable = 0
    confirmed = 0
    for a in alerts:
        cves = [c for c in (a.get('cves') or []) if c]
        pkgs = set()
        adv_status = set()
        for c in cves[:6]:  # a CERT-FR avis can carry hundreds; the head is the subject
            p, st = packages_for(c)
            pkgs |= p
            adv_status.add(st)
        if not pkgs:
            ## Nothing to look up — and WHY is three different facts, only one
            ## of which is about the technology. "The advisory exists and names
            ## no package" IS the deployed-product signal the label was written
            ## for (Metabase, GitLab, a WordPress install). A read that failed,
            ## was never funded, or matched no indexed advisory says nothing at
            ## all — dressing that up as "deployed product" states a confident
            ## fact about the technology derived from a transport error.
            a['version_check'] = ('not_a_package'
                                  if ('indexed' in adv_status and 'failed' not in adv_status)
                                  else 'unavailable')
            continue
        confirmable += 1
        names = set(n for _, n in pkgs)
        cveset = set(cves)
        ## Keyed by (repo, PACKAGE), not by repo: one advisory routinely names
        ## several packages and a repo can run more than one of them. Keyed by
        ## repo alone, every match after the first lost its package, its fix
        ## version and its dates, and the message showed ONE fix as though it
        ## covered the repository.
        matches = {}
        ## An advisory read that failed leaves the package set incomplete, so
        ## whatever the alert lane then finds cannot be a COMPLETE answer.
        checked, complete = False, ('failed' not in adv_status)
        for org in orgs:
            got, ok = alerts_for(org, names)
            checked = checked or ok
            complete = complete and ok
            for al in got:
                if not isinstance(al, dict):
                    continue
                adv = (al.get('security_advisory') or {})
                if cveset and (adv.get('cve_id') or '') not in cveset:
                    continue
                pk = ((al.get('dependency') or {}).get('package') or {})
                ## The ecosystem is no longer filtered server-side (see
                ## alerts_for), so the pair is re-checked here: a package name
                ## can collide across ecosystems.
                if ((pk.get('ecosystem') or '').lower(), pk.get('name') or '') not in pkgs:
                    continue
                repo = ((al.get('repository') or {}).get('full_name') or '')
                if not repo:
                    continue
                key = (repo, pk.get('name') or '')
                st = (al.get('state') or '')
                prev = matches.get(key)
                ## An OPEN alert wins over a fixed one for the same repo+package
                ## — still-vulnerable is the actionable truth — and it brings
                ## its OWN fix version and dates with it. Promoting the state
                ## alone would date an open exposure from the resolved alert
                ## that happened to be seen first, and order here is not
                ## controllable: it follows org iteration and GitHub's sort.
                if prev is not None and not (st == 'open' and prev['state'] != 'open'):
                    continue
                sv = (al.get('security_vulnerability') or {})
                matches[key] = {'repo': repo, 'package': key[1], 'state': st,
                                'fix': ((sv.get('first_patched_version') or {}) or {}).get('identifier') or '',
                                'since': (al.get('created_at') or '')[:10],
                                'until': '' if st == 'open' else (al.get('fixed_at') or '')[:10]}
        ## Group back to ONE record per repository: the operator-facing count is
        ## repositories, and a repo running two affected packages must not
        ## inflate it into two findings. A repo with anything still open is an
        ## open repo, and only its open packages are the actionable part.
        hits = {}
        for key in sorted(matches):
            m = matches[key]
            g = hits.setdefault(m['repo'], {'repo': m['repo'], 'state': m['state'], 'packages': []})
            if m['state'] == 'open' and g['state'] != 'open':
                g['state'], g['packages'] = 'open', []
            elif g['state'] == 'open' and m['state'] != 'open':
                continue
            g['packages'].append({'package': m['package'], 'fix': m['fix'],
                                  'since': m['since'], 'until': m['until']})
        a['confirmed_repos'] = sorted(hits.values(), key=lambda r: (r['state'] != 'open', r['repo']))
        if hits:
            a['version_check'] = 'confirmed'
            confirmed += 1
        else:
            ## An empty result is an ALL-CLEAR only where a check actually ran
            ## to completion. No org configured, no token for one, a spent
            ## budget, an HTTP error, a partial advisory resolution — every one
            ## of them yields the same empty set, and rendering that as "no
            ## vulnerable dependency found in the watched orgs" is a false
            ## all-clear on a security message.
            a['version_check'] = 'none_found' if (checked and complete) else 'unavailable'

    parts = [str(confirmed) + '/' + str(confirmable) + ' unit(s) version-confirmed',
             str(lookups[0]) + ' lookup(s)']
    if expired[0]:
        parts.append('stopped on the ' + str(max_seconds) + 's deadline')
    elif lookups[0] >= max_lookups:
        parts.append('lookup budget spent')
    if errors:
        parts.append(str(len(errors)) + ' lookup error(s)')
    print(json.dumps({'alerts': alerts, 'confirmable': confirmable, 'confirmed': confirmed,
                      'lookups': lookups[0], 'errors': errors,
                      'summary': ', '.join(parts)}))

tool notify:
  input: notify_input
  output: notify_output
  language: py
  script: |
    import json, os, re, sys, urllib.request
    null = None; true = True; false = False  # JSON-literal shim for missing refs
    alerts = {{input.alerts}} or []
    overflow = int({{input.overflow_count}} or 0)
    stale = {{input.stale_sources}} or []
    sinks = {{input.sinks}} or []
    labels = {{input.labels}} or {}
    dry_run = {{input.dry_run}}
    webhooks_file = {{secrets.webhooks.path}}

    def out(o):
        print(json.dumps(o, ensure_ascii=False))
        raise SystemExit(0)

    ## Every field below comes from an UNTRUSTED source — advisory titles,
    ## GitHub advisory summaries, KEV vulnerability names. Rendered raw into
    ## chat markdown, a title carrying newlines can forge a second,
    ## indistinguishable alert block (same emoji, same sender) pointing at a
    ## hostile URL, or bury the real alert under the fold. flat() collapses
    ## all whitespace to single spaces and bounds the length, so an external
    ## string can never span lines or dominate the message.
    def flat(s, cap=300):
        return re.sub(r'\s+', ' ', str(s if s is not None else '')).strip()[:cap]

    ## Links are emitted only when they are plain http(s) URLs — a
    ## javascript:/data: URL or one carrying markdown control characters
    ## never reaches the channel.
    _URL_RE = re.compile(r'^https?://[^\s<>"\'()\[\]`]+$')
    def safe_url(u):
        u = str(u or '').strip()
        return u if _URL_RE.match(u) else ''

    def render(a):
        ## One fragment per signal KIND (a multi-CVE unit repeats them —
        ## observed: "CISA KEV · CISA KEV · EPSS 80% · EPSS 98%"): the
        ## latest KEV date, the alert-class flag once, the max EPSS.
        sigs = a.get('signals') or []
        sig_bits = []
        kev_dates = sorted({s.get('date') or '?' for s in sigs if s['type'] == 'kev'})
        if kev_dates:
            sig_bits.append(labels['kev_signal'].replace('{date}', kev_dates[-1]))
        if any(s['type'] == 'ale' for s in sigs):
            sig_bits.append(labels['ale_signal'])
        epss_scores = [s.get('score') or 0 for s in sigs if s['type'] == 'epss']
        if epss_scores:
            sig_bits.append(labels['epss_signal'].replace('{pct}', str(int(round(max(epss_scores) * 100)))))
        if not sig_bits:
            sig_bits.append(labels['sev_signal'].replace('{sev}', flat(a.get('severity'), 20) or '?'))
        head_subject = ' / '.join(flat(t, 60) for t in (a.get('tech_labels') or [])) or \
            (flat(a.get('package') or a.get('id'), 80) +
             ((' (' + flat(a['ecosystem'], 20) + ')') if a.get('ecosystem') else ''))
        ## A CERT-FR avis can carry HUNDREDS of CVE ids (observed: 222 on
        ## one Splunk avis) — cap the display; the full set lives in the
        ## alert log and the state.
        all_cves = [flat(c, 40) for c in ((a.get('cves') or []) or [a.get('id') or '?'])]
        shown_cves = all_cves[:4]
        ids = ' / '.join(shown_cves) + \
            ((' +' + str(len(all_cves) - len(shown_cves)) + ' ' + labels['more']) if len(all_cves) > len(shown_cves) else '')
        ## Honest fix line: Dependabot data DOES say whether a patched
        ## version exists (empty = truly none); an advisory/KEV unit
        ## carries no structured fix field, so absence of data must read
        ## "see the advisory", never "none published".
        if a.get('fixes'):
            fix = ', '.join(flat(f, 40) for f in a['fixes'])
        elif a.get('kind') == 'dependabot':
            fix = labels['no_fix']
        else:
            fix = labels['fix_see_source']
        lines = []
        lines.append(':rotating_light: **' + labels['exploited' if (a.get('signals')) else 'alert'] + ' · ' + head_subject + '**')
        lines.append('**' + ids + '** — ' + flat(a.get('title')))
        sev = flat(a.get('severity'), 20).upper()
        lines.append(labels['signal'] + ': ' + ' · '.join(sig_bits) +
                     ((' · ' + labels['severity'] + ' ' + sev) if sev else '') +
                     ' · ' + labels['fix'] + ': ' + fix)
        pnames = a.get('project_names') or []
        prepos = a.get('project_repos') or {}
        if a.get('repos'):
            shown = [flat(r, 100) for r in a['repos'][:12]]
            extra = len(a['repos']) - len(shown)
            per_proj = {}
            for r in a['repos']:
                for pk, rs in prepos.items():
                    if r.lower() in [x.lower() for x in rs]:
                        per_proj.setdefault(pk, []).append(r)
            labels_by_key = a.get('project_label') or {}
            named = [flat(labels_by_key.get(pk) or pk, 60) for pk in per_proj]
            proj_part = (', '.join(sorted(set(named))) + ' — ') if named else ''
            lines.append(labels['projects'] + ' (' + str(len(a['repos'])) + ' ' + labels['repos'] + '): ' +
                         proj_part + ', '.join('`' + r + '`' for r in shown) +
                         ((' +' + str(extra) + ' ' + labels['more']) if extra > 0 else ''))
            lines.append('_' + labels['via_dependabot'].replace('{n}', str(len(a['repos']))) + '_')
        else:
            ## Two lists, never one. The inventory match is keyword-based and
            ## VERSION-BLIND — it answers "who declares this technology", not
            ## "who is vulnerable". Printing it alone under a heading that reads
            ## "affected" is what turns one real finding into a 53-project wall
            ## nobody reads. What confirm_versions proved comes FIRST and stays
            ## short; the rest is demoted to context, explicitly unverified.
            conf = a.get('confirmed_repos') or []
            def render_repos(group, heading):
                ## A heading is what a skimmed security message is read by, so
                ## an already-fixed match must NEVER sit under one that asserts
                ## current exposure — its "was vulnerable" detail line does not
                ## undo the word above it. Open exposures and closed history are
                ## two sections; the window is kept, it is just not called a
                ## vulnerability any more.
                if not group:
                    return
                bits = []
                for c in group[:12]:
                    who = flat(c.get('repo'), 100)
                    pks = c.get('packages') or []
                    detail = []
                    ## Every affected package, not just the first: showing one
                    ## fix version as though it covered the repository is how an
                    ## operator patches half of an exposure and files it closed.
                    for p in pks[:4]:
                        nm = flat(p.get('package'), 40)
                        detail.append((nm + ' → ' + flat(p.get('fix'), 30)) if p.get('fix') else nm)
                    if len(pks) > 4:
                        detail.append('+' + str(len(pks) - 4) + ' ' + labels['more'])
                    ## Dates span the repo's matches, so a window can never be
                    ## borrowed from a different package's alert.
                    sinces = sorted(x for x in [p.get('since') or '' for p in pks] if x)
                    untils = sorted(x for x in [p.get('until') or '' for p in pks] if x)
                    if c.get('state') == 'open':
                        if sinces:
                            detail.append(labels['open_since'].replace('{since}', flat(sinces[0], 10)))
                    elif sinces and untils:
                        detail.append(labels['fixed_window']
                                      .replace('{since}', flat(sinces[0], 10))
                                      .replace('{until}', flat(untils[-1], 10)))
                    bits.append('`' + who + '`' + ((' ' + ' · '.join(detail)) if detail else ''))
                extra = len(group) - len(bits)
                lines.append(heading + ' (' + str(len(group)) + '): ' + ', '.join(bits) +
                             ((' +' + str(extra) + ' ' + labels['more']) if extra > 0 else ''))
            if conf:
                render_repos([c for c in conf if c.get('state') == 'open'], labels['confirmed_projects'])
                render_repos([c for c in conf if c.get('state') != 'open'], labels['fixed_projects'])
            else:
                ## Say WHY nothing is confirmed. "none_found" and "this kind of
                ## technology cannot be checked" are different facts, and
                ## collapsing them would let a deployed product read as safe.
                why = a.get('version_check') or ''
                if why == 'not_a_package':
                    lines.append('_' + labels['not_a_package'] + '_')
                elif why == 'unavailable':
                    lines.append('_' + labels['check_unavailable'] + '_')
                elif why == 'none_found':
                    lines.append('_' + labels['none_found'] + '_')
            if pnames:
                shown = [flat(n, 60) for n in pnames[:12]]
                extra = len(pnames) - len(shown)
                head = labels['declared_projects'] if conf or a.get('version_check') else labels['projects']
                lines.append(head + ' (' + str(len(pnames)) + '): ' + ', '.join(shown) +
                             ((' +' + str(extra) + ' ' + labels['more']) if extra > 0 else ''))
        src = []
        unit_url = safe_url(a.get('url'))
        if unit_url:
            src.append(unit_url)
        for c in all_cves[:3]:
            u = safe_url('https://nvd.nist.gov/vuln/detail/' + c)
            if u and u not in src:
                src.append(u)
        if src:
            lines.append(labels['sources'] + ': ' + ' · '.join(src))
        if a.get('refire_of'):
            sig_txt = ', '.join(sig_bits)
            lines.append('_' + labels['refire'].replace('{date}', a['refire_of'][:10]).replace('{signal}', sig_txt) + '_')
        return chr(10).join(lines)

    messages = [(':rotating_light:', render(a)) for a in alerts]
    if overflow > 0:
        messages.append((':warning:', ':warning: ' + labels['overflow'].replace('{n}', str(overflow))))
    for s in stale:
        messages.append((':warning:', ':warning: ' + labels['stale']
                         .replace('{source}', s.get('source') or '?')
                         .replace('{hours}', str(s.get('hours')))
                         .replace('{last}', s.get('last_ok') or 'never')))

    rendered = [{'text': text} for _, text in messages]
    if not messages:
        out({'posted': False, 'dry_run': bool(dry_run), 'messages': [], 'delivered': 0,
             'consume': not dry_run, 'targets': [], 'summary': 'nothing to deliver'})
    if not sinks:
        ## Alerts with nowhere to go are a CONFIG GAP, and a config gap that
        ## exits 0 is the silent-green outcome this bot exists to end: an
        ## hourly schedule would report success forever while delivering
        ## nothing. Fail loudly — nothing is consumed, so the alerts replay
        ## the moment a sink exists. (dry_run is handled above: previewing
        ## without sinks is a legitimate, explicit choice.)
        raise SystemExit('vuln-watch: ' + str(len(messages)) +
                         ' message(s) to deliver but NO sinks are configured -- add a `sinks` entry to '
                         'the workspace config (or run with --var dry_run=true to preview). Nothing was '
                         'consumed: these alerts will be re-computed on the next run.')
    payloads = []
    for icon, text in messages:
        for s in sinks:
            payloads.append(((s.get('webhook') or ''),
                             {'text': text[:14000], 'channel': s.get('channel') or '',
                              'username': s.get('username') or 'Senti',
                              'icon_emoji': s.get('icon_emoji') or ':shield:'}))
    rendered = [{'webhook': n, 'channel': p['channel'], 'text': p['text']} for n, p in payloads]
    if dry_run:
        ## stderr only: the engine parses the WHOLE stdout as one JSON
        ## object, so any extra stdout line silently breaks the node output
        ## (found live: NO_OUTGOING_EDGE on the first dry-run).
        for name, p in payloads:
            print('DRY-RUN -> webhook=' + name + ' channel=' + p['channel'] + chr(10) + p['text'] + chr(10) + '---', file=sys.stderr)
        out({'posted': False, 'dry_run': True, 'messages': rendered, 'delivered': 0,
             'consume': False, 'targets': [n for n, _ in payloads],
             'summary': 'dry-run: ' + str(len(payloads)) + ' payload(s) prepared, nothing posted, nothing consumed'})
    whmap = {}
    if webhooks_file and os.path.exists(webhooks_file):
        with open(webhooks_file, encoding='utf-8') as fh:
            whmap = json.load(fh)
    missing = sorted({n for n, _ in payloads if not whmap.get(n)})
    if missing:
        raise SystemExit('vuln-watch: webhook name(s) [' + ', '.join(missing) + '] not found in the bound `webhooks` secret (JSON map name -> url)')
    delivered, failures, targets = 0, [], []
    ## Track delivery PER MESSAGE, not per payload: a rate-limited sink that
    ## drops the 3rd alert of a burst must not let the run consume the state
    ## — the alerts already flipped to "alerted" upstream would be lost for
    ## good. Consuming requires every message to have reached at least one
    ## sink; otherwise the whole tick replays (at-least-once, so a delivered
    ## alert may repeat once — far better than a silent loss).
    msgs_ok = set()
    for idx, (name, p) in enumerate(payloads):
        req = urllib.request.Request(whmap[name], data=json.dumps(p).encode('utf-8'),
                                     headers={'Content-Type': 'application/json',
                                              'User-Agent': 'vuln-watch (iterion)'}, method='POST')
        try:
            with urllib.request.urlopen(req, timeout=20):
                delivered += 1
                msgs_ok.add(idx // max(1, len(sinks)))
                targets.append(name + '->' + (p['channel'] or 'default'))
        except Exception as e:
            failures.append(name + ': ' + type(e).__name__ + ': ' + str(e)[:200])
    if delivered == 0:
        raise SystemExit('vuln-watch: all ' + str(len(payloads)) + ' webhook post(s) failed: ' + '; '.join(failures))
    consume = len(msgs_ok) == len(messages)
    summary = 'delivered ' + str(delivered) + '/' + str(len(payloads))
    if failures:
        summary += ' -- FAILED: ' + '; '.join(failures)
    if not consume:
        ## A tick that delivered SOME messages holds every cursor back (the
        ## state is not consumed), so the same work replays hour after hour.
        ## Exiting 0 would let that read as success forever — the silent-green
        ## outcome this bot exists to end. The delivered messages are already
        ## out; this failure is what makes the stuck half visible.
        print(json.dumps({'posted': True, 'dry_run': False, 'messages': rendered,
                          'delivered': delivered, 'consume': False,
                          'targets': sorted(set(targets)), 'summary': summary},
                         ensure_ascii=False), file=sys.stderr)
        raise SystemExit('vuln-watch: ' + str(len(messages) - len(msgs_ok)) + '/' + str(len(messages)) +
                         ' message(s) reached NO sink -- the state is NOT consumed, so this tick replays '
                         'in full on the next run. ' + summary)
    out({'posted': True, 'dry_run': False, 'messages': rendered, 'delivered': delivered,
         'consume': consume, 'targets': sorted(set(targets)), 'summary': summary})

## Persist the staged state under flock: write state.json, append the
## alert log, and — with state_commit=true — commit+push the state dir
## with the rebase-retry discipline (ephemeral cloud runners share the
## branch). Runs ONLY after delivery succeeded (or nothing needed
## delivering): a failed post replays next run instead of losing alerts.
tool commit_state:
  input: commit_input
  output: commit_output
  language: py
  script: |
    import json, os, fcntl, subprocess
    null = None; true = True; false = False  # JSON-literal shim for missing refs
    state_next = {{input.state_next_file}}
    alertlog_delta = {{input.alertlog_file}}
    state_commit = {{input.state_commit}}
    ws = {{input.workspace}}
    state_dir = {{input.state_dir}}
    os.chdir(ws)

    def _commit_push_state(sdir, msg):
        ## Every git call captures its streams: the engine parses this
        ## node's WHOLE stdout as one JSON object, and `git commit`'s
        ## "[branch sha] msg" summary would silently corrupt the output.
        subprocess.run(['git', 'add', sdir], check=True, capture_output=True)
        ## `git diff --cached --name-only` prints REPO-ROOT-relative paths
        ## while sdir is relative to the workspace. When the workspace is a
        ## subdirectory of the repo, comparing the two makes every one of the
        ## bot's own files look "outside the state dir" and the guard fires
        ## on itself, every tick. Compare in the repo's own frame.
        prefix = subprocess.run(['git', 'rev-parse', '--show-prefix'],
                                capture_output=True, text=True).stdout.strip()
        sdir_repo = (prefix + sdir.rstrip('/')).lstrip('/')
        ## Guard: the bot may ONLY ever commit the state dir. A staged path
        ## outside it (vuln-watch.json, inventory.json, .github/**) would be
        ## a bug or an injection — hard-fail before the push rather than
        ## persisting it under the bot's identity.
        staged = subprocess.run(['git', 'diff', '--cached', '--name-only'],
                                capture_output=True, text=True).stdout.split(chr(10))
        pfx = sdir_repo + '/'
        outside = [p for p in staged if p.strip() and p != sdir_repo and not p.startswith(pfx)]
        if outside:
            raise SystemExit('vuln-watch: refusing to commit path(s) outside the state dir ' +
                             repr(sdir) + ': ' + ', '.join(outside[:10]))
        if subprocess.run(['git', 'diff', '--cached', '--quiet']).returncode == 0:
            return False
        ## Remember where we were: on a failed rebase we drop OUR commit and
        ## nothing else. `reset --hard origin/<branch>` would also destroy
        ## the operator's uncommitted work and unpushed commits — this bot
        ## runs with `worktree: none`, i.e. directly in their checkout.
        before = subprocess.run(['git', 'rev-parse', 'HEAD'],
                                capture_output=True, text=True).stdout.strip()
        committed = subprocess.run(['git', 'commit', '-m', msg], capture_output=True, text=True)
        if committed.returncode != 0:
            ## Name the cause instead of dying on a CalledProcessError
            ## traceback: the usual one is a runner with no git identity,
            ## which is a one-line fix the message should hand over.
            raise SystemExit('vuln-watch: git commit of the state dir failed -- ' +
                             'if git reports an unknown identity, set user.email/user.name on the '
                             'workspace clone (or in the runner image). git said: ' +
                             ((committed.stderr or committed.stdout or '')[-400:]).strip())
        br = subprocess.run(['git', 'rev-parse', '--abbrev-ref', 'HEAD'],
                            capture_output=True, text=True).stdout.strip() or 'HEAD'
        for _ in range(5):
            pushed = subprocess.run(['git', 'push', 'origin', 'HEAD'],
                                    capture_output=True, text=True)
            if pushed.returncode == 0:
                return True
            err = (pushed.stderr or '')[-400:]
            if 'could not read Username' in err or 'Authentication failed' in err \
                    or 'terminal prompts disabled' in err or 'Permission denied' in err:
                raise SystemExit('vuln-watch: git push was refused for lack of credentials -- '
                                 'the state was committed locally and is NOT pushed, so alerts may '
                                 'replay next run. Bind the forge_token secret (or run with '
                                 'state_commit=false). git said: ' + err.strip())
            rebased = subprocess.run(['git', 'pull', '--rebase', '--autostash', 'origin', br],
                                     capture_output=True, text=True)
            if rebased.returncode != 0:
                subprocess.run(['git', 'rebase', '--abort'], capture_output=True)
                ## Drop OUR commit instead of stacking it: a retained
                ## conflicting commit replays the SAME conflict on every
                ## later tick, so the branch never converges again. Scoped
                ## to the commit we made (`before`), never to origin — the
                ## operator's own work in this checkout is not ours to
                ## discard. `--soft` keeps their files untouched; only the
                ## commit pointer moves, and our state files stay on disk
                ## (the run raises, so nothing is consumed and the next tick
                ## recomputes from a fresh clone or re-commits here).
                if before:
                    subprocess.run(['git', 'reset', '--soft', before], capture_output=True)
                raise SystemExit('vuln-watch: could not rebase onto origin/' + br +
                                 ' to retry the push -- aborting. git said: ' +
                                 (rebased.stderr or '')[-400:].strip())
        raise SystemExit('vuln-watch: git push failed after 5 retries (non-fast-forward or network)')

    os.makedirs(state_dir, exist_ok=True)
    ## alertlog.jsonl is append-only from several runners onto one branch:
    ## without a merge driver, every rebase of two appends conflicts, the
    ## push wedges FOREVER, and on ephemeral runners the state never comes
    ## back — the same alerts then re-post every hour. `merge=union` keeps
    ## both sides' lines, which is exactly right for an append-only log.
    ga = os.path.join(state_dir, '.gitattributes')
    want = 'alertlog.jsonl merge=union' + chr(10)
    if not os.path.exists(ga) or want not in open(ga, encoding='utf-8').read():
        with open(ga, 'a', encoding='utf-8') as fh:
            fh.write(want)
    lock = open(os.path.join(state_dir, '.lock'), 'w')
    fcntl.flock(lock, fcntl.LOCK_EX)
    with open(state_next, encoding='utf-8') as fh:
        staged = fh.read()
    tmp = os.path.join(state_dir, 'state.json.tmp')
    with open(tmp, 'w', encoding='utf-8') as fh:
        fh.write(staged)
    os.replace(tmp, os.path.join(state_dir, 'state.json'))
    appended = 0
    if alertlog_delta and os.path.exists(alertlog_delta):
        with open(alertlog_delta, encoding='utf-8') as src:
            delta = [ln for ln in src.read().split(chr(10)) if ln.strip()]
        if delta:
            with open(os.path.join(state_dir, 'alertlog.jsonl'), 'a', encoding='utf-8') as dst:
                for ln in delta:
                    dst.write(ln + chr(10))
            appended = len(delta)
    committed = False
    if state_commit:
        committed = _commit_push_state(state_dir, 'chore(vuln-watch): watch tick, ' + str(appended) + ' alert(s)')
    print(json.dumps({'committed': committed,
                      'summary': 'state persisted (' + str(appended) + ' alert(s) logged)' +
                                 (', pushed' if committed else '')}, ensure_ascii=False))

## ─── Workflow ───────────────────────────────────────────────────

workflow vuln_watch:
  entry: plan

  ## The state (seen/cursors/health + alert log) IS the product and must
  ## persist in the workspace across runs — a run worktree would isolate
  ## the writes and discard them at finalization. Never auto.
  worktree: none

  ## This bot never builds the target repo: it reads two JSON files and
  ## talks to security APIs. Realising the workspace's toolchain would
  ## buy nothing and slow the hourly tick.
  repo_devbox: off

  budget:
    max_parallel_branches: 1
    max_duration: "15m"
    ## Belt only — the workflow has no LLM node to spend anything.
    max_cost_usd: 0.5

  plan -> poll_dependabot with {
    orgs: "{{outputs.plan.github_orgs}}",
    api_base: "{{outputs.plan.github_api_base}}",
    timeout_secs: "{{vars.fetch_timeout_secs}}",
    scratch_dir: "{{vars.scratch_dir}}",
    allow_private: "{{vars.allow_private_sources}}",
    workspace: "{{vars.workspace_dir}}",
    state_dir: "{{vars.state_dir}}"
  }

  poll_dependabot -> poll_advisories with {
    feeds: "{{outputs.plan.advisory_feeds}}",
    timeout_secs: "{{vars.fetch_timeout_secs}}",
    scratch_dir: "{{vars.scratch_dir}}",
    allow_private: "{{vars.allow_private_sources}}",
    workspace: "{{vars.workspace_dir}}",
    state_dir: "{{vars.state_dir}}"
  }

  poll_advisories -> poll_exploit with {
    kev_url: "{{outputs.plan.kev_url}}",
    timeout_secs: "{{vars.fetch_timeout_secs}}",
    scratch_dir: "{{vars.scratch_dir}}",
    allow_private: "{{vars.allow_private_sources}}"
  }

  poll_exploit -> match_policy with {
    alerts_file: "{{outputs.poll_dependabot.alerts_file}}",
    units_file: "{{outputs.poll_advisories.units_file}}",
    kev_file: "{{outputs.poll_exploit.kev_file}}",
    dependabot_errors: "{{outputs.poll_dependabot.errors}}",
    advisory_errors: "{{outputs.poll_advisories.errors}}",
    kev_error: "{{outputs.poll_exploit.error}}",
    epss_url: "{{outputs.plan.epss_url}}",
    epss_threshold: "{{outputs.plan.epss_threshold}}",
    dependabot_alert_floor: "{{outputs.plan.dependabot_alert_floor}}",
    certfr_avis: "{{outputs.plan.certfr_avis}}",
    github_orgs: "{{outputs.plan.github_orgs}}",
    advisory_feeds: "{{outputs.plan.advisory_feeds}}",
    kev_url: "{{outputs.plan.kev_url}}",
    inventory_path: "{{outputs.plan.inventory_path}}",
    workspace: "{{vars.workspace_dir}}",
    state_dir: "{{vars.state_dir}}",
    scratch_dir: "{{vars.scratch_dir}}",
    timeout_secs: "{{vars.fetch_timeout_secs}}",
    allow_private: "{{vars.allow_private_sources}}",
    max_alerts: "{{vars.max_alerts_per_run}}",
    kev_max_age_days: "{{vars.kev_max_age_days}}",
    observe_window_days: "{{vars.observe_window_days}}",
    source_stale_hours: "{{vars.source_stale_hours}}"
  }

  match_policy -> confirm_versions with {
    alerts: "{{outputs.match_policy.alerts}}",
    github_orgs: "{{outputs.plan.github_orgs}}",
    github_api_base: "{{outputs.plan.github_api_base}}",
    timeout_secs: "{{vars.fetch_timeout_secs}}",
    allow_private: "{{vars.allow_private_sources}}",
    max_lookups: "{{vars.max_version_lookups}}",
    max_seconds: "{{vars.max_version_seconds}}"
  }

  confirm_versions -> notify with {
    alerts: "{{outputs.confirm_versions.alerts}}",
    overflow_count: "{{outputs.match_policy.overflow_count}}",
    stale_sources: "{{outputs.match_policy.stale_sources}}",
    sinks: "{{outputs.plan.sinks}}",
    labels: "{{outputs.plan.labels}}",
    dry_run: "{{vars.dry_run}}"
  }

  ## Only a completed delivery (or a nothing-to-deliver tick) consumes
  ## the staged state; dry-runs and sink-less alert runs keep the old
  ## state so the SAME alerts recompute next run (at-least-once).
  notify -> done when not consume
  notify -> commit_state when consume with {
    state_next_file: "{{outputs.match_policy.state_next_file}}",
    alertlog_file: "{{outputs.match_policy.alertlog_file}}",
    state_commit: "{{vars.state_commit}}",
    workspace: "{{vars.workspace_dir}}",
    state_dir: "{{vars.state_dir}}"
  }
  commit_state -> done
