## ─────────────────────────────────────────────────────────────────
## review_pr — "Revi", a read-only cross-family code reviewer.
##
## Revi reviews the changes on the current branch and PUBLISHES the
## findings — it never edits, fixes, or commits code. That mutation
## job belongs to the improve-loops (Billy = branch_improve_loop,
## Willy = whole_improve_loop). Revi is the PR reviewer: it reads the
## diff, reasons about it with one reviewer (mono, the default) or two
## independent reviewers from different model families (dual — opt-in via
## `--var review_mode=dual`), then a single emit step
## merges + de-duplicates their findings and writes them to the
## iterion native kanban board (one issue per finding) plus a markdown
## report.
##
## Shape (single pass — no loop, no convergence, nothing to converge
## ON since Revi changes nothing between iterations):
##
##   topology (condition — ADR-052)
##     ├─ mono (DEFAULT) -> the single family reviewer
##     └─ dual           -> fan (fan_out_all)
##                            ├─ reviewer_claude  (claude_code, read-only)
##                            └─ reviewer_gpt     (claw + openai/gpt-5.5)
##   reviewer_* -> emit    (await: wait_all)   board + markdown report
##   emit -> pr_gate       (deterministic: was a pr_url given?)
##     ├─ no  -> done
##     └─ yes -> publish_review  (DETERMINISTIC forge publish via the
##               iterion server endpoint — no LLM, no workspace token) ->
##               publish_health  (deterministic anti-façade gate) -> done
##
## Cross-family value (DUAL only): an issue flagged by BOTH families is
## far more likely real than one flagged by a single reviewer. emit raises
## the confidence of cross-confirmed findings and labels them so the
## operator can triage agreement first. It is worth paying for on a
## high-stakes diff, not on every routine push — hence mono by default.
## In mono every finding is still reported; only the cross-confirmation
## tag is absent.
##
## Scope discipline (matches the loop bots): reviewers diff the
## WORKING TREE against the merge-base of `base_ref` and HEAD —
## `git diff $(git merge-base base_ref HEAD)` — so both committed and
## uncommitted branch changes are reviewed. To review ONLY the
## uncommitted working tree, run with `--var base_ref=HEAD` (then the
## merge-base is HEAD and the diff is HEAD-vs-working-tree).
##
## Read-only safety: no node mutates source. reviewer_claude is
## `readonly: true`; reviewer_gpt is given only read tools (bash,
## read_file, glob, grep — no write_file/file_edit). The single
## downstream `emit` step writes exactly one file (the report) and
## creates board issues over MCP; it runs after the parallel reviewers
## converge, so the one-mutating-branch workspace rule holds.
##
## v2 opportunity: very large diffs can overflow a reviewer's context.
## The loop bots solve this with a deterministic `plan_chunks` shard
## step; Revi v1 instructs reviewers to triage `git diff --stat` first
## and prioritise the highest-impact hunks. Port plan_chunks here when
## reviewing 1k+ LoC PRs becomes common.
##
## FORGE PR REVIEW (v0.3.0 — deterministic, tokenless-in-workspace):
## When `--var pr_url=<PR url>` is given, Revi ALSO publishes its
## merged findings directly onto that PR as a proper forge review —
## inline comments anchored to file:line, including one-click
## suggestion blocks (when a finding carries a concrete `replacement`)
## — on top of the native kanban board + markdown report it always
## writes. Publishing is a DETERMINISTIC tool node: it POSTs the
## findings to the iterion server's /api/v1/forge/publish-review
## endpoint (authenticated by a per-run token the server injects as
## `forge_publish_url` / `forge_publish_token` launch vars), and the
## SERVER posts the review through the team forge connection's LIVE
## client — a GitHub App connection mints a fresh installation token
## per call, so the ~1h token-freeze failure mode of a workspace-
## mounted forge_token is structurally gone, and no LLM agent ever
## holds a forge credential to post. Forge-agnostic: the endpoint
## dispatches by the connection's provider (GitHub / GitLab /
## Forgejo-Gitea) — no forge names in this DSL (universal-bots
## doctrine). A deterministic `publish_health` gate flags a no-op /
## failed publish (findings existed but 0 comments landed) so a façade
## is never silent. `post_to_board` remains the local sink; both run.
##
## Remaining enhancement (not yet built): auto-resolve base/head from
## the PR URL. Today review the LOCAL checkout (base_ref..HEAD) and
## publish to pr_url — so check out the PR branch and pass its base as
## base_ref. See the `pr_url` var doc below. Manual launch against a PR
## (`--var pr_url=<url>`) works today; a PR-event trigger
## (dispatcher/webhook auto-launch on PR open/update) is the other
## remaining enhancement.
## ─────────────────────────────────────────────────────────────────

secrets:
  ## Forge API token for OTHER forge uses (e.g. cloning a private repo on
  ## a cloud runner). NOT used by the publish path any more: since
  ## v0.3.0 the review is posted by the DETERMINISTIC publish_review
  ## node through the iterion server's forge-publish endpoint, which
  ## uses the team connection's live client — a workspace-mounted token
  ## freezes at launch (a GitHub App installation token lives ~1h) and
  ## must never be the posting credential. Mounted read-only as a FILE
  ## (path/env only, never read into a prompt); `optional: true` so
  ## runs without a binding are unaffected.
  forge_token:
    as: file
    optional: true

vars:
  workspace_dir: string = "${PROJECT_DIR}"

  ## Branch comparison base. Reviewers audit
  ## `git diff $(git merge-base base_ref HEAD)` (working tree vs the
  ## merge-base), so committed + uncommitted branch changes are both in
  ## scope. Default "main" covers the common GitHub/GitLab/Forgejo
  ## integration-branch name; pass `--var base_ref=develop` for another
  ## base, or `--var base_ref=HEAD` to review only uncommitted changes.
  base_ref: string = "main"

  ## Free-text steering for the reviewers (e.g. "focus on the new auth
  ## middleware" or "this is a hotfix, prioritise correctness"). Empty
  ## = review the whole diff against the full production-ready grid.
  scope_notes: string = ""

  ## Drop findings below this severity (order: low < medium < high <
  ## critical). Default "low" surfaces everything.
  severity_threshold: string [enum: "low", "medium", "high", "critical"] = "low"

  ## Cap the number of board issues / report rows (highest severity
  ## first). A capped run says so prominently in the report so it is
  ## never mistaken for "only N issues exist".
  max_findings: int = 40

  ## When true, emit creates one native-board issue per kept finding
  ## (label source:revi). When false, emit writes the markdown report
  ## only — useful for a read-only PR comment workflow with no board.
  post_to_board: bool = true

  ## Markdown report destination, repo-root-relative. A neutral
  ## dotfile the operator can gitignore — deliberately NOT under
  ## .iterion/ so Revi never scatters engine state into the target
  ## repo's tree.
  report_path: string = ".review-pr/findings.md"

  ## FORGE PR REVIEW (v0.3.0). When set to a pull-request (merge-request on GitLab) URL,
  ## Revi ALSO publishes its merged findings onto that PR as a real
  ## forge review: one inline comment per finding anchored to file:line,
  ## with a one-click suggestion block when the finding carries a
  ## concrete `replacement`, else a plain inline comment. Empty (default)
  ## = today's board + markdown-report behaviour only.
  ##
  ## Publishing is deterministic + server-mediated: the publish_review
  ## tool node POSTs the findings to the iterion server's
  ## /api/v1/forge/publish-review endpoint, which posts through the
  ## team forge connection's live client (GitHub / GitLab /
  ## Forgejo-Gitea). It needs `forge_publish_url` + `forge_publish_token`
  ## below — injected automatically by the server at launch.
  ##
  ## v1 diff model: review the LOCAL checkout (base_ref..HEAD, as
  ## always) and publish to this PR. So check out the PR's branch
  ## locally and pass its base as `base_ref` (e.g.
  ## `--var base_ref=main --var pr_url=https://github.com/o/r/pull/42`).
  ## Auto-resolving base/head from the PR URL is a future enhancement.
  pr_url: string = ""

  ## Review posting mode when pr_url is set: "inline" (default — one
  ## comment per finding anchored to file:line) or "summary" (a single
  ## rolled-up review body carrying all findings). The endpoint
  ## auto-falls back to a summary-only review when the forge rejects
  ## the inline anchors, so "inline" is safe unattended.
  pr_review_mode: string [enum: "inline", "summary"] = "inline"

  ## REVIEW TOPOLOGY (ADR-052). "mono" runs ONE family reviewer; "dual"
  ## runs both and cross-confirms. Dual costs a full reviewer pass per
  ## family on EVERY review — and with the merge gate wired, every push
  ## re-reviews — so mono is the default and dual is a deliberate opt-in
  ## (`--var review_mode=dual`, or the launch flag). "auto" is resolved at
  ## LAUNCH by pkg/reviewtopology from the host's detected credentials and
  ## also lands on mono; it only picks the family for you.
  ##
  ## Cross-family confirmation is worth paying for on a high-stakes diff,
  ## not on every routine push: a finding either reviewer raises is still
  ## reported, dual only adds the `cross-confirmed by both reviewers` tag.
  review_mode: string [enum: "auto", "mono", "dual"] = "mono"

  ## Which family runs in mono. Overwritten by the launch-time resolver
  ## when it detects only one usable family (e.g. an Anthropic-forfait
  ## instance with no OpenAI quota resolves to "claude").
  mono_family: string [enum: "claude", "gpt"] = "claude"

  ## MERGE GATE (v0.5.0). When pr_url is set, the deterministic publish
  ## step ALSO posts a commit status named "revi/review" on the PR head
  ## SHA: `success` when 0 findings meet `gate_severity`, else `failure`.
  ## Add that context to the repo's required checks (branch protection /
  ## merge queue) to make Revi's verdict BLOCK the merge; leave it out and
  ## the status is a harmless advisory check. The verdict is DETERMINISTIC
  ## — a count of findings at/above the threshold, computed here, never an
  ## LLM judgment. Non-blocking `questions` never count. A push re-reviews
  ## (opt-in ReviewOnSync webhook) so the status tracks the fixed head.
  ## Set false to skip the status entirely (advisory-only reviews).
  gate_enabled: bool = true

  ## Severity floor that BLOCKS the merge (order: low < medium < high <
  ## critical). Default "high": high + critical findings block; low +
  ## medium advise only. A finding you "would block a PR on" is exactly
  ## the reviewer's own bar (see review_system), so high is the sane floor.
  gate_severity: string [enum: "low", "medium", "high", "critical"] = "high"

  ## The commit-status CONTEXT the gate posts under — the name that appears
  ## in the repo's required checks. A required check applies to EVERY PR, so
  ## a repo where different bots review different PRs (a dependency guard on
  ## the bot's PRs, this reviewer on the humans') must give them ONE shared
  ## context, or whichever bot did not run leaves the check permanently
  ## absent and blocks the PR. Set it per repo via the integration's
  ## launch_vars (durable across re-provisioning), the same value on every
  ## bot that can gate. The default keeps this bot's historical name.
  gate_context: string = "revi/review"

  ## Deterministic forge publish grant — INJECTED BY THE ITERION SERVER
  ## at launch when the run's team has a forge connection covering
  ## pr_url's repo (studio/API launches and inbound webhooks both
  ## inject). forge_publish_url is the server's
  ## /api/v1/forge/publish-review endpoint; forge_publish_token is an
  ## ephemeral per-run token scoped to posting reviews on that one repo
  ## (24h TTL). When left empty (e.g. a bare CLI run with no server),
  ## publish_review skips with an explicit reason and publish_health
  ## banners it — never a silent no-op, and never a fallback to
  ## workspace credentials.
  forge_publish_url: string = ""
  forge_publish_token: string = ""

## ─── Prompts ────────────────────────────────────────────────────

prompt review_system:
  You are an EXTREMELY demanding, methodical code reviewer performing
  a PRODUCTION-READY review of the changes on the current branch. You
  are READ-ONLY: you NEVER edit, fix, format, or commit anything. Your
  only output is a structured list of findings — fixing is another
  bot's job.

  REVIEW SCOPE (crucial):
  1. Enumerate the changed files with
     `git -C {{vars.workspace_dir}} diff --name-only $(git -C {{vars.workspace_dir}} merge-base {{vars.base_ref}} HEAD)`.
     This is the working-tree diff against the merge-base of
     `{{vars.base_ref}}` and HEAD — it captures the changes the branch
     introduced (committed AND uncommitted). That diff is your scope.
  2. Read the actual diff with
     `git -C {{vars.workspace_dir}} diff $(git -C {{vars.workspace_dir}} merge-base {{vars.base_ref}} HEAD)`.
     On a large diff, read `--stat` first and prioritise the
     highest-impact hunks; never let context overflow silently.
  3. You MAY read surrounding code (callers, conventions, the host
     package) to judge how the change integrates, but you MUST only
     report issues in the CHANGED lines/files. Pre-existing issues the
     branch did not touch are out of scope — note them in `summary`
     at most, never as findings.

  AXES (cover what's relevant to the change):
    - Correctness: logic bugs, off-by-one, wrong conditionals, missing
      cases, broken invariants, incorrect API usage.
    - Security: auth, input validation, secret leaks, injection
      (shell/SQL/template), path traversal, unsafe deserialization,
      SSRF.
    - Concurrency: races, deadlocks, unbalanced locks, double-close,
      unbounded goroutines/channels, missing timeouts.
    - Error handling: swallowed errors, missing checks, panics on
      untrusted input, partial-failure cleanup.
    - Data: migrations, transactions, idempotence, ordering, data loss
      on crash.
    - Performance: O(n^2) on hot paths, N+1 queries, unbounded memory,
      needless allocations on hot paths.
    - Tests & maintainability: missing coverage for the new behaviour,
      dead code, leaky abstractions that will cause bugs.

  ANTI-FAÇADE DISCIPLINE:
    - Report only REAL, concrete, actionable issues anchored to a
      specific `file:line`. Every finding must name what breaks and
      under what condition.
    - NO stylistic nitpicks, NO "consider renaming", NO speculative
      "this could maybe" unless it is a genuine latent bug. If you
      would not block a PR on it, do not file it.
    - Rate each finding's `confidence` honestly. A guess is `low`.
    - Finding nothing is a valid, common outcome — return an empty
      `findings` array and say so in `summary`. Do NOT invent issues
      to look thorough. A clean review is NOT "trust me, nothing":
      make it auditable through `questions` (next section).

  OPEN QUESTIONS (falsifiability — kept STRICTLY SEPARATE from findings):
    `findings` are issues you would BLOCK a merge on. The most valuable
    thing a sharp human reviewer does on a clean diff is ASK — surface
    the load-bearing assumptions the change now RELIES ON but that you
    could not fully verify yourself:
      - a contract MOVED to another component ("EditorView no longer
        opens the file — does EditorTabHost guarantee it still does?"),
      - an invariant the diff now depends on but does not itself prove,
      - a cross-file / cross-service assumption you read AROUND but could
        not confirm end-to-end.
    Record each in `questions`, phrased as a concrete question a
    maintainer can answer. They are NON-BLOCKING: never inflate one into
    a finding, never file it to the board, never let it gate a merge —
    their only job is to make a 0-finding review falsifiable, showing
    WHAT you checked and WHERE the residual risk hides. Empty is correct
    when the change is genuinely self-contained and you verified it
    end-to-end — but reach for it before concluding a silent "nothing".

  OUTPUT — emit `review_output`:
    - `family`: YOUR model family — "claude" or "gpt" (the user
      message tells you which). Be exact: a wrong family breaks the
      cross-family agreement signal downstream.
    - `findings`: a JSON array. Each finding is an object:
        {
          "file": "relative/path.go",
          "line": 142,
          "line_end": 142,
          "severity": "critical" | "high" | "medium" | "low",
          "category": "correctness" | "security" | "concurrency" |
                      "error-handling" | "data" | "performance" |
                      "tests" | "maintainability",
          "title": "short noun phrase incl. the symptom",
          "detail": "what breaks, under what condition, why it matters",
          "suggestion": "one-line remediation sketch (no patch)",
          "replacement": "",
          "confidence": "low" | "medium" | "high"
        }
      `line` / `line_end`: the anchor span IN THE CHANGED CODE (a single
      line → set both equal). Anchor to lines the branch actually added
      or modified — that is where a forge can attach an inline comment.
      `replacement`: the literal new code for lines [`line`..`line_end`],
      ready to apply in one click (the forge renders it as a ```suggestion
      block). PROVIDE IT whenever the fix is LOCAL and HIGH-CONFIDENCE —
      a competent dev would accept it verbatim. It MAY span several lines
      and change the line count: the forge replaces the WHOLE anchored
      range, so set `line`/`line_end` to the smallest range that fully
      contains the fix and reproduce every UNCHANGED line inside that
      range verbatim. (To ADD a line — e.g. a `defer resp.Body.Close()`
      before line 18 — anchor line=18,line_end=18 and put BOTH the new
      line and the original line 18 in `replacement`.) A clean one-click
      fix is high-value: prefer it over a prose-only sketch. Leave it ""
      ONLY when the fix genuinely is not a localizable replacement — it
      needs edits in other files, an import far from the anchor, or it is
      judgement-dependent (several equally valid approaches). Never put a
      diff, prose, or a partial line in `replacement` — only the literal,
      complete replacement text; when empty, your one-line `suggestion`
      sketch is posted as a plain comment instead.
    - `scanned_areas`: the (axis, file) surfaces you actually audited.
    - `questions`: non-blocking open questions / load-bearing assumptions
      per OPEN QUESTIONS above — a string array (empty when none). These
      are NOT findings and never reach the board or a merge gate.
    - `summary`: one paragraph — overall risk read + anything notable
      that did not rise to a finding.

prompt review_user_claude:
  You are the CLAUDE-family reviewer — set `family` to "claude" in your
  output.

  Workspace: {{vars.workspace_dir}}
  Base ref:  {{vars.base_ref}}
  Operator steering (may be empty): {{vars.scope_notes}}

  Run the git scope commands above yourself, read the diff, and produce
  your `review_output`.

prompt review_user_gpt:
  You are the GPT-family reviewer — set `family` to "gpt" in your
  output.

  Workspace: {{vars.workspace_dir}}
  Base ref:  {{vars.base_ref}}
  Operator steering (may be empty): {{vars.scope_notes}}

  Use your `bash`, `read_file`, `glob` and `grep` tools to run the git
  scope commands, read the diff and surrounding code, then produce your
  `review_output`. You have NO write tools — you are read-only by
  construction.

prompt emit_system:
  You merge two INDEPENDENT code reviews (one Claude-family, one
  GPT-family) into a single de-duplicated finding set and PUBLISH it.
  You are read-only on source code: you write exactly one report file
  and (optionally) create kanban issues. You NEVER edit the code under
  review.

  STEP 1 — MERGE & DEDUPE:
    - Union the two `findings` arrays.
    - Two findings are the SAME issue when they share roughly the same
      `file` and overlapping `line` and describe the same defect — even
      if worded differently. Collapse them into one.
    - A finding raised by BOTH families is "cross-confirmed": keep the
      higher severity, set its confidence to "high", and remember to
      label/flag it as agreed-by-both. Cross-confirmed findings are the
      operator's highest-trust signal.
    - Keep family-unique findings too (one reviewer often sees what the
      other misses), at their own confidence.
    - Union the two `questions` arrays the same way: dedupe near-identical
      questions, keep each family's distinct ones. Questions are NEVER
      promoted to findings and NEVER filed to the board — they are the
      falsifiability channel that makes a 0-finding review auditable.

  STEP 2 — THRESHOLD & CAP:
    - Drop findings whose severity is below `{{vars.severity_threshold}}`
      (low < medium < high < critical).
    - Sort by severity (critical first), then cross-confirmed first.
    - Keep at most `{{vars.max_findings}}`. If you drop any to the cap,
      state it PROMINENTLY at the top of the report (e.g. "⚠ Capped:
      showing N of M findings — raise max_findings or narrow scope and
      re-run") so a capped run is never read as a clean bill of health.

  STEP 3 — BOARD (only when `{{vars.post_to_board}}` is true):
    - Read `{{vars.workspace_dir}}/.claude/skills/iterion-board.md`
      for the board MCP tools before your first call.
    - For each KEPT finding, call `mcp__iterion_board__create_issue`
      ONCE with:
        title  — short noun phrase incl. the anchor, e.g.
                 "SSRF in proxy handler at pkg/server/proxy.go:142"
        body   — markdown, using the template below
        state  — "ready"
        labels — ["severity:<level>", "type:<category>",
                  "source:revi"] plus "cross-confirmed" when both
                  families flagged it. Severity/type labels lowercase.
      One issue per finding. No batching. Capture each returned id;
      collect any rejected create into `failed_issues` and CONTINUE —
      never fail the run on a single rejected issue.
    - When `{{vars.post_to_board}}` is false, skip all board calls and
      leave `issues_created` empty.

    Body template (markdown):
    ```
    ## Anchor
    `<file>:<line>`

    ## Severity / Type / Confidence
    `<severity>` · `<category>` · `<confidence>`<cross-confirmed?>

    ## What breaks
    <detail — the defect and the condition that triggers it>

    ## Fix sketch
    <suggestion — one paragraph, no patch>

    ## Reviewers
    <claude | gpt | both>
    ```

  STEP 4 — REPORT:
    Write a markdown summary to
    `{{vars.workspace_dir}}/{{vars.report_path}}` (create parent dirs):
      # Code review — Revi
      ## Summary       (counts by severity; cross-confirmed count; cap
                        banner if any)
      ## Findings      (table: severity, category, file:line, title,
                        reviewers, board issue id)
      ## Agreement     (one line: N of M findings cross-confirmed)
      ## Open questions (the merged non-blocking questions as a bulleted
                        list — what the reviewers verified/assumed and the
                        contracts a maintainer should confirm; "none" when
                        empty. NEVER a findings table — these do not block.)

  RETURN `emit_output`:
    - `report_path`: absolute path of the markdown file you wrote.
    - `total_findings`: number of findings KEPT after threshold+cap.
    - `issues_created`: the board issue ids you created (empty when
      post_to_board is false).
    - `failed_issues`: any board creates the runtime rejected.
    - `findings`: the FINAL merged/threshold/capped finding set as a
      MACHINE-PARSED **JSON ARRAY OF OBJECTS** — NEVER a prose sentence,
      NEVER a summary STRING like "4 findings kept (1 high, 2 medium)".
      A deterministic downstream step runs `JSON.parse` on this exact
      value to count blocking findings and post inline PR comments: a
      string (or anything that is not a `[...]` array) fails the parse,
      which FAIL-CLOSES the merge gate AND drops every finding from the
      review. Emit the array itself, `[]` when there are none. Same
      per-object shape the reviewers emitted — preserve `file`, `line`,
      `line_end`, `severity`, `category`, `title`, `detail`, `suggestion`,
      `replacement`, `confidence`, and add
      `"reviewers": "claude" | "gpt" | "both"`. Keep `line`/`line_end` and
      any `replacement` exactly as given; do not re-summarise or drop
      fields. Example (the WHOLE value, verbatim shape):
        [
          {"file":"pkg/x/y.go","line":42,"line_end":42,"severity":"high",
           "category":"correctness","title":"nil deref on empty input",
           "detail":"…","suggestion":"guard len==0","replacement":"",
           "confidence":"high","reviewers":"both"}
        ]
      (Contrast: `questions` below is a newline-joined STRING; `findings`
      is an ARRAY. Do not swap their shapes.)
    - `questions`: the merged, de-duplicated non-blocking questions as a
      SINGLE STRING with ONE QUESTION PER LINE (newline-separated), NOT a
      JSON array — empty string "" when none. (A downstream shell step
      interpolates this value; a scalar string is shell-safe, an array is
      not.) Carried forward so the PR summary can show what the reviewers
      verified/assumed even on a 0-finding review. NOT findings — they never
      gate or reach the board.

prompt emit_user:
  Workspace:          {{vars.workspace_dir}}
  Severity threshold: {{vars.severity_threshold}}
  Max findings:       {{vars.max_findings}}
  Post to board:      {{vars.post_to_board}}
  Report path:        {{vars.report_path}}

  ── Claude-family review ── (ran: {{outputs.merge_reviews.claude_ran}})
  Summary: {{outputs.merge_reviews.claude_summary}}
  Findings (JSON):
  {{outputs.merge_reviews.claude_findings}}
  Areas audited: {{outputs.merge_reviews.claude_areas}}
  Open questions: {{outputs.merge_reviews.claude_questions}}

  ── GPT-family review ── (ran: {{outputs.merge_reviews.gpt_ran}})
  Summary: {{outputs.merge_reviews.gpt_summary}}
  Findings (JSON):
  {{outputs.merge_reviews.gpt_findings}}
  Areas audited: {{outputs.merge_reviews.gpt_areas}}
  Open questions: {{outputs.merge_reviews.gpt_questions}}

  A family with `ran: false` was not part of this review (mono topology) —
  merge only what the family that DID run reported, and never invent the
  other side's agreement: `reviewers` is "both" only when both ran and both
  flagged it.

  Merge, dedupe, threshold, cap, publish, and report per your
  instructions.

## ─── Schemas ────────────────────────────────────────────────────

schema review_output:
  ## family is enum-constrained so a hallucinated third value fails
  ## structured-output validation (triggering the retry path) instead
  ## of silently breaking the cross-family agreement signal.
  family: string [enum: "claude", "gpt"]
  ## findings is a free-form JSON array of finding objects (the schema
  ## DSL has no object-array type); the per-object shape is specified
  ## in review_system. emit reads it as JSON.
  findings: json
  scanned_areas: string[]
  ## Non-blocking reviewer questions / load-bearing assumptions to
  ## confirm — the falsifiability channel, kept strictly out of findings
  ## (never filed to the board, never gates a merge).
  questions: string[]
  summary: string

## Normalised per-family review blocks. In MONO only one reviewer runs, and
## an {{outputs.<absent node>.<field>}} reference renders as a LITERAL
## placeholder rather than as nothing — which reads to the merging agent as a
## broken template, not as "that family did not run" (observed live: a mono
## review was mistaken for a reviewer failure). Routing both families through
## a compute makes every field exist with a real value on every path.
schema family_reviews:
  claude_ran: bool
  claude_summary: string
  claude_findings: json
  claude_areas: json
  claude_questions: json
  gpt_ran: bool
  gpt_summary: string
  gpt_findings: json
  gpt_areas: json
  gpt_questions: json

schema emit_output:
  report_path: string
  total_findings: int
  issues_created: string[]
  failed_issues: string[]
  ## The final merged/capped finding set, carried forward so the forge
  ## publish step can map each finding to an inline PR comment. Same
  ## per-object shape the reviewers emit (file/line/line_end/severity/
  ## category/title/detail/suggestion/replacement/confidence/reviewers).
  findings: json
  ## Merged non-blocking questions, ONE PER LINE in a single string (NOT a
  ## JSON array): an all-string array decodes to []string, which the tool-node
  ## command substitution space-joins instead of JSON-encoding, breaking the
  ## downstream publish shell (a question landing in command position → exit
  ## 127). A scalar string is shell-escaped as one safe token. The
  ## falsifiability channel surfaced in the report + PR summary body, never on
  ## the board and never gating.
  questions: string

schema diff_precheck_output:
  is_empty: bool
  changed_files: int
  ## reviewed_sha: the worktree HEAD the reviewers judge against. Carried to
  ## publish_review so it can refuse to post a review whose line anchors were
  ## computed against a tree that has since changed (a resume after the branch
  ## advanced) — a stale-review guard, not a new gate.
  reviewed_sha: string

## ─── Forge PR review (v0.3.0) schemas ───────────────────────────

## pr_gate: deterministic branch on whether a PR target was given, so
## the (LLM) publish step is reached ONLY when pr_url is non-empty.
## Carries emit's findings + counts through to publish_review.
schema pr_gate_input:
  pr_url: string
  findings: json
  ## questions is a scalar string (one question per line), NOT a json array —
  ## see emit_output.questions for why (shell-safety of the publish command).
  questions: string
  total_findings: int
  ## RECOVERY INPUTS: the two reviewers' own raw finding arrays, carried
  ## untouched past converge. When converge's merged `findings` comes back
  ## unreadable (the LLM has emitted prose such as "See structured findings
  ## array." instead of the array — observed on PR #300, 8 findings lost),
  ## publish falls back to the union of these two, de-duplicated
  ## DETERMINISTICALLY by anchor. Losing the LLM's merge is far better than
  ## losing every finding.
  claude_findings: json
  gpt_findings: json

schema pr_gate_output:
  has_pr: bool
  pr_url: string
  findings: json
  questions: string
  total_findings: int
  claude_findings: json
  gpt_findings: json

schema publish_input:
  pr_url: string
  ## reviewed_sha: the worktree HEAD the findings anchor to. Comes in on the
  ## EDGE: a tool `command:` resolves {{input.X}}, {{vars.X}}, {{secrets.X}}
  ## and {{run.id}} — an {{outputs.…}} ref written there is NOT one of them and
  ## stays literal text, so every comparison against it is meaningless.
  reviewed_sha: string
  findings: json
  questions: string
  total_findings: int
  claude_findings: json
  gpt_findings: json

schema publish_output:
  ## published: a forge review was successfully created.
  published: bool
  ## forge: "github" | "gitlab" | "forgejo" | "unknown" — the team
  ## connection's provider, echoed by the iterion forge-publish
  ## endpoint. Free-form string, not a closed DSL enum.
  forge: string
  ## review_url: link to the posted review/comment thread (evidence).
  review_url: string
  ## comments_posted: inline comments the forge ACCEPTED (re-fetched as
  ## evidence, not self-reported optimistically).
  comments_posted: int
  ## suggestions_posted: of those, how many carried a ```suggestion block.
  suggestions_posted: int
  ## skipped_reason: non-empty when nothing was published (e.g. unknown
  ## forge, CLI not authenticated, zero anchorable findings).
  skipped_reason: string
  ## summary: what was posted + the re-fetch evidence behind the counts.
  summary: string

schema publish_health_input:
  published: bool
  comments_posted: int
  total_findings: int
  skipped_reason: string
  review_url: string

## Deterministic anti-façade gate: when a publish was requested AND
## there were findings, at least one inline comment must have landed.
## degraded=true surfaces a loud banner (the board + report already
## succeeded, so this informs rather than hard-fails the run).
schema publish_health_output:
  degraded: bool
  banner: string

## ─── Nodes ──────────────────────────────────────────────────────

## EFFICIENCY guard (deterministic, no LLM): compute the review diff
## (working tree vs the merge-base of base_ref + HEAD — the same diff the
## reviewers audit). If it is empty there is nothing to review, so
## short-circuit past both LLM reviewers + emit and finish fast. Only skips
## when the merge-base resolves AND the diff is empty; on any ambiguity
## (e.g. base_ref absent) it runs the reviewers — never wrongly skips a
## real review.
tool diff_precheck:
  command: `WS={{vars.workspace_dir}} BASE={{vars.base_ref}} python3 -c "
import os, subprocess, json
os.chdir(os.environ['WS'])
base = os.environ.get('BASE', 'main')
head = subprocess.run(['git', 'rev-parse', 'HEAD'], capture_output=True, text=True).stdout.strip()
mb = subprocess.run(['git', 'merge-base', base, 'HEAD'], capture_output=True, text=True).stdout.strip()
if not mb:
    print(json.dumps({'is_empty': False, 'changed_files': -1, 'reviewed_sha': head})); raise SystemExit(0)
out = subprocess.run(['git', 'diff', '--name-only', mb], capture_output=True, text=True).stdout.strip()
files = [f for f in out.splitlines() if f.strip()]
print(json.dumps({'is_empty': len(files) == 0, 'changed_files': len(files), 'reviewed_sha': head}))
"`
  output: diff_precheck_output

## Topology gate. A `condition` router picks a SINGLE target, which is
## exactly what mono needs; the guard cannot live on `fan`'s own edges
## because fan_out_all collects every outgoing edge without evaluating
## `when` (same trap as round_robin).
router topology:
  mode: condition

router fan:
  mode: fan_out_all

judge reviewer_claude:
  backend: "claude_code"
  model: "${ITERION_VIBE_MODEL_CLAUDE:-claude-opus-5}"
  reasoning_effort: "${ITERION_VIBE_EFFORT_CLAUDE:-high}"
  output: review_output
  system: review_system
  user: review_user_claude
  session: fresh
  ## Hard read-only: claude_code keeps Read/Grep/Bash for running git +
  ## reading code, but Write/Edit are removed so the reviewer cannot
  ## mutate the code it is judging.
  readonly: true

judge reviewer_gpt:
  ## Explicit backend pin: "openai/gpt-5.5" only resolves via claw.
  ## Without it the auto-resolver routes through claude_code, which
  ## doesn't recognise openai/* models and the schema validator fails.
  ## Both env-overridable so an instance without a usable OpenAI quota
  ## can run the second reviewer on the Claude forfait instead
  ## (ITERION_VIBE_BACKEND_GPT=claude_code +
  ## ITERION_VIBE_MODEL_GPT=claude-sonnet-5 — cross-model diversity
  ## when cross-vendor isn't available).
  backend: "${ITERION_VIBE_BACKEND_GPT:-claw}"
  model: "${ITERION_VIBE_MODEL_GPT:-openai/gpt-5.5}"
  reasoning_effort: "${ITERION_VIBE_EFFORT_GPT:-high}"
  output: review_output
  system: review_system
  user: review_user_gpt
  session: fresh
  ## Read-only toolset only (no write_file / file_edit): the claw
  ## reviewer can run git + read the workspace but has no structured
  ## path to edit it.
  tools: [bash, read_file, glob, grep]
  tool_max_steps: 30

## Converges the reviewer branch(es) and fills in whichever family did not
## run, so the merging agent sees a stated absence instead of a raw template.
compute merge_reviews:
  output: family_reviews
  ## best_effort, not wait_all: in mono only one branch ever arrives.
  await: best_effort
  expr:
    claude_ran:       "outputs.reviewer_claude.family == 'claude'"
    claude_summary:   "if(outputs.reviewer_claude.summary, outputs.reviewer_claude.summary, '(this family did not run)')"
    claude_findings:  "if(outputs.reviewer_claude.findings, outputs.reviewer_claude.findings, '[]')"
    claude_areas:     "if(outputs.reviewer_claude.scanned_areas, outputs.reviewer_claude.scanned_areas, '')"
    claude_questions: "if(outputs.reviewer_claude.questions, outputs.reviewer_claude.questions, '')"
    gpt_ran:          "outputs.reviewer_gpt.family == 'gpt'"
    gpt_summary:      "if(outputs.reviewer_gpt.summary, outputs.reviewer_gpt.summary, '(this family did not run)')"
    gpt_findings:     "if(outputs.reviewer_gpt.findings, outputs.reviewer_gpt.findings, '[]')"
    gpt_areas:        "if(outputs.reviewer_gpt.scanned_areas, outputs.reviewer_gpt.scanned_areas, '')"
    gpt_questions:    "if(outputs.reviewer_gpt.questions, outputs.reviewer_gpt.questions, '')"

agent converge:
  backend: "claude_code"
  model: "${ITERION_VIBE_MODEL_CLAUDE:-claude-opus-5}"
  reasoning_effort: "${ITERION_VIBE_EFFORT_EMIT:-medium}"
  output: emit_output
  system: emit_system
  user: emit_user
  session: fresh
  ## Converge the two parallel reviewer branches: emit runs once, after
  ## BOTH reviewers complete, and reads their outputs directly.
  await: wait_all
  ## board.read to load the iterion-board skill, board.create +
  ## board.label to file findings. emit writes the report file via its
  ## ordinary claude_code tools.
  capabilities: [board.read, board.create, board.label]

## ─── Forge PR review (v0.3.0) nodes ─────────────────────────────

## Deterministic branch (no LLM): reach the forge publish step ONLY
## when a pr_url was given. Passes the merged findings + counts through
## so publish_review reads them as input.* (stable across the edge).
compute pr_gate:
  input: pr_gate_input
  output: pr_gate_output
  expr:
    has_pr: "input.pr_url != ''"
    pr_url: "input.pr_url"
    findings: "input.findings"
    questions: "input.questions"
    total_findings: "input.total_findings"
    claude_findings: "input.claude_findings"
    gpt_findings: "input.gpt_findings"

## DETERMINISTIC forge publish (no LLM, no workspace credential): map the
## merged findings onto the iterion server's forge-publish payload and
## POST it to {{vars.forge_publish_url}} with the per-run token. The
## SERVER anchors the inline comments and renders the per-forge one-click
## suggestion syntax through the team connection's LIVE forge client, so
## a frozen workspace token can never 401 this step (prod run 019f8861's
## failure mode). Any failure is reported honestly in skipped_reason —
## published is true ONLY on a 2xx from the endpoint, whose counts are
## forge-re-fetched (anti-façade), never self-estimated.
tool publish_review:
  command: `WS={{vars.workspace_dir}} REVIEWED_SHA={{input.reviewed_sha}} PUB_URL={{vars.forge_publish_url}} PUB_TOKEN={{vars.forge_publish_token}} MODE={{vars.pr_review_mode}} REVIEW_MODE={{vars.review_mode}} PR_URL={{input.pr_url}} FINDINGS={{input.findings}} QUESTIONS={{input.questions}} CLAUDE_FINDINGS={{input.claude_findings}} GPT_FINDINGS={{input.gpt_findings}} GATE_ENABLED={{vars.gate_enabled}} GATE_SEVERITY={{vars.gate_severity}} GATE_CONTEXT={{vars.gate_context}} python3 -c "
import os, json, subprocess, urllib.request, urllib.error

def emit(published, forge='unknown', review_url='', posted=0, sugg=0, skipped='', summary=''):
    print(json.dumps({'published': published, 'forge': forge, 'review_url': review_url,
                      'comments_posted': posted, 'suggestions_posted': sugg,
                      'skipped_reason': skipped, 'summary': summary}))
    raise SystemExit(0)

url = os.environ.get('PUB_URL', '').strip()
tok = os.environ.get('PUB_TOKEN', '').strip()
pr = os.environ.get('PR_URL', '').strip()
mode = os.environ.get('MODE', '').strip() or 'inline'
findings_parse_failed = False

# Stale-review guard (#1): the findings' file:line anchors were computed
# against the tree at REVIEWED_SHA. If the worktree HEAD has since moved (a
# resume after the branch advanced), those anchors no longer match — refuse to
# post a misaligned review rather than land comments on the wrong lines.
#
# It only ever fires on two REAL shas that differ. Anything else — an empty
# value, or an unresolved template that reached us as literal text — means the
# guard cannot evaluate itself, and a guard that cannot evaluate itself must
# not swallow the review: the publish carries the gate status, and a status
# that never lands blocks the PR for good.
reviewed = os.environ.get('REVIEWED_SHA', '').strip()
ws = os.environ.get('WS', '').strip()
looks_like_sha = len(reviewed) >= 7 and all(c in '0123456789abcdefABCDEF' for c in reviewed)
stale_anchors = ''
if reviewed and ws and looks_like_sha:
    try:
        cur = subprocess.run(['git', '-C', ws, 'rev-parse', 'HEAD'],
                             capture_output=True, text=True).stdout.strip()
    except Exception:
        cur = ''
    if cur and cur != reviewed:
        stale_anchors = reviewed[:12] + ' -> ' + cur[:12]

try:
    findings = json.loads(os.environ.get('FINDINGS') or '[]')
except ValueError:
    findings = []
    findings_parse_failed = True
if not isinstance(findings, list):
    findings = []
    findings_parse_failed = True

# RECOVERY: converge is an LLM step and sometimes emits its findings as prose
# (observed: 'See structured findings array.') instead of the array, which
# would silently drop EVERY finding from the review and fail-close the gate on
# a lie. Fall back to the reviewers own raw arrays, unioned and de-duplicated
# DETERMINISTICALLY by anchor. The LLM merge (cross-confirmation, threshold,
# cap) is lost -- publishing an un-merged set beats publishing nothing.
recovered_from_reviewers = False
if findings_parse_failed:
    union = []
    for env_name in ('CLAUDE_FINDINGS', 'GPT_FINDINGS'):
        try:
            arr = json.loads(os.environ.get(env_name) or '[]')
        except ValueError:
            arr = []
        if isinstance(arr, list):
            union.extend([f for f in arr if isinstance(f, dict)])
    seen = set()
    deduped = []
    for f in union:
        key = (str(f.get('file') or ''), str(f.get('line') or ''),
               str(f.get('title') or '').strip().lower()[:80])
        if key in seen:
            continue
        seen.add(key)
        deduped.append(f)
    if deduped:
        findings = deduped
        recovered_from_reviewers = True
        findings_parse_failed = False
# QUESTIONS arrives as a newline-separated string (NOT JSON): a json array of
# strings would be space-joined by the tool-command substitution and break this
# shell (a question in command position -> exit 127). One question per line.
questions = [q.strip() for q in (os.environ.get('QUESTIONS') or '').split(chr(10)) if q.strip()]
if not url or not tok:
    emit(False, skipped='no forge publish endpoint bound to this run: launch through an iterion server with a team forge connection covering the PR repo, so it injects forge_publish_url/forge_publish_token', summary='publish skipped: run holds no server-side forge publish grant (and never uses workspace tokens to post).')

nl = chr(10)
sev_rank = {'critical': 0, 'high': 1, 'medium': 2, 'low': 3}
counts = {}
comments = []
for f in findings:
    if not isinstance(f, dict):
        continue
    sev = str(f.get('severity') or 'low').lower()
    counts[sev] = counts.get(sev, 0) + 1
    cross = str(f.get('reviewers') or '') == 'both'
    header = '[' + sev + ' / ' + str(f.get('category') or '') + (' / cross-confirmed by both reviewers' if cross else '') + '] ' + str(f.get('title') or '')
    body = header + nl + nl + str(f.get('detail') or '')
    sketch = str(f.get('suggestion') or '').strip()
    if sketch:
        body = body + nl + nl + 'Suggested fix: ' + sketch
    try:
        line = int(f.get('line') or 0)
    except (TypeError, ValueError):
        line = 0
    try:
        line_end = int(f.get('line_end') or 0)
    except (TypeError, ValueError):
        line_end = 0
    repl = str(f.get('replacement') or '')
    comments.append({'path': str(f.get('file') or ''), 'line': line, 'line_end': line_end,
                     'body': body, 'suggestion': repl if repl.strip() else ''})

summary = ['## Code review by Revi (iterion)', '', str(len(findings)) + ' finding(s) kept after threshold/cap.']
if recovered_from_reviewers:
    summary.append('')
    summary.append(chr(9888) + ' DEGRADED: the merged finding set was unreadable, so these were recovered directly from the two reviewers and de-duplicated by anchor. Cross-confirmation, severity threshold and cap were NOT applied.')
elif findings_parse_failed:
    summary.append('')
    summary.append(chr(9888) + ' DEGRADED: the review produced findings but their machine-readable form was unreadable, and no reviewer fallback was available. Nothing could be anchored inline; the merge gate fails closed.')
for sev in sorted(counts, key=lambda s: sev_rank.get(s, 9)):
    summary.append('- ' + sev + ': ' + str(counts[sev]))
# Cross-confirmation only exists when two families actually reviewed. The
# topology predicate is the same one the graph routes on (anything not 'dual'
# runs a single reviewer), so mono cannot report it. Saying '0 cross-confirmed'
# there reads as 'two families looked and agreed on nothing' — a claim about a
# review that never happened.
dual = str(os.environ.get('REVIEW_MODE', '')).strip().lower() == 'dual'
cross_n = len([f for f in findings if isinstance(f, dict) and str(f.get('reviewers') or '') == 'both'])
summary.append('')
if not findings:
    summary.append('No blocking findings.')
elif dual:
    summary.append(str(cross_n) + ' finding(s) cross-confirmed by both model families.')
else:
    summary.append('Reviewed by a single model family (mono topology): no finding is cross-confirmed, and none is meant to be.')
if questions:
    summary.append('')
    summary.append('### Open questions (non-blocking — reviewer assumptions to confirm)')
    for q in questions:
        summary.append('- ' + q)
elif not findings:
    summary.append('')
    summary.append('Reviewers verified the change end-to-end and raised no open questions.')

# Stale anchors cost the inline comments, never the publish. The POST below
# is what carries the merge-gate status, and a required status that never
# lands blocks the PR for good — a far worse outcome than a review whose
# file:line markers point at the wrong lines. So the anchors are dropped and
# the summary says why, rather than the whole review being swallowed.
if stale_anchors:
    comments = []
    summary.append('')
    summary.append(chr(9888) + ' The worktree HEAD moved after the reviewers judged it (' + stale_anchors +
                   '), so the inline anchors would land on the wrong lines. The findings are summarised '
                   'above instead. Push again or comment /revi for a review of the current head.')

payload = {'pr_url': pr, 'summary': nl.join(summary), 'mode': mode, 'comments': comments}

# Deterministic merge-gate verdict: count findings at/above the blocking
# severity floor. The server maps 0 blocking -> success, >0 -> failure on the
# revi/review commit status. Questions never count.
# Resolved unconditionally: the summary below reads it whenever the server
# reports a posted gate, and a NameError in this deterministic final step
# would cost the whole review.
gate_ctx = str(os.environ.get('GATE_CONTEXT', '')).strip() or 'revi/review'
gate_enabled = str(os.environ.get('GATE_ENABLED', '')).strip().lower() in ('1', 'true', 'yes', 'on')
if gate_enabled:
    gate_sev = str(os.environ.get('GATE_SEVERITY', 'high')).strip().lower() or 'high'
    # sev_rank is INVERTED (critical=0 .. low=3), so a SMALLER rank is MORE
    # severe. floor is the rank of the blocking threshold; rank <= floor
    # therefore means at least as severe as the threshold (e.g. floor=high=1
    # blocks critical=0 and high=1, not medium=2/low=3). Unknown rank=0
    # (most severe) always blocks -- fail closed.
    floor = sev_rank.get(gate_sev, 1)
    # A gate fails CLOSED: an unparseable finding set can't be evaluated, so it
    # blocks rather than reporting a green status by omission.
    if findings_parse_failed:
        blocking = 1
    else:
        blocking = 0
        for f in findings:
            if not isinstance(f, dict):
                continue
            # An off-enum severity (a trailing-space high, a synonym like
            # blocker or major, anything the model wrote outside the four
            # values) is UNKNOWN, and an unknown severity must block, never
            # silently downgrade to low. NOTE: keep this python -c body free of
            # the double-quote character -- the whole body is wrapped by the
            # shell in a double-quoted argument, so a stray one ends the string
            # and truncates the script (a silent empty output, no publish).
            # Same trap as backticks: use plain words in comments here.
            rank = sev_rank.get(str(f.get('severity') or '').strip().lower())
            if rank is None:
                rank = 0
            if rank <= floor:
                blocking += 1
    payload['gate'] = {'enabled': True, 'context': gate_ctx,
                       'blocking_count': blocking, 'threshold': gate_sev,
                       'total_findings': len(findings)}
    # Never let the status describe an unreadable review as a real blocking
    # finding: that message sent an operator hunting for a finding that was
    # never published. The note field overrides the server description.
    if findings_parse_failed:
        payload['gate']['note'] = 'review output unreadable (findings were not machine-readable) - gate fails closed; re-run /revi'
    elif recovered_from_reviewers:
        payload['gate']['note'] = str(blocking) + ' blocking of ' + str(len(findings)) + ' finding(s) recovered from the reviewers (merge step degraded)'
req = urllib.request.Request(url, data=json.dumps(payload).encode(),
                             headers={'Content-Type': 'application/json', 'X-Iterion-Run': tok},
                             method='POST')
try:
    with urllib.request.urlopen(req, timeout=120) as resp:
        res = json.loads(resp.read().decode())
except urllib.error.HTTPError as e:
    try:
        detail = e.read().decode()[:500].strip()
    except Exception:
        detail = ''
    emit(False, skipped='forge publish endpoint HTTP ' + str(e.code) + ': ' + detail, summary='deterministic publish FAILED: the iterion forge-publish endpoint refused the request (HTTP ' + str(e.code) + ').')
except Exception as e:
    emit(False, skipped='forge publish endpoint unreachable: ' + str(e)[:300], summary='deterministic publish FAILED: could not reach the iterion forge-publish endpoint.')

posted = int(res.get('comments_posted') or 0)
sugg = int(res.get('suggestions_posted') or 0)
fallback = str(res.get('fallback') or '')
verified = bool(res.get('verified'))
s = 'posted ' + str(posted) + ' inline comment(s), ' + str(sugg) + ' with one-click suggestions, via the iterion forge-publish endpoint (server-side live-token client); counts ' + ('re-fetched from the forge.' if verified else 'as submitted (forge re-fetch unavailable).')
if fallback:
    s = s + ' fallback=' + fallback + ': rejected inline anchors were folded into the review summary body, not dropped.'
if bool(res.get('gate_posted')):
    s = s + ' merge gate: ' + gate_ctx + '=' + str(res.get('gate_state') or '') + ' on ' + str(res.get('gate_sha') or '')[:12] + '.'
elif str(res.get('gate_error') or ''):
    s = s + ' merge gate NOT posted: ' + str(res.get('gate_error')) + '.'
emit(bool(res.get('published')), forge=str(res.get('provider') or 'unknown'),
     review_url=str(res.get('review_url') or ''), posted=posted, sugg=sugg, skipped='', summary=s)
"`
  input: publish_input
  output: publish_output

## Deterministic anti-façade gate (no LLM): when findings existed but
## zero inline comments landed, emit a loud banner. The board + report
## already succeeded upstream, so this informs (degraded=true) rather
## than hard-failing the run. Forge-agnostic: a pure count assertion.
tool publish_health:
  command: `TOTAL={{input.total_findings}} POSTED={{input.comments_posted}} PUBLISHED={{input.published}} REVIEW_URL={{input.review_url}} SKIPPED={{input.skipped_reason}} python3 -c "
import os, json, sys
total = int(os.environ.get('TOTAL', '0') or '0')
posted = int(os.environ.get('POSTED', '0') or '0')
review_url = os.environ.get('REVIEW_URL', '')
skipped = os.environ.get('SKIPPED', '')
degraded = total > 0 and posted == 0
if degraded:
    banner = chr(9888) + ' FORGE PUBLISH FAILED: ' + str(total) + ' finding(s) to post but 0 inline comments landed on the PR (reason: ' + (skipped or 'none given') + '). The board + markdown report still succeeded; fix the forge CLI auth and re-run with the same pr_url to publish.'
else:
    banner = 'forge publish OK: ' + str(posted) + ' inline comment(s) posted; review: ' + (review_url or 'n/a')
sys.stderr.write(banner + chr(10))
print(json.dumps({'degraded': degraded, 'banner': banner}))
"`
  input: publish_health_input
  output: publish_health_output

## ─── Workflow ───────────────────────────────────────────────────

workflow review_pr:
  entry: diff_precheck

  budget:
    ## Two read-only reviewer branches run in parallel; emit runs alone
    ## afterwards.
    max_parallel_branches: 2
    max_duration: "45m"
    max_cost_usd: 20

  ## EFFICIENCY: an empty review diff skips both LLM reviewers + emit.
  diff_precheck -> topology when not is_empty
  diff_precheck -> done when is_empty

  ## TOPOLOGY (ADR-052). Dual takes the fan-out and runs both families;
  ## mono goes straight to the single family reviewer, so only one LLM
  ## pass is spent. The claude edge is the unconditional fallback, so an
  ## unset/unknown review_mode degrades to the cheap path rather than to
  ## an empty router.
  topology -> fan when "vars.review_mode == 'dual'"
  topology -> reviewer_gpt when "vars.review_mode != 'dual' && vars.mono_family == 'gpt'"
  topology -> reviewer_claude

  ## Fan out to both family reviewers (dual only).
  fan -> reviewer_claude
  fan -> reviewer_gpt

  ## Converge on emit (await: wait_all). emit reads
  ## outputs.merge_reviews (normalised per family) directly, so the
  ## edges carry no data mapping.
  reviewer_claude -> merge_reviews
  reviewer_gpt -> merge_reviews
  merge_reviews -> converge

  ## emit always runs (board + markdown report). Then pr_gate decides
  ## whether to ALSO publish to a forge PR — only when pr_url is set —
  ## feeding emit's merged findings forward to the publish step.
  converge -> pr_gate with {
    pr_url: "{{vars.pr_url}}",
    findings: "{{outputs.converge.findings}}",
    questions: "{{outputs.converge.questions}}",
    total_findings: "{{outputs.converge.total_findings}}",
    claude_findings: "{{outputs.merge_reviews.claude_findings}}",
    gpt_findings: "{{outputs.merge_reviews.gpt_findings}}"
  }
  ## No PR target → finish after the board + report (the default,
  ## zero extra LLM cost). PR target → deterministic server-mediated
  ## forge publish (no LLM, no workspace credential).
  pr_gate -> done when not has_pr
  pr_gate -> publish_review when has_pr with {
    pr_url: "{{outputs.pr_gate.pr_url}}",
    reviewed_sha: "{{outputs.diff_precheck.reviewed_sha}}",
    findings: "{{outputs.pr_gate.findings}}",
    questions: "{{outputs.pr_gate.questions}}",
    total_findings: "{{outputs.pr_gate.total_findings}}",
    claude_findings: "{{outputs.pr_gate.claude_findings}}",
    gpt_findings: "{{outputs.pr_gate.gpt_findings}}"
  }
  ## Deterministic anti-façade gate on the publish result, then done.
  publish_review -> publish_health with {
    published: "{{outputs.publish_review.published}}",
    comments_posted: "{{outputs.publish_review.comments_posted}}",
    total_findings: "{{outputs.pr_gate.total_findings}}",
    skipped_reason: "{{outputs.publish_review.skipped_reason}}",
    review_url: "{{outputs.publish_review.review_url}}"
  }
  publish_health -> done
