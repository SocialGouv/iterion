## A line naming a file inside the checkout or the workspace is a build
## tool's chatter, not a route: it is counted and set aside, never read.
## The checkout's path is this run's own; the workspace's is not (a pod's
## is /workspace, a prefix an app's routes may share), so a line under it
## is chatter only when it names one of the workspace's top-level entries.
tree_roots = [os.path.realpath(tree) + os.sep, tree + os.sep]
try:
    ws_entries = set(os.listdir(real_ws))
except OSError:
    ws_entries = set()
def names_a_file(pat):
    if any(pat.startswith(r) for r in tree_roots):
        return True
    if not pat.startswith(real_ws + os.sep):
        return False
    return re.split('[:]', pat[len(real_ws) + 1:].split('/', 1)[0])[0] in ws_entries
if lfs_pointer(text):
    degrade('the net routes_probe printed a Git LFS pointer, not a route table' + stray)
parsed, odd = parse_route_table(text)
routes, dropped = [], odd
for pat in parsed:
    if names_a_file(pat):
        dropped += 1
        continue
    routes.append(pat)
aside = (str(dropped) + ' line(s) naming files in the checkout, or that are not a route, were not read as routes') if dropped else ''
if not routes:
    degrade('the net routes_probe ran and printed NO route' + ((' (' + aside + ')') if aside else '') + stray + (('; ' + left) if left else ''))
note = '; '.join(x for x in [aside, stray.lstrip('; '), left] if x)
emit(routes, 'probe', note, dropped, 'ROUTE TABLE: ' + str(len(routes)) + ' route(s) replayed from the net routes_probe at ' + base_sha[:12] + ((' -- ' + note) if note else ''))
"`
