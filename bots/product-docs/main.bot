    tmp = tempfile.mkdtemp(prefix='product-docs-routes-')
except OSError as exc:
    degrade('no throwaway checkout of the run base could be made for the probe -- ' + ' '.join(str(exc).split())[:200] + stray)
tree = os.path.join(tmp, 'tree')
rc, _out, err = git(['clone', '--quiet', '--no-checkout', '--shared', real_ws, tree], tmp)
## The clone keeps no remote: a probe that pushes has nowhere to push to.
if rc == 0:
    rc, _out, err = git(['remote', 'remove', 'origin'], tree)
if rc == 0:
