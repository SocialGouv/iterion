tool scan_hints:
  command: `WS={{vars.workspace_dir}} PRODUCT_DIR={{input.product_dir}} SURFACES={{input.surfaces}} EDITORIAL_DIR={{vars.editorial_dir}} DISMISSED_PATH={{vars.dismissed_path}} MAX_HINTS={{vars.max_hints}} MODE={{vars.mode}} DIFF_SINCE={{vars.diff_since}} python3 -I -c "
import os, json, glob, re, subprocess
ws = os.environ['WS']
os.chdir(ws)
product_dir = (os.environ.get('PRODUCT_DIR') or '').strip().strip('/')
editorial_dir = (os.environ.get('EDITORIAL_DIR') or '').strip().strip('/')
try:
    max_hints = int((os.environ.get('MAX_HINTS') or '120').strip() or '120')
except ValueError:
    max_hints = 120
try:
    surfaces = json.loads(os.environ.get('SURFACES') or '[]')
except ValueError:
    surfaces = []
if not isinstance(surfaces, list):
    surfaces = []
pages = sorted(p for p in glob.glob(os.path.join(product_dir, '**', '*.md'), recursive=True) if os.path.isfile(p))
dismissed = set()
dismissed_path = (os.environ.get('DISMISSED_PATH') or '').strip()
if dismissed_path and os.path.exists(dismissed_path):
    try:
        with open(dismissed_path, encoding='utf-8') as df:
            for e in json.load(df):
                if isinstance(e, dict):
                    dismissed.add((e.get('doc', ''), e.get('kind', ''), str(e.get('value', ''))))
    except (OSError, ValueError, TypeError):
        pass
hints = []
ledger_excluded = 0
def add_hint(doc, line, kind, value, note):
    global ledger_excluded
    if (doc, kind, str(value)) in dismissed:
        ledger_excluded += 1
        return
    hints.append({'doc': doc, 'line': line, 'kind': kind, 'value': value, 'note': note})
BT = chr(96)
MD_LINK_RE = re.compile(r'\[(?:[^\]]*)\]\(([^)\s]+)')
def slugify(text):
    s = text.strip().lower().replace(BT, '')
    s = re.sub(r'[^\w\s-]', '', s, flags=re.UNICODE)
    s = re.sub(r'\s', '-', s)
    return s.strip('-')
_heading_cache = {}
def headings_of(path):
    if path in _heading_cache:
        return _heading_cache[path]
    slugs = set()
    try:
        with open(path, encoding='utf-8', errors='replace') as fh:
            for ln in fh:
                hm = re.match(r'\s{0,3}(#{1,6})\s+(.+)', ln)
                if hm:
                    slugs.add(slugify(hm.group(2)))
    except (OSError, IsADirectoryError):
        pass
    _heading_cache[path] = slugs
    return slugs
INDEX_NAMES = {'readme.md', 'index.md', 'summary.md'}
checked_links = 0
linked_targets = set()
corpus_parts = []
empty_pages = []
for doc in pages:
    try:
        with open(doc, encoding='utf-8', errors='replace') as fh:
            lines = fh.readlines()
    except (OSError, IsADirectoryError):
        continue
    corpus_parts.append(''.join(lines))
    body = [l for l in lines if l.strip() and not l.lstrip().startswith('#')]
    if not body:
        empty_pages.append(doc)
    seen = set()
    for lineno, line in enumerate(lines, start=1):
        for m in MD_LINK_RE.finditer(line):
            target = m.group(1)
            if target.startswith('#'):
                continue
            if re.match(r'^[a-z][a-z0-9+.-]*://', target) or target.startswith(('mailto:', 'tel:', '//', 'www.')):
                continue
            if '#' in target:
                path_part, frag = target.split('#', 1)
            else:
                path_part, frag = target, ''
            if ('link', target) in seen:
                continue
            seen.add(('link', target))
            checked_links += 1
            tgt = doc if not path_part else os.path.normpath(os.path.join(os.path.dirname(doc), path_part))
            if path_part and not os.path.exists(tgt):
                add_hint(doc, lineno, 'dead_link', target, 'link target not found: ' + tgt)
                continue
            if path_part:
                linked_targets.add(tgt)
            if frag and tgt.endswith('.md') and slugify(frag.replace('-', ' ')) and frag.lower() not in headings_of(tgt):
                add_hint(doc, lineno, 'dead_anchor', target, 'no heading matching #' + frag + ' in ' + tgt)
corpus = chr(10).join(corpus_parts)
for doc in pages:
    if os.path.basename(doc).lower() in INDEX_NAMES:
        continue
    if os.path.normpath(doc) in linked_targets:
        continue
    add_hint(doc, 0, 'orphan_page', doc, 'no other page links to this one -- unreachable from the hub, so invisible to the reader')
for doc in empty_pages:
    add_hint(doc, 0, 'empty_page', doc, 'page has a title and no prose')
def surface_label(s):
    if isinstance(s, dict):
        return str(s.get('name') or s.get('title') or s.get('id') or '').strip()
    return str(s).strip()
for s in surfaces:
    label = surface_label(s)
    if not label:
        continue
    if label.lower() not in corpus.lower():
        add_hint('', 0, 'unmapped_surface', label, 'the catalog declares this functional surface and no page mentions it (advisory zone)')
prio = {'dead_link': 0, 'dead_anchor': 0, 'empty_page': 1, 'orphan_page': 2, 'unmapped_surface': 3}
hints.sort(key=lambda h: (prio.get(h['kind'], 4), h['doc'], h['line']))
dead_link_count = sum(1 for h in hints if h['kind'] in ('dead_link', 'dead_anchor'))
orphan_count = sum(1 for h in hints if h['kind'] == 'orphan_page')
unmapped_surface_count = sum(1 for h in hints if h['kind'] == 'unmapped_surface')
truncated = max_hints > 0 and len(hints) > max_hints
if max_hints > 0:
    hints = hints[:max_hints]
editorial_files = []
if editorial_dir:
    editorial_files = sorted(p for p in glob.glob(os.path.join(editorial_dir, '**', '*.md'), recursive=True) if os.path.isfile(p))
if not pages:
    hints_note = 'no page under ' + (product_dir or '<product_dir>') + ' yet -- this is a BOOTSTRAP pass: author the initial documentation set from the sources, per the documentary model in force'
else:
    hints_note = str(dead_link_count) + ' dead link(s)/anchor(s), ' + str(orphan_count) + ' orphan page(s), ' + str(unmapped_surface_count) + ' unmapped surface(s) -- from ' + str(checked_links) + ' internal link(s) across ' + str(len(pages)) + ' page(s); ' + str(ledger_excluded) + ' ledger-dismissed excluded' + (' [list truncated to ' + str(max_hints) + ']' if truncated else '')
if editorial_files:
    hints_note = hints_note + '; ' + str(len(editorial_files)) + ' editorial override(s) published by the docs repo (AUTHORITATIVE)'
else:
    hints_note = hints_note + '; no editorial override in the docs repo -- the bundle default skills apply'
mode = (os.environ.get('MODE') or 'full').strip().lower()
diff_since = (os.environ.get('DIFF_SINCE') or '').strip()
if mode == 'incremental' and not diff_since:
    try:
        ## Path-limited to THIS product, like catalog_ingest's own
        ## stamp lookup: in a multi-product docs repo an unscoped grep
        ## reads a SIBLING product's alignment commit and narrows this
        ## product's delta window to nothing.
        p = subprocess.run(['git', 'log', '-E', '--grep', '^Bot: product-docs', '-n', '1', '--format=%H', '--', product_dir], capture_output=True, text=True, check=True)
        diff_since = p.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        diff_since = ''
incremental_base = ''
recent = []
if diff_since:
    for ref in (diff_since, 'origin/' + diff_since):
        try:
            ## quotePath=false so accented (French) page names come
            ## back verbatim, not C-quoted into never-matching strings.
            proc = subprocess.run(['git', '-c', 'core.quotePath=false', 'diff', '--name-only', ref + '...HEAD'], capture_output=True, text=True, check=True)
            recent = sorted(l for l in proc.stdout.splitlines() if l.strip())
            incremental_base = ref
            break
        except (OSError, subprocess.SubprocessError):
            recent = []
if mode == 'incremental' and not incremental_base:
    ## First run (or unreadable history): there is no alignment commit
    ## to diff since, so an incremental pass would report an empty
    ## delta the campaign is told to read as 'nothing changed'. The
    ## honest degradation is a FULL sweep, said out loud.
    mode = 'full'
    hints_note = hints_note + '; BOOTSTRAP: no prior alignment commit for this product -- incremental mode degraded to a full sweep'
print(json.dumps({'pages': pages, 'page_count': len(pages), 'hints': hints, 'hint_count': len(hints), 'dead_link_count': dead_link_count, 'orphan_count': orphan_count, 'unmapped_surface_count': unmapped_surface_count, 'checked_links': checked_links, 'ledger_excluded': ledger_excluded, 'truncated': truncated, 'hints_note': hints_note, 'editorial_files': editorial_files, 'mode': mode, 'incremental_base': incremental_base, 'recently_changed_pages': recent}, ensure_ascii=False))
"`
  input: hints_input
  output: hints_output

## scope_check — the DETERMINISTIC writeable-set gate. Diffs the RUN
## BASE (the newest reflog entry that is not one of this run's own
## commits) against the working tree and flags any changed path that is
## not a `.md` file under the product directory — so the source clones
## (out of tree), the docs repo's editorial skills, and every other
## product's directory are all structurally protected. Untracked files
## are held to the same rule. No LLM; the campaign must revert whatever
## this flags.
tool scope_check:
  command: `WS={{vars.workspace_dir}} PRODUCT_DIR={{input.product_dir}} EDITORIAL_DIR={{vars.editorial_dir}} BASE_SHA={{input.base_sha}} python3 -I -c "
import os, json, subprocess
ws = os.environ.get('WS', '.')
product_dir = (os.environ.get('PRODUCT_DIR') or '').strip().strip('/')
editorial_dir = (os.environ.get('EDITORIAL_DIR') or '').strip().strip('/')
base = (os.environ.get('BASE_SHA') or '').strip()
## The diff this gate reads is the repository's, never what state the
## judged agent can plant in .git makes it look like: a replace ref on the
## base (or a graft) would empty the diff it audits. An inherited GIT_DIR
## or work tree cannot redirect it either.
for k in ('GIT_DIR', 'GIT_WORK_TREE', 'GIT_INDEX_FILE', 'GIT_COMMON_DIR', 'GIT_OBJECT_DIRECTORY', 'GIT_ALTERNATE_OBJECT_DIRECTORIES', 'GIT_NAMESPACE'):
    os.environ.pop(k, None)
os.environ['GIT_NO_REPLACE_OBJECTS'] = '1'
os.environ['GIT_GRAFT_FILE'] = os.devnull

def git(args):
    ## core.quotePath=false: git C-quotes non-ASCII paths by default
    ## (literal quotes + octal escapes), and this bot writes FRENCH
    ## pages -- an accented filename must compare equal, not become a
    ## permanent scope violation. A git failure RAISES: this gate is
    ## the truth oracle, and an empty answer must fail it closed (the
    ## same stance the empty-base guard below takes), never certify a
    ## tree it did not diff. stderr stays separate so a git message can
    ## never be mistaken for a changed path.
    p = subprocess.run(['git', '-C', ws, '-c', 'core.quotePath=false'] + args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=120)
    if p.returncode != 0:
        raise RuntimeError('git ' + ' '.join(args[:2]) + ' rc=' + str(p.returncode) + ': ' + ' '.join((p.stderr or '').split())[:300])
    return p.stdout or ''

## The base is RECORDED by catalog_ingest before the campaign writes
## anything. Re-deriving it from commit messages would hand the
## audited party the choice of its own audit window: one commit
## missing the trailer becomes the base and empties its own diff.
if not base:
    print(json.dumps({'scope_ok': False, 'out_of_scope': [], 'log': 'SCOPE GATE UNAVAILABLE: catalog_ingest recorded no run base (base_sha empty), so the writeable set cannot be computed. Refusing to certify it.'}, ensure_ascii=False))
    raise SystemExit(0)

## --no-renames: with rename detection ON git reports only a rename's
## DESTINATION, so renaming a protected file onto an allowed .md path
## would delete it behind a green gate.
try:
    changed = set(l for l in git(['diff', '--no-renames', base, '--name-only']).splitlines() if l.strip())
    ## Mode 120000 is a symlink: writing THROUGH one escapes the repo
    ## entirely, and committing one publishes a host path in the docs.
    symlinks = set()
    for row in git(['diff', '--no-renames', '--raw', base]).splitlines():
        if not row.startswith(':'):
            continue
        meta, _, path = row.partition(chr(9))
        fields = meta.split()
        if len(fields) >= 2 and '120000' in (fields[0].lstrip(':'), fields[1]):
            p = path.split(chr(9))[-1].strip()
            if p:
                symlinks.add(p)
    ## -uall: without it git collapses an untracked directory into one
    ## entry that never ends in .md, so a brand-new journey folder -- the
    ## bootstrap case -- reds the gate on the very path it must write.
    for line in git(['status', '--porcelain', '-uall']).splitlines():
        if line[:2].strip() == '??':
            changed.add(line[3:].strip())

    # iterion materialises the bundle's skills into <workspace>/.claude/ at run
    # start and again on every resume. That tree is the ENGINE's own artifact
    # while it stays UNTRACKED: attributing it to the run would fail the gate on
    # every pass, and the campaign could not fix it — the next pass re-creates
    # it. A TRACKED path under it is a different thing: the run committed the
    # agent's own notes into the docs repo, so it stays in scope.
    tracked_claude = set(l.strip() for l in git(['ls-files', '--', '.claude']).splitlines() if l.strip())
    changed = set(p for p in changed if p in tracked_claude or (p != '.claude' and not p.startswith('.claude/')))

    def allowed(p):
        if p in symlinks or os.path.islink(os.path.join(ws, p)):
            return False
        ## The editorial charter is the product team's own: the bot reads
        ## it, is governed by it, and never rewrites it.
        if editorial_dir and (p == editorial_dir or p.startswith(editorial_dir + '/')):
            return False
        if not p.endswith('.md'):
            return False
        if not product_dir:
            return False
        return p == product_dir or p.startswith(product_dir + '/')

    out_of_scope = sorted(p for p in changed if not allowed(p))
    log = ''
    if out_of_scope:
        log = 'SCOPE VIOLATION: this run changed files outside the product writeable-set (.md under ' + (product_dir or '<product_dir>') + ' only, never a symlink, never the editorial charter ' + (editorial_dir or '<editorial_dir>') + '). Revert these before continuing (git revert the offending commits, or git checkout ' + base[:12] + ' -- <path>): ' + ', '.join(out_of_scope[:40])
    print(json.dumps({'scope_ok': not out_of_scope, 'out_of_scope': out_of_scope[:100], 'log': log}, ensure_ascii=False))
except Exception as exc:
    ## Fail CLOSED: a gate that cannot compute the writeable set must
    ## say so and refuse to certify -- git absent, a bad base, a
    ## timeout. The campaign gets the reason verbatim.
    print(json.dumps({'scope_ok': False, 'out_of_scope': [], 'log': 'SCOPE GATE UNAVAILABLE: ' + ' '.join(str(exc).split())[:400] + ' -- refusing to certify the writeable set.'}, ensure_ascii=False))
"`
  input: product_dir_input
  output: scope_check_output

## page_lint — the DETERMINISTIC EDITORIAL gate. A published page is
## read by the product's users; it carries no trace of how it was
## produced. Four rules, each independently disableable through
## `lint_rules`, plus operator-supplied extra headings:
##   html_comments   — an HTML comment is a working note that survived
##   sources_box     — a "Sources" heading or a hint block whose body
##                     is a source reference
##   clarify_section — a "Points à clarifier" section (open questions
##                     belong inline as [à confirmer], or in the run
##                     report)
##   technical_annex — a "Correspondance technique" annex (technical
##                     content is out of scope for these pages)
## A violation is NOT converged: the log feeds the next pass and the
## campaign removes exactly the reported lines.
tool page_lint:
  command: `WS={{vars.workspace_dir}} PRODUCT_DIR={{input.product_dir}} LINT_RULES={{vars.lint_rules}} EXTRA_HEADINGS={{vars.extra_forbidden_headings}} NO_ANCHOR={{vars.coverage_no_anchor_marker}} ORACLE_PATH={{input.oracle_path}} python3 -I -c "
import os, json, glob, re
ws = os.environ['WS']
os.chdir(ws)
product_dir = (os.environ.get('PRODUCT_DIR') or '').strip().strip('/')
rules = {r.strip() for r in (os.environ.get('LINT_RULES') or '').split(',') if r.strip()}
extra = [h.strip() for h in (os.environ.get('EXTRA_HEADINGS') or '').split(',') if h.strip()]
## ONE declared token, honoured by every site that reads a heading.
## coverage_check reads vars.coverage_no_anchor_marker as the written
## exception to its anchor rule; if this gate also read it as a working
## note, the two would order the campaign to add and to remove the same
## characters, and the run could never converge. The exemption is the
## EXACT token and nothing else: any other comment on the same line is
## still a violation, and the marker itself is still chrome-free by
## construction (an HTML comment renders as nothing).
## AND IT IS ARMED BY THE NET, not by the var. coverage_check is armed by the
## presence of the two artifacts, so with no net there is no second gate to
## contradict -- and a run with no net must get the node it had before the
## coverage gate existed, its VALUES included and not only its expression: a
## working note on such a page is a working note.
no_anchor = (os.environ.get('NO_ANCHOR') or '').strip() if (os.environ.get('ORACLE_PATH') or '').strip() else ''
if not product_dir:
    ## Fail CLOSED, like scope_check: an empty product directory lints
    ## zero pages, and reporting that as clean would certify an
    ## artifact nobody looked at.
    print(json.dumps({'lint_ok': False, 'violations': [], 'violation_count': 0, 'pages_linted': 0, 'log': 'EDITORIAL LINT UNAVAILABLE: no product_dir was resolved, so no published page could be read. Refusing to certify the pages as clean.'}, ensure_ascii=False))
    raise SystemExit(0)
pages = sorted(p for p in glob.glob(os.path.join(product_dir, '**', '*.md'), recursive=True) if os.path.isfile(p))
HEADING_RE = re.compile(r'^\s{0,3}#{1,6}\s+(.+?)\s*$')
BOLD_LABEL_RE = re.compile(r'^\s{0,3}\*\*([^*]+?)\s*:?\s*\*\*')
## Anchored on the WHOLE heading: a blocking gate that fires on
## 'Sources de financement' or 'Points a clarifier avec votre
## conseiller' orders the campaign to delete reader-facing content,
## and the run never converges. Chrome is the bare title.
SOURCES_RE = re.compile(r'^sources?\s*:?\s*$', re.IGNORECASE)
## A BOLD label is prose furniture, not a section title: only the
## plural box title is chrome. '**Source :** arrete du 3 mars' is a
## citation the reader wants.
SOURCES_BOLD_RE = re.compile(r'^sources\s*:?\s*$', re.IGNORECASE)
CLARIFY_RE = re.compile(r'^points?\s+.{0,4}\s*clarifier\s*:?\s*$', re.IGNORECASE)
ANNEX_RE = re.compile(r'^(annexe\s*:?\s*)?correspondance\s+technique\b', re.IGNORECASE)
HINT_OPEN_RE = re.compile(r'\{%\s*hint\b')
HINT_CLOSE_RE = re.compile(r'\{%\s*endhint\s*%\}')
FENCE_RE = re.compile(r'^\s{0,3}(' + chr(96) * 3 + '+|~{3,})')
KEY_BLOCK_RE = re.compile(r'-----BEGIN [A-Z ]*PRIVATE KEY-----')
TOKEN_RE = re.compile(r'\b(ghp_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|glpat-[A-Za-z0-9_-]{15,}|xox[abprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|sk-[A-Za-z0-9]{20,})')
ASSIGN_RE = re.compile(r'(?:password|passwd|pwd|mot[_ ]de[_ ]passe|secret|token|api[_-]?key|access[_-]?key)\s*[:=]\s*(\S+)\s*$', re.IGNORECASE)
## chr(36) is the dollar sign: written literally it would sit next to
## an opening brace inside this double-quoted command and the SHELL
## would expand it before python ever sees the pattern.
PLACEHOLDER_RE = re.compile(r'^[<{(\[' + chr(36) + r']|[*x.]{3,}|^(votre|vos|your|mon|my|xxx|todo|redacted|confirmer)', re.IGNORECASE)
violations = []
def add(page, line, rule, excerpt):
    violations.append({'page': page, 'line': line, 'rule': rule, 'excerpt': ' '.join((excerpt or '').split())[:160]})
def credential_value(v):
    ## A credential is one opaque token. French prose ('8 caracteres
    ## minimum', 'votre mot de passe personnel') never is.
    if len(v) < 8 or PLACEHOLDER_RE.search(v):
        return False
    return bool(re.search(r'[0-9]', v)) or len(v) >= 16
for page in pages:
    try:
        with open(page, encoding='utf-8', errors='replace') as fh:
            lines = fh.readlines()
    except (OSError, IsADirectoryError):
        continue
    in_comment = False
    in_fence = False
    in_hint = 0
    hint_start = 0
    hint_body = []
    for lineno, raw_line in enumerate(lines, start=1):
        ## THE LINE IS READ RAW. Stripping the declared token before every
        ## rule made the token a switch on all of them: a marker declared as
        ## an opening comment put out html_comments, one declared as the word
        ## password put out the secret scan. The exemption is where it belongs:
        ## the html_comments rule, and only for a comment that IS the token;
        ## the title extraction removes it so it cannot pad a heading.
        line = raw_line
        ## Credential material is scanned EVERYWHERE, fenced code
        ## included: a pasted secret is worse inside a block, not
        ## exempt from the gate.
        if 'secret_material' in rules:
            if KEY_BLOCK_RE.search(line) or TOKEN_RE.search(line):
                add(page, lineno, 'secret_material', line)
            else:
                am = ASSIGN_RE.search(line)
                if am and credential_value(am.group(1)):
                    add(page, lineno, 'secret_material', line)
        ## Every other rule is about editorial chrome, which a fenced
        ## sample legitimately contains: a page teaching users to paste
        ## an HTML snippet must not be permanently red.
        if FENCE_RE.match(line):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        if 'html_comments' in rules:
            if in_comment:
                if '-->' in line:
                    in_comment = False
            else:
                at = 0
                while True:
                    start = line.find('<!--', at)
                    if start < 0:
                        break
                    close = line.find('-->', start)
                    comment = line[start:close + 3] if close >= 0 else line[start:]
                    ## EXACTLY the declared token is exempt, and only as a
                    ## whole comment: a second, genuine note on the same line
                    ## is still a violation, and a token that is a PREFIX of
                    ## a comment exempts nothing.
                    if no_anchor and comment == no_anchor:
                        at = start + len(no_anchor)
                        continue
                    add(page, lineno, 'html_comments', line)
                    if close < 0:
                        in_comment = True
                    break
        ## A hint block is scanned for a Sources body, but it NEVER
        ## suppresses the heading rules below: no document state may
        ## disable a gate rule for the rest of a page (an unclosed or
        ## single-line hint used to do exactly that).
        if in_hint and HINT_CLOSE_RE.search(line):
            if 'sources_box' in rules:
                joined = ' '.join(hint_body)
                if re.search(r'\bsources?\s*:', joined, re.IGNORECASE) or re.search(r'^\s*\*?\*?sources?\b', joined, re.IGNORECASE):
                    add(page, hint_start, 'sources_box', joined)
            in_hint = 0
            hint_body = []
        elif in_hint:
            hint_body.append(line.strip())
        elif HINT_OPEN_RE.search(line):
            if HINT_CLOSE_RE.search(line):
                if 'sources_box' in rules:
                    body = HINT_OPEN_RE.split(line)[-1]
                    if re.search(r'\bsources?\s*:', body, re.IGNORECASE):
                        add(page, lineno, 'sources_box', line)
            else:
                in_hint = 1
                hint_start = lineno
                hint_body = []
        title = ''
        from_bold = False
        hm = HEADING_RE.match(line)
        if hm:
            title = hm.group(1).strip()
        else:
            bm = BOLD_LABEL_RE.match(line)
            if bm:
                title = bm.group(1).strip()
                from_bold = True
        ## The declared marker is chrome-free by construction (an HTML comment
        ## renders as nothing), so it must not pad the title the rules below
        ## match on -- a heading that IS 'Sources' stays 'Sources'.
        if title and no_anchor:
            title = title.replace(no_anchor, '').strip()
        if not title:
            continue
        plain = re.sub(r'[*_' + chr(96) + r']', '', title).strip()
        if 'sources_box' in rules and (SOURCES_BOLD_RE if from_bold else SOURCES_RE).match(plain):
            add(page, lineno, 'sources_box', line)
        if 'clarify_section' in rules and CLARIFY_RE.match(plain):
            add(page, lineno, 'clarify_section', line)
        if 'technical_annex' in rules and ANNEX_RE.match(plain):
            add(page, lineno, 'technical_annex', line)
        for h in extra:
            if plain.lower().startswith(h.lower()):
                add(page, lineno, 'extra_forbidden_heading', line)
    ## An unclosed hint still has a body: flush it at EOF rather than
    ## letting a missing endhint drop the sources check.
    if in_hint and 'sources_box' in rules:
        joined = ' '.join(hint_body)
        if re.search(r'\bsources?\s*:', joined, re.IGNORECASE) or re.search(r'^\s*\*?\*?sources?\b', joined, re.IGNORECASE):
            add(page, hint_start, 'sources_box', joined)
log = ''
if violations:
    shown = ['- ' + v['page'] + ':' + str(v['line']) + ' [' + v['rule'] + '] ' + v['excerpt'] for v in violations[:40]]
    log = 'EDITORIAL LINT VIOLATION: published pages must carry no working notes (no HTML comments, no Sources box/section, no Points a clarifier section, no Correspondance technique annex). Remove exactly these, then re-check:' + chr(10) + chr(10).join(shown)
    if len(violations) > 40:
        log = log + chr(10) + '- ... and ' + str(len(violations) - 40) + ' more'
print(json.dumps({'lint_ok': not violations, 'violations': violations[:200], 'violation_count': len(violations), 'pages_linted': len(pages), 'log': log}, ensure_ascii=False))
"`
  input: lint_input
  output: lint_output

## coverage_check — the DETERMINISTIC EXHAUSTIVENESS gate, and the
## answer to the one question a documentation bot cannot ask itself:
## did I document EVERYTHING? Until now the answer was the agent's own
## `docs_aligned`, and the surface coverage was an advisory hint. Here
## it is read off the golden-master net the target already commits.
##
## ARMED IF AND ONLY IF a net is present — catalog_ingest resolves
## `<oracle_dir>/{feature-coverage.json, corpus.json}` in the docs
## workspace, then in each source clone, and passes the directory (or
## nothing) down this edge. WITHOUT a net this node reports
## `coverage_ok: true, net_present: false`, contributes nothing to
## fail_log, and Prody is exactly the bot it was.
##
## WITH a net it refuses five ways, each cause NAMED, never counted in
## silence:
##   PHANTOM_DOC         — a documented screen the net never saw: a
##                         cited corpus entry that does not exist, an
##                         inventory id nobody inventoried, a path that
##                         is neither a declared route nor a corpus
##                         entry path, a query parameter the corpus
##                         never observes on that path. A framework
##                         catch-all route (`/{slug}`, `/**`) declares
##                         every path and proves none: for a path only
##                         such a route covers, the corpus is the only
##                         evidence.
##   GAP                 — a covered feature no block documents. One
##                         line must CITE its id AND one of its
##                         inventory entries, and the block carrying it
##                         -- a paragraph, a list item, a table row --
##                         must READ, with prose enough for every
##                         feature it documents: the screen is anchored
##                         on the reference that exercises it, and
##                         described for a reader. Two citations side by
##                         side are an index row, a neighbour's prose is
##                         not the row's own, and a heading describes
##                         nothing.
##   CONCEALED_EXCLUSION — an exclusion the pages do not name AS one,
##                         under the declared exclusions chapter, in a
##                         block of prose of its own. A documentation
##                         that hides a hole lies about the application.
##   UNANCHORED_CHAPTER  — a chapter (heading level >= 2) naming no
##                         reference it restitutes and not declaring it
##                         observes none. The general clause of
##                         PHANTOM_DOC; the gate PRINTS the chapters
##                         that carry the declared marker, so hiding
##                         one behind it only denounces itself.
##   NET_UNREADABLE      — the material cannot be judged: absent,
##                         unparsable or not-an-object artifacts, a
##                         declared hole with no title to name it
##                         under, an inventory that
##                         contradicts itself, and EVERY emptiness —
##                         no page, no feature, no corpus entry, no
##                         `exclusions` key, an empty route table. A
##                         guard that reads `if collection and …` is
##                         DISABLED on an empty collection; here each
##                         emptiness is a decision, said out loud.
##
## IT INFERS NOTHING, IN EITHER DIRECTION. A reference is what the page
## SAYS is one — `coverage_citation_open` + token + `coverage_citation_close`
## — and a code span is prose, whatever it looks like. Every citation is
## verified wherever it sits, so an invented screen alone on its line is
## refused; nothing that is not a citation is ever looked at, so an
## interface label, a file name or an inline 404 stay prose. Guessing from
## a token's shape which of the two a code span is trades a false green (an
## invention alone on its line goes unverified) for a false red (a label is
## refused as an entry that does not exist): no setting closes both, only
## an explicit marker that has no middle.
##
## LANGUAGE-NEUTRAL BY CONSTRUCTION: the exclusions chapter title, the
## anchorless marker and the citation syntax are DECLARED identifiers
## (`coverage_*` vars). What it does NOT judge is the prose: that stays
## with its reader.
##
## Raw-string command, like its siblings: the python body carries no
## double quote, no literal backtick and no dollar sign.

## diagram_lint — the DETERMINISTIC verdict on the map the diagram step
## wrote. It runs in the tail, on the FINAL state of the pages (the
## campaign may have maintained them), and refuses by name:
##   MAP_ABSENT — no page at all under `<product_dir>/diagrams/` (a
##   documentation with no map after a map step drew one means the step
##   or the campaign lost it);
##   MAP_NOT_A_DIAGRAM — a page there carries no fenced ```mermaid
##   block (a "diagram" that diagrams nothing);
##   PHANTOM_MAP — a route-shaped token inside a mermaid block matches
##   NO declared route (and, when the net is present, NO corpus path):
##   a box on the map the application does not serve. The map lies, and
##   the campaign organizes its pages around the lie.
## With no route table available (no net) the route check DEGRADES
## VISIBLY — `routes_unverified` true, the log says so — it never
## silently greens. The check judges EXISTENCE and GROUNDING, never the
## art of the drawing: a map that misses a screen is coverage_check's
## and the route checks' business, not this one's.
##
## Raw-string command: no double quote, no literal backtick, no dollar
## sign in the python body.
tool diagram_lint:
  command: `WS={{vars.workspace_dir}} PRODUCT_DIR={{input.product_dir}} ORACLE_PATH={{input.oracle_path}} ROUTES={{input.routes}} ROUTES_SOURCE={{input.routes_source}} ROUTES_NOTE={{input.routes_note}} NET_DIGEST={{input.net_digest}} python3 -I -c "
import os, json, re, glob, hashlib
ws = os.environ['WS']
os.chdir(ws)
product_dir = (os.environ.get('PRODUCT_DIR') or '').strip().strip('/')
oracle = (os.environ.get('ORACLE_PATH') or '').strip()
routes_source = (os.environ.get('ROUTES_SOURCE') or '').strip()
route_note = (os.environ.get('ROUTES_NOTE') or '').strip()
try:
    net_digest = json.loads(os.environ.get('NET_DIGEST') or '{}')
except ValueError:
    net_digest = None
if not isinstance(net_digest, dict):
    net_digest = {}
causes = []
notes = []
def refuse(cause, where, detail):
    causes.append({'cause': cause, 'where': where, 'detail': detail})
if not product_dir:
    refuse('MAP_ABSENT', '<product_dir>', 'no product directory was resolved -- the map cannot be read and the run cannot certify a map nobody looked at')
    print(json.dumps({'diagram_ok': False, 'causes': causes, 'cause_count': 1, 'diagram_pages': 0, 'mermaid_blocks': 0, 'routes_on_map': 0, 'routes_unverified': True, 'log': 'DIAGRAM LINT UNAVAILABLE: no product_dir. Refusing to certify.'}, ensure_ascii=False))
    raise SystemExit(0)
map_dir = os.path.join(product_dir, 'diagrams')
pages = sorted(p for p in glob.glob(os.path.join(map_dir, '**', '*.md'), recursive=True) if os.path.isfile(p))
if not pages:
    refuse('MAP_ABSENT', map_dir, 'the map directory holds NO page -- a documentation run that drew a map must ship one; write the map pages under diagrams/ (at minimum a context map)')
FENCE = chr(96) * 3
blocks_total = 0
routes_on_map = set()
## A path segment carries what a captured URL carries -- dots (a file),
## percent-escapes, ~ + @ -- or the map lint truncates a screen the net
## captured and refuses what it did not read. Trailing sentence punctuation
## is not part of the path.
ROUTE_RE = re.compile(r'(?<![A-Za-z0-9_:/-])/[A-Za-z0-9_{}:*.%~+@-]+(?:/[A-Za-z0-9_{}:*.%~+@-]+)*(?:[?]([A-Za-z0-9_%-]+=[^ ]+))?')
for page in pages:
    with open(page, encoding='utf-8') as fh:
        lines = fh.read().split(chr(10))
    in_fence = False
    body = []
    fence_open = False
    for ln in lines:
        stripped = ln.strip()
        if not in_fence and stripped == FENCE + 'mermaid':
            in_fence = True
            fence_open = True
            blocks_total += 1
            body = []
        elif in_fence and stripped == FENCE:
            in_fence = False
            joined = chr(10).join(body)
            if not joined.strip():
                refuse('MAP_NOT_A_DIAGRAM', page, 'a mermaid block is EMPTY -- a diagram that diagrams nothing is dead weight; draw it or remove the block')
            for mm in ROUTE_RE.finditer(joined):
                tok = mm.group(0).rstrip('.,')
                if tok:
                    routes_on_map.add(tok)
            body = []
        elif in_fence:
            body.append(ln)
    if in_fence:
        refuse('MAP_NOT_A_DIAGRAM', page, 'a mermaid block is never CLOSED -- a fence the renderer cannot close renders nothing; close the block')
    elif not fence_open:
        refuse('MAP_NOT_A_DIAGRAM', page, 'the map page carries NO fenced mermaid block -- a page in diagrams/ that diagrams nothing is dead weight; draw the diagram or move the prose into the pages it belongs to')
## The route table is DATA handed over by route_table, resolved once per
## run at a commit: this node reads no file and runs no command for it.
try:
    declared = json.loads(os.environ.get('ROUTES') or '[]')
except ValueError:
    declared = None
if not isinstance(declared, list) or not all(isinstance(r, str) for r in declared):
    refuse('MAP_UNREADABLE', 'routes', 'the route table handed to the map lint is not a list of routes')
    declared = []
declared = list(dict.fromkeys(r for r in declared if r.startswith('/')))
route_from_probe = routes_source == 'probe'
## The corpus grounds a box too: a screen the net CAPTURED is served, even
## when the declared table misses it (a handler inherited from a generic
## controller, say). The route table widens what the corpus observed; it
## never overrules it.
corpus_paths = []
if oracle:
    try:
        with open(os.path.join(oracle, 'corpus.json'), 'rb') as fh:
            raw = fh.read()
        ## The corpus as the run found it (route_table's fingerprint): a
        ## corpus that changed under the pass grounds nothing.
        expected = net_digest.get('corpus.json')
        if expected != hashlib.sha256(raw).hexdigest():
            refuse('MAP_UNREADABLE', 'corpus.json', 'the net corpus is not the one the run began with (' + ('no fingerprint was recorded' if expected is None else 'fingerprint ' + (expected[:12] or 'absent') + ' at the start') + ') -- a net that changes during the run grounds no box on the map')
            raise ValueError('it changed since the run began')
        corpus_doc = json.loads(raw.decode('utf-8'))
        entries = corpus_doc.get('entries') if isinstance(corpus_doc, dict) else None
        if not isinstance(entries, list):
            raise ValueError('it carries no list of entries')
        for entry in entries:
            cp = entry.get('path') if isinstance(entry, dict) else None
            if isinstance(cp, str) and cp.startswith('/'):
                corpus_paths.append(cp.split('?', 1)[0].split('#', 1)[0])
    except (OSError, ValueError) as exc:
        notes.append('DIAGRAM LINT: the net corpus is unreadable (' + ' '.join(str(exc).split())[:160] + ') -- a mapped path is then grounded by the route table alone')
routes_unverified = not declared
def segments(path):
    return [s for s in path.split('/') if s != '']
def pattern_matches(pattern, target):
    ps, ts = segments(pattern), segments(target)
    if (pattern.endswith('/') and pattern != '/') != (target.endswith('/') and target != '/'):
        return False
    i = 0
    while i < len(ps):
        seg = ps[i]
        if seg == '**':
            return i == len(ps) - 1
        if i >= len(ts):
            return False
        if not (seg == '*' or seg.startswith(':') or (seg.startswith('{') and seg.endswith('}')) or seg == ts[i]):
            return False
        i += 1
    return i == len(ts)
def is_placeholder(seg):
    return seg == '*' or seg == '**' or seg.startswith(':') or (seg.startswith('{') and seg.endswith('}'))
def is_map_shape(tok):
    ss = segments(tok.split('?', 1)[0])
    return bool(ss) and not all(is_placeholder(s) for s in ss)
def has_literal(pattern):
    return any(not is_placeholder(s) for s in segments(pattern))
## A route grounds a mapped path only when it fits it WITHOUT a placeholder
## standing for a value nobody observed -- the sibling gate's rule: the box
## /offres/archiver is not grounded by the route /offres/{id}.
def aligned(route, path):
    return pattern_matches(route, path) and all((not is_placeholder(a)) or is_placeholder(b) for a, b in zip(segments(route), segments(path)))
## THE SAME DOCTRINE AS THE SIBLING GATE: a catch-all route declares
## every path and proves none, so a token grounded ONLY by one is not
## grounded -- it is UNVERIFIABLE, and the gate says so out loud (a
## visible note, never a silent bless). One predicate, two gates, or
## they disagree about the same route table.
def route_proves(pattern):
    return has_literal(pattern) and '**' not in segments(pattern)
unverified_tokens = []
for tok in sorted(routes_on_map):
    if not is_map_shape(tok):
        continue
    path_only = tok.split('?', 1)[0].split('#', 1)[0]
    if any(route_proves(r) and aligned(r, path_only) for r in declared):
        continue
    if route_proves(path_only) and any(pattern_matches(path_only, cp) for cp in corpus_paths):
        continue
    if not declared:
        notes.append('DIAGRAM LINT: routes DEGRADED -- no declared route table was available, the mapped path ' + tok + ' could not be verified')
        continue
    fits = sorted((r for r in declared if route_proves(r) and pattern_matches(r, path_only)), key=lambda r: (tuple(1 if is_placeholder(seg) else 0 for seg in segments(r)), r))
    if fits:
        refuse('PHANTOM_MAP', tok, 'the mapped path ' + tok + ' fits the declared route ' + fits[0] + ' only through a placeholder, with a value the net never observed -- draw the route itself (' + fits[0] + ') or a screen the net captured')
        continue
    if any(pattern_matches(r, path_only) for r in declared):
        unverified_tokens.append(tok)
        notes.append('DIAGRAM LINT: UNVERIFIED -- the mapped path ' + tok + ' matches only catch-all route(s) (/{x}, /**), which declare every path and prove none; ground it on a route with a literal segment or leave it to the route-presence gate')
        continue
    refuse('PHANTOM_MAP', tok, 'the mapped path ' + tok + ' matches NO declared route and NO corpus path -- a box on the map the application does not serve; ground it on a route the sources declare or take it off the map')
if unverified_tokens:
    notes.append('DIAGRAM LINT: ' + str(len(unverified_tokens)) + ' mapped path(s) unverified behind catch-all routes -- visible, never a silent pass')
log_lines = ['DIAGRAM LINT: ' + str(len(pages)) + ' map page(s), ' + str(blocks_total) + ' mermaid block(s), ' + str(len(routes_on_map)) + ' mapped path token(s), route table ' + ('present (' + str(len(declared)) + ' routes' + (', replayed from the net routes_probe' if route_from_probe else '') + ')' + ((' -- ' + route_note) if route_note else '') if declared else 'ABSENT -- mapped paths unverified: ' + (route_note or 'no net to read it from'))]
log_lines.extend(notes)
for c in causes[:40]:
    log_lines.append('DIAGRAM LINT: ' + c['cause'] + ' -- ' + c['where'] + ': ' + c['detail'])
if len(causes) > 40:
    log_lines.append('DIAGRAM LINT: ... and ' + str(len(causes) - 40) + ' more')
log_lines.append('DIAGRAM LINT: ' + ('RED -- ' + str(len(causes)) + ' named cause(s); each one above says what the map is missing or inventing' if causes else 'GREEN -- the map exists, every page draws, every mapped path is grounded'))
print(json.dumps({'diagram_ok': not causes, 'causes': causes[:200], 'cause_count': len(causes), 'diagram_pages': len(pages), 'mermaid_blocks': blocks_total, 'routes_on_map': len(routes_on_map), 'routes_unverified': routes_unverified, 'log': chr(10).join(log_lines)}, ensure_ascii=False))
raise SystemExit(0)
"`
  input: maplint_input
  output: maplint_output

tool coverage_check:
  command: `WS={{vars.workspace_dir}} ORACLE_PATH={{input.oracle_path}} PRODUCT_DIR={{input.product_dir}} EXCL_HEADING={{vars.coverage_exclusions_heading}} NO_ANCHOR={{vars.coverage_no_anchor_marker}} ROUTES={{input.routes}} ROUTES_SOURCE={{input.routes_source}} ROUTES_NOTE={{input.routes_note}} NET_DIGEST={{input.net_digest}} CITE_OPEN={{vars.coverage_citation_open}} CITE_CLOSE={{vars.coverage_citation_close}} PLACEHOLDERS={{vars.coverage_placeholders}} MIN_PROSE={{vars.coverage_min_prose}} MAX_ANCHORLESS={{vars.coverage_max_anchorless}} python3 -I -c "
import os, json, glob, re, unicodedata, hashlib
from urllib.parse import urlsplit, parse_qsl
ws = os.environ['WS']
os.chdir(ws)
oracle = (os.environ.get('ORACLE_PATH') or '').strip()
product_dir = (os.environ.get('PRODUCT_DIR') or '').strip().strip('/')
try:
    net_digest = json.loads(os.environ.get('NET_DIGEST') or '{}')
except ValueError:
    net_digest = None
if not isinstance(net_digest, dict):
    net_digest = {}
excl_token = (os.environ.get('EXCL_HEADING') or '').strip()
no_anchor = (os.environ.get('NO_ANCHOR') or '').strip()
routes_source = (os.environ.get('ROUTES_SOURCE') or '').strip()
route_note = (os.environ.get('ROUTES_NOTE') or '').strip()
cite_open = (os.environ.get('CITE_OPEN') or '').strip()
cite_close = (os.environ.get('CITE_CLOSE') or '').strip()
placeholders = [p.strip() for p in (os.environ.get('PLACEHOLDERS') or '').split(',') if p.strip()]
try:
    min_prose = int((os.environ.get('MIN_PROSE') or '60').strip() or '60')
except ValueError:
    min_prose = 60
try:
    max_anchorless = int((os.environ.get('MAX_ANCHORLESS') or '0').strip() or '0')
except ValueError:
    max_anchorless = 0
## A block of min_prose characters carrying fewer than one recognisable word
## per twelve is not a sentence: a row of dots or of dashes reaches any length.
min_words = max(3, min_prose // 12)
BT = chr(96)
## NO NET, NO GATE. Prody without a golden-master net is Prody as it was:
## this node reports coverage_ok and adds NOTHING to the gate expression or
## to fail_log. The activation is the PRESENCE of the two artifacts, resolved
## once by catalog_ingest -- never a var an operator could forget to unset.
if not oracle:
    print(json.dumps({'coverage_ok': True, 'net_present': False, 'causes': [], 'cause_count': 0, 'features_total': 0, 'features_documented': 0, 'exclusions_total': 0, 'exclusions_named': 0, 'entries_cited': 0, 'paths_cited': 0, 'chapters': 0, 'chapters_unanchored_declared': 0, 'chapters_anchorless_max': 0, 'routes_declared': 0, 'routes_degraded': False, 'net_unproven': False, 'oracle_dir_used': '', 'counts_line': '', 'log': ''}, ensure_ascii=False))
    raise SystemExit(0)
causes = []
def refuse(cause, where, detail, outside=False):
    ## outside=True marks a cause whose REPAIR lands outside this run
    ## writeable set. scope_check allows the campaign to write
    ## <product_dir>/**/*.md and nothing else, so a complaint about the net,
    ## about a launch var or about the catalog is an order it is forbidden to
    ## obey: the two gates would contradict each other and the run would burn
    ## every pass. Those are refused BEFORE the loop instead -- see the
    ## pre-flight refusal below.
    causes.append({'cause': cause, 'where': where, 'detail': detail, 'outside': outside})
def load(path, what):
    ## ONE door for both artifacts, and it hands back an OBJECT or nothing.
    ## Every reader below asks a parsed document for a key; a JSON array, a
    ## string or a number answers that with an AttributeError and a traceback
    ## -- a crash where the doctrine promises a named cause. The shape of the
    ## top level is decided here, once, rather than at each of its readers.
    if not os.path.isfile(path):
        refuse('NET_UNREADABLE', path, what + ': file absent', True)
        return None
    try:
        with open(path, 'rb') as fh:
            raw = fh.read()
    except OSError as exc:
        refuse('NET_UNREADABLE', path, what + ': unreadable -- ' + ' '.join(str(exc).split())[:200], True)
        return None
    ## THE NET AS THE RUN FOUND IT. route_table fingerprinted this file
    ## before any agent ran; a file that is no longer that one is not
    ## judged -- neither the working tree nor a source clone is where the
    ## pass under judgement can move its own yardstick.
    expected = net_digest.get(os.path.basename(path))
    got = hashlib.sha256(raw).hexdigest()
    if expected != got:
        if expected is None:
            why = 'no fingerprint of it was recorded when the run began'
        elif expected == '':
            why = 'the net carried no such file when the run began'
        elif expected.startswith('unreadable'):
            why = 'it could not be fingerprinted when the run began (' + expected + ')'
        else:
            why = 'it is not the file the run began with (sha256 ' + expected[:12] + ' then, ' + got[:12] + ' now)'
        ## The workspace's OWN net was changed by this run: the change lies
        ## outside the writeable set and is reverted like any other (scope_check
        ## names the commit to restore it from) -- a convergence term. A source
        ## clone's net cannot be restored from inside the run: pre-flight.
        if expected is not None and own_net:
            moved.append({'cause': 'NET_UNREADABLE', 'where': path, 'detail': what + ': ' + why + ' -- the net is judged as the run found it. Restore the file as the run began: it lies outside the writeable set, and scope_check names the commit to restore it from.', 'outside': False})
        else:
            unfound.append(what + ': ' + why + ' -- the net is judged as the run found it, and a net that changes during the run cannot certify it')
        return None
    try:
        doc = json.loads(raw.decode('utf-8'))
    except ValueError as exc:
        refuse('NET_UNREADABLE', path, what + ': unreadable JSON -- ' + ' '.join(str(exc).split())[:200], True)
        return None
    if not isinstance(doc, dict):
        refuse('NET_UNREADABLE', path, what + ': the top-level JSON is a ' + type(doc).__name__ + ' and not an object -- this file is read for its keys, and a document that has none cannot be judged: a refusal, not a traceback', True)
        return None
    return doc
own_net = os.path.realpath(oracle).startswith(os.path.realpath(ws) + os.sep)
moved, unfound = [], []
cov = load(os.path.join(oracle, 'feature-coverage.json'), 'the inventory feature-coverage.json')
corpus = load(os.path.join(oracle, 'corpus.json'), 'the corpus corpus.json')
## A net this run changed is judged on nothing else: every refusal that
## would follow from it (an inventory read as absent, say) is noise, and one
## of them would stop the run where a revert repairs it. A net the run cannot
## restore -- a source clone's, or one never fingerprinted -- stops it here,
## on that cause alone.
if unfound:
    raise SystemExit('product-docs: the non-regression net is not the one the run began with, and its repair lies OUTSIDE the writeable set of this run. That is a PRE-FLIGHT failure, never a convergence term:' + chr(10) + chr(10).join('- NET_UNREADABLE -- ' + u for u in unfound))
if moved:
    log = chr(10).join(['COVERAGE GATE: the net changed during the run -- nothing else is judged until it is restored'] + ['COVERAGE GATE: ' + c['cause'] + ' -- ' + c['where'] + ': ' + c['detail'] for c in moved] + ['COVERAGE GATE: RED -- ' + str(len(moved)) + ' named cause(s); restore the net, then re-check.'])
    print(json.dumps({'coverage_ok': False, 'net_present': True, 'causes': moved, 'cause_count': len(moved), 'features_total': 0, 'features_documented': 0, 'exclusions_total': 0, 'exclusions_named': 0, 'entries_cited': 0, 'paths_cited': 0, 'chapters': 0, 'chapters_unanchored_declared': 0, 'chapters_anchorless_max': 0, 'routes_declared': 0, 'routes_degraded': False, 'net_unproven': False, 'oracle_dir_used': oracle, 'counts_line': '', 'log': log}, ensure_ascii=False))
    raise SystemExit(0)
features, exclusions, entries = None, None, None
if cov is not None:
    features = cov.get('features')
    exclusions = cov.get('exclusions')
if corpus is not None:
    entries = corpus.get('entries')
## THE EMPTY IS A NAMED REFUSAL, never a guard that switches itself off.
## An if-collection-and-... guard is DISABLED on an empty collection: every loop
## below runs unguarded, and each emptiness is decided here, out loud.
if not isinstance(features, list) or not features:
    refuse('NET_UNREADABLE', 'feature-coverage.json', 'features is absent, empty or not a list -- with no inventory, completeness cannot be falsified: a refusal, not a vacuous pass', True)
    features = []
## An ABSENT exclusions key is an EMPTY LIST, which is how the net producer
## itself reads it (golden-master validate_feature_coverage: coverage.get(key)
## or []). A product that excludes nothing writes no key; refusing it would
## refuse every such product for ever, and for a repair that lands in the net
## -- a file this run is forbidden to write. Only a key that is THERE and
## mistyped is a refusal.
if exclusions is None:
    exclusions = []
if not isinstance(exclusions, list):
    refuse('NET_UNREADABLE', 'feature-coverage.json', 'exclusions is present and is not a list -- the net no longer declares its holes in a readable shape, and a documentation with no declared hole lies by omission', True)
    exclusions = []
if not isinstance(entries, list) or not entries:
    refuse('NET_UNREADABLE', 'corpus.json', 'entries is absent, empty or not a list -- with no corpus no anchor exists: a refusal, not a vacuous pass', True)
    entries = []
feature_names, entry_lists = [], {}
for i, f in enumerate(features):
    name = f.get('feature') if isinstance(f, dict) else None
    if not isinstance(name, str) or not name.strip():
        refuse('NET_UNREADABLE', 'features[' + str(i) + ']', 'inventory entry with no readable feature id', True)
        continue
    name = name.strip()
    if name in entry_lists:
        refuse('NET_UNREADABLE', name, 'listed twice among the COVERED features -- the count would grow without inventorying anything', True)
        continue
    ents = f.get('entries')
    ## The USABLE set decides, not the list's truthiness: entries of [' ']
    ## is a truthy list that names nothing, and it would join the covered
    ## features with an empty entry set -- a permanent GAP whose detail
    ## lists no entry to document, unactionable where the doctrine
    ## promises a named refusal.
    own = set(e.strip() for e in ents if isinstance(e, str) and e.strip()) if isinstance(ents, list) else set()
    if not own:
        refuse('NET_UNREADABLE', name, 'COVERED with no usable corpus entry -- a feature without a reference cannot be anchored', True)
        entry_lists[name] = set()
        continue
    feature_names.append(name)
    entry_lists[name] = own
exclusion_names, exclusion_reasons = [], {}
for i, x in enumerate(exclusions):
    name = x.get('feature') if isinstance(x, dict) else None
    if not isinstance(name, str) or not name.strip():
        refuse('NET_UNREADABLE', 'exclusions[' + str(i) + ']', 'exclusion with no readable feature id', True)
        continue
    name = name.strip()
    if name in exclusion_reasons:
        refuse('NET_UNREADABLE', name, 'excluded twice in the inventory -- its hole would be counted twice', True)
        continue
    exclusion_names.append(name)
    reason = x.get('reason') if isinstance(x.get('reason'), str) else ''
    exclusion_reasons[name] = reason
    if not reason.strip():
        refuse('NET_UNREADABLE', name, 'EMPTY reason in the inventory -- the net no longer declares why this hole exists', True)
for name in sorted(set(feature_names) & set(exclusion_reasons)):
    refuse('NET_UNREADABLE', name, 'BOTH covered and excluded -- the inventory contradicts itself', True)
## A HOLE THE PAGES CANNOT NAME. The declared chapter title is the ONLY way an
## exclusion counts as named, so an empty one refuses every hole the net
## declares, for a repair -- a launch var -- the campaign is forbidden to make:
## it would burn every pass rewriting prose that was never the problem. This
## is not the disabled-guard trap the node refuses elsewhere: what the
## condition reads is the TOKEN, and with no hole declared the rule has no
## subject at all, nothing being skipped in silence.
if exclusion_reasons and not excl_token:
    refuse('NET_UNREADABLE', 'coverage_exclusions_heading', 'the net declares ' + str(len(exclusion_reasons)) + ' exclusion(s) and the chapter title that would name them is not declared -- with no title no page can ever name a hole, and every one of them would be refused as concealed: a refusal, not an order the campaign cannot obey', True)
corpus_ids = set()
entry_paths = {}
entry_path_by_id = {}
for e in entries:
    if not isinstance(e, dict):
        continue
    eid = e.get('id')
    if isinstance(eid, str) and eid.strip():
        corpus_ids.add(eid.strip())
    p = e.get('path')
    if isinstance(p, str) and p.startswith('/'):
        parts = urlsplit(p)
        entry_paths.setdefault(parts.path, set()).update(k for k, _v in parse_qsl(parts.query, keep_blank_values=True))
        if isinstance(eid, str) and eid.strip():
            entry_path_by_id[eid.strip()] = parts.path
## The INVENTORY MUST POINT AT EVIDENCE THAT IS THERE. The two artifacts
## are regenerated separately, so a feature can keep citing an entry the
## corpus no longer holds. Left unchecked that drift makes two of this
## gate's own rules mutually unsatisfiable: documenting the feature with
## that entry is refused as a PHANTOM_DOC, omitting it is refused as a
## GAP, and the campaign burns every pass obeying two contradictory
## orders. The net's harness refuses the same drift on its side; this
## re-reads it here rather than assuming it was run.
for name in feature_names:
    absent = sorted(e for e in entry_lists.get(name, set()) if e not in corpus_ids)
    if absent:
        refuse('NET_UNREADABLE', name, 'the inventory maps it to corpus entries that DO NOT EXIST (' + ', '.join(absent) + ') -- the map points at evidence that is not there, and no page can satisfy both the gap rule and the phantom rule', True)

## The DECLARED route table is DATA handed over by route_table, resolved
## once per run at a commit (the net's committed table, or its routes_probe
## replayed at the run base): this gate reads no file and runs no command
## for it. Empty, the path check DEGRADES to the corpus alone, with the
## cause route_table gave, in the log and in routes_degraded. Degraded is
## visible; it is never silently green.
try:
    declared = json.loads(os.environ.get('ROUTES') or '[]')
except ValueError:
    declared = None
if not isinstance(declared, list) or not all(isinstance(r, str) for r in declared):
    refuse('NET_UNREADABLE', 'routes', 'the route table handed to the gate is not a list of routes', True)
    declared = []
declared = list(dict.fromkeys(r for r in declared if r.startswith('/')))
route_from_probe = routes_source == 'probe'
routes_degraded = not declared
## PRODY TRUSTS THE NET WITHOUT PROOF THAT THE NET OWN GATE RAN ON IT. A rite
## emits its runner (verify-oracle.sh, which replays the gate) and REPORT.md
## into the net directory, so the ABSENCE of both means no harness ever
## produced this material here. Their presence is a TRACE and never a verdict
## -- neither file is stamped with the commit it judged, and asking for that
## stamp belongs to the golden-master bundle, not to this one. Reported the
## way routes_degraded is: visible, never silently green.
net_proof = [f for f in ['verify-oracle.sh', 'REPORT.md'] if oracle and len(net_digest.get(f) or '') == 64]
net_unproven = not net_proof
def segments(path):
    return [s for s in path.split('/') if s != '']
def pattern_matches(pattern, target):
    ## The net's own route grammar (golden-master route_regex): {x}, :x and *
    ## match ONE segment, ** matches the tail and only as the last segment.
    ## A trailing slash is NEVER folded -- with and without are two routes.
    ps, ts = segments(pattern), segments(target)
    if (pattern.endswith('/') and pattern != '/') != (target.endswith('/') and target != '/'):
        return False
    i = 0
    while i < len(ps):
        seg = ps[i]
        if seg == '**':
            return i == len(ps) - 1
        if i >= len(ts):
            return False
        if not (seg == '*' or seg.startswith(':') or (seg.startswith('{') and seg.endswith('}')) or seg == ts[i]):
            return False
        i += 1
    return i == len(ts)
def is_placeholder(seg):
    return seg == '*' or seg == '**' or seg.startswith(':') or (seg.startswith('{') and seg.endswith('}'))
def has_literal(pattern):
    return any(not is_placeholder(s) for s in segments(pattern))
def specificity(route):
    return tuple(1 if is_placeholder(seg) else 0 for seg in segments(route))
def shape(route):
    return '/' + '/'.join('{}' if is_placeholder(seg) else seg for seg in segments(route))
def route_proves(pattern):
    ## A framework catch-all (/{slug}, /**) declares every path and proves
    ## none, and so does a TAIL WILDCARD: ** swallows an unbounded tail, so
    ## /dashboard/** carries one literal segment and still matches screens it
    ## has never described. For a path only such a route covers, the corpus
    ## reference is the only evidence. ONE predicate, read by both sides: a
    ## declared route and a cited path are the same claim written by two
    ## different authors, and the rule that governs one governs the other.
    ps = segments(pattern)
    if not ps:
        return True
    return has_literal(pattern) and '**' not in ps
def corpus_matches(cited):
    return [c for c in entry_paths if pattern_matches(cited, c)]
def aligned(route, path):
    ## The route fits the path WITHOUT a placeholder standing for a value no
    ## one observed: each placeholder of the route is cited as a placeholder,
    ## each literal as itself. /offres/{id} is grounded by the route
    ## /offres/{id}; /offres/archiver is not -- it is a value, and the table
    ## cannot say it is served.
    return pattern_matches(route, path) and all((not is_placeholder(a)) or is_placeholder(b) for a, b in zip(segments(route), segments(path)))
def grounded_path(path):
    return any(route_proves(r) and aligned(r, path) for r in declared) or bool(corpus_matches(path))
## A CITATION IS WHAT THE PAGE SAYS IS ONE -- nothing is inferred, in either
## direction. Guessing from a token's shape whether it is a reference leaves
## either a false green (an invented screen alone on its line unverified) or
## a false red (an ordinary code span refused as a corpus entry that does not
## exist); no setting closes both. Every citation is verified, wherever it
## sits; nothing that is not one is ever looked at.
if not cite_open or not cite_close:
    refuse('NET_UNREADABLE', 'coverage_citation_open/close', 'the citation syntax is not declared -- with no way to recognise a reference this gate would certify a documentation it never read: a refusal, not a vacuous pass', True)
CITE_RE = re.compile(re.escape(cite_open) + r'\s*([^' + chr(10) + r']*?)\s*' + re.escape(cite_close)) if (cite_open and cite_close) else None
inventory_names = set(entry_lists) | set(exclusion_reasons)
## CommonMark lets an ATX heading open with up to THREE spaces; anchored
## at column zero, ' ## Title' -- a real chapter heading -- read as a
## paragraph and a chapter without an anchor escaped the rule.
HEADING_RE = re.compile(r'^ {0,3}(#{1,6})\s+(.*\S)\s*' + chr(36))
FENCE_RE = re.compile(r'^\s{0,3}(' + BT * 3 + '+|~{3,})')
## A WORD IN EVERY SCRIPT. An ASCII range counted zero words on a page written
## in a script that does not decompose to ASCII, so min_words could never be
## reached: every feature a permanent GAP, unrepairable inside the writeable
## set, on a node whose vars declare it language-neutral.
WORD_RE = re.compile(r'[^\W_]+')
## SCRIPTS WITHOUT SPACES: a full sentence of han, kana or hangul is ONE
## WORD_RE run, so a complete, informative page counted as two words and
## every feature on it went GAP -- unreachable from inside the writeable
## set. Each such character is counted as the word it renders as;
## punctuation-only filler still counts nothing.
CJK_RUN_RE = re.compile('[\u3040-\u30ff\u31f0-\u31ff\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff\uac00-\ud7af]+')
def word_count(text):
    non_cjk = WORD_RE.findall(CJK_RUN_RE.sub(' ', text))
    return sum(1 for w in non_cjk if len(w) >= 4) + sum(len(r) for r in CJK_RUN_RE.findall(text))
## A placeholder is a WHOLE token: without boundaries, WIP matched the wip
## in "swipe" and TODO the todo in Spanish "todos", refusing honest prose.
PLACEHOLDER_RE = re.compile('|'.join('(?<![\w])' + re.escape(p) + '(?! [\w])'.replace(' ', '') for p in placeholders), re.I) if placeholders else None
## THE UNIT A READER READS AS ONE. Prose is credited over the BLOCK that
## carries a citation, and a block is what markdown renders as one: a run of
## consecutive non-blank lines is a single paragraph only when nothing in it
## starts a block of its own. A heading, a table row (with or without its
## leading pipe), a list item and a line of block-level HTML are each read on
## their own whatever the spacing; a quote marker, a thematic break and a
## template tag line end the block before them. Lumped into one paragraph,
## an index table would credit its header and every other row to each
## feature listed in it.
QUOTE_RE = re.compile(r'^ {0,3}> ?')
ITEM_RE = re.compile(r'^\s*(?:[-*+]|[0-9]{1,9}[.)])(?:\s|' + chr(36) + ')')
HR_RE = re.compile(r'^ {0,3}(?:(?:-[ \t]*){3,}|(?:[*][ \t]*){3,}|(?:_[ \t]*){3,})' + chr(36))
SETEXT_RE = re.compile(r'^ {0,3}(=+|-+)[ \t]*' + chr(36))
DELIM_RE = re.compile(r'^\s*[|]?\s*:?-+:?\s*(?:[|]\s*:?-+:?\s*)*[|]?\s*' + chr(36))
TEMPLATE_LINE_RE = re.compile(r'^\s*[{]%.*%[}]\s*' + chr(36))
HTML_BLOCK_RE = re.compile(r'^ {0,3}</?(?:table|thead|tbody|tfoot|tr|td|th|caption|ul|ol|li|dl|dt|dd|div|p|details|summary|section|article|aside|header|footer|nav|figure|figcaption|blockquote|h[1-6])(?:[\s/>]|' + chr(36) + ')', re.I)
TAG_RE = re.compile(r'</?[A-Za-z][A-Za-z0-9-]*(?:\s[^<>]*)?/?>')
YAML_LINE_RE = re.compile(r'^(?:\s|#|-\s|[A-Za-z0-9_][A-Za-z0-9_.-]*\s*:(?:\s|' + chr(36) + ')|-?' + chr(36) + ')')
LINK_DEST_RE = re.compile(r'\]\([^)]*\)')
## Text a reader NEVER sees: an HTML comment (working notes -- page_lint
## refuses them outright, but the two gates are separate terms and its rule
## list is a var) and a link reference definition, which renders as nothing at
## all. Counted as prose, either one pads a bare citation over the bar -- the
## same class as a link destination, whose words nobody reads.
COMMENT_RE = re.compile(r'<!--.*?(?:-->|' + chr(36) + ')', re.S)
LINK_DEF_RE = re.compile(r'^\s{0,3}\[[^\]]+\]:\s*\S+')
def visible_text(content):
    ## THE TEXT A READER SEES. Comments and link reference definitions render
    ## as nothing, an HTML tag renders as its CONTENT -- never its attributes
    ## -- and a link DESTINATION shows only when the page prints it bare:
    ## the label is what a reader reads, the URL in parens is not. Citations
    ## read from text a renderer hides -- a tag attribute, a link
    ## destination -- satisfied GAP in both directions at once: counted as a
    ## citation, stripped from the prose.
    if LINK_DEF_RE.match(content):
        return ''
    return LINK_DEST_RE.sub(']', TAG_RE.sub(' ', COMMENT_RE.sub(' ', content)))
def fold(s):
    return ''.join(c for c in unicodedata.normalize('NFD', s) if not unicodedata.combining(c)).lower()
def unquote(text):
    depth, m = 0, QUOTE_RE.match(text)
    while m:
        depth, text = depth + 1, text[m.end():]
        m = QUOTE_RE.match(text)
    return depth, text
def page_blocks(rows):
    ## [{kind, depth, lines: [(no, text, content)], level?, title?}] for ONE
    ## page, in order. content is the line without its quote markers.
    blocks, cur, mode, in_fence, fence_opener, in_comment = [], None, '', False, None, False
    skip_title, in_tag, in_raw = False, False, ''
    ## FRONT MATTER is page metadata no renderer shows: a first line of ---
    ## up to the next --- (or ...), every line between reading as YAML. Read
    ## as markdown, its closing line would underline the keys into a chapter
    ## nobody can anchor. A block that does NOT read as YAML is shown to the
    ## reader, and is read here like the rest of the page.
    start = 0
    if rows and rows[0][1].strip() == '---':
        for j in range(1, len(rows)):
            if rows[j][1].strip() in ('---', '...'):
                if all(YAML_LINE_RE.match(t) for _n, t in rows[1:j]):
                    start = j + 1
                break
    for idx in range(start, len(rows)):
        no, text = rows[idx]
        ## THE OPEN CONSTRUCT WINS, and everything is decided on the
        ## QUOTE-STRIPPED line: a fence inside a blockquote is a fence,
        ## quoted or not. Inside a fence, only a compatible closer matters
        ## and comment markers are literal; inside a comment, only its
        ## closer matters and fence markers are comment text; an HTML tag
        ## opener without its close carries invisible attributes to the
        ## following lines. Outside all of them, the EARLIEST marker on the
        ## line wins, and the visible PART of the line survives: prose
        ## before an opener, the tail after a closer. The declared
        ## anchorless MARKER is exempt from stripping: it is a comment that
        ## carries gate semantics.
        depth, content = unquote(text)
        if in_fence:
            m = FENCE_RE.match(content)
            if m and fence_opener and m.group(1)[0] == fence_opener[0] \
                    and len(m.group(1)) >= fence_opener[1] and not content[m.end():].strip():
                in_fence, fence_opener = False, None
                cur, mode = None, ''
            continue
        if in_tag:
            end = content.find('>')
            if end == -1:
                continue
            content = content[end + 1:]
            in_tag = False
        if in_raw:
            ## The body of a script or style element is DATA for the page's
            ## behaviour, not prose for its reader: hidden whole, like the
            ## element that carries it.
            low = content.lower()
            end = low.find('</' + in_raw)
            if end == -1:
                continue
            content = content[end:]
            in_raw = ''
        if in_comment:
            end = content.find('-->')
            if end == -1:
                continue
            content = content[end + 3:]
            in_comment = False
        ## An HTML TAG OPENER WITHOUT ITS CLOSE ON THE SAME LINE: the
        ## attributes carry to the following lines, and attributes are
        ## invisible -- read raw, one carried citations that satisfied GAP.
        ## Inline CODE SPANS are literal: a backtick-quoted label is not a
        ## tag opener, and reading it as one discarded the rest of the page.
        ## A script or style opener is a RAW-TEXT element: everything up to
        ## its closer is data, and read as prose or citations it documented
        ## a feature the reader never saw.
        masked = []
        i2, n2 = 0, len(content)
        while i2 < n2:
            if content[i2] == chr(96):
                j2 = content.find(chr(96), i2 + 1)
                if j2 == -1:
                    masked.append(' ' * (n2 - i2))
                    i2 = n2
                    continue
                masked.append(' ' * (j2 - i2 + 1))
                i2 = j2 + 1
                continue
            masked.append(content[i2])
            i2 += 1
        masked_line = ''.join(masked)
        raw_open = re.search(r'(?i)<(script|style)\b[^>]*>', masked_line)
        if raw_open:
            name = raw_open.group(1).lower()
            close_at = content.lower().find('</' + name, raw_open.start())
            if close_at == -1:
                content = content[:raw_open.start()]
                in_raw = name
                if not content.strip():
                    continue
            else:
                gt = content.find('>', close_at)
                content = content[:raw_open.start()] + ' ' + content[gt + 1:]
        open_tag = re.search(r'<[A-Za-z/][^>]*$', ''.join(masked))
        if open_tag:
            content = content[:open_tag.start()]
            in_tag = True
            if not content.strip():
                continue
        pos = 0
        while True:
            f = FENCE_RE.match(content[pos:])
            c = content.find('<!--', pos)
            if f is None and c == -1:
                break
            f_at = (pos + f.start()) if f else None
            if c != -1 and (f_at is None or c < f_at):
                end = content.find('-->', c + 4)
                if end == -1:
                    content = content[:c]
                    in_comment = True
                    break
                if content[c:end + 3] != no_anchor:
                    content = content[:c] + ' ' + content[end + 3:]
                    pos = c
                else:
                    pos = end + 3
            else:
                in_fence, fence_opener = True, (f.group(1)[0], len(f.group(1)))
                cur, mode = None, ''
                break
        if in_fence:
            continue
        if re.match(r'^ {0,3}\[[^\]]+\]:\s*$', content):
            ## A definition whose DESTINATION sits on the next line: both
            ## lines render as nothing, and the destination+title line read
            ## alone leaked its citations and its words as prose.
            skip_title = True
            cur, mode = None, ''
            continue
        if LINK_DEF_RE.match(content):
            ## A link reference DEFINITION renders as nothing -- and its
            ## optional TITLE sits on the NEXT line, indented and quoted.
            ## Read alone, that title counted as visible prose and its words
            ## as citations: a hidden definition's continuation, leaking.
            nxt = rows[idx + 1][1].strip() if idx + 1 < len(rows) else ''
            if len(nxt) >= 2 and nxt[0] in (chr(34), chr(39), '(') and nxt[-1] in (chr(34), chr(39), ')'):
                skip_title = True
            cur, mode = None, ''
            continue
        if skip_title:
            skip_title = False
            continue
        if not content.strip() or TEMPLATE_LINE_RE.match(content):
            cur, mode = None, ''
            continue
        if cur is not None and cur['depth'] != depth:
            cur, mode = None, ''
        m = HEADING_RE.match(content)
        if m:
            ## CommonMark strips a CLOSING hash sequence from the title:
            ## '## Exclusions ##' titles the chapter Exclusions, and a title
            ## stored with its hashes matched no declared exclusions token.
            blocks.append({'kind': 'heading', 'depth': depth, 'level': len(m.group(1)),
                           'title': re.sub(r'\s+#+\s*$', '', m.group(2)), 'lines': [(no, text, content)]})
            cur, mode = None, ''
            continue
        m = SETEXT_RE.match(content)
        if m and cur is not None and cur['kind'] == 'para':
            ## An underline turns the paragraph above it into a heading, as
            ## every renderer does -- a chapter written that way is a chapter.
            cur['kind'], cur['level'] = 'heading', (1 if m.group(1)[0] == '=' else 2)
            cur['title'] = ' '.join(c.strip() for _n, _t, c in cur['lines'])
            cur, mode = None, ''
            continue
        if HR_RE.match(content):
            cur, mode = None, ''
            continue
        nxt = unquote(rows[idx + 1][1])[1] if idx + 1 < len(rows) else ''
        if not mode and '|' in content and '|' in nxt and DELIM_RE.match(nxt):
            ## A TABLE is a header row followed by its delimiter row, leading
            ## pipes or not -- lines of pipes with no delimiter render as a
            ## paragraph, and are measured as one.
            mode = 'row'
        elif not mode and HTML_BLOCK_RE.match(content):
            mode = 'html'
        if mode:
            ## A table or an HTML block runs to the next blank line, and each
            ## of its lines is read on its own: a row credits its own cells.
            blocks.append({'kind': mode, 'depth': depth, 'lines': [(no, text, content)]})
            cur = None
            continue
        if ITEM_RE.match(content):
            cur = {'kind': 'item', 'depth': depth, 'lines': [(no, text, content)]}
            blocks.append(cur)
            continue
        if cur is not None:
            cur['lines'].append((no, text, content))
            continue
        cur = {'kind': 'para', 'depth': depth, 'lines': [(no, text, content)]}
        blocks.append(cur)
    return blocks
def block_prose(b):
    ## What a reader READS in the block: its text MINUS its citations and the
    ## markup that renders as no word -- table pipes, HTML tags, link
    ## destinations (a URL spells words nobody reads) -- and the text a reader
    ## never sees at all: an HTML comment, a link reference definition. A row
    ## of citations is an index, and an index documents nothing. Code spans
    ## stay: a page writing an interface label in one has written words, not a
    ## reference. A VISIBLE url stays too -- it is on the page, and the line
    ## drawn here is between what is shown and what is not.
    out = []
    for _no, _text, content in b['lines']:
        s = visible_text(content)
        s = CITE_RE.sub(' ', s) if CITE_RE is not None else s
        if b['kind'] == 'row':
            s = s.replace('|', ' ')
        out.append(s)
    return ' '.join(COMMENT_RE.sub(' ', ' '.join(out)).split())
def significant(text):
    ## The words a reader would recognise. Short ones carry no evidence that
    ## anything was written; folding makes the comparison accent-blind.
    return set(w for w in WORD_RE.findall(fold(text)) if len(w) >= 4)
def written(prose, share=1):
    ## (prose, words) when the block is WRITING for share subjects, ('',
    ## empty) otherwise. Length alone is not writing: dots reach any length,
    ## and a declared substitute is a label on silence.
    if PLACEHOLDER_RE is not None and PLACEHOLDER_RE.search(prose):
        return '', set()
    words = significant(prose)
    if len(prose) < min_prose * share or word_count(prose) < min_words * share:
        return '', set()
    return prose, words
def opens_exclusions(title):
    ## The WHOLE title, anchored -- the way page_lint matches its own chrome
    ## headings. Matched as a SUBSTRING, an insurance product chapter called
    ## 'Les exclusions de garantie' opened the chapter of documented holes.
    if not excl_token:
        return False
    plain = title.replace(no_anchor, '') if no_anchor else title
    plain = re.sub(r'[*_' + BT + r']', '', plain).strip().rstrip(':').strip()
    return fold(plain) == fold(excl_token)
## The documentation. Absent or empty: a NAMED refusal, never a vacuous green.
files = sorted(p for p in glob.glob(os.path.join(product_dir, '**', '*.md'), recursive=True) if os.path.isfile(p)) if product_dir else []
if not product_dir:
    refuse('NET_UNREADABLE', '<product_dir>', 'no product directory was resolved, so no published page could be read -- refusing to certify coverage', True)
elif not files:
    refuse('NET_UNREADABLE', product_dir, 'NO markdown file -- the functional documentation does not exist: a refusal, not a vacuous pass')
## PRE-FLIGHT REFUSAL. A cause whose repair lands OUTSIDE the writeable set
## is not a term of convergence: scope_check lets this run write
## <product_dir>/**/*.md and nothing else, so an order to repair the net, a
## launch var or the catalog is an order the campaign is forbidden to obey.
## Left as a gate term it makes two deterministic gates contradict each other
## and the run burns every pass. The run stops HERE instead, naming every such
## cause, and the operator repairs the net where the net lives.
blocking = [c for c in causes if c.get('outside')]
if blocking:
    shown = [c['cause'] + ' -- ' + c['where'] + ': ' + c['detail'] for c in blocking[:40]]
    raise SystemExit('product-docs: the non-regression net cannot be judged, and its repair lies OUTSIDE the writeable set of this run (' + (product_dir or '<product_dir>') + '/**/*.md). That is a PRE-FLIGHT failure, never a convergence term -- the campaign would be ordered to fix what it is forbidden to touch. ' + str(len(blocking)) + ' cause(s):' + chr(10) + chr(10).join('- ' + line for line in shown))
pages = []
for path in files:
    try:
        with open(path, encoding='utf-8', errors='replace') as fh:
            pages.append((path, list(enumerate(fh.read().splitlines(), 1))))
    except OSError as exc:
        refuse('NET_UNREADABLE', path, 'page unreadable -- ' + ' '.join(str(exc).split())[:200])
## ONE pass over the blocks in file order, so the chapter a citation sits
## under is a fact of structure and not an opinion. Headings of EVERY level
## open the exclusions chapter (a one-chapter-per-file model puts it at level
## 1); the anchor rule below judges levels >= 2 only -- a file's title is
## judged by its body. A heading inside a quote is part of the quote, not a
## chapter of the document.
headings = []
marked = []
anchors_by_line = {}
blocks = []
for where, rows in pages:
    ## Fence state and CHAPTER state are both PER PAGE. An unclosed fence
    ## at the end of one page would otherwise blind the gate to every page
    ## after it -- and a page ending inside the exclusions chapter would
    ## mark the NEXT page's lines as being under it, which is the exact
    ## false green this gate exists to refuse: an exclusion id cited with
    ## enough prose in an unrelated page would satisfy the rule.
    in_exc, exc_level = False, None
    for b in page_blocks(rows):
        b['where'] = where
        chapter = b['kind'] == 'heading' and b['depth'] == 0
        excl_heading = chapter and opens_exclusions(b['title'])
        if excl_heading:
            ## Already inside the chapter, a DEEPER heading repeating the
            ## token must not re-anchor it at its own level: a sibling of
            ## that sub-heading would then close the whole chapter early,
            ## and every exclusion named after it would read as concealed.
            ## The SHALLOWEST level wins.
            exc_level = b['level'] if exc_level is None else min(exc_level, b['level'])
            in_exc = True
        elif chapter and exc_level is not None and b['level'] <= exc_level:
            in_exc, exc_level = False, None
        b['under_exclusions'] = in_exc
        b['names'], b['pairs'] = set(), set()
        anchored = False
        for no, text, content in b['lines']:
            ents, ids, paths, unknown = [], [], [], []
            ## THE SAME TEXT PROSE IS MEASURED ON. Invisible text is not read,
            ## in EITHER direction: a citation inside an HTML comment or a link
            ## reference definition renders as nothing, so it anchors no
            ## chapter and documents no feature -- and it is not verified
            ## either, because a reference nobody can read claims nothing. Read
            ## from the raw line, it let text no reader ever sees satisfy the
            ## two rules that ask a page to say something.
            visible = visible_text(content)
            ## EVERY citation, and ONLY the citations. A token is a path when
            ## it leads with a slash, an entry when the corpus holds it, an
            ## inventory id when the inventory does -- and an INVENTED
            ## reference otherwise, wherever it sits and whatever else the
            ## line carries. A code span is prose and is never read here.
            for tok in (CITE_RE.findall(visible) if CITE_RE is not None else []):
                tok = tok.strip()
                if not tok:
                    refuse('PHANTOM_DOC', where + ':' + str(no), 'an EMPTY citation ' + cite_open + cite_close + ' names nothing -- cite a corpus entry id, an inventory feature id or a path, or write prose')
                    continue
                if tok.startswith('/'):
                    paths.append(tok)
                else:
                    ## THE TWO ID SPACES ARE INDEPENDENT MEMBERSHIPS. An id
                    ## the corpus and the inventory both declare is both
                    ## things at once; reading the corpus hit as THE answer
                    ## left ids empty, no pair could form, and a collision
                    ## made convergence impossible whatever the page wrote.
                    ## The net holds neither? WHICH of the two it was meant
                    ## to be is not guessed -- guessing from a token shape is
                    ## the habit this node got rid of. The repair is the same
                    ## either way: cite something the net holds, or write
                    ## prose.
                    if tok in corpus_ids:
                        ents.append(tok)
                    if tok in inventory_names:
                        ids.append(tok)
                    if tok not in corpus_ids and tok not in inventory_names:
                        unknown.append(tok)
            anchors_by_line[(where, no)] = (ents, ids, paths, unknown, text)
            anchored = anchored or bool(ents or ids or paths)
            b['names'].update(ids)
            ## The PAIR the gap rule reads: ONE line citing a covered feature
            ## together with one of its own entries.
            for name in ids:
                if entry_lists.get(name, set()) & set(ents):
                    b['pairs'].add(name)
        if chapter and b['level'] > 1:
            headings.append((where, b['lines'][0][0], b['level'], b['title'], excl_heading, anchored))
        blocks.append(b)
## STRUCTURAL RULE -- every chapter carries an anchor, or DECLARES that it
## carries none. A chapter that can name no reference it restitutes describes
## a screen nobody captured: the general clause of the phantom refusal. The
## declared marker is the written exception, and the gate PRINTS the chapters
## that carry it -- hiding a whole chapter behind it only denounces itself.
## The chapter that OPENS the declared exclusions chapter is anchored by its
## ROLE: the gate knows what it is, and its body is judged by the exclusions
## rule. Requiring a marker there would force every product to spend one of
## its anchorless declarations on a chapter the gate itself named.
judged = [h for h in headings if not h[4]]
for where, no, level, title, _x, _a in judged:
    if no_anchor and no_anchor in title:
        marked.append({'page': where, 'line': no, 'title': title.replace(no_anchor, '').strip()})
## THE COUNT IS KNOWN BEFORE THE FIRST REFUSAL IS WRITTEN, because a refusal
## that offers a remedy the ceiling then denies makes the two causes ping-pong
## until max_passes: the campaign marks the chapter, the ceiling refuses the
## mark, the anchor rule offers the mark again. With no headroom the refusal
## asks for an ANCHOR and says the hatch is full -- and it never asks for a
## bigger ceiling, which is an operator decision outside the writeable set.
headroom = max_anchorless - len(marked)
for where, no, level, title, _x, anchored in judged:
    if no_anchor and no_anchor in title:
        continue
    ## A chapter is anchored by a reference that EXISTS (or by a path, which
    ## is a citation by syntax) -- never by a token that merely resembles
    ## one, which would let a chapter fake its own anchor. The answer is the
    ## one the single pass already computed for this heading: a second copy
    ## of the test is how the two come to disagree.
    if not anchored:
        remedy = (' or declare it restitutes none with ' + no_anchor + ' (' + str(headroom) + ' such declaration(s) left of ' + str(max_anchorless) + ')') if (no_anchor and headroom > 0) else (' -- the anchorless declarations are ALL SPENT (' + str(len(marked)) + ' of ' + str(max_anchorless) + '), so this chapter must carry a reference')
        refuse('UNANCHORED_CHAPTER', where + ':' + str(no), 'the chapter ' + title + ' names NO reference it restitutes -- cite a corpus entry, an inventory id or a path IN THE HEADING LINE ITSELF (a citation in the chapter body does NOT anchor it)' + remedy)
## THE ESCAPE HATCH HAS A CEILING. Above it, the declarations are themselves
## the refusal, and each marked chapter is printed whether the run is red or
## green. The repair named is ANCHORING: raising the ceiling is an operator
## decision, and ordering the campaign to make one would order it outside the
## writeable set scope_check enforces.
if len(marked) > max_anchorless:
    refuse('UNANCHORED_CHAPTER', product_dir or '<product_dir>', str(len(marked)) + ' chapter(s) DECLARE they restitute no reference and at most ' + str(max_anchorless) + ' may -- anchor the surplus on a corpus entry, an inventory id or a path: ' + ', '.join(m['page'] + ':' + str(m['line']) + ' ' + m['title'] for m in marked[:20]))
## PHANTOM_DOC -- every cited anchor must exist, in the corpus, in the
## inventory or in the declarations; never in the writer's memory.
cited_entries, cited_paths = set(), set()
for (where, no), (ents, ids, paths, unknown, text) in sorted(anchors_by_line.items()):
    cited_entries.update(ents)
    for tok in unknown:
        refuse('PHANTOM_DOC', where + ':' + str(no), 'the reference ' + tok + ' is CITED and the net holds NOTHING by that name -- it is neither one of the ' + str(len(corpus_ids)) + ' corpus entry ids, nor an inventory feature id (covered or excluded), nor a path (those start with a slash). A documented screen without a reference is an invented screen; if this was not meant as a reference, write it as prose -- only ' + cite_open + '...' + cite_close + ' cites')
    for path in paths:
        cited_paths.add(path)
        try:
            parts = urlsplit(path)
        except ValueError as exc:
            ## A MALFORMED citation is a documentation-side error, and the
            ## gate answers errors by NAME: left to raise, //[-broken]]-shaped
            ## citations aborted coverage_check instead of refusing the page.
            refuse('PHANTOM_DOC', where + ':' + str(no), 'the cited path ' + path + ' does not '
                   'parse as a URL (' + str(exc) + ') -- a citation the gate cannot read '
                   'documents nothing; cite a path the net actually observed')
            continue
        hits = corpus_matches(parts.path)
        ## The catch-all rule cuts BOTH ways. A cited path is read as a
        ## pattern, so a lone placeholder path matches every corpus entry
        ## and would pass while restituting nothing -- the same hole the
        ## declared-route side closes, on the side the graded agent writes.
        if segments(parts.path) and not has_literal(parts.path):
            refuse('PHANTOM_DOC', where + ':' + str(no), 'the cited path ' + path + ' is made of PLACEHOLDERS ONLY -- like a framework catch-all it matches every path and restitutes none; cite a path the net actually observed')
        elif '**' in segments(parts.path):
            ## A cited path is read as a PATTERN, and ** swallows the whole
            ## tail: /dashboard/** carries one literal segment, so it passes
            ## the placeholders-only rule while claiming every screen below
            ## it. A documentation cites the screens it documents.
            refuse('PHANTOM_DOC', where + ':' + str(no), 'the cited path ' + path + ' carries a TAIL WILDCARD -- it claims every path below it and restitutes none of them; cite the paths the documentation actually describes')
        elif any(route_proves(r) and aligned(r, parts.path) for r in declared):
            pass
        elif hits:
            pass
        elif routes_degraded:
            refuse('PHANTOM_DOC', where + ':' + str(no), 'the path ' + path + ' matches NO corpus entry path, and no declared route table was available to widen the check (degraded) -- a documented screen the net never observed')
        elif any(route_proves(r) and pattern_matches(r, parts.path) for r in declared):
            fits = sorted((r for r in declared if route_proves(r) and pattern_matches(r, parts.path)), key=lambda r: (specificity(r), r))
            refuse('PHANTOM_DOC', where + ':' + str(no), 'the path ' + path + ' fits the declared route ' + fits[0] + ' only through a placeholder, with a value the net never observed -- an invented instance is an invented screen; cite the route itself, ' + cite_open + fits[0] + cite_close + ', or a path the net captured')
        else:
            refuse('PHANTOM_DOC', where + ':' + str(no), 'the path ' + path + ' is NEITHER a declared route NOR a corpus entry path -- a documented screen the application does not serve')
        observed = set()
        for c in hits:
            observed |= entry_paths.get(c, set())
        for k, _v in parse_qsl(parts.query, keep_blank_values=True):
            if k not in observed:
                refuse('PHANTOM_DOC', where + ':' + str(no), 'the parameter ' + k + ' of ' + path + ' is observed on NO corpus entry of that path -- a documented filter the net does not exercise')
## THE OTHER DIRECTION: the declared routes must be CITED. The loop above
## validates citations against the route table; nothing yet required the
## table's own routes to appear in the documentation -- a declared route
## cited by no page is a served screen no document describes, and the gate
## would stay green over the hole. It runs ONCE, after every anchor line has
## been read: a route first cited on page 12 must not be refused while the
## gate is still reading page 3. A citation is matched WITHOUT its query
## and fragment: cited_paths carries the raw token -- '/items?status=open'
## -- the gate verifies cited parameters separately, and pattern_matches
## compares segments literally -- a route whose only citation carries a
## query would be refused for a screen the documentation already
## describes. partition, never urlsplit: refuse only accumulates, so
## malformed tokens already refused upstream stay in the set and
## urlsplit could raise on them.
## A page documents the screen a route serves by citing its PATH, or by
## citing a corpus ENTRY that exercises it -- the entry carries the path
## of the screen it captured. Each citation is credited to the MOST
## SPECIFIC declared route it instantiates, the one a router serves it
## from: /dashboard/items/new is the create screen, never the detail
## /dashboard/items/{id} its path also fits. And, as for a feature, a
## heading documents nothing and CO-PRESENCE IS NOT DOCUMENTATION: a route
## is credited by a paragraph, list item or table row that writes about
## it -- min_prose characters and min_words words of its own prose for
## each route the block credits. A row of route citations is an index.
proving = [r for r in declared if route_proves(r)]
def credited_routes(target):
    hits = [r for r in proving if pattern_matches(r, target)]
    if not hits:
        return set()
    best = min(specificity(r) for r in hits)
    return set(r for r in hits if specificity(r) == best)
## THE SHARES A BLOCK OWES: one per feature it pairs (the routes its
## entries reach ride that prose), and HALF of one per route it credits
## otherwise -- cited by its path, or reached through an entry cited without
## its feature. One rule for both channels: the same prose documents the same
## routes whichever citation it uses. Half a share refuses an index of routes
## and stays within what a real page describing a screen and its actions
## writes per route. Two routes of one shape (/x/{id} and /x/{itemId}) are one
## screen. And ONE PROSE CREDITS ONCE: the same sentence copied under several
## blocks -- digits aside -- describes none of them, the rule the exclusions
## obey.
documented_routes, mentioned_routes = set(), set()
attempts = {}
claimed_prose = {}
for b in blocks:
    by_entry, by_path, paired = set(), set(), set()
    for no, _text, _content in b['lines']:
        ents, _ids, paths, _unknown, _t = anchors_by_line.get((b['where'], no), ([], [], [], [], ''))
        for path in paths:
            target = path.partition('?')[0].partition('#')[0]
            if grounded_path(target):
                by_path |= credited_routes(target)
        for e in ents:
            if e not in entry_path_by_id:
                continue
            reached = credited_routes(entry_path_by_id[e])
            by_entry |= reached
            if any(e in entry_lists.get(name, set()) for name in b['pairs']):
                paired |= reached
    by_path -= by_entry
    cited = by_entry | by_path
    mentioned_routes |= cited
    if not cited:
        continue
    where = b['where'] + ':' + str(b['lines'][0][0])
    if b['kind'] == 'heading':
        for r in cited:
            attempts.setdefault(r, ('heading', where))
        continue
    prose = block_prose(b)
    loose = set(shape(r) for r in (by_entry - paired) | by_path)
    need = max(1, len(b['pairs']) + (len(loose) + 1) // 2)
    key = re.sub('[0-9]+', '', fold(prose)).strip()
    copy_of = claimed_prose.get(key) if key else None
    if copy_of is None and written(prose, need)[0]:
        if key:
            claimed_prose[key] = where
        documented_routes |= cited
        continue
    for r in cited:
        if copy_of is not None:
            attempts[r] = ('copy', where, copy_of)
        elif attempts.get(r, ('',))[0] != 'short' or len(prose) / need > attempts[r][3] / attempts[r][5]:
            attempts[r] = ('short', where, {'para': 'paragraph', 'item': 'list item', 'row': 'table row', 'html': 'HTML line'}.get(b['kind'], 'block'), len(prose), word_count(prose), need)
for route in proving:
    if route in documented_routes:
        continue
    tag = cite_open + route + cite_close
    seen = attempts.get(route)
    if seen and seen[0] == 'short':
        refuse('ROUTE_UNDOCUMENTED', route, 'the declared route ' + route + ' is cited at ' + seen[1] + ', but that ' + seen[2] + ' owes ' + str(seen[5]) + ' share(s) of prose and writes ' + str(seen[3]) + ' characters and ' + str(seen[4]) + ' recognisable words -- each share is ' + str(min_prose) + ' characters and ' + str(min_words) + ' words: one per feature it pairs, and half of one per route it cites by path or reaches through an entry cited without its feature. A list of routes is an index, not a screen described: describe the screen or action it serves there, or in a block of its own that cites ' + tag + '.')
    elif seen and seen[0] == 'copy':
        refuse('ROUTE_UNDOCUMENTED', route, 'the declared route ' + route + ' is cited at ' + seen[1] + ' in a block whose prose is the same as ' + seen[2] + ' -- one prose describes one thing, and a sentence copied under several routes describes none of them. Describe the screen or action it serves in words of its own, in the block that cites ' + tag + '.')
    elif seen:
        refuse('ROUTE_UNDOCUMENTED', route, 'the declared route ' + route + ' is cited only in a heading (' + seen[1] + ') -- a title labels a chapter and documents nothing. Cite ' + tag + ' in the paragraph, list item or table row that describes the screen or action it serves.')
    else:
        refuse('ROUTE_UNDOCUMENTED', route, 'the declared route ' + route
               + ' is cited by NO page of the documentation, neither by its'
               ' path nor by a corpus entry that exercises it -- a route the'
               ' application serves that no screen describes. Describe the'
               ' screen or action it serves in a paragraph, list item or table'
               ' row that cites ' + tag + '.')
## GAP -- every covered feature is DOCUMENTED by one block: a paragraph, a
## list item or a table row with ONE line citing its id AND one of its own
## inventory entries -- the documented screen is anchored on the reference
## that exercises it -- and prose a reader reads. The loop runs over EVERY
## feature, unguarded: emptying the documentation of one feature or of all
## reddens the same way.
##
## CO-PRESENCE IS NOT DOCUMENTATION, and a neighbour's prose is not either.
## Two citations on a line are an index row; a block's text is credited to
## that block only, never to the rows or items around it; and a block that
## documents several features SHARES its prose between them -- each needs
## its own min_prose characters and min_words words. Credited whole to each,
## a paragraph of soft-wrapped index lines would document every feature it
## lists with one sentence's worth of words, no table syntax needed.
## A HEADING DOCUMENTS NOTHING: it labels and anchors a chapter, and its
## body is where a feature is described.
undocumented = []
for name in feature_names:
    own = entry_lists.get(name, set())
    cands = [b for b in blocks if name in b['pairs']]
    body = [b for b in cands if b['kind'] != 'heading']
    if any(written(block_prose(b), len(b['pairs']))[0] for b in body):
        continue
    undocumented.append(name)
    if body:
        best = max(body, key=lambda b: len(block_prose(b)) / len(b['pairs']))
        prose = block_prose(best)
        refuse('GAP', name, 'the covered feature is CITED but not documented: at ' + best['where'] + ':' + str(best['lines'][0][0]) + ' the ' + {'para': 'paragraph', 'item': 'list item', 'row': 'table row', 'html': 'HTML line'}[best['kind']] + ' citing it with one of its entries (' + ', '.join(sorted(own)) + ') documents ' + str(len(best['pairs'])) + ' feature(s) with ' + str(len(prose)) + ' characters and ' + str(word_count(prose)) + ' recognisable words of prose outside the citations -- a row in an index, not a screen a functional reader can understand. Each feature a block documents needs ' + str(min_prose) + ' characters and ' + str(min_words) + ' words of its own; the block is the paragraph, list item or table row that carries the citation, never its neighbours')
    elif cands:
        refuse('GAP', name, 'the covered feature is cited with one of its entries ONLY IN A HEADING -- a title labels a chapter and documents nothing: cite ' + cite_open + name + cite_close + ' with ' + ' or '.join(cite_open + e + cite_close for e in sorted(own)) + ' in the paragraph, list item or table row that describes it')
    else:
        refuse('GAP', name, 'the covered feature is ABSENT from the documentation: no line CITES ' + cite_open + name + cite_close + ' together with one of its entries (' + ', '.join(cite_open + e + cite_close for e in sorted(own)) + ') -- a served, inventoried screen the functional reader will not find')
## CONCEALED_EXCLUSION -- every exclusion is cited UNDER a chapter that says
## exclusions, in a block with PROSE: a bare id is not writing, and a
## placeholder is not either. The block is the one the gap rule reads -- a
## paragraph wrapped over two lines says its reason once, across both. The
## full reason stays in the net; the page carries it for its reader, and the
## gate refuses silence and substitutes alike.
hidden = []
claimed = {}
for name in sorted(exclusion_reasons):
    reason_words = significant(exclusion_reasons.get(name) or '')
    ## THE PAGE MUST SAY WHAT THE NET SAYS. Length is an orthography anyone
    ## can reach -- one generic sentence copied under every id cleared the
    ## bar. The net already carries the reason, so the page prose has to
    ## OVERLAP it: two of its recognisable words, or the one it has.
    need = min(2, len(reason_words))
    ok = ''
    for b in blocks:
        if b['kind'] == 'heading' or not b['under_exclusions'] or name not in b['names']:
            continue
        prose, words = written(block_prose(b))
        if not prose:
            continue
        if need and len(words & reason_words) < need:
            continue
        ## PREFER A BLOCK NOBODY HAS CLAIMED. Breaking on the FIRST qualifying
        ## one made a shared summary -- one sentence naming two holes,
        ## legitimately -- claim the first exclusion and leave the second
        ## unfixable: its own dedicated paragraph further down was never
        ## looked at, and the refusal asked for prose it had already written.
        cand = ' '.join(fold(prose).split())
        if not ok:
            ok = cand
        if cand not in claimed:
            ok = cand
            break
    if not ok:
        hidden.append(name)
        refuse('CONCEALED_EXCLUSION', name, 'the exclusion is nowhere named AS an exclusion in the documentation (its id cited under a chapter titled exactly ' + (excl_token or '<coverage_exclusions_heading>') + ', in a paragraph, list item or table row whose prose of its own says what the net says) -- a documentation that hides a hole lies about the application; the net records the reason: ' + (exclusion_reasons.get(name) or '')[:120])
        continue
    ## ONE PROSE, ONE EXCLUSION. The same block satisfying two holes -- one
    ## paragraph naming both, or one sentence copied under each -- describes
    ## neither: it is a template, and a template is silence with more
    ## characters.
    if ok in claimed:
        hidden.append(name)
        refuse('CONCEALED_EXCLUSION', name, 'the exclusion is named with the SAME prose as ' + claimed[ok] + ' -- one paragraph cannot say why two different holes exist; give this one a paragraph or list item of its own that says what the net records: ' + (exclusion_reasons.get(name) or '')[:120])
        continue
    claimed[ok] = name
documented = len(feature_names) - len(undocumented)
named = len(exclusion_reasons) - len(hidden)
count_line = ('COVERAGE GATE: ' + str(documented) + '/' + str(len(feature_names)) + ' features documented, ' + str(named) + '/' + str(len(exclusion_reasons)) + ' exclusions named, ' + str(len(cited_entries)) + ' corpus entries cited, ' + str(len(cited_paths)) + ' paths cited, ' + str(len(headings)) + ' chapters of which ' + str(len(marked)) + ' declared anchorless (ceiling ' + str(max_anchorless) + '); net at ' + oracle + ' holds ' + str(len(feature_names)) + ' features + ' + str(len(exclusion_reasons)) + ' exclusions, ' + str(len(corpus_ids)) + ' corpus entries, ' + str(len(declared)) + ' declared routes')
notes = [count_line]
if net_unproven:
    ## OPERATOR-SIDE, SAID SO. These notes ride log, and gate.fail_log relays
    ## log to the next pass whenever the gate is red: an imperative here reads
    ## as a repair order to a campaign that may write <product_dir>/**/*.md and
    ## nothing else. Following it would redden scope_check instead -- the very
    ## loop the pre-flight rule exists to prevent.
    notes.append('COVERAGE GATE: DEGRADED -- the net at ' + oracle + ' carries NO trace of its own gate (neither verify-oracle.sh nor REPORT.md). This gate reads the inventory and the corpus as given; nothing here proves a harness ever scored them. OPERATOR-SIDE ONLY, never a repair for this run: the rite emissions live with the net, outside ' + (product_dir or '<product_dir>') + '/**/*.md, and a verdict stamped with the commit it judged would be better still.')
if routes_degraded:
    notes.append('COVERAGE GATE: DEGRADED -- no declared route table: ' + (route_note or 'none could be read') + '. A cited path is therefore checked against the CORPUS ONLY: a route the corpus never touches cannot be recognised and is refused. OPERATOR-SIDE ONLY, never a repair for this run: the route table lives with the net, outside ' + (product_dir or '<product_dir>') + '/**/*.md.')
elif route_from_probe:
    notes.append('COVERAGE GATE: route table -- ' + str(len(declared)) + ' route(s) replayed from the net routes_probe at the run base' + ((' -- ' + route_note) if route_note else ''))
## The log is capped and relayed to the next pass: a long run of route
## refusals must not push a feature gap out of sight.
causes.sort(key=lambda c: c.get('cause') == 'ROUTE_UNDOCUMENTED')
for m in marked:
    notes.append('COVERAGE GATE: chapter declared anchorless -- ' + m['page'] + ':' + str(m['line']) + ' ' + m['title'])
for c in causes[:60]:
    notes.append('COVERAGE GATE: ' + c['cause'] + ' -- ' + c['where'] + ': ' + c['detail'])
if len(causes) > 60:
    notes.append('COVERAGE GATE: ... and ' + str(len(causes) - 60) + ' more')
if causes:
    notes.append('COVERAGE GATE: RED -- ' + str(len(causes)) + ' named cause(s); each one above says what is missing and where. Fix exactly those, then re-check.')
else:
    notes.append('COVERAGE GATE: GREEN -- every documented screen rests on a reference that exists, every inventoried feature is documented, every exclusion is named.')
print(json.dumps({'coverage_ok': not causes, 'net_present': True, 'causes': causes[:200], 'cause_count': len(causes), 'features_total': len(feature_names), 'features_documented': documented, 'exclusions_total': len(exclusion_reasons), 'exclusions_named': named, 'entries_cited': len(cited_entries), 'paths_cited': len(cited_paths), 'chapters': len(headings), 'chapters_unanchored_declared': len(marked), 'chapters_anchorless_max': max_anchorless, 'routes_declared': len(declared), 'routes_degraded': routes_degraded, 'net_unproven': net_unproven, 'oracle_dir_used': oracle, 'counts_line': count_line, 'log': chr(10).join(notes)}, ensure_ascii=False))
"`
  input: coverage_input
  output: coverage_output

## forge_auth_probe — DETERMINISTIC pre-flight for the push.
## finalize_mr is an LLM agent; entering it with NO push credential
## mounted burns a whole turn just to rediscover, in shell, that it
## cannot push. Read-only, idempotent.
tool forge_auth_probe:
  command: `python3 -I -c "
import os, subprocess, json
tok = '/run/iterion/secrets/forge_token'
try:
    if os.path.isfile(tok) and os.path.getsize(tok) > 0:
        print(json.dumps({'available': True, 'reason': 'file:' + tok})); raise SystemExit(0)
except OSError:
    pass
for v in ('GH_TOKEN', 'GITHUB_TOKEN', 'GITLAB_TOKEN', 'FORGEJO_TOKEN', 'GITEA_TOKEN'):
    if os.environ.get(v):
        print(json.dumps({'available': True, 'reason': 'env:' + v})); raise SystemExit(0)
try:
    r = subprocess.run(['gh', 'auth', 'status'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
    if r.returncode == 0:
        print(json.dumps({'available': True, 'reason': 'gh host auth'})); raise SystemExit(0)
except (OSError, subprocess.SubprocessError):
    pass
print(json.dumps({'available': False, 'reason': 'no forge_token secret, no *_TOKEN env, no gh host auth'}))
"`
  output: forge_auth_state

## surface_pr_link — DETERMINISTIC result-link emitter for the studio
## run summary. The studio surfaces a run's headline PR link from the
## `[iterion] preview_url=… kind=pr` directive a tool node prints on
## stdout — never from agent prose. Read-only, idempotent.
tool surface_pr_link:
  command: `URL={{input.url}} python3 -I -c "
import os
u = (os.environ.get('URL') or '').strip()
if u:
    print('[iterion] preview_url=' + u + ' kind=pr scope=external')
"`
  input: surface_pr_link_input

## ─── Nodes : publication tail (opt-in) ──────────────────────────

## publish_gate — DETERMINISTIC pre-flight for the publish tail.
## publish is an LLM agent; entering it with no opt-in, no base URL,
## no image repository, no credential or no platform playbook burns a
## turn to rediscover in shell what a 20-line probe already knows —
## and the playbook case is worse than a wasted turn, since the agent
## holds a registry token and a deploy credential while it improvises.
## Read-only, idempotent.
tool publish_gate:
  ## Secret paths come from the TEMPLATE ({{secrets.X.path}}), which the
  ## engine resolves for sandboxed AND host runs alike — a hardcoded
  ## mount path only exists under the sandbox bind-mount and silently
  ## disabled publishing everywhere else.
  command: `PUB={{vars.publish}} BASE={{vars.publish_base_url}} IMAGE={{vars.publish_image}} CRED={{secrets.deploy_credential.path}} REG={{secrets.registry_token.path}} WS={{vars.workspace_dir}} python3 -I -c "
import os, json
pub = (os.environ.get('PUB') or '').strip().lower() in ('1', 'true', 'yes')
base = (os.environ.get('BASE') or '').strip()
image = (os.environ.get('IMAGE') or '').strip()
paths = {'deploy_credential': os.environ.get('CRED') or '', 'registry_token': os.environ.get('REG') or ''}
missing = [n for n, p in paths.items() if not (p and os.path.isfile(p))]
## The PLATFORM playbook is a soft reference on both ends -- the compiler
## only warns on a malformed skill NAME, and the runtime skips one it
## cannot resolve with a log line -- so an unattached deploy-target
## reaches the publish agent as nothing louder than a start-up warning,
## and the agent improvises a deployment holding a registry-write token
## and a cluster credential. Probe its ABSENCE here, which is the only
## half that is conclusive: presence is not provenance (a file checked
## into the docs repo shadows a rejected contribution), so this clears a
## necessary condition and certifies nothing. publish_system carries the
## STOP clause that covers the rest.
## Both mirror shapes: <name>/SKILL.md (skill library) and the flat
## <name>.md (plugin contribution). Both candidate roots too: tool nodes
## run in the run workDir, which is also where the engine mirrors, and
## vars.workspace_dir names the same tree -- either answering is enough.
roots = [r for r in (os.getcwd(), (os.environ.get('WS') or '').strip()) if r]
shapes = [('deploy-target', 'SKILL.md'), ('deploy-target.md',)]
skill = any(os.path.isfile(os.path.join(r, '.claude', 'skills', *s)) for r in roots for s in shapes)
ok = pub and bool(base) and bool(image) and not missing and skill
if not pub:
    reason = 'publish disabled (vars.publish=false)'
elif not base:
    reason = 'publish_base_url is empty'
elif not image:
    reason = 'publish_image is empty -- name the image repository the site is pushed to, there is no default'
elif missing:
    reason = 'missing credentials: ' + ', '.join(missing)
elif not skill:
    reason = 'no deploy-target skill attached -- the platform playbook must reach the workspace as a plugin or skill-library skill named deploy-target; without it the publish agent has no platform to deploy to'
else:
    reason = 'ready'
print(json.dumps({'do_publish': ok, 'reason': reason}))
"`
  output: publish_gate_output

## verify_publish — DETERMINISTIC truth gate on the live URL. The
## agent's own verification is necessary but not sufficient: this
## node re-checks from outside the agent's narrative and FAILS the
## run when the site is not actually serving. Polls ≤ 2 min: the
## deploy-target skill already waits for its own rollout and validates
## the URL before returning, so this is a RE-measurement from outside,
## not the first wait — the window covers the tail of an ingress/DNS
## propagation, not a cold deploy.
tool verify_publish:
  command: `URL={{input.url}} BASE={{input.base_url}} DEPLOYED={{input.deployed}} SUMMARY={{input.summary}} python3 -I -c "
import json, os, time, urllib.request
u = (os.environ.get('URL') or '').strip()
base = (os.environ.get('BASE') or '').strip().rstrip('/')
dep = (os.environ.get('DEPLOYED') or '').strip().lower() in ('1', 'true', 'yes')
## One line, bounded: the agent's verdict travels into this node's
## detail, the run events and the report.
note = ' '.join((os.environ.get('SUMMARY') or '').split())[:400]
if not u:
    ## An empty url is the shape of EVERY honest refusal the publish
    ## agent is instructed to make -- no playbook, a rejected
    ## credential, an image the cluster cannot pull, a host outside the
    ## base URL. Calling that 'returned no URL' discards the remedy the
    ## agent just worked out and sends the operator looking at the wrong
    ## thing. The run still FAILS -- publish was asked for and did not
    ## happen -- but it fails saying why.
    why = 'publish reported deployed=' + ('true' if dep else 'false') + ' with no URL'
    if note:
        why = why + ' -- ' + note
    print(json.dumps({'verified': False, 'url': '', 'detail': why}))
    raise SystemExit(1)
if not u.endswith('/'):
    u = u + '/'
## anchored() is the LANDING check, deliberately looser than the one
## below: the redirect an ingress legitimately performs is an http ->
## https upgrade, so scheme is ignored there and only the operator's
## host+path anchors. A lookalike suffix domain still cannot satisfy it
## -- the trailing / is required.
def anchored(candidate):
    c = (candidate or '').split('://', 1)[-1]
    b = base.split('://', 1)[-1]
    return bool(b) and (c == b or c.startswith(b + '/'))
## The truth gate verifies THE OPERATOR'S deployment, not whatever URL
## the agent narrated: any live page would answer 200 with a title.
## The url the agent RETURNS is held to the anchor exactly, scheme
## included -- it is a claim, not a redirect.
if not base or not u.startswith(base + '/'):
    print(json.dumps({'verified': False, 'url': u, 'detail': 'returned url is not under publish_base_url (' + (base or '<empty>') + ')'}))
    raise SystemExit(1)
code, body, final = 0, '', ''
for i in range(12):
    try:
        r = urllib.request.urlopen(u, timeout=10)
        code = r.getcode()
        ## urlopen follows redirects SILENTLY, so the checked-above url
        ## proves nothing about what answered. An ingress fronting an SSO
        ## login, a platform error page or an unrelated host is exactly
        ## the shape a 302 takes -- re-anchor on where we LANDED.
        final = r.geturl() or u
        body = r.read(65536).decode('utf-8', 'replace')
    except Exception:
        code, body, final = 0, '', ''
    ## A served page ENDS the poll, right or wrong. The retry window is
    ## for a rollout that has not answered yet; re-asking the same url
    ## cannot change WHO answered it, so keeping an off-base redirect in
    ## the loop only spends two minutes to reach the same verdict.
    if code == 200 and '<title>' in body:
        break
    time.sleep(10)
## Name WHICH half failed: 'http 200 after 12 tries' reads as a
## contradiction, and an operator debugging an ingress that answers but
## serves the wrong body needs to know it answered.
if code != 200:
    print(json.dumps({'verified': False, 'url': u, 'detail': 'http ' + str(code) + ' after 12 tries'}))
    raise SystemExit(1)
if '<title>' not in body:
    print(json.dumps({'verified': False, 'url': u, 'detail': 'http 200 but the body carries no <title> -- something answers here, it is not the built site'}))
    raise SystemExit(1)
if not anchored(final):
    print(json.dumps({'verified': False, 'url': u, 'detail': 'redirected to ' + final + ', outside publish_base_url (' + base + ') -- something is answering, but not the deployment'}))
    raise SystemExit(1)
print(json.dumps({'verified': True, 'url': u, 'detail': 'http 200, title present'}))
"`
  input: verify_publish_input
  output: verify_publish_output

## surface_site_link — DETERMINISTIC result-link emitter, the
## published site counterpart of surface_pr_link.
tool surface_site_link:
  command: `URL={{input.url}} python3 -I -c "
import os
u = (os.environ.get('URL') or '').strip()
if u:
    print('[iterion] preview_url=' + u + ' kind=site scope=external')
"`
  input: surface_site_link_input

## gate — the deterministic continuation decision. converged = the
## writeable set is clean AND the published pages carry no working
## notes AND the documentation is EXHAUSTIVE against the net AND the
## campaign reports the documentation aligned AND the map the diagram
## step drew still exists, still draws, and grounds every mapped path.
## NOTHING ELSE: the advisory hint counts are telemetry in the run
## events, never conditions. Without a net `coverage_ok` is true by
## construction, so this is the expression it always was. fail_log
## relays the four gates' complaints to the next pass — and carries
## each term only when it is red, so a run with no net produces the
## log it produced before, plus the map verdict. A green-but-more-work
## pass rides an empty log. No LLM, no shell.
compute gate:
  output: gate_state
  expr:
    converged: "outputs.scope_check.scope_ok && outputs.page_lint.lint_ok && outputs.diagram_lint.diagram_ok && outputs.coverage_check.coverage_ok && outputs.campaign.docs_aligned"
    fail_log: "if(!outputs.scope_check.scope_ok, outputs.scope_check.log + ' | ', '') + if(!outputs.page_lint.lint_ok, outputs.page_lint.log, '') + if(!outputs.diagram_lint.diagram_ok, if(!outputs.page_lint.lint_ok, ' | ', '') + outputs.diagram_lint.log, '') + if(!outputs.coverage_check.coverage_ok, if(!outputs.page_lint.lint_ok || !outputs.diagram_lint.diagram_ok, ' | ', '') + outputs.coverage_check.log, '')"

## ─── Nodes : PR finalization tail (opt-in) ─────────────────────────

## mr_gate decides whether the PR tail runs. No LLM, no shell.
compute mr_gate:
  output: mr_gate_output
  expr:
    open_mr: "vars.open_mr"

## ─── Workflow ───────────────────────────────────────────────────
workflow product_docs:
  ## Run in an isolated git worktree of the DOCS repo — the campaign
  ## commits pages in stride; the worktree + finalize keeps the
  ## operator's checkout untouched during the run and lands the series
  ## on a persistent branch.
  worktree: auto
  ## The docs repository is a documentation repository: it has no
  ## build, and its devbox.json (if any) would install a toolchain
  ## this run never uses. The BOT's own devbox.json still applies.
  repo_devbox: off

  entry: catalog_ingest

  budget:
    max_parallel_branches: 1
    ## A comprehensive pass reads N source repositories and writes a
    ## journey-shaped page set — long by construction. The ceiling
    ## holds max_passes of those, so the asymptote converges on its own
    ## terms rather than stopping wherever the cap happens to fall. A
    ## run on an OAuth forfait spends no money at all here — the figure
    ## prices tokens against a plan already paid for.
    ##
    ## The engine declines a back-edge it cannot fund (priced by the
    ## previous pass), so exhausting this ceiling routes the run
    ## through mr_gate → the PR tail with the pages it committed in
    ## stride, instead of dying mid-pass and stranding them.
    max_duration: "6h"
    max_cost_usd: 300

  compaction:
    threshold: 0.9
    preserve_recent: 8

  ## The clones happen ONCE, before the loop: source repositories do
  ## not change during a run.
  ## The map step runs ONCE, on the way into the loop: it sits between
  ## catalog_ingest and scan_hints, and the continuation loop re-enters
  ## at scan_hints, so later passes never redraw the map. It reads the
  ## product's editorial overrides itself (the declared channel from
  ## scan_hints does not exist yet at this point — the compiler says
  ## so); the campaign pass enforces the product's own editorial line
  ## on the map pages like on every other page.
  ## The route table is resolved ONCE, at the run base, before any page
  ## is written: every consumer below reads this one frozen answer.
  catalog_ingest -> route_table with {
    oracle_path: "{{outputs.catalog_ingest.oracle_path}}",
    base_sha: "{{outputs.catalog_ingest.base_sha}}",
  }

  route_table -> diagram with {
    product_id: "{{outputs.catalog_ingest.product_id}}",
    product_dir: "{{outputs.catalog_ingest.product_dir}}",
    surfaces: "{{outputs.catalog_ingest.surfaces}}",
    inventory: "{{outputs.catalog_ingest.inventory}}",
    sources_stamp: "{{outputs.catalog_ingest.sources_stamp}}",
    routes: "{{outputs.route_table.routes}}",
    routes_source: "{{outputs.route_table.source}}",
  }

  diagram -> scan_hints with {
    product_dir: "{{outputs.catalog_ingest.product_dir}}",
    surfaces: "{{outputs.catalog_ingest.surfaces}}",
  }

  ## Each pass: the fresh advisory report + the source inventory are
  ## handed to the campaign as HELP (+ the previous gate's feedback —
  ## empty on pass 1; outputs.gate resolves nil-safe before the gate
  ## has run).
  scan_hints -> campaign with {
    product_id: "{{outputs.catalog_ingest.product_id}}",
    product_dir: "{{outputs.catalog_ingest.product_dir}}",
    surfaces: "{{outputs.catalog_ingest.surfaces}}",
    inventory: "{{outputs.catalog_ingest.inventory}}",
    sources_stamp: "{{outputs.catalog_ingest.sources_stamp}}",
    editorial_files: "{{outputs.scan_hints.editorial_files}}",
    hints: "{{outputs.scan_hints.hints}}",
    hint_count: "{{outputs.scan_hints.hint_count}}",
    hints_note: "{{outputs.scan_hints.hints_note}}",
    mode: "{{outputs.scan_hints.mode}}",
    incremental_base: "{{outputs.scan_hints.incremental_base}}",
    recently_changed_pages: "{{outputs.scan_hints.recently_changed_pages}}",
    oracle_path: "{{outputs.catalog_ingest.oracle_path}}",
    routes: "{{outputs.route_table.routes}}",
    routes_source: "{{outputs.route_table.source}}",
    fail_log: "{{outputs.gate.fail_log}}",
  }

  ## Deterministic TRUTH gates after every campaign pass: writeable-set
  ## containment, then the editorial lint, then the continuation
  ## decision. A documentation-only change cannot break a build, so
  ## there is no build gate — the lint is this bot's equivalent truth
  ## oracle on the artifact it actually ships.
  campaign -> scope_check with {
    product_dir: "{{outputs.catalog_ingest.product_dir}}",
    base_sha: "{{outputs.catalog_ingest.base_sha}}",
  }

  scope_check -> page_lint with {
    product_dir: "{{outputs.catalog_ingest.product_dir}}",
    base_sha: "{{outputs.catalog_ingest.base_sha}}",
    oracle_path: "{{outputs.catalog_ingest.oracle_path}}",
  }

  ## The exhaustiveness gate. `oracle_path` is empty whenever the
  ## product carries no golden-master net, and the node is then a
  ## no-op that certifies nothing and refuses nothing.
  ## The map is judged in the tail, on its FINAL state: the campaign
  ## may have maintained (or broken) the diagram pages, and the verdict
  ## must be about what ships, not about what was once written.
  page_lint -> diagram_lint with {
    product_dir: "{{outputs.catalog_ingest.product_dir}}",
    oracle_path: "{{outputs.catalog_ingest.oracle_path}}",
    routes: "{{outputs.route_table.routes}}",
    routes_source: "{{outputs.route_table.source}}",
    routes_note: "{{outputs.route_table.note}}",
    net_digest: "{{outputs.route_table.net_digest}}",
  }

  diagram_lint -> coverage_check with {
    product_dir: "{{outputs.catalog_ingest.product_dir}}",
    oracle_path: "{{outputs.catalog_ingest.oracle_path}}",
    routes: "{{outputs.route_table.routes}}",
    routes_source: "{{outputs.route_table.source}}",
    routes_note: "{{outputs.route_table.note}}",
    net_digest: "{{outputs.route_table.net_digest}}",
  }

  coverage_check -> gate

  ## Converged → straight to the PR tail.
  gate -> mr_gate when converged

  ## Not converged → another pass through the loop head: a fresh
  ## advisory report (resolved hints + ledger entries retire) →
  ## campaign. The scope/lint complaints ride outputs.gate.fail_log on
  ## the scan_hints→campaign edge.
  gate -> scan_hints as continuation_loop("{{vars.max_passes}}") with {
    product_dir: "{{outputs.catalog_ingest.product_dir}}",
    surfaces: "{{outputs.catalog_ingest.surfaces}}",
  }

  ## continuation_loop exhausted (max_passes hit while work remains) →
  ## finish anyway, shipping what is banked (every committed page is
  ## real, landed work; drift_remaining tells the operator what is
  ## left).
  gate -> mr_gate

  ## ── PR tail (opt-in) ────────────────────────────────────────────
  ## Reached on BOTH finishes (converged and max_passes-exhausted).
  ## finalize_mr refuses an empty PR and reports drift_remaining +
  ## unread_sources honestly in the body.
  mr_gate -> forge_auth_probe when open_mr

  mr_gate -> publish_gate when not open_mr

  forge_auth_probe -> finalize_mr when available with {
    workspace_dir: "{{vars.workspace_dir}}",
    product_id: "{{outputs.catalog_ingest.product_id}}",
    draft: "{{vars.mr_draft}}",
    mr_branch: "{{vars.mr_branch}}",
    mr_base: "{{vars.mr_base}}",
    source_issue_ref: "{{vars.source_issue_ref}}",
    scope_notes: "{{vars.scope_notes}}",
    campaign_summary: "{{outputs.campaign.summary}}",
    drift_remaining: "{{outputs.campaign.drift_remaining}}",
    unread_sources: "{{outputs.campaign.unread_sources}}",
    coverage_counts: "{{outputs.coverage_check.counts_line}}",
  }

  forge_auth_probe -> publish_gate when not available

  ## PR opened → surface its URL as a headline result-link in the run
  ## summary. Every PR-tail outcome then flows into the publication
  ## tail, which decides for itself (publish_gate) whether to run.
  finalize_mr -> surface_pr_link when opened with {
    url: "{{outputs.finalize_mr.url}}"
  }

  finalize_mr -> publish_gate when not opened

  surface_pr_link -> publish_gate

  ## ── Publication tail (opt-in) ───────────────────────────────────
  ## Deterministic gate → skill-driven publish agent → deterministic
  ## URL truth gate. verify_publish FAILS the run when the site is
  ## not serving: a publish that was asked for either goes live or
  ## fails loudly — never a façade.
  publish_gate -> publish when do_publish with {
    product_id: "{{outputs.catalog_ingest.product_id}}",
    product_dir: "{{outputs.catalog_ingest.product_dir}}",
    slug: "{{vars.publish_slug}}",
    base_url: "{{vars.publish_base_url}}",
    image: "{{vars.publish_image}}",
    registry_user: "{{vars.publish_registry_user}}",
    tools_ref: "{{vars.publish_tools_ref}}",
  }

  publish_gate -> done when not do_publish

  ## Unconditional fallback: edge selection SKIPS a conditional edge
  ## whose field is absent from the output (an errored tool body yields
  ## an output without do_publish), and a node with only conditional
  ## edges then dead-ends the run with NO_OUTGOING_EDGE. The fallback
  ## makes the safe route structural: no publish signal → done.
  publish_gate -> done

  publish -> verify_publish with {
    url: "{{outputs.publish.url}}",
    base_url: "{{vars.publish_base_url}}",
    deployed: "{{outputs.publish.deployed}}",
    summary: "{{outputs.publish.summary}}",
  }

  verify_publish -> surface_site_link with {
    url: "{{outputs.verify_publish.url}}"
  }

  surface_site_link -> done
