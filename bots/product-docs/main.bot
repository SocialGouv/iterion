            try:
                p.wait(timeout=max(0.0, deadline - time.monotonic()))
            except subprocess.TimeoutExpired:
                why = late
    finally:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            pass
        p.stdout.close()
        p.wait()
    if why:
        return None, why
    text = b''.join(chunks).decode('utf-8', 'replace')
    if p.returncode != 0:
        return None, 'the net routes_probe exited ' + str(p.returncode) + ' -- ' + ' '.join(text.split())[-200:]
    return text, ''
def cleanup(path):
    ## The throwaway checkout is this node's own (mkdtemp); nothing else is
    ## ever removed. A directory the probe left read-only is made writable
    ## first -- never through a link, which could point anywhere.
    try:
        shutil.rmtree(path)
    except OSError:
        for top, dirs, _files in os.walk(path):
            for d in dirs:
                p = os.path.join(top, d)
                if not os.path.islink(p):
                    try:
                        os.chmod(p, 0o700)
                    except OSError:
                        pass
        shutil.rmtree(path, ignore_errors=True)
    return '' if not os.path.lexists(path) else 'the throwaway checkout ' + path + ' could not be fully removed'
