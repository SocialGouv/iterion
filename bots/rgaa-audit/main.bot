  refute_applied: bool
  refute_degraded: bool
  refuted: int
  reopened: json
  open_ids: json

schema review_gate_output:
  fail_incomplete: bool
  to_human: bool
  refute_applied: bool
  refute_degraded: bool
  refuted: int
  undecided_ids: json
  undecided: int

schema human_review_input:
  draft_path: string
  technical_annex_path: string
  summary: string
  applied: int
  rejected: int
  undecided: int
  undecided_ids: json
  refuted: int
  refute_applied: bool
  refute_degraded: bool

schema human_review_output:
  approved: bool
  undecidable_ids: json
  notes: string

schema undecidable_input:
  run_dir: string
  standard: string
  undecidable_ids: json
  notes: string
  undecidable_present: bool
  undecidable_path: string

schema undecidable_output:
  written: int
  path: string

schema final_input:
  run_dir: string
  workspace_dir: string
  standard: string
  html_report: bool
  report_dir: string
  require_complete: bool
  undecidable_present: bool
  undecidable_path: string
  scope_notes: string

schema final_output:
  ok: bool
  fail_code: string
  reason: string
  report_path: string
  technical_annex_path: string
  html_path: string
  html_single_path: string
  grid_json_path: string
  report_files: json
  grid_path: string
  annex_path: string
  ledger_path: string
  conformance_pct: int
  provisional: bool
  complete: bool
  undecided: int
  undecided_ids: json
  degraded: json
  audit_sha256: string

schema deliver_input:
  run_dir: string
  workspace_dir: string
  standard: string
  report_path: string
  findings_cap: int
  board_state: string
  board_epic_label: string

schema deliver_output:
  ok: bool
  fail_code: string
  reason: string
  issues: json
  total: int
  capped: int
  blocking: int
  advisory: int

schema publish_gate_input:
  post_to_board: bool
  total: int

schema publish_gate_output:
  post: bool

schema publish_input:
  issues: json
  total: int
  capped: int
  state: string

schema publish_output:
  created: json
  existing: json
  failed: json
  summary: string

schema publish_verify_input:
  run_dir: string
  issues: json
  created: json
  existing: json
  failed: json

schema publish_verify_output:
  ok: bool
  fail_code: string
  reason: string
  missing: json
  created: int
  existing: int

## ─── LLM nodes ────────────────────────────────────────────────────────

## The adjudicator: one read-only agent per batch of criteria, replayed in
## parallel by the dispatch router. claude_code so the bundled skills are
## mirrored into .claude/skills/. It rules, it never edits; its verdicts are
## filtered to its own batch, then folded by the engine's own gate.
agent adjudicate:
  model: "${ITERION_RGAA_MODEL_ADJUDICATE:-claude-opus-5-5}"
  backend: "${ITERION_RGAA_BACKEND_ADJUDICATE:-claude_code}"
  input: adjudicate_input
  output: adjudicate_output
  system: adjudicate_system
  user: adjudicate_user
  tools: [read_file, glob, grep]
  tool_max_steps: 80
  reasoning_effort: "${ITERION_RGAA_EFFORT_ADJUDICATE:-high}"
  timeout: "25m"
  readonly: true

## The second reader: a judge per batch of claims, same read-only posture.
## Opus by default, like the adjudicator; a cross-family reader is one env
## dial away (ITERION_RGAA_BACKEND_REFUTE=claw ITERION_RGAA_MODEL_REFUTE=…).
judge refute:
  model: "${ITERION_RGAA_MODEL_REFUTE:-claude-opus-5-5}"
  backend: "${ITERION_RGAA_BACKEND_REFUTE:-claude_code}"
  input: refute_input
  output: refute_output
  system: refute_system
  user: refute_user
  tools: [read_file, glob, grep]
  tool_max_steps: 60
  reasoning_effort: "${ITERION_RGAA_EFFORT_REFUTE:-medium}"
  timeout: "20m"
  readonly: true

## Board transcription with NO native tools: `tools: []` strips the whole
## claude_code roster, the capability-gated board MCP tools still reach it.
## It decides nothing; the plan it receives is already the engine's,
## de-duplicated, severity-sorted and capped. Its report of what it created
## is held to the plan by publish_verify — a self-report, not a board read:
## a tool node has no board action today.
judge publish:
  model: "${ITERION_RGAA_MODEL_PUBLISH:-claude-opus-5-5}"
  backend: "claude_code"
  input: publish_input
  output: publish_output
  system: publish_system
  user: publish_user
  tools: []
  capabilities: [board.read, board.create, board.label]
  tool_max_steps: 200
  reasoning_effort: "${ITERION_RGAA_EFFORT_PUBLISH:-low}"
  timeout: "30m"
  readonly: true

## ─── Routers ──────────────────────────────────────────────────────────
router dispatch:
  mode: fan_out_each
  over: "{{outputs.plan_batches.batches}}"
  as: batch

router refute_dispatch:
  mode: fan_out_each
  over: "{{outputs.plan_refute.batches}}"
  as: rbatch

human human_review:
  input: human_review_input
  output: human_review_output
  interaction: human
  instructions: human_review_instructions

## ─── Tool nodes ───────────────────────────────────────────────────────

## DETERMINISTIC setup and the run's first hard gate. The ENTRY node: its
## input is the launch payload, so every value may arrive as the string a
## `--var` carries, and the run directory is `run_dir/<run id>`, joined
## here and handed to every later node through `run_dir`. Resolves the
## engine by PATH AND HASH: a candidate is fingerprinted (size, then sha256)
## before anything of it runs, then asked its version. Candidates in order:
## $ULTRA11Y_BIN (explicit: refused loudly, never replaced), the global npm
## install (the runner image), a private install under $ULTRA11Y_HOME, and
## finally `npm install ultra11y@<pin>` into the run directory. Also writes
## the run's shared helper library (every later node requires it) and the
## engine manifest every call is re-verified against.
tool prepare:
  script: |
    const fs = require("fs"), path = require("path"), os = require("os");
    const cp = require("child_process");
    const asBool = (v) => v === true || v === "true" || v === 1 || v === "1";
    const asInt = (v, d) => { const n = typeof v === "number" ? v : parseInt(String(v), 10); return Number.isFinite(n) ? n : d; };
    const asStr = (v) => (v === null || v === undefined) ? "" : String(v);
    const RUN = path.join(asStr({{input.run_dir}}), asStr({{run.id}}));
    const WS = asStr({{input.workspace_dir}});
    const WANT = asStr({{input.engine_version}});
    const SHA = asStr({{input.engine_sha256}});
    const SIZE = asInt({{input.engine_size}}, -1);
    const STD = asStr({{input.standard}});
    const reportDir = asStr({{input.report_dir}});
    fs.mkdirSync(path.join(RUN, "bin"), { recursive: true });
    fs.mkdirSync(path.join(RUN, "layers"), { recursive: true });
    fs.mkdirSync(path.join(RUN, "state"), { recursive: true });

    // The helper library shared by every node of this run. Written from this
    // function's own source so the bot carries it exactly once.
    function helpers() {
      const fs = require("fs"), path = require("path"), cp = require("child_process"), crypto = require("crypto");
      let RUN = "";
      const init = (dir) => { RUN = dir; return api; };
      const sha256 = (p) => crypto.createHash("sha256").update(fs.readFileSync(p)).digest("hex");
      const fingerprint = (p) => { const b = fs.readFileSync(p); return { size: b.length, sha256: crypto.createHash("sha256").update(b).digest("hex") }; };
      const exists = (p) => { try { fs.accessSync(p); return true; } catch (e) { return false; } };
      const readJSON = (p) => JSON.parse(fs.readFileSync(p, "utf8"));
      const writeJSON = (p, v) => { fs.mkdirSync(path.dirname(p), { recursive: true }); fs.writeFileSync(p, JSON.stringify(v, null, 1)); };
      // Synchronous writes: stdout to a pipe is asynchronous in node and
      // process.exit would drop what the pipe has not taken yet (64 KiB).
      const out = (o) => { fs.writeSync(1, JSON.stringify(o)); process.exit(0); };
      const refuse = (code, reason, extra) => out(Object.assign({ ok: false, fail_code: code, reason: reason }, extra || {}));
      const die = (msg) => { fs.writeSync(2, String(msg) + "\n"); process.exit(1); };
      const auditPath = () => path.join(RUN, "audit-latest.json");
      const statePath = (name) => path.join(RUN, "state", name + ".json");
      // The writer of audit-latest.json records its hash; every later node
      // refuses to go on when the file no longer matches that record.
      const commitAudit = () => { const h = sha256(auditPath()); writeJSON(statePath("audit"), { sha256: h, at: new Date().toISOString() }); return h; };
      const checkAudit = () => { if (!exists(auditPath())) die("no audit at " + auditPath()); const got = sha256(auditPath()); if (!exists(statePath("audit"))) refuse("AUDIT_INTEGRITY", "audit-latest.json has no recorded hash: the node that wrote it did not finish"); const rec = readJSON(statePath("audit")).sha256; if (got !== rec) refuse("AUDIT_INTEGRITY", "audit-latest.json changed outside the engine's own folds: sha256 " + got + " now, " + rec + " when the last writer left it"); return got; };
      // A node that rewrites the audit records its output: re-entered on a
      // resume with the audit as it left it, it re-emits instead of folding
      // the same verdicts twice (which the engine refuses).
      const once = (name) => { const p = statePath("node-" + name); if (!exists(p)) return null; const rec = readJSON(p); return rec.post_sha256 === sha256(auditPath()) ? rec.out : null; };
      const record = (name, o) => { writeJSON(statePath("node-" + name), { post_sha256: sha256(auditPath()), out: o }); return o; };
      // The engine, re-fingerprinted before EVERY call: what runs is what the
      // pin certifies, for the whole run and not only at resolution time.
      const engine = (args, opts) => {
        opts = opts || {};
        const meta = readJSON(path.join(RUN, "bin", "engine.json"));
        const fp = fingerprint(meta.entry);
        if (fp.size !== meta.size || fp.sha256 !== meta.sha256) die("engine integrity: " + meta.entry + " no longer carries the pinned fingerprint (size " + fp.size + " sha256 " + fp.sha256 + ")");
        const r = cp.spawnSync(process.execPath, [meta.entry].concat(args), { cwd: opts.cwd || RUN, env: Object.assign({}, process.env, { npm_config_update_notifier: "false" }, opts.env || {}), encoding: "utf8", maxBuffer: 256 * 1024 * 1024, timeout: opts.timeoutMs || 600000 });
        if (r.error) die("engine " + args[0] + ": " + r.error.message);
        let json = null; try { json = JSON.parse(r.stdout); } catch (e) { json = null; }
        return { code: r.status, stdout: r.stdout || "", stderr: r.stderr || "", json: json };
      };
      // A `--json` call that printed no JSON is an engine crash, never a refusal.
      const engineJSON = (args, opts) => { const r = engine(args, opts); if (r.json === null || typeof r.json !== "object") die("engine " + args.join(" ") + " printed no JSON (exit " + r.code + ")\n" + r.stderr.slice(-4000)); return r; };
      const std = (standard) => ["--standard", standard, "--lang", "fr"];
      // What the report's « Décidés » line says about a document: validated =
      // C without `inapplicable`; faute de sujet = every criterion carrying
      // `inapplicable`; à évaluer = manual.
      const countDoc = (doc) => { const c = { decided: 0, total: 0, conformes: 0, nc: 0, fauteDeSujet: 0, aEvaluer: 0 }; for (const cr of doc.criteria || []) { c.total++; const inap = !!cr.inapplicable; if (inap) c.fauteDeSujet++; if (cr.status === "C") { if (!inap) c.conformes++; c.decided++; } else if (cr.status === "NC") { c.nc++; c.decided++; } else if (cr.status === "manual") { c.aEvaluer++; } else { c.decided++; } } return c; };
      // The engine's own formula, operation for operation: (v / a) * 100 then
      // round — 100 * v / a rounds the other way on some splits (23/40).
      const rate = (c) => { const den = c.conformes + c.nc + c.aEvaluer; return den === 0 ? -1 : Math.round((c.conformes / den) * 100); };
      const flagged = (doc) => (doc.criteria || []).filter((cr) => cr.inapplicable && cr.status === "manual").map((cr) => cr.id).sort();
      const undecided = (doc) => (doc.criteria || []).filter((cr) => cr.status === "manual").map((cr) => cr.id).sort();
      const num = (s) => parseInt(String(s).replace(/[^0-9-]/g, ""), 10);
      // The « Décidés » and « Taux » lines of the engine's French report.
      const reportLines = (md) => { const lines = md.split("\n"); const dl = lines.find((l) => l.startsWith("- **Décidés** : ")); const rl = lines.find((l) => l.startsWith("- **Taux de conformité")); const r = { decided: null, rate: null }; if (dl) { const m = dl.match(/: (\d+)\/(\d+) — (-?\d+) conforme\(s\), (-?\d+) non conforme\(s\), (-?\d+) conforme\(s\) faute de sujet, (-?\d+) à évaluer/); if (m) r.decided = { decided: num(m[1]), total: num(m[2]), conformes: num(m[3]), nc: num(m[4]), fauteDeSujet: num(m[5]), aEvaluer: num(m[6]) }; } if (rl) { const m = rl.match(/\*\* : (-?\d+)%/); r.rate = m ? num(m[1]) : (/non calculable/.test(rl) ? -1 : null); } return r; };
      const sameCounts = (a, b) => !!a && !!b && ["decided", "total", "conformes", "nc", "fauteDeSujet", "aEvaluer"].every((k) => a[k] === b[k]);
      const layer = (name, obj) => writeJSON(path.join(RUN, "layers", name + ".json"), Object.assign({ layer: name, at: new Date().toISOString() }, obj));
      const layers = () => { const dir = path.join(RUN, "layers"); const o = {}; if (!exists(dir)) return o; for (const f of fs.readdirSync(dir).sort()) if (f.endsWith(".json")) o[f.slice(0, -5)] = readJSON(path.join(dir, f)); return o; };
      const listJSON = (dir, prefix) => exists(dir) ? fs.readdirSync(dir).filter((f) => f.endsWith(".json") && (!prefix || f.startsWith(prefix))).sort().map((f) => path.join(dir, f)) : [];
      const isObj = (x) => !!x && typeof x === "object" && !Array.isArray(x);
      const asText = (x) => typeof x === "string" ? x : (typeof x === "number" ? String(x) : null);
      const asLine = (x) => { const n = typeof x === "number" ? x : (typeof x === "string" && /^\d+$/.test(x) ? Number(x) : NaN); return Number.isInteger(n) && n >= 0 ? n : null; };
      // Nested verdict fields, one shape each: anything else crashes the
      // engine's fold without JSON, so it is dropped (and counted) here.
      const citation = (c) => { if (!isObj(c)) return null; const file = asText(c.file), line = asLine(c.line); if (!file || line === null) return null; const o = { file: file, line: line }; if (typeof c.snippet === "string") o.snippet = c.snippet; if (typeof c.selector === "string") o.selector = c.selector; return o; };
      const finding = (f) => { if (!isObj(f)) return null; const file = asText(f.file), line = asLine(f.line), ref = asText(f.normativeRef); if (!file || line === null || !ref || typeof f.message !== "string") return null; const o = { file: file, line: line, message: f.message, normativeRef: ref }; if (typeof f.snippet === "string") o.snippet = f.snippet; if (typeof f.selector === "string") o.selector = f.selector; return o; };
      // A recommendation is anchored like a finding (the engine grounds it and
      // renders it as an advisory) and carries no normative reference.
      const recommendation = (r) => { if (!isObj(r)) return null; const file = asText(r.file), line = asLine(r.line); if (!file || line === null || typeof r.message !== "string" || !r.message.trim()) return null; const o = { file: file, line: line, message: r.message }; if (typeof r.snippet === "string") o.snippet = r.snippet; if (typeof r.selector === "string") o.selector = r.selector; return o; };
      // Edit distances from a transcription to a harvested snippet, whitespace
      // collapsed: to some excerpt of it (an alignment free to start and end
      // anywhere in the snippet — none for a copy or an excerpt, a few for a
      // retyping), to its head (free to end anywhere — an element starts its
      // own snippet, a container only runs into it) and to the whole of it.
      // Compared under NFKC, as the engine's grounding compares. A
      // transcription over four times the line's longest snippet is no
      // retyping of any of them: the alignment reads its head, the same head
      // for every anchor of the line.
      const flatText = (s) => String(s).normalize("NFKC").replace(/\s+/g, " ").trim();
      const distances = (text, snippet, cap) => {
        const b = flatText(snippet), a = flatText(text).slice(0, cap);
        let ex = new Array(b.length + 1).fill(0), wh = Array.from({ length: b.length + 1 }, (_, j) => j);
        for (let i = 1; i <= a.length; i++) {
          const ex2 = [i], wh2 = [i];
          for (let j = 1; j <= b.length; j++) {
            const sub = a[i - 1] === b[j - 1] ? 0 : 1;
            ex2.push(Math.min(ex[j] + 1, ex2[j - 1] + 1, ex[j - 1] + sub));
            wh2.push(Math.min(wh[j] + 1, wh2[j - 1] + 1, wh[j - 1] + sub));
          }
          ex = ex2;
          wh = wh2;
        }
        return { excerpt: Math.min.apply(null, ex), head: Math.min.apply(null, wh), whole: wh[b.length] };
      };
      // Of the evidence anchors at a transcription's own file:line, the one it
      // stands on: the one its snippet copies; else the nearest by excerpt
      // distance, then the one its selector names, then by head distance, then
      // by whole distance. `edits` is the excerpt distance (0: a copy or an
      // excerpt), null when it transcribed no snippet — then the anchor its
      // selector names, else the first.
      const nearestAnchor = (evidence, o) => {
        const key = (x) => String(x.file) + ":" + String(x.line);
        const at = evidence.filter((e) => key(e) === key(o));
        if (!at.length) return null;
        const named = (e) => typeof o.selector === "string" && o.selector !== "" && e.selector === o.selector;
        if (typeof o.snippet !== "string" || !flatText(o.snippet)) return { anchor: at.find(named) || at[0], edits: null };
        const copy = at.find((e) => e.snippet === o.snippet);
        if (copy) return { anchor: copy, edits: 0 };
        const text = (e) => typeof e.snippet === "string" ? e.snippet : "";
        const cap = 4 * Math.max.apply(null, at.map((e) => flatText(text(e)).length)) + 64;
        let best = null;
        for (const e of at) {
          const d = distances(o.snippet, text(e), cap);
          const rank = [d.excerpt, named(e) ? 0 : 1, d.head, d.whole];
          const i = best ? rank.findIndex((r, k) => r !== best.rank[k]) : -1;
          if (!best || (i >= 0 && rank[i] < best.rank[i])) best = { anchor: e, rank: rank };
        }
        return { anchor: best.anchor, edits: best.rank[0] };
      };
      // The criteria an engine apply refused: every fold JSON carries the list,
      // and a decision read from its absence would read "nothing refused".
      const rejectedOf = (json, what) => { if (!Array.isArray(json.rejectedCriteria)) die(what + " printed no rejectedCriteria list"); return json.rejectedCriteria; };
      // A transcription restored from the anchor it stands on: the anchor's
      // own snippet and selector (none when the anchor has none). A copy or an
      // excerpt of the anchor (`edits` 0) is returned as written.
      const restoreFrom = (o, near) => {
        if (near.edits === 0) return o;
        const r = Object.assign({}, o);
        delete r.snippet;
        delete r.selector;
        if (typeof near.anchor.snippet === "string") r.snippet = near.anchor.snippet;
        if (typeof near.anchor.selector === "string" && near.anchor.selector) r.selector = near.anchor.selector;
        return r;
      };
      // A report's companions are part of its contract, not optional context.
      // Only accept readable regular files inside this generation's output tree.
      const reportFile = (file, root) => {
        if (typeof file !== "string" || !file) die("report component has no path");
        const base = fs.realpathSync(root), resolved = path.resolve(file);
        const real = fs.realpathSync(resolved);
        if (!resolved.startsWith(path.resolve(root) + path.sep) || !real.startsWith(base + path.sep)) die("report component escapes output directory: " + file);
        if (!fs.statSync(real).isFile()) die("report component is not a regular file: " + file);
        fs.accessSync(real, fs.constants.R_OK);
        return resolved;
      };
      const reportParts = (rep, root, html) => {
        const report = reportFile(rep.path, root), annex = reportFile(rep.annexPath, root);
        const main = fs.readFileSync(report, "utf8"), technical = fs.readFileSync(annex, "utf8");
        const name = path.basename(annex);
        if (path.dirname(report) !== path.dirname(annex) || !main.includes("](" + name + ")") || !technical.startsWith("<!-- ultra11y:annex " + name + " -->")) die("report's technical annex is invalid or not linked: " + annex);
        // Finding prose in the business report is content, never annex metadata.
        const text = main + "\n\n" + technical;
        const lines = { decided: reportLines(technical).decided, rate: reportLines(main).rate };
        if (!lines.decided || lines.rate === null) die("split report lacks its counts or conformity rate");
        const index = html ? reportFile(rep.htmlPath, root) : "";
        const single = html ? reportFile(rep.htmlSinglePath, root) : "";
        return { report: report, annex: annex, html: index, single: single, text: text, lines: lines, files: [report, annex, index, single].filter(Boolean) };
      };
      const copyReportFiles = (files, sourceRoot, destination) => {
        fs.mkdirSync(destination, { recursive: true });
        const destRoot = fs.realpathSync(destination);
        return files.map((file) => {
          // Keep the caller's path spelling in published metadata; real paths
          // are used only for containment, including symlinked run roots.
          const source = reportFile(file, sourceRoot), dest = path.join(path.resolve(destination), path.relative(path.resolve(sourceRoot), source));
          fs.mkdirSync(path.dirname(dest), { recursive: true });
          const parent = fs.realpathSync(path.dirname(dest));
          if (parent !== destRoot && !parent.startsWith(destRoot + path.sep)) die("report export escapes destination: " + dest);
          const entry = fs.lstatSync(dest, { throwIfNoEntry: false });
          if (entry && entry.isSymbolicLink()) die("report export refuses a symlink: " + dest);
          if (source !== dest) fs.copyFileSync(source, dest);
          return dest;
        });
      };
      // A fresh directory gives the exact file set produced by this engine
      // invocation, including screenshots omitted from its JSON. Never infer
      // dependencies from finding text, or sweep outputs from earlier attempts.
      const generateReport = (output, html, standard, opts) => {
        const fresh = fs.mkdtempSync(path.join(RUN, "report-generation-"));
        const rep = engineJSON(["report", "--in", auditPath(), "--out", fresh, "--json"].concat(html ? ["--html"] : [], std(standard)), opts);
        if (rep.code !== 0) die("report generation exit " + rep.code + ": " + rep.stderr.slice(-3000));
        reportParts(rep.json, fresh, html);
        const files = [];
        const walk = (dir) => {
          for (const entry of fs.readdirSync(dir, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name))) {
            const file = path.join(dir, entry.name);
            if (entry.isDirectory()) walk(file);
            else if (entry.isFile()) files.push(reportFile(file, fresh));
            else die("report generation produced a non-regular entry: " + file);
          }
        };
        walk(fresh);
        rep.files = copyReportFiles(files, fresh, output);
        for (const key of ["path", "annexPath", "htmlPath", "htmlSinglePath"]) {
          if (rep.json[key]) rep.json[key] = path.join(path.resolve(output), path.relative(fresh, reportFile(rep.json[key], fresh)));
        }
        fs.rmSync(fresh, { recursive: true });
        return rep;
      };

      const api = { init, sha256, fingerprint, exists, readJSON, writeJSON, out, refuse, die, auditPath, statePath, commitAudit, checkAudit, once, record, engine, engineJSON, std, countDoc, rate, flagged, undecided, reportLines, reportParts, reportFile, copyReportFiles, generateReport, sameCounts, layer, layers, listJSON, isObj, asText, asLine, citation, finding, recommendation, nearestAnchor, restoreFrom, rejectedOf };
      return api;
    }
    fs.writeFileSync(path.join(RUN, "bin", "lib.js"), "module.exports = (" + helpers.toString() + ")();\n");
    const L = helpers().init(RUN);
    const empty = { run_dir: RUN, engine_path: "", engine_source: "", engine_version: "", engine_pkg_dir: "", audit_args: [], browser_ok: false, browser_reason: "", rc_present: false, ledger_present: false, ledger_path: "", undecidable_present: false, undecidable_path: "" };
    if (reportDir && L.exists(reportDir) && !fs.statSync(reportDir).isDirectory()) L.die("report_dir " + reportDir + " exists and is not a directory");

    // Candidates, fingerprinted BEFORE anything of them runs.
    const tried = [];
    const okEntry = (p, source) => {
      if (!p || !L.exists(p)) return null;
      const fp = L.fingerprint(p);
      if (fp.size !== SIZE || fp.sha256 !== SHA) { tried.push({ source: source, path: p, size: fp.size, sha256: fp.sha256 }); return null; }
      const r = cp.spawnSync(process.execPath, [p, "--version"], { encoding: "utf8", timeout: 120000, env: Object.assign({}, process.env, { npm_config_update_notifier: "false" }) });
      const lines = String(r.stdout || "").trim().split("\n");
      const got = lines[lines.length - 1];
      if (r.status !== 0 || got !== WANT) { tried.push({ source: source, path: p, version: got || "(no output)", exit: r.status }); return null; }
      return { entry: fs.realpathSync(p), source: source };
    };
    let engine = null;
    const explicit = process.env.ULTRA11Y_BIN || "";
    if (explicit) {
      engine = okEntry(explicit, "ULTRA11Y_BIN");
      if (!engine) L.refuse("ENGINE_HASH_MISMATCH", "ULTRA11Y_BIN=" + explicit + " is not the pinned engine (want " + WANT + ", size " + SIZE + ", sha256 " + SHA + "): refusing to substitute another engine for an explicit choice", empty);
    }
    if (!engine) {
      const g = cp.spawnSync("npm", ["root", "-g"], { encoding: "utf8", timeout: 60000 });
      const root = String(g.stdout || "").trim();
      if (g.status === 0 && root) engine = okEntry(path.join(root, "ultra11y", "scripts", "ultra11y.mjs"), "npm-global");
    }
    if (!engine) {
      const home = process.env.ULTRA11Y_HOME || path.join(process.env.XDG_CACHE_HOME || path.join(os.homedir(), ".cache"), "iterion", "ultra11y");
      engine = okEntry(path.join(home, WANT, "node_modules", "ultra11y", "scripts", "ultra11y.mjs"), "ULTRA11Y_HOME");
    }
    let installFailed = "";
    if (!engine) {
      const prefix = path.join(RUN, "engine");
      fs.mkdirSync(prefix, { recursive: true });
      const r = cp.spawnSync("npm", ["install", "--prefix", prefix, "--ignore-scripts", "--no-audit", "--no-fund", "--no-package-lock", "ultra11y@" + WANT], { encoding: "utf8", timeout: 600000, env: Object.assign({}, process.env, { npm_config_update_notifier: "false" }) });
      if (r.status !== 0) installFailed = String(r.stderr || r.error || "").slice(-2000);
      else engine = okEntry(path.join(prefix, "node_modules", "ultra11y", "scripts", "ultra11y.mjs"), "npm-install");
      if (!engine && !installFailed) {
        L.refuse("ENGINE_HASH_MISMATCH", "ultra11y@" + WANT + " installed from the registry does not carry the pinned fingerprint (want size " + SIZE + ", sha256 " + SHA + "; got " + JSON.stringify(tried[tried.length - 1]) + ") — the pin and the published package disagree", empty);
      }
    }
    if (!engine) L.refuse("ENGINE_UNRESOLVED", "no ultra11y " + WANT + " engine could be resolved (candidates refused: " + JSON.stringify(tried) + "; npm install: " + (installFailed || "not attempted") + ") — refusing to report an audit no engine produced", empty);
    const pkgDir = path.dirname(path.dirname(engine.entry));
    L.writeJSON(path.join(RUN, "bin", "engine.json"), { entry: engine.entry, source: engine.source, version: WANT, size: SIZE, sha256: SHA, pkg_dir: pkgDir });

    // Audit arguments: the scope globs reach the engine's own globber.
    const split = (s) => asStr(s).split(/[,\s]+/).map((x) => x.trim()).filter(Boolean);
    const globs = split({{input.scope_globs}});
    const args = (globs.length ? globs : ["."]).concat(["--graph"]);
    if (asBool({{input.force_jsx}})) args.push("--jsx");
    for (const ex of split({{input.exclude_globs}})) args.push("--exclude", ex);
    const maxFiles = asInt({{input.max_files}}, 0);
    if (maxFiles > 0) args.push("--max-files", String(maxFiles));

    // Browser probe BEFORE any LLM spend, only when the rendered layer may run.
    const rendered = asStr({{input.rendered}});
    let browserOk = false, browserReason = "rendered layer off";
    if (rendered !== "off") {
      const r = L.engineJSON(["status", "--browser", "--cwd", pkgDir, "--json"], { timeoutMs: 120000 });
      browserOk = !!(r.json.browser && r.json.browser.ok);
      browserReason = browserOk ? "" : String((r.json.browser && r.json.browser.reason) || "no browser");
    }
    const rcPresent = L.exists(path.join(WS, ".ultra11yrc.json"));
    const ledgerRel = asStr({{input.ledger_path}}) || path.join(".ultra11y", "verdicts", STD + ".json");
    const undecRel = asStr({{input.undecidable_path}}) || path.join(".ultra11y", "undecidable-" + STD + ".json");
    const ledgerAbs = path.resolve(WS, ledgerRel), undecAbs = path.resolve(WS, undecRel);
    L.layer("engine", { status: "ok", version: WANT, source: engine.source, entry: engine.entry });
    L.out({ ok: true, fail_code: "", reason: "", run_dir: RUN, engine_path: engine.entry, engine_source: engine.source, engine_version: WANT, engine_pkg_dir: pkgDir, audit_args: args, browser_ok: browserOk, browser_reason: browserReason, rc_present: rcPresent, ledger_present: L.exists(ledgerAbs), ledger_path: ledgerAbs, undecidable_present: L.exists(undecAbs), undecidable_path: undecAbs });
  language: js
  input: prepare_input
  output: prepare_output

## DETERMINISTIC. The engine runs on the workspace; its document IS the
## finding set, and this node records its hash. A scope that matches no
## auditable file is an EMPTY_SCOPE, reported as such — the engine having
## found nothing to parse is a different fact from the code being clean.
tool static_audit:
  script: |
    const path = require("path");
    const RUN = {{input.run_dir}};
    const L = require(path.join(RUN, "bin", "lib.js")).init(RUN);
    const WS = {{input.workspace_dir}};
    const r = L.engine(["audit"].concat({{input.audit_args}}, ["--out", RUN, "--json"], L.std({{input.standard}})), { cwd: WS, timeoutMs: 1800000 });
    if (r.code !== 0 && r.code !== 1) L.die("engine audit exit " + r.code + ": " + r.stderr.slice(-4000));
    if (!L.exists(L.auditPath())) L.die("the engine exited " + r.code + " but wrote no audit at " + L.auditPath() + ": " + r.stderr.slice(-2000));
    // A fresh audit starts a fresh generation: the ledger copy an earlier
    // fold of this run merged belongs to the audit this one replaced.
    const ledgerCopy = path.join(RUN, "ledger", {{input.standard}} + ".json");
    if (L.exists(ledgerCopy)) require("fs").unlinkSync(ledgerCopy);
    const doc = L.readJSON(L.auditPath());
    const core = doc.core || doc;
    const files = Number((core.scope && core.scope.files) || 0);
    const maxFiles = Number({{input.max_files}} || 0);
    const truncated = !!(core.scope && core.scope.truncated) || (maxFiles > 0 && files >= maxFiles);
    const findings = (doc.findings || []).length, residual = (doc.residualRisks || []).length;
    const sha = L.commitAudit();
    const auto = Math.round(Number(doc.conformancePct || 0));
    if (files === 0) L.refuse("EMPTY_SCOPE", "the engine found no auditable file in scope — an empty scope is NOT a clean audit: widen scope_globs, or check that this project has a user interface at all", { files: 0, findings: findings, residual: residual, auto_pct: 0, truncated: false, audit_path: L.auditPath(), audit_sha256: sha });
    L.layer("static", { status: truncated ? "degraded" : "ok", files: files, findings: findings, residual: residual, auto_pct: auto, truncated: truncated, reason: truncated ? "périmètre tronqué à max_files=" + maxFiles : "" });
    L.out({ ok: true, fail_code: "", reason: "", files: files, findings: findings, residual: residual, auto_pct: auto, truncated: truncated, audit_path: L.auditPath(), audit_sha256: sha });
  language: js
  input: audit_input
  output: audit_output

## The engine's finding set, banked as an artifact before any LLM runs:
## whatever dies later, the real findings survive and are readable.
tool bank_static:
  script: |
    const path = require("path");
    const RUN = {{input.run_dir}};
    const L = require(path.join(RUN, "bin", "lib.js")).init(RUN);
    const sha = L.checkAudit();
    const doc = L.readJSON(L.auditPath());
    L.writeJSON(path.join(RUN, "bank", "audit-static.json"), doc);
    const all = (doc.findings || []).map((f) => ({ criteriaId: f.criteriaId, severity: f.severity, ruleId: f.ruleId, file: f.file, line: f.line }));
    const cap = 200;
    L.out({ ok: true, fail_code: "", reason: "", banked: true, findings: all.slice(0, cap), truncated: Math.max(0, all.length - cap), audit_sha256: sha });
  language: js
  input: bank_input
  output: bank_output
  publish: static_bank

## The rendered layer: serve the site when asked, scan the page sample with
## the engine's own Playwright (resolved from the engine package, never from
## the audited tree), merge the captures into the audit. The served site
## runs in this node's own process group (a cancel reaches it) and is
## stopped when the node ends. Under `auto` a failure degrades the layer
## and says why; under `required` it is a typed, resumable refusal. The
## captures land under `.ultra11y/pages/` of the workspace, where the
## engine writes them.
tool render:
  script: |
    const fs = require("fs"), path = require("path"), cp = require("child_process");
    const RUN = {{input.run_dir}};
    const L = require(path.join(RUN, "bin", "lib.js")).init(RUN);
    const WS = {{input.workspace_dir}};
    const STD = {{input.standard}};
    const required = {{input.rendered}} === "required";
    let sha = L.checkAudit();
    const prior = L.once("render");
    if (prior) L.out(prior);
    const degrade = (reason) => { L.layer("rendered", { status: required ? "failed" : "degraded", reason: reason }); if (required) L.refuse("RENDER_UNAVAILABLE", reason, { status: "failed", pages_recorded: 0, pages_refused: 0, missing_kinds: [], audit_sha256: sha }); L.out({ ok: true, fail_code: "", reason: reason, status: "degraded", pages_recorded: 0, pages_refused: 0, missing_kinds: [], audit_sha256: sha }); };
    let server = null;
    const stop = () => { if (server && server.exitCode === null) { try { server.kill("SIGTERM"); } catch (e) {} } };
    process.on("exit", stop);
    const serveCmd = {{input.serve_command}};
    const readyUrl = {{input.serve_ready_url}};
    const timeoutMs = Math.max(1, Number({{input.serve_timeout_seconds}}) || 120) * 1000;
    const pagesDir = path.join(WS, ".ultra11y", "pages");
    const started = Date.now();
    const sample = (() => { try { const rc = L.readJSON(path.join(WS, ".ultra11yrc.json")); return ((rc.sample && rc.sample.pages) || []).length; } catch (e) { return 0; } })();
    const main = async () => {
      if (serveCmd) {
        const log = fs.openSync(path.join(RUN, "serve.log"), "w");
        // bash runs the command as a child and forwards our SIGTERM to it.
        server = cp.spawn("bash", ["-c", "( " + serveCmd + " ) & child=$!; trap 'kill -TERM $child 2>/dev/null' TERM INT EXIT; wait $child"], { cwd: WS, stdio: ["ignore", log, log] });
        server.on("error", () => {});
        fs.writeFileSync(path.join(RUN, "serve.pid"), String(server.pid));
        if (readyUrl) {
          const deadline = Date.now() + timeoutMs;
          let up = false;
          while (Date.now() < deadline) {
            if (server.exitCode !== null) return degrade("the serve command exited with " + server.exitCode + " before the site answered (serve.log in the run directory)");
            try { const res = await fetch(readyUrl); if (res.status < 500) { up = true; break; } } catch (e) {}
            await new Promise((r) => setTimeout(r, 1000));
          }
          if (!up) return degrade("the served site did not answer at " + readyUrl + " within " + timeoutMs / 1000 + "s (serve.log in the run directory)");
        }
      }
      const check = L.engine(["sample", "check", "--standard", STD, "--json"], { cwd: WS, timeoutMs: 120000 });
      // A refused lint (no sample block, unreadable rc) is the layer's failure, never an empty "missing" list.
      // Under --json the engine prints an invalid block's issues on stdout, a
      // missing block's refusal on stderr.
      if (check.code !== 0 || !check.json) return degrade("sample check exit " + check.code + ": " + ((check.json && Array.isArray(check.json.issues) && check.json.issues.length) ? check.json.issues.map((i) => (i && i.path ? i.path + ": " : "") + (i && i.message)).join("; ") : (check.stderr || "").slice(-800)));
      const missing = Array.isArray(check.json.missing) ? check.json.missing.map((m) => m.id || m) : [];
      const scan = L.engine(["scan", "--sample", "--runtime", "local", "--cwd", {{input.engine_pkg_dir}}, "--standard", STD, "--merge", L.auditPath(), "--out", RUN, "--json"], { cwd: WS, timeoutMs: 2700000 });
      if (scan.code !== 0 || !scan.json) return degrade("scan --sample exit " + scan.code + ": " + (scan.stderr || "").slice(-1500));
      sha = L.commitAudit();
      // The scan's JSON is the merged document; the captures it wrote are
      // the page directories touched since this node started.
      let recorded = 0;
      if (L.exists(pagesDir)) for (const d of fs.readdirSync(pagesDir)) { try { if (fs.statSync(path.join(pagesDir, d)).mtimeMs >= started - 1000) recorded++; } catch (e) {} }
      const refused = Math.max(0, sample - recorded);
      L.layer("rendered", { status: "ok", pages_recorded: recorded, pages_refused: refused, missing_kinds: missing });
      L.out(L.record("render", { ok: true, fail_code: "", reason: "", status: "ok", pages_recorded: recorded, pages_refused: refused, missing_kinds: missing, audit_sha256: sha }));
    };
    main().catch((e) => L.die("render: " + (e && e.stack || e)));
  language: js
  input: render_input
  output: render_output
  publish: rendered_bank

## The committed verdict ledger, REPLAYED, never believed: the engine
## re-grounds every entry on today's source and names the stale ones, which
## stay « à évaluer » and go back to the agents. An unreadable ledger is a
## typed refusal; an absent one is simply a first run.
tool ledger_replay:
  script: |
    const fs = require("fs"), path = require("path");
    const RUN = {{input.run_dir}};
    const L = require(path.join(RUN, "bin", "lib.js")).init(RUN);
    const STD = {{input.standard}};
    let sha = L.checkAudit();
    const prior = L.once("ledger_replay");
    if (prior) L.out(prior);
    // `copy` is what the final fold merges into: written only from a replay
    // the engine finished. The engine replays a separate input file, and
    // writes its audit beside the real one, moved into place once it is whole.
    const copy = path.join(RUN, "ledger", STD + ".json");
    const input = path.join(RUN, "ledger", STD + ".replay-input.json");
    const replayOut = path.join(RUN, "replay");
    const none = (reason) => { L.layer("ledger", { status: "absent", reason: reason }); L.out({ ok: true, fail_code: "", reason: reason, present: false, replayed: 0, stale: 0, obsolete: 0, missing: 0, refused: 0, recommendations_stripped: 0, audit_sha256: sha }); };
    if (!{{input.ledger_present}}) none("no ledger at " + {{input.ledger_path}});
    let doc;
    try { doc = L.readJSON({{input.ledger_path}}); } catch (e) { L.refuse("LEDGER_INVALID", "the ledger at " + {{input.ledger_path}} + " is not readable JSON: " + e.message, { present: true, replayed: 0, stale: 0, obsolete: 0, missing: 0, refused: 0, recommendations_stripped: 0, audit_sha256: sha }); }
    const entries = Array.isArray(doc) ? doc : (doc && Array.isArray(doc.entries) ? doc.entries : null);
    if (!entries) L.refuse("LEDGER_INVALID", "the ledger at " + {{input.ledger_path}} + " carries no entries[] array", { present: true, replayed: 0, stale: 0, obsolete: 0, missing: 0, refused: 0, recommendations_stripped: 0, audit_sha256: sha });
    if (entries.length === 0) none("the ledger at " + {{input.ledger_path}} + " is empty");
    // Every entry the engine writes is an object keyed by a string criterion
    // id; anything else is not an entry it wrote, and is refused by name.
    entries.forEach((e, i) => { if (!L.isObj(e) || typeof e.criteriaId !== "string") L.refuse("LEDGER_INVALID", "the ledger at " + {{input.ledger_path}} + " carries an entry #" + i + " that is not an object with a criteriaId", { present: true, replayed: 0, stale: 0, obsolete: 0, missing: 0, refused: 0, recommendations_stripped: 0, audit_sha256: sha }); });
    // The engine re-grounds a stored recommendation at replay with no fallback:
    // an advised element since edited — what a recommendation asks for — would
    // refuse the whole replayed verdict. A recommendation is non-normative, so
    // the replayed copy carries none (counted).
    let recStripped = 0;
    const replayable = entries.map((e) => { if (!L.isObj(e) || !Object.prototype.hasOwnProperty.call(e, "recommendations")) return e; const rec = e.recommendations; recStripped += Array.isArray(rec) ? rec.length : (rec === null || rec === undefined ? 0 : 1); const o = Object.assign({}, e); delete o.recommendations; return o; });
    L.writeJSON(input, Array.isArray(doc) ? replayable : Object.assign({}, doc, { entries: replayable }));
    const replayedDoc = path.join(replayOut, "audit-latest.json");
    if (L.exists(replayedDoc)) fs.unlinkSync(replayedDoc);
    const r = L.engine(["verify", "--apply", input, "--in", L.auditPath(), "--out", replayOut, "--json"].concat(L.std(STD)), { cwd: {{input.workspace_dir}} });
    if (r.code === null) L.die("the engine was killed by a signal during the ledger replay (the audit is untouched): " + (r.stderr || "").trim().slice(-600));
    if (r.code === 2 || (r.code !== 0 && r.code !== 1)) L.refuse("LEDGER_INVALID", "the engine refused the ledger (exit " + r.code + "): " + (r.stderr || r.stdout).slice(-1500), { present: true, replayed: 0, stale: 0, obsolete: 0, missing: 0, refused: 0, recommendations_stripped: 0, audit_sha256: sha });
    // The replay reads stored fields with string methods and no shape check,
    // so a value it cannot read (a hand edit, or one the engine wrote and
    // cannot read back) kills it before it writes anything: that is the
    // ledger's refusal, with the engine's own message — never a guess at which
    // field shapes it would have read. A system error (EACCES, ENOSPC…) is the
    // environment's, not the ledger's: it stays an untyped, resumable death.
    const said = (r.stderr || "").trim().slice(-600);
    if (!r.json && /^E[A-Z]+: /m.test(said)) L.die("the engine failed on its environment, not on the ledger (exit " + r.code + "): " + said);
    if (!r.json) L.refuse("LEDGER_INVALID", "the engine could not replay the ledger at " + {{input.ledger_path}} + " (exit " + r.code + ", no JSON): " + (said || "no message"), { present: true, replayed: 0, stale: 0, obsolete: 0, missing: 0, refused: 0, recommendations_stripped: 0, audit_sha256: sha });
    // Exit 1 (every fresh entry refused by the gate) nests the replay's own
    // accounting under `replay`; exit 0 prints it at the top level.
    const rp = L.isObj(r.json.replay) ? r.json.replay : r.json;
    const stale = rp.stale || [], obsolete = rp.obsolete || [], missing = rp.missing || [];
    // A fresh entry the engine's gate still refuses goes back to « à évaluer »
    // like a stale one: named, and out of the copy.
    const refused = L.rejectedOf(r.json, "the ledger replay").map(String);
    const dropped = new Set([].concat(stale, obsolete, missing, refused).map(String));
    // The copy the final fold merges into keeps only what replayed.
    const kept = Object.assign({}, Array.isArray(doc) ? { kind: "verdict-ledger" } : doc, { entries: replayable.filter((e) => !dropped.has(String(e.criteriaId))) });
    // Exit 1 writes no audit; exit 0 wrote a whole one beside the real audit.
    if (L.exists(replayedDoc)) fs.renameSync(replayedDoc, L.auditPath());
    L.writeJSON(copy, kept);
    sha = L.commitAudit();
    const fresh = r.json.replayed !== undefined ? Number(r.json.replayed || 0) : (Array.isArray(rp.fresh) ? rp.fresh.length : 0);
    const replayed = Math.max(0, fresh - refused.length);
    L.layer("ledger", { status: refused.length ? "degraded" : "ok", path: {{input.ledger_path}}, replayed: replayed, stale: stale, obsolete: obsolete, missing: missing, refused: refused, recommendations_stripped: recStripped });
    L.out(L.record("ledger_replay", { ok: true, fail_code: "", reason: "", present: true, replayed: replayed, stale: stale.length, obsolete: obsolete.length, missing: missing.length, refused: refused.length, recommendations_stripped: recStripped, audit_sha256: sha }));
  language: js
  input: replay_input
  output: replay_output
  publish: replay_bank

## The worklist the engine writes: one item per criterion still « à évaluer »,
## with the harvested evidence, and one normative brief per criterion. Each
## item is also written to its own small file so an agent reads its batch
## and nothing else.
tool worklist:
  script: |
    const path = require("path");
    const RUN = {{input.run_dir}};
    const L = require(path.join(RUN, "bin", "lib.js")).init(RUN);
    const sha = L.checkAudit();
    const r = L.engineJSON(["verify", "--manual", "--in", L.auditPath(), "--out", RUN, "--no-web", "--json"].concat(L.std({{input.standard}})), { cwd: {{input.workspace_dir}} });
    if (r.code !== 0) L.die("verify --manual exit " + r.code + ": " + r.stderr.slice(-3000));
    const w = r.json;
    const todo = L.readJSON(w.todoPath), skeleton = L.readJSON(w.verdictsPath);
    const itemsDir = path.join(RUN, "items");
    const ids = [];
    for (const it of todo.items || []) { ids.push(it.criteriaId); L.writeJSON(path.join(itemsDir, it.criteriaId + ".json"), it); }
    L.writeJSON(path.join(RUN, "pending.json"), { round: 0, ids: ids, issues: {} });
    L.writeJSON(path.join(RUN, "worklist.json"), { count: Number(w.count || 0), ids: ids, items_dir: itemsDir, briefs_dir: w.itemsDir, todo_path: w.todoPath, verdicts_path: w.verdictsPath, contract: skeleton.contract || {} });
    L.layer("worklist", { status: "ok", count: Number(w.count || 0) });
    L.out({ ok: true, fail_code: "", reason: "", count: Number(w.count || 0), items_dir: itemsDir, briefs_dir: w.itemsDir, todo_path: w.todoPath, verdicts_path: w.verdictsPath, pending_ids: ids, contract: skeleton.contract || {}, audit_sha256: sha });
  language: js
  input: worklist_input
  output: worklist_output

## Batches for the fan-out: the pending criteria (all of them on round 0,
## the fold's named refusals on a re-ask), grouped by theme, at most
## batch_size each. File-driven and idempotent: a resume replans the same.
tool plan_batches:
  script: |
    const path = require("path");
    const RUN = {{input.run_dir}};
    const L = require(path.join(RUN, "bin", "lib.js")).init(RUN);
    const pending = L.readJSON(path.join(RUN, "pending.json"));
    const asked = Number({{input.batch_size}});
    const size = Number.isInteger(asked) && asked > 0 ? asked : 8;
    const byTheme = {};
    const themeOf = (id) => String(id).split(".")[0];
    const ids = pending.ids.slice().sort((a, b) => { const ta = Number(themeOf(a)), tb = Number(themeOf(b)); if (ta !== tb) return ta - tb; return Number(String(a).split(".")[1] || 0) - Number(String(b).split(".")[1] || 0); });
    for (const id of ids) (byTheme[themeOf(id)] = byTheme[themeOf(id)] || []).push(id);
    const batches = [];
    for (const theme of Object.keys(byTheme).sort((a, b) => Number(a) - Number(b))) {
      const list = byTheme[theme];
      for (let i = 0; i < list.length; i += size) {
        const chunk = list.slice(i, i + size);
        const id = "r" + pending.round + "-b" + String(batches.length + 1).padStart(2, "0");
        const prior = {};
        for (const c of chunk) if (pending.issues && pending.issues[c]) prior[c] = pending.issues[c];
        const b = { id: id, round: pending.round, theme: theme, ids: chunk, count: chunk.length, prior_issues: prior };
        L.writeJSON(path.join(RUN, "batches", id + ".json"), b);
        batches.push(b);
      }
    }
    L.out({ batches: batches, count: batches.length, round: pending.round });
  language: js
  input: plan_input
  output: plan_output

## Item-keyed write of one batch's verdicts: ids outside the batch are
## dropped and counted, two verdicts for one id cancel each other, every
## nested field is held to the one shape the engine's fold survives,
## nothing else is judged. Each replay writes its own file, so concurrent
## branches never collide.
tool write_fragment:
  script: |
    const path = require("path");
    const RUN = {{input.run_dir}};
    const L = require(path.join(RUN, "bin", "lib.js")).init(RUN);
    const allowed = new Set(({{input.ids}} || []).map(String));
    let raw = {{input.verdicts}};
    if (typeof raw === "string") { try { raw = JSON.parse(raw); } catch (e) { raw = []; } }
    if (raw && !Array.isArray(raw) && Array.isArray(raw.verdicts)) raw = raw.verdicts;
    if (!Array.isArray(raw)) raw = [];
    const byId = {}, count = {}, recDropped = {};
    let foreign = 0, malformed = 0;
    // The engine reads a verdict trimmed and case-blind among the verdicts
    // its contract lists: written here in its own spelling, the merge and the
    // fold read the verdict the engine folds.
    const contract = L.readJSON(path.join(RUN, "worklist.json")).contract || {};
    if (!Array.isArray(contract.verdicts) || !contract.verdicts.length) L.die("the worklist carries no engine verdict vocabulary (contract.verdicts)");
    const VERDICTS = contract.verdicts.map(String);
    const verdictOf = (x) => { if (x === undefined || x === null) return null; const w = String(x), k = w.trim().toLowerCase(); return VERDICTS.find((d) => d.toLowerCase() === k) || w; };
    for (const v of raw) {
      if (!L.isObj(v)) { malformed++; continue; }
      const id = String(v.criteriaId || v.id || "");
      if (!allowed.has(id)) { foreign++; continue; }
      count[id] = (count[id] || 0) + 1;
      const o = { criteriaId: id, verdict: verdictOf(v.verdict), justification: typeof v.justification === "string" ? v.justification : "" };
      if (typeof v.reason === "string") o.reason = v.reason;
      if (Array.isArray(v.citations)) { o.citations = []; for (const c of v.citations) { const n = L.citation(c); if (n) o.citations.push(n); else malformed++; } }
      if (Array.isArray(v.findings)) { o.findings = []; for (const f of v.findings) { const n = L.finding(f); if (n) o.findings.push(n); else malformed++; } }
      // The engine refuses the whole verdict over one recommendation that is
      // not an anchored object, and offers to drop it instead: dropped here,
      // counted per criterion.
      recDropped[id] = 0;
      if (Array.isArray(v.recommendations)) { o.recommendations = []; for (const r of v.recommendations) { const n = L.recommendation(r); if (n) o.recommendations.push(n); else recDropped[id]++; } }
      else if (v.recommendations !== undefined && v.recommendations !== null) recDropped[id]++;
      byId[id] = o;
    }
    let duplicate = 0;
    const kept = [];
    for (const id of Object.keys(byId).sort()) { if (count[id] > 1) { duplicate++; continue; } kept.push(byId[id]); }
    const id = {{input.batch_id}};
    const recDroppedKept = {};
    for (const v of kept) recDroppedKept[v.criteriaId] = recDropped[v.criteriaId];
    const recTotal = kept.reduce((n, v) => n + recDropped[v.criteriaId], 0);
    L.writeJSON(path.join(RUN, "fragments", id + ".json"), { batch_id: id, round: {{input.round}}, verdicts: kept, foreign: foreign, duplicate: duplicate, malformed: malformed, duplicate_ids: Object.keys(count).filter((k) => count[k] > 1), recommendations_dropped: recDroppedKept });
    L.out({ batch_id: id, written: kept.length, foreign: foreign, duplicate: duplicate, malformed: malformed, missing: allowed.size - kept.length, recommendations_dropped: recTotal });
  language: js
  input: fragment_input
  output: fragment_output
  parallel_safe: true

## The one writer of adjudication.json: every fragment of every round,
## later rounds winning per criterion, keyed by id — never by arrival
## order. A branch that died is named (its batch has no fragment), never
## hidden. Two bot-side checks the engine does not make: a citation must be
## one of the anchors THIS criterion's evidence shows (the engine grounds a
## citation on the source file, which would accept a stray line), and a NA
## on a criterion the engine harvested evidence for must cite that evidence
## (the contract says so; the fold accepts a bare NA). A recommendation is
## non-normative: one that stands on no anchor of the criterion's evidence
## is dropped and counted, never allowed to cost the verdict it rides on.
tool merge_verdicts:
  script: |
    const path = require("path");
    const RUN = {{input.run_dir}};
    const L = require(path.join(RUN, "bin", "lib.js")).init(RUN);
    const round = {{input.round}};
    const wl = L.readJSON(path.join(RUN, "worklist.json"));
    const skeleton = L.readJSON(wl.verdicts_path);
    const planned = L.listJSON(path.join(RUN, "batches"), "r" + round + "-").map((p) => L.readJSON(p));
    const fragments = L.listJSON(path.join(RUN, "fragments")).map((p) => L.readJSON(p)).sort((a, b) => (a.round - b.round) || (a.batch_id < b.batch_id ? -1 : 1));
    const have = new Set(fragments.map((f) => f.batch_id));
    const failed = planned.filter((b) => !have.has(b.id)).map((b) => b.id);
    const issues = L.exists(path.join(RUN, "issues.json")) ? L.readJSON(path.join(RUN, "issues.json")) : {};
    const byId = {}, recDropped = {};
    let foreignDropped = 0;
    for (const f of fragments) {
      foreignDropped += Number(f.foreign || 0) + Number(f.duplicate || 0) + Number(f.malformed || 0);
      for (const v of f.verdicts || []) { byId[v.criteriaId] = v; recDropped[v.criteriaId] = Number(L.isObj(f.recommendations_dropped) ? f.recommendations_dropped[v.criteriaId] || 0 : 0); }
      for (const id of f.duplicate_ids || []) if (f.round === round) issues[id] = "two verdicts were returned for this criterion in one batch — return exactly one";
    }
    let citationRejected = 0;
    const anchorKey = (a) => String(a.file) + ":" + String(a.line);
    const evidenceOf = (id) => L.readJSON(path.join(wl.items_dir, id + ".json")).evidence || [];
    for (const id of Object.keys(byId)) {
      const v = byId[id];
      const evidence = evidenceOf(id);
      const anchors = evidence.map(anchorKey);
      const cited = Array.isArray(v.citations) ? v.citations : [];
      const stray = cited.filter((c) => !anchors.includes(anchorKey(c)));
      if (stray.length) { citationRejected++; issues[id] = "a " + v.verdict + " verdict cited an anchor outside this criterion's own evidence (" + stray.map((c) => c.file + ":" + c.line).join(", ") + ") — cite only the evidence shown"; delete byId[id]; continue; }
      if (v.verdict === "NA" && anchors.length && cited.length === 0) { citationRejected++; issues[id] = "a NA verdict on a criterion the engine harvested evidence for must cite that evidence (out of scope, not cleared) — copy the evidence anchors into citations[]"; delete byId[id]; continue; }
      // A kept recommendation takes the snippet and selector of the anchor it
      // stands on, unless it copies or excerpts it: the fold grounds a
      // recommendation with no fallback, and a recommendation never costs its
      // verdict. Citations reach the fold as written (fold_final restores the
      // ones the engine accepts); findings stay as written.
      if (Array.isArray(v.recommendations)) {
        const anchored = [];
        for (const r of v.recommendations) { const near = L.nearestAnchor(evidence, r); if (near) anchored.push(L.restoreFrom(r, near)); else recDropped[id]++; }
        v.recommendations = anchored;
      }
    }
    const items = [];
    let recommendationsDropped = 0;
    for (const id of wl.ids) if (byId[id] && byId[id].verdict) { items.push(byId[id]); recommendationsDropped += recDropped[id] || 0; }
    const adjudication = Object.assign({}, skeleton, { items: items });
    L.writeJSON(path.join(RUN, "adjudication.json"), adjudication);
    L.writeJSON(path.join(RUN, "issues.json"), issues);
    L.layer("adjudication", { status: failed.length ? "degraded" : "ok", round: round, filled: items.length, unfilled: wl.ids.length - items.length, failed_batches: failed, foreign_dropped: foreignDropped, citation_rejected: citationRejected, recommendations_dropped: recommendationsDropped });
    L.out({ ok: true, fail_code: "", reason: failed.length ? "batches without a fragment: " + failed.join(", ") : "", filled: items.length, unfilled: wl.ids.length - items.length, failed_batches: failed, foreign_dropped: foreignDropped, citation_rejected: citationRejected, recommendations_dropped: recommendationsDropped });
  language: js
  input: merge_input
  output: merge_output
  await: best_effort

## The fold, PROBED on a copy: names what the engine refuses and what is
## still open, writes the next re-ask, touches nothing real. The real audit
## is folded exactly once, by fold_final.
tool fold_probe:
  script: |
    const path = require("path");
    const RUN = {{input.run_dir}};
    const L = require(path.join(RUN, "bin", "lib.js")).init(RUN);
    const round = {{input.round}};
    L.checkAudit();
    const wl = L.readJSON(path.join(RUN, "worklist.json"));
    const adj = L.readJSON(path.join(RUN, "adjudication.json"));
    const dir = path.join(RUN, "probe", "r" + round);
    const copy = path.join(dir, "audit-latest.json");
    L.writeJSON(copy, L.readJSON(L.auditPath()));
    let applied = 0, rejected = [], issueList = [];
    if (adj.items.length) {
      const r = L.engine(["verify", "--apply", path.join(RUN, "adjudication.json"), "--in", copy, "--out", dir, "--json"].concat(L.std({{input.standard}})), { cwd: {{input.workspace_dir}} });
      if (!r.json) L.die("fold probe printed no JSON (exit " + r.code + "): " + r.stderr.slice(-3000));
      applied = Number(r.json.applied || 0); rejected = L.rejectedOf(r.json, "the fold probe").map(String); issueList = (r.json.issues || []).map(String);
    }
    const probed = L.readJSON(copy);
    const filled = new Set(adj.items.map((i) => i.criteriaId));
    const unfilled = wl.ids.filter((id) => !filled.has(id));
    const flaggedOpen = L.flagged(probed);
    const issues = L.exists(path.join(RUN, "issues.json")) ? L.readJSON(path.join(RUN, "issues.json")) : {};
    const general = [];
    // The engine names a criterion the merge already sent back as a coverage
    // gap; the merge's own reason (the stray citation) is the one to re-ask with.
    for (const s of issueList) { const m = s.match(/^criterion (\S+): (.*)$/); if (!m) { general.push(s); continue; } if (!issues[m[1]] || !/coverage gap/.test(m[2])) issues[m[1]] = m[2]; }
    for (const id of rejected) if (!issues[id]) issues[id] = "refused by the fold" + (general.length ? ": " + general.join(" | ") : "");
    for (const id of flaggedOpen) if (!rejected.includes(id) && !unfilled.includes(id)) issues[id] = "the engine found no subject for this criterion and a manual verdict leaves the report inconsistent — decide NA (no subject in the audited scope) or C/NC on the evidence";
    const pendingIds = Array.from(new Set([].concat(rejected, unfilled, flaggedOpen))).sort();
    const pendingIssues = {};
    for (const id of pendingIds) pendingIssues[id] = issues[id] || "no verdict received";
    L.writeJSON(path.join(RUN, "pending.json"), { round: round + 1, ids: pendingIds, issues: pendingIssues });
    L.writeJSON(path.join(RUN, "issues.json"), issues);
    L.out({ ok: true, fail_code: "", reason: "", pending: pendingIds.length, pending_ids: pendingIds, applied: applied, rejected: rejected.length, unfilled: unfilled.length, flagged_open: flaggedOpen.length, round: round });
  language: js
  input: probe_input
  output: probe_output

## THE fold of the real audit: partial, once, with the ledger merged into
## the replayed copy. What the engine still refuses stays « à évaluer » and
## is named in the annex; under require_complete it is a typed refusal. A
## citation the fold forgives as written can still fail the trial, which
## grounds a conformity's citations as stored, with no fallback to the anchor
## (SocialGouv/ultra11y#50): each citation of a conformity that neither
## copies nor excerpts an anchor at its own file:line is given the snippet
## and selector of the anchor it stands on, the engine judges both versions
## on copies of the audit, and a criterion keeps its restored citations only
## where it accepts both and the restored text grounds as written — the
## fold's verdict is the as-written one.
tool fold_final:
  script: |
    const path = require("path");
    const RUN = {{input.run_dir}};
    const L = require(path.join(RUN, "bin", "lib.js")).init(RUN);
    const STD = {{input.standard}};
    let sha = L.checkAudit();
    const prior = L.once("fold_final");
    if (prior) L.out(prior);
    const adj = L.readJSON(path.join(RUN, "adjudication.json"));
    const ledger = path.join(RUN, "ledger", STD + ".json");
    const wl = L.readJSON(path.join(RUN, "worklist.json"));
    const candidates = {};
    for (const it of adj.items) {
      if (it.verdict !== "C" || !Array.isArray(it.citations) || !it.citations.length) continue;
      const evidence = L.readJSON(path.join(wl.items_dir, it.criteriaId + ".json")).evidence || [];
      const probes = [];
      const citations = it.citations.map((c) => { const near = L.nearestAnchor(evidence, c); const r = near ? L.restoreFrom(c, near) : c; if (r !== c) probes.push(Object.assign({}, r, { message: "literal grounding probe" })); return r; });
      if (probes.length) candidates[it.criteriaId] = { item: Object.assign({}, it, { citations: citations }), changed: probes.length, probes: probes };
    }
    let folded = adj, citationsRestored = 0;
    const restoredIds = [], keptIds = [];
    if (Object.keys(candidates).length) {
      const refusedBy = (name, doc) => {
        const dir = path.join(RUN, "restore", name);
        L.writeJSON(path.join(dir, "adjudication.json"), doc);
        L.writeJSON(path.join(dir, "audit-latest.json"), L.readJSON(L.auditPath()));
        const r = L.engine(["verify", "--apply", path.join(dir, "adjudication.json"), "--in", path.join(dir, "audit-latest.json"), "--out", dir, "--json"].concat(L.std(STD)), { cwd: {{input.workspace_dir}} });
        if (!r.json) L.die("the " + name + " restore probe printed no JSON (exit " + r.code + "): " + r.stderr.slice(-3000));
        return new Set(L.rejectedOf(r.json, "the " + name + " restore probe").map(String));
      };
      const asWritten = refusedBy("as-written", adj);
      // The restored version is probed with each restored citation also
      // posed as a recommendation: the fold grounds a recommendation
      // literally, as the trial grounds a citation, so a restored text that
      // does not ground (an anchor snippet cut inside a decomposed accent,
      // which the fold would still forgive through another anchor) is
      // refused there.
      const restored = refusedBy("restored", Object.assign({}, adj, { items: adj.items.map((it) => { const c = candidates[it.criteriaId]; return c ? Object.assign({}, c.item, { recommendations: (c.item.recommendations || []).concat(c.probes) }) : it; }) }));
      folded = Object.assign({}, adj, { items: adj.items.map((it) => {
        const c = candidates[it.criteriaId];
        if (!c) return it;
        if (asWritten.has(it.criteriaId) || restored.has(it.criteriaId)) { keptIds.push(it.criteriaId); return it; }
        restoredIds.push(it.criteriaId);
        citationsRestored += c.changed;
        return c.item;
      }) });
    }
    const foldedPath = path.join(RUN, "adjudication.folded.json");
    L.writeJSON(foldedPath, folded);
    let applied = 0, stillManual = 0, rejected = [];
    if (folded.items.length) {
      const r = L.engine(["verify", "--apply", foldedPath, "--in", L.auditPath(), "--out", RUN, "--ledger", ledger, "--json"].concat(L.std(STD)), { cwd: {{input.workspace_dir}} });
      if (!r.json) L.die("the final fold printed no JSON (exit " + r.code + "): " + r.stderr.slice(-3000));
      applied = Number(r.json.applied || 0); stillManual = Number(r.json.stillManual || 0); rejected = L.rejectedOf(r.json, "the final fold").map(String);
    }
    sha = L.commitAudit();
    const doc = L.readJSON(L.auditPath());
    const open = L.undecided(doc), flaggedOpen = L.flagged(doc);
    L.layer("fold", { status: open.length ? "partial" : "ok", applied: applied, still_manual: stillManual, rejected: rejected, still_open: open, flagged_open: flaggedOpen, ledger: L.exists(ledger) ? ledger : "", citations_restored: citationsRestored, citations_restored_ids: restoredIds, citations_kept_ids: keptIds });
    const base = { applied: applied, still_manual: stillManual, rejected: rejected.length, still_open: open.length, still_open_ids: open, flagged_open: flaggedOpen.length, citations_restored: citationsRestored, ledger_path: L.exists(ledger) ? ledger : "", audit_sha256: sha };
    if ({{input.require_complete}} && open.length) L.out(L.record("fold_final", Object.assign({ ok: false, fail_code: "ADJUDICATION_INCOMPLETE", reason: open.length + " criteria are still « à évaluer » after the fold and require_complete is set: " + open.join(", ") }, base)));
    L.out(L.record("fold_final", Object.assign({ ok: true, fail_code: "", reason: "" }, base)));
  language: js
  input: fold_input
  output: fold_output

## The draft report and the trial worklist of its claims (every stated NC
## and every landed conformity) for the second reader. The landed
## conformities come from the audit — the source the engine re-derives the
## trial's coverage from when it applies it — never from the ledger copy,
## whose anchors may be written another way (relative, or another run's
## worktree) and would leave those claims « absent from the trial ».
tool draft_report:
  script: |
    const path = require("path");
    const RUN = {{input.run_dir}};
    const L = require(path.join(RUN, "bin", "lib.js")).init(RUN);
    const STD = {{input.standard}};
    const sha = L.checkAudit();
    const rep = L.generateReport(path.join(RUN, "draft"), false, STD, { cwd: {{input.workspace_dir}} });
    if (rep.code !== 0 || !rep.json.path) L.die("draft report exit " + rep.code + ": " + rep.stderr.slice(-3000));
    const parts = L.reportParts(rep.json, path.join(RUN, "draft"), false);
    const args = ["verify", "--report", rep.json.path, "--in", L.auditPath(), "--out", path.join(RUN, "refute"), "--max-verify", "0", "--json"].concat(L.std(STD));
    const v = L.engineJSON(args, { cwd: {{input.workspace_dir}} });
    if (v.code !== 0 || !v.json.todoPath) L.die("verify --report exit " + v.code + ": " + v.stderr.slice(-3000));
    L.writeJSON(path.join(RUN, "refute", "pending.json"), { round: 0, ns: (v.json.items || []).map((i) => i.n) });
    L.writeJSON(path.join(RUN, "draft", "draft.json"), { draft_path: rep.json.path, technical_annex_path: parts.annex, todo_path: v.json.todoPath, claims: Number(v.json.count || 0) });
    L.out({ ok: true, fail_code: "", reason: "", draft_path: rep.json.path, technical_annex_path: parts.annex, claims: Number(v.json.count || 0), nc_claims: Number(v.json.nc || 0), c_claims: Number(v.json.conformities || 0), todo_path: v.json.todoPath, audit_sha256: sha });
  language: js
  input: draft_input
  output: draft_output

## Batches of claims for the second reader (the pending ones on a re-ask).
tool plan_refute:
  script: |
    const path = require("path");
    const RUN = {{input.run_dir}};
    const L = require(path.join(RUN, "bin", "lib.js")).init(RUN);
    const draft = L.readJSON(path.join(RUN, "draft", "draft.json"));
    const todo = L.readJSON(draft.todo_path);
    const pending = L.readJSON(path.join(RUN, "refute", "pending.json"));
    const want = new Set(pending.ns.map(Number));
    const items = todo.filter((i) => want.has(Number(i.n)));
    const asked = Number({{input.batch_size}});
    const size = Number.isInteger(asked) && asked > 0 ? asked : 10;
    const batches = [];
    for (let i = 0; i < items.length; i += size) {
      const chunk = items.slice(i, i + size);
      const id = "r" + pending.round + "-c" + String(batches.length + 1).padStart(2, "0");
      const b = { id: id, round: pending.round, ns: chunk.map((c) => Number(c.n)), items: chunk.map((c) => ({ n: c.n, criteriaId: c.criteriaId, file: c.file, line: c.line, selector: c.selector, claim: c.claim, kind: c.kind || "nc", citations: c.citations || [] })) };
      L.writeJSON(path.join(RUN, "refute", "batches", id + ".json"), b);
      batches.push(b);
    }
    L.out({ batches: batches, count: batches.length, round: pending.round });
  language: js
  input: plan_refute_input
  output: plan_refute_output

tool write_refute_fragment:
  script: |
    const path = require("path");
    const RUN = {{input.run_dir}};
    const L = require(path.join(RUN, "bin", "lib.js")).init(RUN);
    const allowed = new Set(({{input.ns}} || []).map(Number));
    const vocab = new Set(["supported", "partial", "refuted", "unsupported"]);
    let raw = {{input.verdicts}};
    if (typeof raw === "string") { try { raw = JSON.parse(raw); } catch (e) { raw = []; } }
    if (raw && !Array.isArray(raw) && Array.isArray(raw.verdicts)) raw = raw.verdicts;
    if (!Array.isArray(raw)) raw = [];
    const seen = new Set(), kept = [];
    let foreign = 0, invalid = 0;
    for (const v of raw) {
      if (!L.isObj(v)) { invalid++; continue; }
      const n = Number(v.n);
      if (!allowed.has(n)) { foreign++; continue; }
      if (seen.has(n)) continue;
      const verdict = String(v.verdict || "").toLowerCase();
      if (!vocab.has(verdict)) { invalid++; continue; }
      seen.add(n);
      kept.push({ n: n, verdict: verdict, note: typeof v.note === "string" ? v.note : "" });
    }
    const id = {{input.batch_id}};
    L.writeJSON(path.join(RUN, "refute", "fragments", id + ".json"), { batch_id: id, round: {{input.round}}, verdicts: kept });
    L.out({ batch_id: id, written: kept.length, foreign: foreign, missing: allowed.size - kept.length, invalid: invalid });
  language: js
  input: refute_fragment_input
  output: refute_fragment_output
  parallel_safe: true

## The one writer of the trial file. The engine applies a trial only when
## EVERY claim carries a verdict, so an unanswered claim is re-asked once
## and then the whole trial is reported as degraded, never half-applied.
tool merge_refutations:
  script: |
    const path = require("path");
    const RUN = {{input.run_dir}};
    const L = require(path.join(RUN, "bin", "lib.js")).init(RUN);
    const round = {{input.round}};
    const draft = L.readJSON(path.join(RUN, "draft", "draft.json"));
    const todo = L.readJSON(draft.todo_path);
    const planned = L.listJSON(path.join(RUN, "refute", "batches"), "r" + round + "-").map((p) => L.readJSON(p));
    const fragments = L.listJSON(path.join(RUN, "refute", "fragments")).map((p) => L.readJSON(p)).sort((a, b) => (a.round - b.round) || (a.batch_id < b.batch_id ? -1 : 1));
    const have = new Set(fragments.map((f) => f.batch_id));
    const failed = planned.filter((b) => !have.has(b.id)).map((b) => b.id);
    const byN = {};
    for (const f of fragments) for (const v of f.verdicts || []) byN[Number(v.n)] = v;
    let filled = 0, refuted = 0, unsupported = 0;
    const unfilled = [];
    for (const it of todo) { const v = byN[Number(it.n)]; if (v) { it.verdict = v.verdict; it.note = v.note; filled++; if (v.verdict === "refuted") refuted++; if (v.verdict === "unsupported") unsupported++; } else { it.verdict = null; it.note = ""; unfilled.push(Number(it.n)); } }
    L.writeJSON(draft.todo_path, todo);
    L.writeJSON(path.join(RUN, "refute", "pending.json"), { round: round + 1, ns: unfilled });
    L.out({ complete: unfilled.length === 0, filled: filled, unfilled: unfilled.length, refuted: refuted, unsupported: unsupported, failed_batches: failed });
  language: js
  input: merge_refute_input
  output: merge_refute_output
  await: best_effort

## Applies the trial — refuted conformities go back to « à évaluer » and
## leave the ledger, refuted agent findings are pruned, the engine's own
## static findings are never touched. An incomplete trial is not applied.
## What the engine prunes is reported whether or not it accepts the whole
## trial: with --prune it rewrites the audit and repairs the ledger whatever
## its verdict on coverage and grounding, so a refusal there (a claim without
## a verdict, a retained claim whose anchor does not ground) is named as the
## degradation of an applied trial. Under require_complete, degraded is a
## refusal (routed by review_gate).
tool refute_apply:
  script: |
    const path = require("path");
    const RUN = {{input.run_dir}};
    const L = require(path.join(RUN, "bin", "lib.js")).init(RUN);
    const STD = {{input.standard}};
    let sha = L.checkAudit();
    const prior = L.once("refute_apply");
    if (prior) L.out(prior);
    const draft = L.readJSON(path.join(RUN, "draft", "draft.json"));
    const ledger = path.join(RUN, "ledger", STD + ".json");
    if (!{{input.complete}}) {
      const reason = "claims left without a verdict after the re-ask; the trial was not applied";
      L.layer("refutation", { status: "degraded", reason: reason, applied: false });
      L.out(L.record("refute_apply", { ok: true, fail_code: "", reason: reason, applied: false, degraded: true, refuted: 0, unsupported: 0, cleared: [], removed_findings: 0, reopened: [], skipped_engine: 0, audit_sha256: sha }));
    }
    const r = L.engine(["verify", "--apply", draft.todo_path, "--report", draft.draft_path, "--in", L.auditPath(), "--out", RUN, "--prune", "--json"].concat(L.exists(ledger) ? ["--ledger", ledger] : [], L.std(STD)), { cwd: {{input.workspace_dir}} });
    if (!r.json) L.die("verify --apply <trial> --prune printed no JSON (exit " + r.code + "): " + r.stderr.slice(-3000));
    const j = r.json, g = L.isObj(j.grounding) ? j.grounding : {};
    // The engine's own write is the next link of the chain, never an outside
    // modification: it rewrites the audit whenever it could prune.
    sha = L.commitAudit();
    const refusals = [];
    if (!L.isObj(j.pruned)) refusals.push("the engine did not prune (" + (r.stderr || "").trim().slice(-800) + ")");
    if (Number(j.unadjudicated || 0)) refusals.push(Number(j.unadjudicated) + " claim(s) without a verdict");
    if (Number(j.invalid || 0)) refusals.push(Number(j.invalid) + " verdict(s) outside the trial vocabulary");
    if (Number(j.missing || 0)) refusals.push(Number(j.missing) + " claim(s) of the report absent from the trial");
    if (Number(g.failed || 0)) refusals.push(Number(g.failed) + " retained claim(s) whose anchor does not ground in the source: " + (Array.isArray(g.issues) ? g.issues.slice(0, 3).join(" | ") : ""));
    if (!j.ok && !refusals.length) refusals.push("the engine reported the trial as refused without a cause this node knows (exit " + r.code + ")");
    const pr = L.isObj(j.pruned) ? j.pruned : {};
    const cleared = (pr.clearedConformities || []).map(String);
    const reopened = Array.from(new Set([].concat(pr.clearedConformities || [], pr.reopenedCriteria || []).map(String))).sort();
    const reason = refusals.length ? "the engine refused part of the trial: " + refusals.join("; ") : "";
    const outcome = { applied: L.isObj(j.pruned), degraded: refusals.length > 0, refuted: Number(j.refuted || 0), unsupported: Number(j.unsupported || 0), cleared: cleared, removed_findings: Number(pr.removedFindings || 0), reopened: reopened, skipped_engine: Number(pr.skippedEngine || 0) };
    L.layer("refutation", Object.assign({ status: refusals.length ? "degraded" : "ok", reason: reason, grounding_failed: Number(g.failed || 0) }, outcome));
    L.out(L.record("refute_apply", Object.assign({ ok: true, fail_code: "", reason: reason }, outcome, { audit_sha256: sha })));
  language: js
  input: refute_apply_input
  output: refute_apply_output

## The operator's undecidable declarations, in the engine's own contract
## (`check --allow-undecided`): the committed file's entries that are still
## open, plus the human gate's, de-duplicated — only criteria still
## « à évaluer » qualify (the engine refuses a declared criterion that
## carries a verdict).
tool write_undecidable:
  script: |
    const path = require("path");
    const RUN = {{input.run_dir}};
    const L = require(path.join(RUN, "bin", "lib.js")).init(RUN);
    const open = new Set(L.undecided(L.readJSON(L.auditPath())));
    let ids = {{input.undecidable_ids}};
    if (typeof ids === "string") { try { ids = JSON.parse(ids); } catch (e) { ids = ids.split(/[,\s]+/); } }
    if (!Array.isArray(ids)) ids = [];
    const notes = String({{input.notes}} || "").trim();
    const byId = {};
    if ({{input.undecidable_present}}) { try { for (const e of (L.readJSON({{input.undecidable_path}}).entries || [])) if (L.isObj(e) && open.has(String(e.criteriaId))) byId[String(e.criteriaId)] = { criteriaId: String(e.criteriaId), reason: String(e.reason || ""), recordedBy: String(e.recordedBy || "declared") }; } catch (e) { L.die("the committed undecidable file " + {{input.undecidable_path}} + " is unreadable: " + e.message); } }
    for (const id of ids.map(String)) if (open.has(id)) byId[id] = { criteriaId: id, reason: notes || "déclaré indécidable par la revue humaine du run", recordedBy: "human-review:" + {{run.id}} };
    const entries = Object.keys(byId).sort().map((k) => byId[k]);
    const p = path.join(RUN, "undecidable-" + {{input.standard}} + ".json");
    L.writeJSON(p, { entries: entries });
    L.layer("human", { status: "ok", approved: true, undecidable: entries.map((e) => e.criteriaId), notes: notes });
    L.out({ written: entries.length, path: p });
  language: js
  input: undecidable_input
  output: undecidable_output

## The deliverable: the French report, its integrity check, the per-page
## grid when this run captured pages, the completeness check, and the
## coverage annex that names every layer — nothing in it is hard-coded.
tool final_report:
  script: |
    const fs = require("fs"), path = require("path");
    const RUN = {{input.run_dir}};
    const L = require(path.join(RUN, "bin", "lib.js")).init(RUN);
    const STD = {{input.standard}}, WS = {{input.workspace_dir}};
    const sha = L.checkAudit();
    const OUT = path.join(RUN, "out");
    fs.mkdirSync(OUT, { recursive: true });
    const degraded = {};
    const rep = L.generateReport(OUT, {{input.html_report}}, STD, { cwd: WS });
    if (rep.code !== 0 || !rep.json.path) L.die("final report exit " + rep.code + ": " + rep.stderr.slice(-3000));
    const parts = L.reportParts(rep.json, OUT, {{input.html_report}});
    const reportPath = parts.report, date = String(rep.json.date || new Date().toISOString().slice(0, 10));
    const doc = L.readJSON(L.auditPath());
    const counts = L.countDoc(doc), lines = parts.lines;
    const rate = L.rate(counts);
    const flaggedOpen = L.flagged(doc);
    if (!L.sameCounts(lines.decided, counts)) degraded.decided_line = "the report's « Décidés » line (" + JSON.stringify(lines.decided) + ") disagrees with the document (" + JSON.stringify(counts) + ")" + (flaggedOpen.length ? " — " + flaggedOpen.length + " criteria the engine marks without subject are still open: " + flaggedOpen.join(", ") : "");
    if (lines.rate !== rate) degraded.rate_line = "the report's « Taux de conformité » (" + lines.rate + ") disagrees with the rate computed from criteria[] (" + rate + ")";
    const chk = L.engineJSON(["check", "--report", reportPath, "--in", L.auditPath(), "--json", "--standard", STD], { cwd: WS });
    const base = { report_path: reportPath, technical_annex_path: parts.annex, html_path: parts.html, html_single_path: parts.single, grid_json_path: "", report_files: [], grid_path: "", annex_path: "", ledger_path: "", conformance_pct: Math.max(0, rate), provisional: counts.aEvaluer > 0 || rate < 0, complete: false, undecided: 0, undecided_ids: [], degraded: degraded, audit_sha256: sha };
    if (chk.code !== 0 || !chk.json.ok) {
      const issues = (chk.json.issues || []).map(String);
      if (flaggedOpen.length) degraded.integrity = "check --report refused the report while " + flaggedOpen.length + " engine-flagged criteria are still open (" + issues.join(" | ") + ")";
      else L.refuse("REPORT_INTEGRITY_FAILED", "the engine's integrity check refused its own report: " + issues.join(" | "), base);
    }
    const layers = L.layers();
    const renderedRan = !!(layers.rendered && layers.rendered.status === "ok");
    // The per-page grid, only from pages THIS run captured: a stale
    // snapshot in the workspace is not a measurement of today's site.
    let gridPath = "", gridJSONPath = "";
    if (renderedRan) {
      const g = L.engine(["pages", "--in", L.auditPath(), "--json", "--out", OUT].concat(L.std(STD)), { cwd: WS });
      const md = L.engine(["pages", "--in", L.auditPath()].concat(L.std(STD)), { cwd: WS });
      if (g.code === 0 && md.code === 0) { gridPath = path.join(OUT, STD + "-" + date + "-pages.md"); fs.writeFileSync(gridPath, md.stdout); gridJSONPath = L.reportFile(path.join(OUT, "pages.json"), OUT); }
      else degraded.pages = "the page grid could not be rendered (exit " + g.code + "/" + md.code + "): " + (g.stderr || md.stderr).slice(-800);
    }
    // Completeness: every criterion decided, by the engine's own check.
    const undecFile = L.exists(path.join(RUN, "undecidable-" + STD + ".json")) ? path.join(RUN, "undecidable-" + STD + ".json") : ({{input.undecidable_present}} ? {{input.undecidable_path}} : "");
    const cargs = ["check", "--in", L.auditPath(), "--require-decided=pages", "--json"].concat(undecFile ? ["--allow-undecided", undecFile] : [], renderedRan ? ["--require-rendered"] : [], ["--standard", STD]);
    const c = L.engineJSON(cargs, { cwd: WS });
    const dec = c.json.decided || {};
    const undecided = (dec.undecided || []).map(String);
    // The per-page cells the engine still holds open (`check
    // --require-decided=pages`): what the trial pruned can leave a page
    // cell « à évaluer » while the DOCUMENT decides the criterion.
    const pageGaps = (dec.pages || []).map((p) => ({ page: String(p.name || p.id), undecided: (p.undecided || []).map(String) }));
    const complete = !!c.json.ok;
    // The coverage annex (French, for the reader of the report).
    const st = (l) => l ? (l.status || "?") : "ignorée";
    const fmt = (v) => Array.isArray(v) ? (v.length ? v.join(", ") : "aucun") : String(v);
    const a = [];
    a.push("# Annexe de couverture — audit " + STD.toUpperCase() + " du " + date);
    a.push("");
    a.push("Rapport : `" + path.basename(reportPath) + "` · annexe technique : `" + path.basename(parts.annex) + "`" + (gridPath ? " · grille par page : `" + path.basename(gridPath) + "`" : "") + " · run iterion `" + {{run.id}} + "`.");
    a.push("");
    a.push("## Moteur");
    a.push("");
    a.push("- ultra11y " + (layers.engine ? layers.engine.version + " (" + layers.engine.source + ")" : "inconnu") + " — épinglé par version et empreinte sha256 du fichier d'entrée, revérifiée avant chaque appel ; les motifs techniques ci-dessous sont cités tels que les nœuds les ont écrits.");
    a.push("");
    a.push("## Couches");
    a.push("");
    a.push("| Couche | État | Détail |");
    a.push("|---|---|---|");
    a.push("| Analyse statique | " + st(layers.static) + " | " + (layers.static ? layers.static.files + " fichier(s), " + layers.static.findings + " constat(s) moteur, " + layers.static.residual + " critère(s) laissés au jugement" + (layers.static.reason ? " — " + layers.static.reason : "") : "") + " |");
    a.push("| Pages rendues | " + st(layers.rendered) + " | " + (layers.rendered ? (layers.rendered.reason || (layers.rendered.pages_recorded + " page(s) capturée(s), " + layers.rendered.pages_refused + " refusée(s)" + (layers.rendered.missing_kinds && layers.rendered.missing_kinds.length ? " ; types de page manquants : " + layers.rendered.missing_kinds.join(", ") : ""))) : "couche désactivée, ou pas de navigateur / d'échantillon de pages") + " |");
    a.push("| Registre de verdicts | " + st(layers.ledger) + " | " + (layers.ledger ? (layers.ledger.reason || (layers.ledger.replayed + " verdict(s) rejoués ; périmés : " + fmt(layers.ledger.stale) + " ; obsolètes : " + fmt(layers.ledger.obsolete) + " ; refusés par le gate moteur : " + fmt(layers.ledger.refused || []) + " ; recommandations non rejouées (non normatives) : " + Number(layers.ledger.recommendations_stripped || 0))) : "") + " |");
    a.push("| Adjudication par agents | " + st(layers.adjudication) + " | " + (layers.adjudication ? layers.adjudication.filled + " verdict(s) reçus, " + layers.adjudication.unfilled + " sans réponse, lots perdus : " + fmt(layers.adjudication.failed_batches) + ", verdicts écartés (hors lot, doublons, malformés) : " + layers.adjudication.foreign_dropped + ", citations renvoyées : " + layers.adjudication.citation_rejected + ", recommandations écartées (pas un objet ancré avec un message, ou hors de l'évidence du critère) : " + Number(layers.adjudication.recommendations_dropped || 0) : "") + " |");
    const restoredIds = layers.fold && Array.isArray(layers.fold.citations_restored_ids) ? layers.fold.citations_restored_ids : [];
    const keptIds = layers.fold && Array.isArray(layers.fold.citations_kept_ids) ? layers.fold.citations_kept_ids : [];
    a.push("| Pliage (gate moteur) | " + st(layers.fold) + " | " + (layers.fold ? layers.fold.applied + " verdict(s) acceptés, refusés : " + fmt(layers.fold.rejected) + ", encore à évaluer : " + fmt(layers.fold.still_open) + ", citations retapées ou incomplètes rétablies depuis leur ancre : " + Number(layers.fold.citations_restored || 0) + (restoredIds.length ? " (" + restoredIds.join(", ") + ")" : "") + (keptIds.length ? ", gardées telles qu'écrites (le moteur refuse l'une des deux versions) : " + keptIds.join(", ") : "") : "") + " |");
    // A layer counts as an applied trial when it says so, or — written before
    // the field existed — when it is an ok layer, which that node wrote only
    // for a trial the engine accepted.
    const trialCounted = !!layers.refutation && (layers.refutation.applied === true || (layers.refutation.applied === undefined && layers.refutation.status === "ok"));
    a.push("| Contre-lecture | " + st(layers.refutation) + " | " + (layers.refutation ? (!trialCounted ? (layers.refutation.reason || "procès non appliqué (raison non consignée)") : (layers.refutation.refuted + " réfutée(s), " + layers.refutation.unsupported + " non tranchée(s), conformités retirées : " + fmt(layers.refutation.cleared) + ", constats moteur non touchés : " + layers.refutation.skipped_engine + (layers.refutation.reason ? " — procès appliqué, refus partiel du moteur : " + layers.refutation.reason : ""))) : "non lancée (désactivée, budget, ou aucune revendication à contre-lire)") + " |");
    a.push("| Revue humaine | " + st(layers.human) + " | " + (layers.human ? "indécidables déclarés : " + fmt(layers.human.undecidable) + (layers.human.notes ? " — " + layers.human.notes : "") : "") + " |");
    a.push("| Intégrité du rapport | " + (Object.keys(degraded).length ? "dégradée" : "ok") + " | " + (Object.keys(degraded).length ? Object.values(degraded).join(" ; ") : "la ligne « Décidés » de l’annexe technique et le taux du bilan correspondent au document ; `check --report` accepte les deux documents") + " |");
    a.push("");
    a.push("## Provenance des décisions");
    a.push("");
    const p = dec.provenance || {};
    a.push("- Total : " + (p.total || counts.total) + " critères — moteur : " + (p.engine || 0) + ", pages rendues : " + (p.scan || 0) + ", agents : " + (p.agent || 0) + ", déclarés indécidables : " + (p.declared || 0) + ", encore à évaluer : " + undecided.length + ".");
    a.push("- Taux de conformité " + STD.toUpperCase() + " : " + (rate < 0 ? "non calculable" : rate + " %") + (counts.aEvaluer ? " (provisoire : " + counts.aEvaluer + " critère(s) à évaluer comptés au dénominateur)" : "") + " — " + counts.conformes + " conforme(s), " + counts.nc + " non conforme(s), " + counts.fauteDeSujet + " sans sujet.");
    if (undecided.length) { a.push(""); a.push("## Critères encore à évaluer"); a.push(""); for (const id of undecided) a.push("- " + id); }
    if (pageGaps.length) { a.push(""); a.push("## Grille par page incomplète"); a.push(""); a.push("Cellules encore « à évaluer » par page — le document peut décider le critère, la page reste à juger :"); a.push(""); for (const g of pageGaps) a.push("- " + g.page + " : " + g.undecided.join(", ")); }
    if (rep.json.untestedCriteria && rep.json.untestedCriteria.length) { a.push(""); a.push("## Critères WCAG non testés faute de page rendue"); a.push(""); a.push(rep.json.untestedCriteria.join(", ")); }
    if ({{input.scope_notes}}) { a.push(""); a.push("## Périmètre demandé"); a.push(""); a.push(String({{input.scope_notes}})); }
    const annexPath = path.join(OUT, STD + "-" + date + "-couverture.md");
    fs.writeFileSync(annexPath, a.join("\n") + "\n");
    const ledger = path.join(RUN, "ledger", STD + ".json");
    let ledgerOut = "";
    // The delivered ledger is the one a project commits: an anchor inside this
    // run's workspace is written relative to it, and a page capture from any
    // run's workspace by the engine's own rule (from its last
    // `.ultra11y/pages/`, as the replay canonicalises it) — never as the
    // absolute path of a run's worktree.
    const roots = Array.from(new Set([WS, fs.realpathSync(WS)])).map((r) => r.replace(/\/+$/, "") + "/");
    const relFile = (f) => { const posix = f.replace(/\\/g, "/"); const cap = posix.lastIndexOf(".ultra11y/pages/"); if (cap >= 0) return posix.slice(cap); const root = roots.find((r) => f.startsWith(r)); return root ? f.slice(root.length) : f; };
    const relativise = (v) => { if (Array.isArray(v)) return v.map(relativise); if (!L.isObj(v)) return v; const o = {}; for (const k of Object.keys(v)) o[k] = k === "file" && typeof v[k] === "string" ? relFile(v[k]) : relativise(v[k]); return o; };
    if (L.exists(ledger)) { ledgerOut = path.join(OUT, "ledger", STD + ".json"); L.writeJSON(ledgerOut, relativise(L.readJSON(ledger))); }
    const reportDir = {{input.report_dir}};
    const reportFiles = rep.files.concat([gridPath, gridJSONPath, annexPath, ledgerOut].filter(Boolean));
    if (reportDir) L.copyReportFiles(reportFiles, OUT, reportDir);
    L.layer("report", { status: Object.keys(degraded).length ? "degraded" : "ok", report: reportPath, technical_annex: parts.annex, annex: annexPath, grid: gridPath, undecided: undecided, degraded: degraded });
    Object.assign(base, { report_files: reportFiles, grid_json_path: gridJSONPath, grid_path: gridPath, annex_path: annexPath, ledger_path: ledgerOut, complete: complete, undecided: undecided.length, undecided_ids: undecided, degraded: degraded });
    if ({{input.require_complete}} && !complete) L.refuse("GRID_INCOMPLETE", undecided.length + " criteria are still undecided and require_complete is set: " + (undecided.length ? undecided.join(", ") : "none") + (pageGaps.length ? " ; incomplete page cells: " + pageGaps.map((g) => g.page + " (" + g.undecided.join(", ") + ")").join("; ") : ""), base);
    L.out(Object.assign({ ok: true, fail_code: "", reason: "" }, base));
  language: js
  input: final_input
  output: final_output
  publish: report_bank

## The issue plan, deterministic and capped: the engine's own tickets (one
## per criterion, severity-sorted), each body completed with how to
## reproduce the audit with the pinned engine and where the report is.
## `tickets` resolves a provider and attempts one list() call even under
## --dry-run; a dead loopback keeps it offline.
tool deliver:
  script: |
    const fs = require("fs"), path = require("path");
    const RUN = {{input.run_dir}};
    const L = require(path.join(RUN, "bin", "lib.js")).init(RUN);
    const STD = {{input.standard}};
    L.checkAudit();
    const OUT = path.join(RUN, "out");
    const r = L.engine(["tickets", "--in", L.auditPath(), "--out", OUT, "--grain", "criterion", "--provider", "github", "--transport", "rest", "--dry-run", "--max-tickets", "500"].concat(L.std(STD)), { cwd: {{input.workspace_dir}}, env: { GITHUB_API_URL: "http://127.0.0.1:9", GH_TOKEN: "", GITHUB_TOKEN: "", GITHUB_REPOSITORY: "offline/offline" } });
    if (r.code !== 0) L.die("tickets exit " + r.code + ": " + r.stderr.slice(-3000));
    const files = fs.readdirSync(OUT).filter((f) => /^issues-.*\.json$/.test(f)).sort();
    if (!files.length) L.die("the engine wrote no issues-<date>.json under " + OUT);
    const plan = L.readJSON(path.join(OUT, files[files.length - 1]));
    const RANK = { bloquant: 3, blocking: 3, majeur: 2, major: 2, mineur: 1, minor: 1 };
    const rank = (i) => RANK[String(i.severity || "").toLowerCase()] || 0;
    const engineMeta = L.readJSON(path.join(RUN, "bin", "engine.json"));
    const issues = (plan.issues || []).map((i, idx) => ({ idx: idx, title: String(i.title || ""), body: String(i.body || ""), labels: Array.isArray(i.labels) ? i.labels.map(String) : [], severity: String(i.severity || ""), advisory: !!i.advisory, criteriaId: String((i.scope && i.scope.criteriaId) || ""), occurrences: Array.isArray(i.occurrences) ? i.occurrences.length : 0 }));
    issues.sort((a, b) => (rank(b) - rank(a)) || (a.idx - b.idx));
    const asked = Number({{input.findings_cap}});
    const cap = Number.isInteger(asked) ? (asked < 0 ? 80 : asked) : 80;
    const kept = issues.slice(0, cap);
    const epic = String({{input.board_epic_label}} || "").trim();
    const out = kept.map((i) => ({ title: i.title, body: i.body + "\n\n---\n\n**Reproduction** : `ultra11y@" + engineMeta.version + " audit <scope> --standard " + STD + "` (moteur épinglé par iterion, run `" + {{run.id}} + "`) · rapport : `" + {{input.report_path}} + "`.", labels: Array.from(new Set(i.labels.concat(["source:rgaa-audit", "criterion:" + i.criteriaId], epic ? [epic] : []))), state: {{input.board_state}}, severity: i.severity, advisory: i.advisory, criteriaId: i.criteriaId, occurrences: i.occurrences }));
    L.writeJSON(path.join(OUT, "issue-plan.json"), { total: issues.length, capped: Math.max(0, issues.length - cap), issues: out });
    L.layer("deliver", { status: "ok", total: issues.length, capped: Math.max(0, issues.length - cap) });
    L.out({ ok: true, fail_code: "", reason: "", issues: out, total: issues.length, capped: Math.max(0, issues.length - cap), blocking: issues.filter((i) => rank(i) === 3 && !i.advisory).length, advisory: issues.filter((i) => i.advisory).length });
  language: js
  input: deliver_input
  output: deliver_output
  publish: a11y_findings

## The judge's report of the board write is held to the plan: created ∪
## existing must cover every title and nothing may have failed. It is the
## judge's own report, not a board read — a tool node has no board action.
tool publish_verify:
  script: |
    const path = require("path");
    const RUN = {{input.run_dir}};
    const L = require(path.join(RUN, "bin", "lib.js")).init(RUN);
    const norm = (x) => { if (typeof x === "string") { try { x = JSON.parse(x); } catch (e) { x = [x]; } } if (!Array.isArray(x)) return []; return x.map((v) => typeof v === "string" ? v : String((v && (v.title || v.name)) || "")); };
    const plan = ({{input.issues}} || []).map((i) => String(i.title || ""));
    const created = norm({{input.created}}), existing = norm({{input.existing}}), failed = norm({{input.failed}});
    const have = new Set(created.concat(existing));
    const missing = plan.filter((t) => !have.has(t));
    L.layer("board", { status: missing.length || failed.length ? "degraded" : "ok", created: created.length, existing: existing.length, failed: failed, missing: missing, source: "rapport du juge de transcription tenu au plan" });
    if (missing.length || failed.length) L.refuse("BOARD_PUBLISH_INCOMPLETE", missing.length + " planned issue(s) neither created nor found on the board (" + missing.slice(0, 5).join(" ; ") + (missing.length > 5 ? " …" : "") + "); " + failed.length + " failed", { missing: missing, created: created.length, existing: existing.length });
    L.out({ ok: true, fail_code: "", reason: "", missing: [], created: created.length, existing: existing.length });
  language: js
  input: publish_verify_input
  output: publish_verify_output

## ─── Compute gates ────────────────────────────────────────────────────

## The rendered layer runs when a browser answered the probe; `required`
## without a browser is the typed refusal, never a scan that cannot start.
compute render_gate:
  input: render_gate_input
  output: render_gate_output
  expr:
    run_render: "input.browser_ok && (input.rendered == 'required' || (input.rendered == 'auto' && input.rc_present))"
    required_missing: "input.rendered == 'required' && !input.browser_ok"
    reason: "if(input.rendered == 'required' && !input.browser_ok, 'rendered=required but no browser can scan the page sample: ' + input.browser_reason, '')"

## The second reader is skipped, visibly, once the run has spent more than
## its share of the cost cap (a cap of 0 is unbounded, never "nothing left").
## The constant outputs are the floor the skip path hands review_gate.
compute budget_gate:
  input: budget_gate_input
  output: budget_gate_output
  expr:
    run_refuter: "input.refute_enabled && input.claims > 0 && (run.max_cost_usd == 0 || run.cost_usd <= run.max_cost_usd * input.share)"
    skipped: "!(input.refute_enabled && input.claims > 0 && (run.max_cost_usd == 0 || run.cost_usd <= run.max_cost_usd * input.share))"
    applied_floor: "false"
    degraded_floor: "false"
    zero: "0"
    no_reopened: "[]"

## What the human gate and the final report read after the trial: the
## criteria still open are the fold's residue plus what the trial reopened.
compute review_gate:
  input: review_gate_input
  output: review_gate_output
  expr:
    fail_incomplete: "vars.require_complete && input.refute_degraded"
    to_human: "vars.human_review && !(vars.require_complete && input.refute_degraded)"
    refute_applied: "input.refute_applied"
    refute_degraded: "input.refute_degraded"
    refuted: "input.refuted"
    undecided_ids: "concat(input.open_ids, input.reopened)"
    undecided: "length(input.open_ids) + length(input.reopened)"

compute publish_gate:
  input: publish_gate_input
  output: publish_gate_output
  expr:
    post: "input.post_to_board && input.total > 0"

## ─── Typed refusals ───────────────────────────────────────────────────
fail engine_unresolved:
  description: "no pinned ultra11y engine could be resolved"
  code: ENGINE_UNRESOLVED
  message: "{{outputs.prepare.reason}}"

fail engine_hash_mismatch:
  description: "an engine answered the pinned version but not the pinned fingerprint"
  code: ENGINE_HASH_MISMATCH
  message: "{{outputs.prepare.reason}}"

fail empty_scope:
  description: "the engine found no auditable file in scope"
  code: EMPTY_SCOPE
  message: "{{outputs.static_audit.reason}}"

fail render_unavailable:
  description: "the rendered layer was required and could not run"
  code: RENDER_UNAVAILABLE
  message: "{{outputs.render_gate.reason}}{{outputs.render.reason}} — fix the browser or the served site and resume"
  resumable: true

fail ledger_invalid:
  description: "the committed verdict ledger is unreadable"
  code: LEDGER_INVALID
  message: "{{outputs.ledger_replay.reason}}"

fail audit_integrity:
  description: "audit-latest.json no longer matches the hash its last writer recorded"
  code: AUDIT_INTEGRITY
  message: "{{outputs.bank_static.reason}}{{outputs.render.reason}}{{outputs.ledger_replay.reason}}{{outputs.worklist.reason}}{{outputs.fold_probe.reason}}{{outputs.fold_final.reason}}{{outputs.draft_report.reason}}{{outputs.refute_apply.reason}}{{outputs.final_report.reason}}{{outputs.deliver.reason}}"

fail unexpected_refusal:
  description: "a tool node refused with a code the graph does not route"
  code: UNEXPECTED_REFUSAL
  message: "a node refused with an unrouted code: {{outputs.bank_static.fail_code}}{{outputs.render.fail_code}}{{outputs.ledger_replay.fail_code}}{{outputs.worklist.fail_code}}{{outputs.fold_probe.fail_code}}{{outputs.fold_final.fail_code}}{{outputs.draft_report.fail_code}}{{outputs.refute_apply.fail_code}}{{outputs.final_report.fail_code}}{{outputs.deliver.fail_code}} — {{outputs.bank_static.reason}}{{outputs.render.reason}}{{outputs.ledger_replay.reason}}{{outputs.worklist.reason}}{{outputs.fold_probe.reason}}{{outputs.fold_final.reason}}{{outputs.draft_report.reason}}{{outputs.refute_apply.reason}}{{outputs.final_report.reason}}{{outputs.deliver.reason}}"

fail adjudication_incomplete:
  description: "criteria still « à évaluer » after the fold, with require_complete"
  code: ADJUDICATION_INCOMPLETE
  message: "{{outputs.fold_final.reason}}"

fail refute_incomplete:
  description: "the refutation trial is degraded (claims without a verdict, or a part the engine refused), with require_complete"
  code: REFUTE_INCOMPLETE
  message: "the refutation trial is degraded ({{outputs.refute_apply.reason}}) and require_complete is set"

fail human_rejected:
  description: "the operator refused the audit at the human gate"
  code: HUMAN_REJECTED
  message: "the human reviewer did not approve the audit: {{outputs.human_review.notes}}"

fail report_integrity_failed:
  description: "the engine's integrity check refused the final report"
  code: REPORT_INTEGRITY_FAILED
  message: "{{outputs.final_report.reason}}"

fail grid_incomplete:
  description: "criteria still undecided in the final report, with require_complete"
  code: GRID_INCOMPLETE
  message: "{{outputs.final_report.reason}}"

fail board_publish_incomplete:
  description: "the board does not carry every planned issue"
  code: BOARD_PUBLISH_INCOMPLETE
  message: "{{outputs.publish_verify.reason}}"

## ─── Workflow ─────────────────────────────────────────────────────────
workflow rgaa_audit:
  default_backend: "claude_code"
  ## The agents judge a checkout they do not control: no instruction file
  ## of the audited repository reaches them.
  ambient_context: none
  ## Reads the repository, does not build it.
  repo_devbox: off
  ## Reads the repository, writes verdicts and a report — never commits.
  workspace_checkpoint: off

  entry: prepare

  budget:
    max_parallel_branches: 4
    max_duration: "${ITERION_RGAA_MAX_DURATION:-3h}"
    max_cost_usd: 30
    max_tokens: 3000000
    max_iterations: 300

  prepare -> static_audit when ok with {
    run_dir: "{{outputs.prepare.run_dir}}",
    workspace_dir: "{{vars.workspace_dir}}",
    standard: "{{vars.standard}}",
    max_files: "{{vars.max_files}}",
    audit_args: "{{outputs.prepare.audit_args}}",
  }

  prepare -> engine_hash_mismatch when "outputs.prepare.fail_code == 'ENGINE_HASH_MISMATCH'"

  prepare -> engine_unresolved else

  static_audit -> bank_static when ok with {
    run_dir: "{{outputs.prepare.run_dir}}"
  }

  static_audit -> empty_scope else

  bank_static -> render_gate when ok with {
    rendered: "{{vars.rendered}}",
    browser_ok: "{{outputs.prepare.browser_ok}}",
    browser_reason: "{{outputs.prepare.browser_reason}}",
    rc_present: "{{outputs.prepare.rc_present}}",
  }

  bank_static -> audit_integrity when "outputs.bank_static.fail_code == 'AUDIT_INTEGRITY'"

  bank_static -> unexpected_refusal else

  render_gate -> render when run_render with {
    run_dir: "{{outputs.prepare.run_dir}}",
    workspace_dir: "{{vars.workspace_dir}}",
    standard: "{{vars.standard}}",
    rendered: "{{vars.rendered}}",
    engine_pkg_dir: "{{outputs.prepare.engine_pkg_dir}}",
    serve_command: "{{vars.serve_command}}",
    serve_ready_url: "{{vars.serve_ready_url}}",
    serve_timeout_seconds: "{{vars.serve_timeout_seconds}}",
  }

  render_gate -> render_unavailable when required_missing

  render_gate -> ledger_replay else with {
    run_dir: "{{outputs.prepare.run_dir}}",
    workspace_dir: "{{vars.workspace_dir}}",
    standard: "{{vars.standard}}",
    ledger_present: "{{outputs.prepare.ledger_present}}",
    ledger_path: "{{outputs.prepare.ledger_path}}",
  }

  render -> ledger_replay when ok with {
    run_dir: "{{outputs.prepare.run_dir}}",
    workspace_dir: "{{vars.workspace_dir}}",
    standard: "{{vars.standard}}",
    ledger_present: "{{outputs.prepare.ledger_present}}",
    ledger_path: "{{outputs.prepare.ledger_path}}",
  }

  render -> render_unavailable when "outputs.render.fail_code == 'RENDER_UNAVAILABLE'"

  render -> audit_integrity when "outputs.render.fail_code == 'AUDIT_INTEGRITY'"

  render -> unexpected_refusal else

  ledger_replay -> worklist when ok with {
    run_dir: "{{outputs.prepare.run_dir}}",
    workspace_dir: "{{vars.workspace_dir}}",
    standard: "{{vars.standard}}",
  }

  ledger_replay -> ledger_invalid when "outputs.ledger_replay.fail_code == 'LEDGER_INVALID'"

  ledger_replay -> audit_integrity when "outputs.ledger_replay.fail_code == 'AUDIT_INTEGRITY'"

  ledger_replay -> unexpected_refusal else

  worklist -> draft_report when "outputs.worklist.ok && outputs.worklist.count == 0" with {
    run_dir: "{{outputs.prepare.run_dir}}",
    workspace_dir: "{{vars.workspace_dir}}",
    standard: "{{vars.standard}}",
  }

  worklist -> plan_batches when ok with {
    run_dir: "{{outputs.prepare.run_dir}}",
    batch_size: "{{vars.batch_size}}",
  }

  worklist -> audit_integrity when "outputs.worklist.fail_code == 'AUDIT_INTEGRITY'"

  worklist -> unexpected_refusal else

  plan_batches -> dispatch

  dispatch -> adjudicate with {
    batch_id: "{{outputs.dispatch.batch.id}}",
    round: "{{outputs.dispatch.batch.round}}",
    theme: "{{outputs.dispatch.batch.theme}}",
    ids: "{{outputs.dispatch.batch.ids}}",
    items_dir: "{{outputs.worklist.items_dir}}",
    briefs_dir: "{{outputs.worklist.briefs_dir}}",
    contract: "{{outputs.worklist.contract}}",
    prior_issues: "{{outputs.dispatch.batch.prior_issues}}",
    workspace_dir: "{{vars.workspace_dir}}",
    standard: "{{vars.standard}}",
    scope_notes: "{{vars.scope_notes}}",
  }

  adjudicate -> write_fragment with {
    run_dir: "{{outputs.prepare.run_dir}}",
    batch_id: "{{outputs.dispatch.batch.id}}",
    round: "{{outputs.dispatch.batch.round}}",
    ids: "{{outputs.dispatch.batch.ids}}",
    verdicts: "{{input.verdicts}}",
  }

  write_fragment -> merge_verdicts with {
    run_dir: "{{outputs.prepare.run_dir}}",
    round: "{{outputs.plan_batches.round}}",
  }

  merge_verdicts -> fold_probe with {
    run_dir: "{{outputs.prepare.run_dir}}",
    workspace_dir: "{{vars.workspace_dir}}",
    standard: "{{vars.standard}}",
    round: "{{outputs.plan_batches.round}}",
  }

  ## Bounded re-ask of the refusals the fold named; the bare edge is the
  ## exit, taken when nothing is pending or the re-asks are spent.
  fold_probe -> plan_batches when "outputs.fold_probe.pending > 0" as reask("vars.max_reask") with {
    run_dir: "{{outputs.prepare.run_dir}}",
    batch_size: "{{vars.batch_size}}",
  }

  fold_probe -> fold_final with {
    run_dir: "{{outputs.prepare.run_dir}}",
    workspace_dir: "{{vars.workspace_dir}}",
    standard: "{{vars.standard}}",
    require_complete: "{{vars.require_complete}}",
  }

  fold_final -> draft_report when ok with {
    run_dir: "{{outputs.prepare.run_dir}}",
    workspace_dir: "{{vars.workspace_dir}}",
    standard: "{{vars.standard}}",
  }

  fold_final -> adjudication_incomplete when "outputs.fold_final.fail_code == 'ADJUDICATION_INCOMPLETE'"

  fold_final -> audit_integrity when "outputs.fold_final.fail_code == 'AUDIT_INTEGRITY'"

  fold_final -> unexpected_refusal else

  draft_report -> budget_gate when ok with {
    refute_enabled: "{{vars.refute_enabled}}",
    claims: "{{outputs.draft_report.claims}}",
    share: "{{vars.refuter_budget_share}}",
  }

  draft_report -> audit_integrity when "outputs.draft_report.fail_code == 'AUDIT_INTEGRITY'"

  draft_report -> unexpected_refusal else

  budget_gate -> plan_refute when run_refuter with {
    run_dir: "{{outputs.prepare.run_dir}}",
    batch_size: "{{vars.refute_batch_size}}",
  }

  budget_gate -> review_gate else with {
    refute_applied: "{{outputs.budget_gate.applied_floor}}",
    refute_degraded: "{{outputs.budget_gate.degraded_floor}}",
    refuted: "{{outputs.budget_gate.zero}}",
    reopened: "{{outputs.budget_gate.no_reopened}}",
    open_ids: "{{outputs.fold_final.still_open_ids}}",
  }

  plan_refute -> refute_dispatch

  refute_dispatch -> refute with {
    batch_id: "{{outputs.refute_dispatch.rbatch.id}}",
    round: "{{outputs.refute_dispatch.rbatch.round}}",
    items: "{{outputs.refute_dispatch.rbatch.items}}",
    draft_path: "{{outputs.draft_report.draft_path}}",
    technical_annex_path: "{{outputs.draft_report.technical_annex_path}}",
    briefs_dir: "{{outputs.worklist.briefs_dir}}",
    workspace_dir: "{{vars.workspace_dir}}",
    standard: "{{vars.standard}}",
    scope_notes: "{{vars.scope_notes}}",
  }

  refute -> write_refute_fragment with {
    run_dir: "{{outputs.prepare.run_dir}}",
    batch_id: "{{outputs.refute_dispatch.rbatch.id}}",
    round: "{{outputs.refute_dispatch.rbatch.round}}",
    ns: "{{outputs.refute_dispatch.rbatch.ns}}",
    verdicts: "{{input.verdicts}}",
  }

  write_refute_fragment -> merge_refutations with {
    run_dir: "{{outputs.prepare.run_dir}}",
    round: "{{outputs.plan_refute.round}}",
  }

  merge_refutations -> plan_refute when "outputs.merge_refutations.unfilled > 0" as rerefute(1) with {
    run_dir: "{{outputs.prepare.run_dir}}",
    batch_size: "{{vars.refute_batch_size}}",
  }

  merge_refutations -> refute_apply with {
    run_dir: "{{outputs.prepare.run_dir}}",
    workspace_dir: "{{vars.workspace_dir}}",
    standard: "{{vars.standard}}",
    complete: "{{outputs.merge_refutations.complete}}",
  }

  refute_apply -> review_gate when ok with {
    refute_applied: "{{outputs.refute_apply.applied}}",
    refute_degraded: "{{outputs.refute_apply.degraded}}",
    refuted: "{{outputs.refute_apply.refuted}}",
    reopened: "{{outputs.refute_apply.reopened}}",
    open_ids: "{{outputs.fold_final.still_open_ids}}",
  }

  refute_apply -> audit_integrity when "outputs.refute_apply.fail_code == 'AUDIT_INTEGRITY'"

  refute_apply -> unexpected_refusal else

  review_gate -> refute_incomplete when fail_incomplete

  review_gate -> human_review when to_human with {
    draft_path: "{{outputs.draft_report.draft_path}}",
    technical_annex_path: "{{outputs.draft_report.technical_annex_path}}",
    summary: "adjudication: applied={{outputs.fold_final.applied}} rejected={{outputs.fold_final.rejected}} open after the fold={{outputs.fold_final.still_open}}; trial: applied={{outputs.review_gate.refute_applied}} degraded={{outputs.review_gate.refute_degraded}} refuted={{outputs.review_gate.refuted}}",
    applied: "{{outputs.fold_final.applied}}",
    rejected: "{{outputs.fold_final.rejected}}",
    undecided: "{{outputs.review_gate.undecided}}",
    undecided_ids: "{{outputs.review_gate.undecided_ids}}",
    refuted: "{{outputs.review_gate.refuted}}",
    refute_applied: "{{outputs.review_gate.refute_applied}}",
    refute_degraded: "{{outputs.review_gate.refute_degraded}}",
  }

  review_gate -> final_report else with {
    run_dir: "{{outputs.prepare.run_dir}}",
    workspace_dir: "{{vars.workspace_dir}}",
    standard: "{{vars.standard}}",
    html_report: "{{vars.html_report}}",
    report_dir: "{{vars.report_dir}}",
    require_complete: "{{vars.require_complete}}",
    undecidable_present: "{{outputs.prepare.undecidable_present}}",
    undecidable_path: "{{outputs.prepare.undecidable_path}}",
    scope_notes: "{{vars.scope_notes}}",
  }

  human_review -> write_undecidable when approved with {
    run_dir: "{{outputs.prepare.run_dir}}",
    standard: "{{vars.standard}}",
    undecidable_ids: "{{input.undecidable_ids}}",
    notes: "{{input.notes}}",
    undecidable_present: "{{outputs.prepare.undecidable_present}}",
    undecidable_path: "{{outputs.prepare.undecidable_path}}",
  }

  human_review -> human_rejected else

  write_undecidable -> final_report with {
    run_dir: "{{outputs.prepare.run_dir}}",
    workspace_dir: "{{vars.workspace_dir}}",
    standard: "{{vars.standard}}",
    html_report: "{{vars.html_report}}",
    report_dir: "{{vars.report_dir}}",
    require_complete: "{{vars.require_complete}}",
    undecidable_present: "{{outputs.prepare.undecidable_present}}",
    undecidable_path: "{{outputs.prepare.undecidable_path}}",
    scope_notes: "{{vars.scope_notes}}",
  }

  final_report -> deliver when ok with {
    run_dir: "{{outputs.prepare.run_dir}}",
    workspace_dir: "{{vars.workspace_dir}}",
    standard: "{{vars.standard}}",
    report_path: "{{outputs.final_report.report_path}}",
    findings_cap: "{{vars.findings_cap}}",
    board_state: "{{vars.board_state}}",
    board_epic_label: "{{vars.board_epic_label}}",
  }

  final_report -> report_integrity_failed when "outputs.final_report.fail_code == 'REPORT_INTEGRITY_FAILED'"

  final_report -> grid_incomplete when "outputs.final_report.fail_code == 'GRID_INCOMPLETE'"

  final_report -> audit_integrity when "outputs.final_report.fail_code == 'AUDIT_INTEGRITY'"

  final_report -> unexpected_refusal else

  deliver -> publish_gate when ok with {
    post_to_board: "{{vars.post_to_board}}",
    total: "{{outputs.deliver.total}}",
  }

  deliver -> audit_integrity when "outputs.deliver.fail_code == 'AUDIT_INTEGRITY'"

  deliver -> unexpected_refusal else

  publish_gate -> publish when post with {
    issues: "{{outputs.deliver.issues}}",
    total: "{{outputs.deliver.total}}",
    capped: "{{outputs.deliver.capped}}",
    state: "{{vars.board_state}}",
  }

  publish_gate -> done else

  publish -> publish_verify with {
    run_dir: "{{outputs.prepare.run_dir}}",
    issues: "{{outputs.deliver.issues}}",
    created: "{{input.created}}",
    existing: "{{input.existing}}",
    failed: "{{input.failed}}",
  }

  publish_verify -> done when ok

  publish_verify -> board_publish_incomplete else
