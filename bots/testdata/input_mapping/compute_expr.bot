## Guard fixture — a compute node's expression reads an input no incoming edge maps.

dsl: 2

vars:
  n: int = 7

schema verdict:
  big: bool

schema out:
  echoed: string
  present: bool

compute classify:
  output: verdict
  expr:
    big: "vars.n > 42"

compute leak:
  output: out
  expr:
    echoed: "if(input.never_mapped == null, 'NIL', 'GOT-A-VALUE')"
    present: "input.never_mapped != null"

workflow compute_expr:

  entry: classify

  classify -> leak

  leak -> done
