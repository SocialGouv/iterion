## Guard fixture — a review gate's review_url and companion system prompt
## each read an input no incoming edge maps. Both are rendered by
## renderHumanInstructions, so both readings are the empty string.

dsl: 2

prompt work:
  Do the work.

prompt gate_instructions:
  Walk the human through the change.

prompt gate_sys:
  You are the review companion for {{input.sys_never_mapped}}.

schema verdict:
  approved: bool

agent seed:
  model: "anthropic/claude-sonnet-4-6"
  user: work

human gate:
  output: verdict
  interaction: review
  instructions: gate_instructions
  model: "anthropic/claude-sonnet-4-6"
  system: gate_sys
  review_url: "{{input.url_never_mapped}}"

workflow review_url:

  entry: seed

  seed -> gate

  gate -> done
