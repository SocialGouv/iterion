## Guard fixture — a review gate's review_url reads an input no incoming edge maps.

dsl: 2

prompt work:
  Do the work.

prompt gate_instructions:
  Walk the human through the change.

schema verdict:
  approved: bool

agent seed:
  model: "anthropic/claude-sonnet-4-6"
  user: work

human gate:
  output: verdict
  interaction: review
  instructions: gate_instructions
  model: "anthropic/claude-sonnet-4-6"
  review_url: "{{input.url_never_mapped}}"

workflow review_url:

  entry: seed

  seed -> gate

  gate -> done
