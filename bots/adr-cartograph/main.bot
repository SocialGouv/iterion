## ─────────────────────────────────────────────────────────────────
## adr_cartograph  (persona: Adry — v2, one agent authors the ADRs in
##                  its natural flow, minimal framing)
##
## THE MISSION is an ADR-ALIGNMENT campaign: observe the decisions the
## code embodies, and make the ADR directory match them — author the
## missing ADRs (Nygard format, sequential NNN), refresh the orphaned
## ones (cited code paths all gone), and hand off feature gaps +
## aged-out ADRs as board issues. Each authored/updated ADR lands as a
## `docs(adr): …` commit in stride.
##
## Sibling of docs-refresh v2 (ADR-058): the DETERMINISTIC machinery is
## kept in full — it is the engine's unique value:
##   scan_adrs      — ADR inventory + front-matter parse +
##                    next_adr_number + duplicates + cache
##                    pre-verification (unchanged).
##   survey_code    — read-only decision/gap survey producing the
##                    structured decisions[]/gaps[] evidence base
##                    (unchanged — an observational aide with the
##                    decision-vs-mechanic dam, not flow framing).
##   build_manifest — deterministic differ: decisions vs ADRs →
##                    decision_drift; ADRs vs filesystem → adr_orphans;
##                    gaps → gaps_for_handoff; age → adrs_aged_out; and
##                    the mechanical coverage_pct. RE-GLOBS the live
##                    adr_dir each pass, so ADRs the campaign authors
##                    are SEEN and coverage rises (the dogfood lesson
##                    in the tool body).
##   campaign       — ONE adaptive agent (claude_code, full tools)
##                    replacing the v1 review/fix relay: adjudicates
##                    the drift set, authors/refreshes ADRs one at a
##                    time, commits in stride, files the handoff
##                    issues. git IS the durable state.
##   scope_check    — deterministic containment: only `.md` under
##                    adr_dir (+ the cache file) may change; anything
##                    else fails the gate and bounces back.
##   verify_build   — the shared stack-agnostic build gate (ADR runs
##     + verify_run   are docs-only; the gate is the cheap universal
##                    floor + catches accidental code edits at build
##                    level too).
##   gate           — converged = build green ∧ scope clean ∧
##                    adrs_aligned ∧ mechanical coverage ≥ target.
##   mark_issue_for_review / update_cache — dispatcher transition +
##                    inter-run cache write (unchanged).
##
## WHY THIS SHAPE. The v1 loop was ~15 nodes: the machinery above PLUS
## an alternating cross-family review/fix relay (alt round_robin →
## reviewer_claude / reviewer_gpt → streak_check + dismissed-ids /
## pushback / chronic accumulators → fix_claude / fix_gpt →
## prepare_commit → commit_changes → detect_changes →
## enforce_fix_scope). ADR-058
## (docs/references/productive-session-patterns.md): "the deficit is
## framing, not capability" — one capable agent adjudicating a bounded,
## mechanically-verified drift manifest converges better than a
## reviewer/fixer relay, and the accumulators existed only to police
## the relay's oscillation. The deterministic manifest + scope + build
## gates keep every anti-Goodhart guarantee.
##
## CONTINUATION IS BOUNDED. The single declared loop (build_manifest →
## campaign → scope_check → verify_build → verify_run → gate →
## build_manifest) is capped by `max_passes`; on exhaustion it ships
## what is banked. `iterion validate` reports NO undeclared cycle.
##
## RETIRED FROM v1 (git history has the design): alt, reviewer_claude,
## reviewer_gpt, streak_check (+ accumulators), fix_claude, fix_gpt,
## prepare_commit, commit_changes, detect_changes, enforce_fix_scope
## (reborn as the detect-only scope_check). 15 nodes → 10.
## ─────────────────────────────────────────────────────────────────


vars:
  ## The workspace root the run operates against. Resolved to the
  ## worktree when worktree: auto is set on the workflow.
  workspace_dir: string = "${PROJECT_DIR}"

  ## The ADR directory (universal Nygard convention). Override per-
  ## repo only when the target uses a non-default location (e.g.
  ## `architecture/decisions`). See skills/adr-scope-detection.md.
  adr_dir: string = "docs/adr"

  ## Inter-run audit cache. A repo-root dotfile the operator can
  ## gitignore. NOT iterion's `.iterion/` store — Adry runs against
  ## ANY repo and must not scatter `.iterion/` paths into someone
  ## else's tree.
  audit_cache_path: string = ".adr-cartograph-cache.json"

  ## Code scope reviewers + survey may grep / read to verify ADR
  ## claims and find ADR-worthy decisions. UNIVERSAL DEFAULT: empty
  ## = whole workspace minus `excluded_dirs`. A language/layout-
  ## specific scope is a per-repo --var override, never the catalog
  ## default — Adry must run on Python / Rust / TS / Go repos
  ## identically out of the box.
  code_scope_globs: string = ""

  ## Hard-excluded directories. Comma-separated list of dir names
  ## whose presence anywhere in a path disqualifies it from the
  ## code survey AND the audit cache.
  excluded_dirs: string = ".iterion,.works,.claude,vendor,node_modules,.git,dist,build,out"

  ## Incremental mode hint. When non-empty, scan_adrs computes
  ## `git diff <diff_since>...HEAD --name-only` and surfaces the
  ## result as `recently_changed_code_files`. Reviewers + survey
  ## use this as a HINT to prioritise decisions touching recent
  ## code churn. The full code surface is still in scope; the
  ## hint is non-authoritative.
  diff_since: string = ""


  ## Coverage threshold (percentage of `build_manifest`'s checkable
  ## anchors that must be verified before stop=true can fire).
  ## Default 80 — high enough to defeat the "rubber-stamp after a
  ## partial audit" failure mode, low enough to allow approval when
  ## a small tail of decisions are genuinely too ambiguous to ADR.
  coverage_target_pct: int = 80

  ## Operator's attention pin — free-text notes that flow into both
  ## the survey and the reviewer prompts (e.g. dispatched from an
  ## issue body via dispatch_vars.scope_notes).
  scope_notes: string = ""

  ## Optional re-challenge invitation. When > 0, prepare_commit files
  ## a `type:adr-rechallenge` issue for every ADR whose Date field is
  ## older than `rechallenge_after_days` days. 0 (default) disables
  ## the invitation. Recommended cadence: 90 days for active projects.
  rechallenge_after_days: int = 0

  ## Auto-exclusion. When non-empty, scan_adrs excludes any file
  ## whose path starts with this prefix from the cache footprint,
  ## and survey_code is told to ignore it. Set to
  ## `bots/adr-cartograph` when running Adry against the iterion
  ## repo itself; otherwise leave empty.
  bundle_self_path: string = ""

  ## Dispatcher-attached issue id. mark_issue_for_review transitions
  ## the issue out of `ready` at run end so the dispatcher's
  ## polling loop doesn't re-pick it. Empty for manual CLI runs.
  issue_id: string = ""

  ## Out-of-tree, sandbox-writable scratch for the deterministic gate's
  ## verify script/log ONLY. ${PROJECT_SCRATCH_DIR} resolves per-project
  ## outside the target tree — never pollute someone else's repo.
  scratch_dir: string = "${PROJECT_SCRATCH_DIR}/adr-cartograph"

  ## BASELINE (G5). Known pre-existing build/test failures to SKIP (ADR
  ## runs are docs-only, so this rarely trips; the build gate still
  ## runs as the universal floor). Empty = establish once cheaply.
  baseline: string = ""

  ## Hard cap on continuation PASSES — the convergence backstop. Each
  ## pass is one manifest→campaign→verify cycle.
  ## NOTE loop semantics: the DSL `as continuation_loop(N)` bounds the
  ## loop-BACKS (re-entries), so the TOTAL number of passes is N+1 —
  ## max_passes: 2 yields up to 3 campaign→verify cycles (observed live,
  ## dogfood 019f3d4d-1aed).
  max_passes: int = 6


## ─── Prompts ────────────────────────────────────────────────────

prompt survey_code_system:
  You are participating in the `adr-cartograph` (Adry) workflow as
  the survey-phase agent. Your job is read-only: explore the code
  in `{{vars.workspace_dir}}` and emit:

  1. A list of ADR-worthy decisions (`decisions[]`) — non-obvious
     trade-offs the code embodies, each with a real alternative
     considered.
  2. A list of feature completeness gaps (`gaps[]`) — places where
     an in-flight feature is stubbed, missing error handling,
     lacks tests, or is otherwise incomplete.

  LOAD YOUR SKILLS FIRST. The bundle ships five skills under
  `.claude/skills/`:
    - `adry.md` — operating playbook, mission, inviolable rules.
    - `decision-vs-mechanic.md` — the dam against ADR-spam.
      EVERY decision you emit must pass its three checks.
    - `completeness-taxonomy.md` — the 8 enum-locked `gap_kind`
      values you must use for every gap entry.
    - `adr-format.md` — the Nygard format you will help author.
    - `adr-scope-detection.md` — where ADRs live in different
      project shapes.

  Read them BEFORE reasoning, then survey the code.

  SCOPE DISCIPLINE:
   - `vars.code_scope_globs` is your code surface. Empty means
     "whole workspace"; respect `vars.excluded_dirs` always.
     `vars.bundle_self_path` (when non-empty) is the bot's own
     bundle directory — do NOT survey it.
   - When `vars.diff_since` is set, prioritise files surfaced by
     `recently_changed_code_files` (a hint, not a scope reduction).
   - Survey is read-only. Do NOT write any file. Do NOT run any
     command that mutates the workspace. Your output is the
     evidence base; the fixer phase will translate it into
     `.md` under `docs/adr/`.

  PER-DECISION DISCIPLINE (decision-vs-mechanic.md applies):
   - non-obvious trade-off: a peer could NOT predict the choice
     from the code alone.
   - real alternative: name a specific other path that was NOT
     taken, AND the constraint that ruled it out.
   - re-challenge condition: a plausible future constraint change
     that would invite reconsidering this decision.
   - If you cannot do all three honestly, set
     `is_mechanic: true` and the reviewer will drop it.

  PER-GAP DISCIPLINE (completeness-taxonomy.md applies):
   - tag every gap with one of the 8 `gap_kind` values.
   - cite file:line evidence inline — `evidence` must contain
     the tool invocation (read_file, grep) and an excerpt.
   - severity:
       high   — shipped, breaks on documented inputs;
       medium — documented edge case fails;
       low    — internal-only inconsistency.

  Operator scope notes (attention pin):
  {{vars.scope_notes}}

prompt survey_code_user:
  Survey the code in {{vars.workspace_dir}} and produce the
  ADR-worthy decisions list + the feature-completeness gaps list.

  Code surface (empty = whole workspace minus excluded_dirs):
   - code_scope_globs: {{vars.code_scope_globs}}
   - excluded_dirs:    {{vars.excluded_dirs}}
   - bundle_self_path: {{vars.bundle_self_path}}

  Existing ADRs (titles + slugs, do not re-author what already exists):
  {{input.adrs}}

  Recently changed code files (a hint, may be empty):
  {{input.recently_changed_code_files}}

  Procedure:
   1. Build a mental map of the major subsystems via the code
      surface. Use Glob + Grep before Read so you spend your tool
      budget on the load-bearing files.
   2. For each subsystem, ask: does the code embody a non-obvious
      decision worth recording? Apply the three checks from
      `decision-vs-mechanic.md`. If yes, populate a `decisions[]`
      entry. If no, move on.
   3. For each in-flight feature you encounter, ask: is the
      implementation complete? Tag any gap with the matching
      `gap_kind` enum from `completeness-taxonomy.md`.
   4. Cap the output: at most 20 decisions + 30 gaps per run.
      Prioritise by severity (gaps) and re-challenge value
      (decisions). The tail surfaces on subsequent runs.

  Output fields (`survey_output`):
   - decisions: structured decision objects (see
     decision-vs-mechanic.md for the per-entry shape;
     `is_mechanic: true` entries are dropped downstream)
   - gaps:      structured gap objects (see
     completeness-taxonomy.md)
   - surveyed_paths: distinct repo-relative paths you read


prompt campaign_system:
  You are Adry, a senior engineer-archivist running an ADR-ALIGNMENT
  campaign — working EXACTLY as you would in a productive, human-driven
  session. You have the repo in front of you and full tools (read,
  edit, shell, git). No one micro-manages you; you own this pass end
  to end.

  THE MISSION: make the ADR directory match the decisions the code
  actually embodies. You OBSERVE code and WRITE ADRs — you never
  change code.

  LOAD YOUR SKILLS FIRST (mirrored into .claude/skills/):
    - `adry.md` — operating playbook, mission, inviolable rules.
    - `decision-vs-mechanic.md` — the dam against ADR-spam. EVERY ADR
      you author must pass its three checks (non-obvious trade-off,
      real alternative + the constraint that ruled it out, plausible
      re-challenge condition). If a drift candidate cannot pass them
      honestly, dismiss it as a mechanic — do NOT pad the archive.
    - `adr-format.md` — the Nygard format (Status / Context /
      Decision / Alternatives / Consequences) you author in.
    - `completeness-taxonomy.md` — the gap_kind enum behind the
      handoff issues.
    - `adr-scope-detection.md` — where ADRs live across repo shapes.

  YOUR WORKING SET is deterministic. Upstream, `survey_code` surveyed
  the code (read-only, evidence-cited) and `build_manifest` diffed its
  findings against the live ADR directory. Your user prompt carries:
    - decision_drift[]  — ADR-worthy decisions the code embodies that
      NO existing ADR records. For each: apply the three checks
      yourself against the cited code_paths (read the code — the
      survey is evidence, not gospel); if it holds, AUTHOR the ADR; if
      it is a mechanic in disguise, dismiss it and say so in summary.
    - adr_orphans[]     — existing ADRs whose cited code paths ALL
      vanished. Read each: update the ADR (a dated addendum, a status
      flip to Superseded, or corrected citations if the code moved) —
      never silently delete history.
    - gaps_for_handoff[] / adrs_aged_out[] — NOT yours to fix in the
      tree; they become board issues (see HANDOFFS).

  HOW TO WORK — reproduce the shape of a productive session:

  1. LIVING TODO LIST from the manifest: group drift items by
     subsystem, orphans by ADR. Re-prioritize as you read the code.

  2. THE REPEATED UNIT, one ADR at a time: read the cited code →
     apply the three checks → author or update ONE `.md` under the
     ADR directory (Nygard format; for a NEW ADR, number it with the
     next free NNN — check the directory as you go, numbers advance
     as you author; zero-padded to three digits) → COMMIT it with
     `docs(adr): <NNN short-title>` and the trailer line
     `Bot: adr-cartograph`. One ADR per commit, evidence before
     authorship — an ADR whose Context/Decision cannot cite the code
     you read is a façade.

  3. COMMIT EACH ADR AS YOU FINISH IT — never batch. `git add -A`
     then commit before moving on. git IS your durable state: an
     interrupted run keeps every ADR you committed, and a fresh pass
     re-manifests and continues.

  4. WRITEABLE SET — `.md` under the ADR directory ONLY (plus the
     audit cache file). A deterministic scope gate diffs the whole
     run against its base after every pass: anything else FAILS the
     gate and bounces back to you to revert. You never edit code —
     a code observation worth acting on becomes a board issue.

  5. BASELINE — the build gate runs as the universal floor. A failure
     that predates this run (see `baseline`, or one cheap
     `git stash`-based check) is out of scope: note it and move on.

  6. ASK ONLY ON A REAL DECISION. Genuinely ambiguous cases (is this
     pattern deliberate or accidental?) may pause for the operator —
     keep it RARE; when in doubt, prefer dismissing over inventing.

  HANDOFFS — after your last commit, file the board issues (call
  `mcp__iterion_board__list_issues` with `{ "state": "inbox" }` first
  to avoid duplicates, then `mcp__iterion_board__create_issue` per NEW
  item):
    - each gaps_for_handoff entry → state "inbox", labels
      ["findings", "type:feature-gap", "source:adr_cartograph",
      "severity:<its severity>"] — the body carries the gap's
      evidence so a feature-gap-fill (Fini) run can close it.
    - each adrs_aged_out entry → state "inbox", labels
      ["findings", "type:adr-rechallenge", "source:adr_cartograph"] —
      the body names the ADR + its age so an adr-rechallenge run can
      re-examine it.
  Be conservative; zero issues is a fine outcome. If the board tools
  are unavailable, list the handoffs in `summary` instead.

  KEEP GOING, one ADR at a time, until this pass has adjudicated every
  drift candidate and orphan in its working set. Then STOP and report.

  TERMINATION CONTRACT (required structured output — the engine keys
  convergence on it; an under-specified end just gets re-poked):
    - adrs_aligned: true ONLY when every candidate this pass surfaced
      is authored, updated, or explicitly dismissed-as-mechanic — i.e.
      you expect a fresh manifest re-diff to find no remaining real
      drift. false if real drift remains.
    - commits_this_pass: how many commits you landed this pass.
    - drift_remaining: a concise note of what still drifts (empty when
      adrs_aligned).
    - needs_human / human_note: set if you paused or need an operator
      decision.
    - summary: the ADRs you authored/updated (with the code evidence
      behind each), the candidates you dismissed as mechanics and why,
      and the handoff issues you filed.

  Be honest. A deterministic manifest re-diff (which re-globs the live
  ADR directory), a scope gate and a build gate re-check the tree
  after you, and the run loops you back until you report adrs_aligned
  AND the gates are green AND the mechanical coverage meets its target
  — so under-reporting only costs a pass, and over-reporting lands you
  right back here.

prompt campaign_user:
  Repository: {{vars.workspace_dir}}
  ADR directory: {{vars.adr_dir}}

  Scope notes (operator's attention pin, may be empty):
  {{vars.scope_notes}}

  ## Deterministic manifest (this pass)
  Existing ADRs: {{input.total_adrs}} · surveyed decisions: {{input.total_decisions}}
  Decision drift (unrecorded decisions): {{input.decision_drift_count}}
  Orphaned ADRs (all cited paths gone):  {{input.adr_orphans_count}}
  Mechanical coverage: {{input.coverage_pct}}% (gate target: {{input.coverage_target_pct}}%)
  Next free ADR number at scan time: {{input.next_adr_number}} (re-check
  the directory as you author — numbers advance with each new ADR)

  Decision drift candidates (each: title, context, decision,
  code_paths, alternative, rechallenge):
  {{input.decision_drift}}

  Orphaned ADRs (each: path, nnn, cited_paths, missing_paths, status):
  {{input.adr_orphans}}

  Handoffs to file as board issues AFTER your last commit:
  gaps (medium/high): {{input.gaps_for_handoff}}
  aged-out ADRs (rechallenge invitations): {{input.adrs_aged_out}}

  Recently changed code files (prioritisation hint, may be empty):
  {{input.recently_changed_code_files}}

  BASELINE — pre-existing failures to SKIP (empty = establish once
  cheaply if the build gate goes red):
  {{vars.baseline}}

  Deterministic gate feedback from the PREVIOUS pass (empty on the
  first pass; a scope violation means revert the offending commits
  before continuing):
  {{input.fail_log}}

  Work the drift one ADR at a time — read the cited code → three
  checks → author/update the `.md` → commit (`docs(adr): …` +
  `Bot: adr-cartograph` trailer) — then file the handoff issues and
  report the termination contract (adrs_aligned, commits_this_pass,
  drift_remaining). Read `git log` first to see what earlier passes
  already landed.


## ─── verify (deterministic build gate, stack-agnostic) ──────────────
## The shared v2 floor: an ADAPTIVE agent writes the repo's real
## build(+fast tests) into an OUT-OF-TREE <scratch_dir>/verify.sh; a
## DETERMINISTIC tool re-runs it on the REAL exit code. ADR passes are
## docs-only, so this is cheap — and it catches any accidental code
## breakage at the build level on top of scope_check's path containment.

prompt verify_system:
  You are a release engineer. An ADR-alignment pass just committed
  documentation changes to this repository. Your single job: capture
  how THIS repo builds itself into a re-runnable script the
  deterministic gate will execute. You do NOT change anything.

  STEPS:
  1. Detect how THIS repo builds — read the `verify-build` skill. Use
     the repo's OWN toolchain, honouring any pinned toolchain. Do NOT
     assume a language.
  2. Write an executable POSIX-sh script to
     `{{vars.scratch_dir}}/verify.sh` (out-of-tree — `mkdir -p` it
     first) that runs the repo's build (or the closest fast sanity
     command) and exits non-zero on failure. This pass touched only
     ADR markdown, so keep it FAST — build-level is enough.
  3. Run it ONCE to confirm the script itself is valid.
  4. If the repo genuinely has no build system (pure docs/config),
     write a script that echoes that and exits 0, and say so.

  A deterministic tool node RE-RUNS your script and gates the run on
  its real exit code. Output prepared=true once the script exists;
  summary = the command you settled on.

prompt verify_user:
  Repository to verify: {{vars.workspace_dir}}

  Capture the repo's real build into `{{vars.scratch_dir}}/verify.sh`
  (out-of-tree — see the `verify-build` skill). Do NOT change
  anything.

  MANDATORY (skill section 1b): if the repo's own CI enforces a
  codegen-drift gate (git diff --exit-code after a regen/vendor step,
  a drift-check task, test -z on git status --porcelain), verify.sh
  MUST mirror it — run the regen command(s), then fail on drift; the
  deterministic precheck rejects a gateless verify.sh otherwise.


## carries each ADR's metadata + sha so subsequent passes can
## detect changes. next_adr_number is the integer Adry uses for
## newly-authored ADRs (max NNN prefix + 1). duplicates[] is
## non-empty when two ADRs share an NNN prefix (warning only).
schema scan_output:
  adrs: json
  adr_count: int
  next_adr_number: int
  duplicates: string[]
  pre_verified_adrs: string[]
  recently_changed_code_files: string[]
  bundle_self_path: string
  scope_notes: string

## survey_output: emitted by survey_code. decisions[] entries
## carry the per-entry shape defined in decision-vs-mechanic.md
## (title, context, decision, code_paths, alternative,
## rechallenge, is_mechanic). gaps[] entries carry the shape
## from completeness-taxonomy.md (feature, implemented, missing,
## gap_kind, severity, evidence). Both are json because the DSL
## schema parser does not support nested object arrays.
schema survey_output:
  decisions: json
  gaps: json
  surveyed_paths: string[]

## build_manifest input: the working set the deterministic
## differ consumes.
schema build_manifest_input:
  workspace_dir: string
  adr_dir: string
  adrs: json
  decisions: json
  gaps: json
  code_scope_globs: string
  rechallenge_after_days: int

## build_manifest output: the bounded candidate set the
## reviewers consume. decision_drift = decisions[] not yet
## recorded as ADRs. adr_orphans = ADRs whose cited code paths
## no longer exist. gaps_for_handoff = filtered to
## severity in {medium, high}. adrs_aged_out = ADRs whose Date
## is older than rechallenge_after_days days (empty when the
## var is 0).
schema build_manifest_output:
  total_adrs: int
  total_decisions: int
  total_gaps: int
  decision_drift: json
  decision_drift_count: int
  adr_orphans: json
  adr_orphans_count: int
  gaps_for_handoff: json
  adrs_aged_out: json
  verified_anchors: int
  drifted_anchors: int
  checkable_anchors: int
  coverage_pct: int

## Free-form mark_issue_for_review output (matches docs-refresh).
schema mark_issue_output:
  text: string

## update_cache I/O.
schema update_cache_input:
  workspace_dir: string
  cache_path: string
  adr_dir: string

schema update_cache_output:
  cache_path: string
  entries_written: int
  skipped: string

## ─── Schemas (v2 campaign / gates) ─────────────────────────────────

## campaign's input: the manifest working set + previous gate feedback.
schema campaign_input:
  total_adrs: int
  total_decisions: int
  decision_drift: json
  decision_drift_count: int
  adr_orphans: json
  adr_orphans_count: int
  gaps_for_handoff: json
  adrs_aged_out: json
  coverage_pct: int
  coverage_target_pct: int
  next_adr_number: int
  recently_changed_code_files: string[]
  fail_log: string

## campaign's TERMINATION CONTRACT (G2).
schema campaign_output:
  adrs_aligned: bool
  commits_this_pass: int
  drift_remaining: string
  needs_human: bool
  human_note: string
  summary: string

schema verify_plan:
  prepared: bool
  summary: string

schema verify_result:
  passed: bool
  skipped: bool
  exit_code: int
  log_tail: string

## scope_check: deterministic writeable-set containment — only .md
## under adr_dir (+ the cache file) may change since the run base.
schema scope_check_output:
  scope_ok: bool
  out_of_scope: string[]
  log: string

schema gate_state:
  converged: bool
  fail_log: string


## ─── Nodes ──────────────────────────────────────────────────────

## scan_adrs runs ONCE upstream of the survey + review loop.
## Enumerates {{vars.adr_dir}}/*.md, parses the bullet-list
## front-matter (Status / Date / Authors / Code / Code context),
## computes next_adr_number and duplicates[], and cross-references
## the sha-cache at {{vars.audit_cache_path}} to seed
## pre_verified_adrs[] (those whose content + cited code shas
## are unchanged since the previous successful run).
##
## Tolerant of: (a) the `**Code**:` / `**Code context**:` dual
## convention, (b) duplicate NNN prefixes (warning, not error),
## (c) a missing ADR directory (returns empty arrays — the
## fixer will create the directory on first author).
##
## Raw-string command — the python snippet embeds quotes, so the
## raw form (backtick-quoted) avoids escape hell. Templates
## {{vars.X}} resolve at iterion's command-substitution layer.
tool scan_adrs:
  command: `WS={{vars.workspace_dir}} ADR_DIR={{vars.adr_dir}} CACHE_PATH={{vars.audit_cache_path}} DIFF_SINCE={{vars.diff_since}} BUNDLE_SELF={{vars.bundle_self_path}} EXCLUDED_DIRS={{vars.excluded_dirs}} SCOPE_NOTES={{vars.scope_notes}} python3 -c "
import os, json, glob, hashlib, re, subprocess, datetime
ws = os.environ['WS']
adr_dir = os.environ.get('ADR_DIR', 'docs/adr').strip()
cache_path = os.environ.get('CACHE_PATH', '').strip()
diff_since = os.environ.get('DIFF_SINCE', '').strip()
bundle_self = os.environ.get('BUNDLE_SELF', '').strip().rstrip(os.sep)
scope_notes = os.environ.get('SCOPE_NOTES', '')
EXCLUDE_DIRS = {d.strip() for d in os.environ.get('EXCLUDED_DIRS', '').split(',') if d.strip()}
os.chdir(ws)
def excluded(p):
    if any(part in EXCLUDE_DIRS for part in p.split(os.sep)):
        return True
    if bundle_self and (p == bundle_self or p.startswith(bundle_self + os.sep)):
        return True
    return False
def sha_of_file(p):
    try:
        with open(p, 'rb') as fh:
            return hashlib.sha1(fh.read()).hexdigest()
    except (FileNotFoundError, IsADirectoryError, PermissionError):
        return 'missing'
adr_files = sorted([f for f in glob.glob(os.path.join(adr_dir, '*.md')) if os.path.isfile(f) and not excluded(f)])
NNN_RE = re.compile(r'^(\d{3,4})-([a-z0-9-]+)\.md$')
STATUS_RE = re.compile(r'^\s*-\s*\*\*Status\*\*\s*:\s*(.+?)\s*$', re.MULTILINE)
DATE_RE = re.compile(r'^\s*-\s*\*\*Date\*\*\s*:\s*(\d{4}-\d{2}-\d{2})\s*$', re.MULTILINE)
TITLE_RE = re.compile(r'^#\s*ADR-\d{3,4}\s*:\s*(.+?)\s*$', re.MULTILINE)
CODE_RE = re.compile(r'^\s*-\s*\*\*Code(?:\s+context)?\*\*\s*:\s*(.+)$', re.MULTILINE)
LINK_RE = re.compile(r'\[([^\]]+)\]\(\.\.\/\.\.\/([^)\s]+)\)')
adrs = []
seen_prefixes = {}
duplicates = []
max_nnn = 0
today = datetime.date.today()
for f in adr_files:
    base = os.path.basename(f)
    m = NNN_RE.match(base)
    if not m:
        continue
    nnn = int(m.group(1))
    slug = m.group(2)
    seen_prefixes.setdefault(m.group(1), []).append(f)
    if nnn > max_nnn:
        max_nnn = nnn
    try:
        with open(f, encoding='utf-8', errors='replace') as fh:
            body = fh.read()
    except (FileNotFoundError, IsADirectoryError, PermissionError):
        continue
    status_m = STATUS_RE.search(body)
    date_m = DATE_RE.search(body)
    title_m = TITLE_RE.search(body)
    code_m = CODE_RE.search(body)
    cited_paths = []
    if code_m:
        cited_paths = sorted({m2.group(2) for m2 in LINK_RE.finditer(code_m.group(1))})
    age_days = None
    if date_m:
        try:
            dt = datetime.date.fromisoformat(date_m.group(1))
            age_days = (today - dt).days
        except ValueError:
            age_days = None
    adrs.append({
        'path': f,
        'nnn': m.group(1),
        'slug': slug,
        'title': title_m.group(1) if title_m else '',
        'status': status_m.group(1) if status_m else '',
        'date': date_m.group(1) if date_m else '',
        'age_days': age_days,
        'sha': sha_of_file(f),
        'cited_paths': cited_paths,
    })
for prefix, paths in seen_prefixes.items():
    if len(paths) > 1:
        duplicates.append(prefix)
duplicates.sort()
recent = []
if diff_since:
    try:
        proc = subprocess.run(['git', 'diff', '--name-only', diff_since + '...HEAD'], capture_output=True, text=True, check=True)
        recent = sorted([l for l in proc.stdout.splitlines() if l and not excluded(l)])
    except Exception:
        recent = []
pre_verified = []
if cache_path:
    try:
        with open(cache_path) as cf:
            cache = json.load(cf)
        entries = cache.get('adr', {})
        for a in adrs:
            entry = entries.get(a['path'])
            if not entry:
                continue
            if entry.get('sha') != a['sha']:
                continue
            refs_ok = True
            for ref in entry.get('refs', []):
                p = ref.get('p', '')
                s = ref.get('s', '')
                if not p:
                    continue
                current = sha_of_file(p) if os.path.exists(p) else 'missing'
                if current != s:
                    refs_ok = False
                    break
            if refs_ok:
                pre_verified.append(a['path'])
    except (FileNotFoundError, json.JSONDecodeError):
        pass
print(json.dumps({
    'adrs': adrs,
    'adr_count': len(adrs),
    'next_adr_number': max_nnn + 1,
    'duplicates': duplicates,
    'pre_verified_adrs': sorted(pre_verified),
    'recently_changed_code_files': recent,
    'bundle_self_path': bundle_self,
    'scope_notes': scope_notes,
}))
"`
  output: scan_output

## survey_code: read-only Claude Code agent. Surveys the code in
## vars.workspace_dir, emits ADR-worthy decisions[] + gaps[]
## grounded in real files. Bounded by code_scope_globs +
## excluded_dirs + bundle_self_path. NO writes; fresh session
## (each run is an independent look).
agent survey_code:
  backend: "claude_code"
  model: "${ITERION_ADRY_MODEL_CLAUDE:-claude-opus-5}"
  reasoning_effort: "${ITERION_ADRY_EFFORT_CLAUDE:-max}"
  input: scan_output
  output: survey_output
  system: survey_code_system
  user: survey_code_user
  session: fresh
  readonly: true
  tool_max_steps: 80
  interaction: human

## build_manifest: deterministic diff of decisions[] vs adrs[]
## and adrs[] vs filesystem. Computes:
##   - decision_drift: decisions whose code_paths are not cited
##                     by any existing ADR (after stripping
##                     is_mechanic entries).
##   - adr_orphans:    ADRs whose Code-cited paths no longer
##                     exist on disk (rename/refactor candidates).
##   - gaps_for_handoff: gaps filtered to
##                     severity in {medium, high}.
##   - adrs_aged_out:  ADRs whose age_days exceeds
##                     rechallenge_after_days (empty when 0).
##   - coverage_pct:   verified / checkable anchor ratio.
##
## Pure python; no LLM. Inputs flow via env vars (JSON-encoded for
## arrays).
tool build_manifest:
  command: `WS={{input.workspace_dir}} ADR_DIR={{input.adr_dir}} ADRS={{input.adrs}} DECISIONS={{input.decisions}} GAPS={{input.gaps}} CODE_GLOBS={{input.code_scope_globs}} RECHALLENGE_DAYS={{input.rechallenge_after_days}} python3 -c "
import os, json
ws = os.environ['WS']
os.chdir(ws)
def jload(name, default):
    raw = os.environ.get(name, '')
    if not raw:
        return default
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return default
import glob, datetime
adr_dir = os.environ.get('ADR_DIR', 'docs/adr')
def _parse_adr(path):
    try:
        txt = open(path, encoding='utf-8').read()
    except Exception:
        txt = ''
    cited = []
    i = 0
    while True:
        j = txt.find('../../', i)
        if j < 0:
            break
        k = j + 6
        e = k
        while e < len(txt) and txt[e] not in ')#\n ':
            e += 1
        seg = txt[k:e]
        if seg:
            cited.append(seg)
        i = max(e, j + 6)
    status = ''
    date = ''
    for line in txt.splitlines():
        s = line.strip()
        if s.startswith('- **Status**:'):
            status = s.split(':', 1)[1].strip()
        elif s.startswith('- **Date**:'):
            date = s.split(':', 1)[1].strip()
    age = None
    if date:
        try:
            d = datetime.date.fromisoformat(date[:10])
            age = (datetime.date.today() - d).days
        except ValueError:
            age = None
    base = os.path.basename(path)
    nnn = base.split('-', 1)[0]
    return {'path': path, 'nnn': nnn, 'cited_paths': sorted(set(cited)), 'status': status, 'date': date, 'age_days': age}
## Re-glob the CURRENT docs/adr/ each pass (NOT the frozen scan_adrs.adrs
## input): the fixers author new ADR files inside the review loop, and the
## coverage gate must SEE them or it can never reach the convergence
## threshold (dogfood finding: coverage froze at 71% through 10 iterations
## because the authored ADRs were invisible to the frozen input set).
adrs = [_parse_adr(p) for p in sorted(glob.glob(os.path.join(adr_dir, '*.md')))]
decisions = jload('DECISIONS', [])
gaps = jload('GAPS', [])
try:
    rechallenge_days = int(os.environ.get('RECHALLENGE_DAYS', '0'))
except ValueError:
    rechallenge_days = 0
non_mechanic_decisions = [d for d in decisions if not d.get('is_mechanic')]
adr_paths_cited = set()
for a in adrs:
    for p in a.get('cited_paths', []):
        adr_paths_cited.add(p)
decision_drift = []
for d in non_mechanic_decisions:
    code_paths = d.get('code_paths', []) or []
    if not any(p in adr_paths_cited for p in code_paths):
        decision_drift.append(d)
adr_orphans = []
for a in adrs:
    cited = a.get('cited_paths', []) or []
    if not cited:
        continue
    missing = [p for p in cited if not os.path.exists(p)]
    if missing and len(missing) == len(cited):
        out = dict(a)
        out['missing_paths'] = missing
        adr_orphans.append(out)
gaps_for_handoff = [g for g in gaps if g.get('severity') in ('medium', 'high')]
adrs_aged_out = []
if rechallenge_days > 0:
    for a in adrs:
        age = a.get('age_days')
        if isinstance(age, int) and age > rechallenge_days:
            adrs_aged_out.append(a)
verified = len(adrs) - len(adr_orphans)
drifted = len(decision_drift) + len(adr_orphans)
checkable = verified + drifted
coverage_pct = (verified * 100 // checkable) if checkable > 0 else 100
print(json.dumps({
    'total_adrs': len(adrs),
    'total_decisions': len(decisions),
    'total_gaps': len(gaps),
    'decision_drift': decision_drift,
    'decision_drift_count': len(decision_drift),
    'adr_orphans': adr_orphans,
    'adr_orphans_count': len(adr_orphans),
    'gaps_for_handoff': gaps_for_handoff,
    'adrs_aged_out': adrs_aged_out,
    'verified_anchors': verified,
    'drifted_anchors': drifted,
    'checkable_anchors': checkable,
    'coverage_pct': coverage_pct,
}))
"`
  input: build_manifest_input
  output: build_manifest_output

## mark_issue_for_review: identical pattern to docs-refresh.
## After convergence, transition the tracker issue out of
## `ready` so the dispatcher does not re-pick it. No-op when
## vars.issue_id is empty (manual CLI runs).
tool mark_issue_for_review:
  command: `if [ -n {{vars.issue_id}} ]; then ID={{vars.issue_id}}; ID_SHORT=${ID#native:}; PORT=${ITERION_DISPATCHER_PORT:-4891}; curl -sS -X POST -H "Content-Type: application/json" -d '{"to":"review"}' "http://localhost:${PORT}/api/v1/native/issues/${ID_SHORT}/transition" 2>&1 | head -c 1000 || true; else echo '{"skipped":"no issue_id"}'; fi`
  output: mark_issue_output

## detect_changes: deterministic guard between converged review
## and the commit phase. A no-op pass (no .md written) bypasses
## prepare_commit + commit_changes + mark_issue_for_review and
## goes straight to update_cache + done — so handoff issues are
## NEVER filed when nothing changed.

## update_cache: rewrites <workspace>/<audit_cache_path> from the
## live ADR directory state (doc shas + cited code shas) so the
## NEXT run's scan_adrs can pre-verify unchanged entries.
tool update_cache:
  command: `python3 -c "
import os, json, hashlib, re, sys, pathlib, glob
ws = sys.argv[1]
cache_path = sys.argv[2]
adr_dir = sys.argv[3] if len(sys.argv) > 3 else 'docs/adr'
if not cache_path:
    print(json.dumps({'cache_path': '', 'entries_written': 0, 'skipped': 'no cache_path'}))
    sys.exit(0)
os.chdir(ws)
def sha_of_file(p):
    try:
        with open(p, 'rb') as fh:
            return hashlib.sha1(fh.read()).hexdigest()
    except (FileNotFoundError, IsADirectoryError, PermissionError):
        return 'missing'
LINK_RE = re.compile(r'\[([^\]]+)\]\(\.\.\/\.\.\/([^)\s]+)\)')
CODE_RE = re.compile(r'^\s*-\s*\*\*Code(?:\s+context)?\*\*\s*:\s*(.+)$', re.MULTILINE)
adr_entries = {}
for f in sorted(glob.glob(os.path.join(adr_dir, '*.md'))):
    if not os.path.isfile(f):
        continue
    try:
        with open(f, encoding='utf-8', errors='replace') as fh:
            body = fh.read()
    except (FileNotFoundError, IsADirectoryError, PermissionError):
        continue
    code_m = CODE_RE.search(body)
    refs = []
    if code_m:
        cited = sorted({m.group(2) for m in LINK_RE.finditer(code_m.group(1))})
        for p in cited:
            refs.append({'p': p, 's': sha_of_file(p) if os.path.exists(p) else 'missing'})
    adr_entries[f] = {'sha': sha_of_file(f), 'refs': refs}
out_path = pathlib.Path(cache_path)
out_path.parent.mkdir(parents=True, exist_ok=True)
with open(out_path, 'w') as out:
    json.dump({'v': 1, 'adr': adr_entries}, out, indent=2, sort_keys=True)
print(json.dumps({'cache_path': str(out_path), 'entries_written': len(adr_entries), 'skipped': ''}))
" {{input.workspace_dir}} {{input.cache_path}} {{input.adr_dir}}`
  input: update_cache_input
  output: update_cache_output


## ─── Workflow ───────────────────────────────────────────────────


## ─── Nodes : v2 campaign + gates ────────────────────────────────

## campaign — the one adaptive agent. Board capabilities power the
## gap / rechallenge handoffs (v1 filed them in prepare_commit).
agent campaign:
  backend: "claude_code"
  model: "${ITERION_ADR_MODEL_CLAUDE:-claude-opus-5}"
  reasoning_effort: "${ITERION_ADR_EFFORT_CLAUDE:-high}"
  input: campaign_input
  output: campaign_output
  system: campaign_system
  user: campaign_user
  session: fresh
  interaction: human
  capabilities: [board.read, board.create]

agent verify_build:
  backend: "claude_code"
  model: "${ITERION_ADR_MODEL_CLAUDE:-claude-opus-5}"
  reasoning_effort: "${ITERION_ADR_EFFORT_CLAUDE:-medium}"
  output: verify_plan
  system: verify_system
  user: verify_user
  session: fresh
  interaction: human

## verify_run — deterministic re-run of the agent-prepared verify.sh
## (real exit code; python3 for safe JSON; no backticks — E012).
tool verify_run:
  command: `WS={{vars.workspace_dir}} SCRATCH={{vars.scratch_dir}} python3 -c "
import os, subprocess, json
ws = os.environ.get('WS', '.')
scratch = os.environ.get('SCRATCH', '.')
try:
    os.makedirs(scratch, exist_ok=True)
except OSError:
    pass
script = os.path.join(scratch, 'verify.sh')
if not os.path.exists(script):
    print(json.dumps({'passed': True, 'skipped': True, 'exit_code': 0, 'log_tail': 'verify_build produced no verify.sh in the scratch dir; build gate SKIPPED (counted as pass, but surfaced) -- verify_build should write the script'}))
    raise SystemExit(0)
def sh_uncommented(text):
    # The script and the CI config, read with comments removed -- shared by
    # every structural check below so a commented-out gate never counts as
    # one and a commented-out pipeline never accuses.
    out_lines = []
    for raw in text.splitlines():
        cut = len(raw)
        i = 0
        while i < len(raw):
            if raw[i] == chr(35) and (i == 0 or raw[i - 1] in (chr(32), chr(9))):
                cut = i
                break
            i = i + 1
        out_lines.append(raw[:cut])
    return out_lines
def ends_nonzero(s):
    # A statement that ENDS the script non-zero: exit/return with a non-zero
    # (or inherited) status, or a bare false.
    for kw in ('exit ', 'return '):
        p = s.find(kw)
        while p >= 0:
            rest = s[p + len(kw):].lstrip()
            if rest[:1] in ('1', '2', '3', '4', '5', '6', '7', '8', '9') or rest[:1] == chr(36):
                return True
            p = s.find(kw, p + 1)
    return s == 'false' or s.endswith(' false') or s.endswith(';false')
def tree_state():
    try:
        p = subprocess.run(['git', '-C', ws, 'status', '--porcelain'], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=60)
        if p.returncode != 0:
            return None
        return set(l for l in p.stdout.splitlines() if l.strip())
    except Exception:
        return None
pre = tree_state()
rc = 0
out = ''
try:
    p = subprocess.run(['sh', script], cwd=ws, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=1200)
    out = p.stdout or ''
    rc = p.returncode
except subprocess.TimeoutExpired as e:
    out = (e.output or '') + chr(10) + '[verify timed out after 1200s]'
    rc = 124
except Exception as e:
    out = 'verify_run could not execute the script: ' + str(e)
    rc = 1
# Deterministic codegen-drift tail (stack-agnostic; the gate stays
# deterministic per ADR-044). Only on a GREEN verify: (1) if the repo's own
# CI enforces a drift gate, verify.sh must mirror it; (2) a green verify
# must not leave new changes in the tree (regen output belongs in a commit).
if rc == 0:
    import glob
    def has_drift_gate(text):
        # STRUCTURAL detection: a drift gate is a drift PROBE whose failure ENDS
        # the script. Read one line at a time the commonest shape was invisible --
        # the exit 1 of an  if ! git diff --quiet ...; then  sits on a LATER line
        # -- so a genuinely green verify was refused with DRIFT GATE MISSING.
        # Comments are stripped first: a comment can DESCRIBE a gate, only a
        # command can BE one.
        lines = sh_uncommented(text)
        fail_fast = False
        for i, l in enumerate(lines):
            s = l.strip()
            if s.startswith('set -'):
                flags = (s.split() + [''])[1]
                if 'e' in flags[1:] or 'errexit' in s:
                    fail_fast = True
            probe = ('diff' in l and ('--exit-code' in l or '--quiet' in l)) or ('status --porcelain' in l)
            if not probe:
                continue
            # 1. --exit-code IS the gate: the command's own status is the verdict.
            if '--exit-code' in l:
                return True
            # 2. the verdict on the SAME line.
            if ('exit 1' in l) or ('|| exit' in l) or ('|| return' in l) or ('test -z' in l) or ('[ -z' in l):
                return True
            # 3. NEGATED conditional -- if ! <probe>; then ... exit 1 ... fi. The
            #    branch runs WHEN THE TREE DRIFTED, so a non-zero exit anywhere in
            #    it is the gate; scan to the matching else/fi. A body that COMMITS
            #    the drift instead (the updater shape) never reaches an exit and
            #    is still correctly rejected.
            if (s.startswith('if ') or s.startswith('elif ')) and '!' in s.split(';')[0]:
                depth = 0
                j = i + 1
                while j < len(lines):
                    b = lines[j].strip()
                    if b == 'fi' or b.startswith('fi '):
                        if depth == 0:
                            break
                        depth = depth - 1
                    elif depth == 0 and (b == 'else' or b.startswith('elif ')):
                        break
                    elif b.startswith('if ') or b == 'if':
                        depth = depth + 1
                    if ends_nonzero(b):
                        return True
                    j = j + 1
                continue
            # 4. FAIL-FAST script -- a bare  git diff --quiet  under set -e aborts
            #    on drift, so the mode itself is the gate. Restricted to the diff
            #    form on purpose: git status --porcelain exits 0 with output, so a
            #    bare one gates nothing. Never a condition, a captured value or a
            #    swallowed status.
            if fail_fast and 'diff' in l and '--quiet' in l:
                bare = not (s.startswith('if ') or s.startswith('elif ') or s.startswith('while ')
                            or s.startswith('until ') or s.startswith('!'))
                if bare and '||' not in s and '&&' not in s and (chr(36) + '(') not in s:
                    return True
        return False
    ci_hit = ''
    for pat in ('.github/workflows/*.yml', '.github/workflows/*.yaml', '.gitlab-ci.yml', '.circleci/config.yml'):
        for f in sorted(glob.glob(os.path.join(ws, pat))):
            try:
                if has_drift_gate(open(f, encoding='utf-8', errors='replace').read()):
                    ci_hit = os.path.relpath(f, ws)
                    break
            except OSError:
                pass
        if ci_hit:
            break
    if ci_hit:
        try:
            vs = open(script, encoding='utf-8', errors='replace').read()
        except OSError:
            vs = ''
        if not has_drift_gate(vs):
            rc = 3
            out = out + chr(10) + 'DRIFT GATE MISSING: CI (' + ci_hit + ') enforces a codegen-drift gate but ' + script + ' has none -- edit the script per the verify-build skill section 1b (run the repo regen command, then: git diff --exit-code).'
    if rc == 0 and pre is not None:
        post = tree_state()
        if post is not None:
            fresh = sorted(post - pre)
            if fresh:
                rc = 4
                out = out + chr(10) + 'UNCOMMITTED REGEN OUTPUT: a green verify left new changes in the tree; commit (or gitignore) them:' + chr(10) + chr(10).join(fresh[:50])
try:
    with open(os.path.join(scratch, 'verify.log'), 'w', encoding='utf-8') as lf:
        lf.write(out)
except OSError:
    pass
print(json.dumps({'passed': rc == 0, 'skipped': False, 'exit_code': rc, 'log_tail': out[-4000:]}))
"`
  output: verify_result

## scope_check — deterministic containment: diff the RUN BASE (oldest
## reflog entry of the fresh per-run worktree) vs the tree; every
## changed path must be .md under adr_dir or the cache file. The
## campaign must revert whatever this flags.
tool scope_check:
  command: `WS={{vars.workspace_dir}} ADR_DIR={{vars.adr_dir}} CACHE={{vars.audit_cache_path}} python3 -c "
import os, json, subprocess
ws = os.environ.get('WS', '.')
adr_dir = (os.environ.get('ADR_DIR', 'docs/adr') or 'docs/adr').strip().strip('/')
cache = os.environ.get('CACHE', '').strip()

def git(args):
    try:
        p = subprocess.run(['git', '-C', ws] + args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=120)
        return p.stdout or ''
    except Exception:
        return ''

reflog = [l for l in git(['reflog', '--format=%H']).splitlines() if l.strip()]
base = reflog[-1] if reflog else 'HEAD'
changed = set(l for l in git(['diff', base, '--name-only']).splitlines() if l.strip())
for line in git(['status', '--porcelain']).splitlines():
    if line[:2].strip() == '??':
        changed.add(line[3:].strip())

def allowed(p):
    if cache and p == cache:
        return True
    return p.startswith(adr_dir + '/') and p.endswith('.md')

out_of_scope = sorted(p for p in changed if not allowed(p))
log = ''
if out_of_scope:
    log = 'SCOPE VIOLATION: this run changed files outside ' + adr_dir + '/*.md. Revert these before continuing (git revert the offending commits, or git checkout ' + base[:12] + ' -- <path>): ' + ', '.join(out_of_scope[:40])
print(json.dumps({'scope_ok': not out_of_scope, 'out_of_scope': out_of_scope[:100], 'log': log}))
"`
  output: scope_check_output

## gate — converged = build green ∧ scope clean ∧ adrs_aligned ∧
## mechanical coverage ≥ target. fail_log priority: scope > build.
compute gate:
  output: gate_state
  expr:
    converged: "outputs.verify_run.passed && outputs.scope_check.scope_ok && outputs.campaign.adrs_aligned && outputs.build_manifest.coverage_pct >= vars.coverage_target_pct"
    fail_log: "if(!outputs.scope_check.scope_ok, outputs.scope_check.log, if(outputs.verify_run.passed, '', outputs.verify_run.log_tail))"


## ─── Workflow ───────────────────────────────────────────────────

workflow adr_cartograph:
  entry: scan_adrs

  ## v2: the campaign commits ADRs in stride, so run in an isolated
  ## per-run worktree (v1 committed once, terminally, on the live
  ## tree). Finalize lands the series on a persistent branch and
  ## best-effort FFs the operator's checkout.
  worktree: auto

  budget:
    max_parallel_branches: 1
    max_duration: "2h"
    max_cost_usd: 60

  compaction:
    threshold: 0.9
    preserve_recent: 8

  scan_adrs -> survey_code
  survey_code -> build_manifest with {
    workspace_dir: "{{vars.workspace_dir}}",
    adr_dir: "{{vars.adr_dir}}",
    adrs: "{{outputs.scan_adrs.adrs}}",
    decisions: "{{outputs.survey_code.decisions}}",
    gaps: "{{outputs.survey_code.gaps}}",
    code_scope_globs: "{{vars.code_scope_globs}}",
    rechallenge_after_days: "{{vars.rechallenge_after_days}}"
  }

  ## Each pass: the fresh manifest (which re-globs the live adr_dir,
  ## so authored ADRs count) hands the campaign its working set + the
  ## previous gate's feedback (nil-safe empty on pass 1).
  build_manifest -> campaign with {
    total_adrs: "{{outputs.build_manifest.total_adrs}}",
    total_decisions: "{{outputs.build_manifest.total_decisions}}",
    decision_drift: "{{outputs.build_manifest.decision_drift}}",
    decision_drift_count: "{{outputs.build_manifest.decision_drift_count}}",
    adr_orphans: "{{outputs.build_manifest.adr_orphans}}",
    adr_orphans_count: "{{outputs.build_manifest.adr_orphans_count}}",
    gaps_for_handoff: "{{outputs.build_manifest.gaps_for_handoff}}",
    adrs_aged_out: "{{outputs.build_manifest.adrs_aged_out}}",
    coverage_pct: "{{outputs.build_manifest.coverage_pct}}",
    coverage_target_pct: "{{vars.coverage_target_pct}}",
    next_adr_number: "{{outputs.scan_adrs.next_adr_number}}",
    recently_changed_code_files: "{{outputs.scan_adrs.recently_changed_code_files}}",
    fail_log: "{{outputs.gate.fail_log}}"
  }

  campaign -> scope_check
  scope_check -> verify_build
  verify_build -> verify_run
  verify_run -> gate

  gate -> mark_issue_for_review when converged
  ## Not converged → re-manifest (fresh drift/orphan/coverage from the
  ## live tree) → next campaign pass.
  gate -> build_manifest as continuation_loop("{{vars.max_passes}}") with {
    workspace_dir: "{{vars.workspace_dir}}",
    adr_dir: "{{vars.adr_dir}}",
    adrs: "{{outputs.scan_adrs.adrs}}",
    decisions: "{{outputs.survey_code.decisions}}",
    gaps: "{{outputs.survey_code.gaps}}",
    code_scope_globs: "{{vars.code_scope_globs}}",
    rechallenge_after_days: "{{vars.rechallenge_after_days}}"
  }
  ## Loop exhausted → ship what is banked (each committed ADR is real
  ## landed work; drift_remaining names the tail).
  gate -> mark_issue_for_review

  mark_issue_for_review -> update_cache with {
    workspace_dir: "{{vars.workspace_dir}}",
    cache_path: "{{vars.audit_cache_path}}",
    adr_dir: "{{vars.adr_dir}}"
  }
  update_cache -> done
