## ═══════════════════════════════════════════════════════════════════
## campaign (Campy) — supervise a WHOLE modernisation programme,
## lot after lot, holding the separation of powers a human held before.
##
## `modernize` carries ONE lot per run, by design: the programme is a suite
## of runs, not one long run. Someone has to relaunch it, judge whether a run
## landed anything, execute the ledger requests the worker is forbidden to
## execute, and decide when the programme is over. This bot is that someone.
##
## It was measured before it was written. A full modernisation programme was
## replayed end to end under a human supervisor, and the interventions were
## counted: almost all of them were MECHANICAL — a written procedure with a
## verifiable criterion — and the criterion held on every single act: the
## observed reference diff equalled the announced one, every time. What was
## mechanical is what this bot mechanises. What was not stays with a human,
## through two escalation modes.
##
## THE SUPERVISOR IS DETERMINISTIC. There is not one LLM node in this graph:
## intelligence lives in the child bots, judgement lives in gates, and the
## supervisor only measures, acts on written announcements, and keeps a
## journal. A supervisor with opinions would be a third author in a system
## whose whole safety comes from having exactly two, separated.
##
## THE TWO AUTHORITIES, unchanged:
##   - the worker (`modernize`, run as a subbot) changes the code and NEVER
##     writes the oracle's references — its own gate enforces that in git;
##   - the steward (a tool node HERE) re-records references, and ONLY on a
##     request written to the ledger, ONLY when the observed diff equals the
##     announced set exactly, with the full counter-test replayed behind.
##   The window discipline that separation demands — never act while a
##   worker is writing — is structural here: a subbot node returns only when
##   the child run is over. What cost a human a suspend/wait/verify ritual
##   costs this graph nothing.
##
## PROGRESS IS JUDGED BY GIT, NEVER BY THE RUN'S OWN JOURNAL. A run that did
## not move HEAD landed nothing — whatever it says of itself. Two child runs
## in a row without movement end the campaign: the point where a programme
## stops moving IS the measurement.
## ═══════════════════════════════════════════════════════════════════

dsl: 2

vars:
  workspace_dir: string = "${PROJECT_DIR}"
  ## The programme contract, versioned in the TARGET repo.
  plan_path: string = ".modernize/plan.yaml"
  ## Who approves a CONTRACT EXTENSION — a lot the worker added or reshaped
  ## in the plan, beyond flipping its own status. "bot": accepted in flight,
  ## listed at the HEAD of the end-of-campaign handoff for review. "human":
  ## every extension pauses the campaign for an operator, whatever the
  ## escalation mode — an unapproved extension shapes every lot after it,
  ## so its approval cannot wait for the end.
  governance: string [enum: "bot", "human"] = "bot"
  ## When escalation items other than extensions arise (a rebaseline request
  ## the steward refused, a mismatched diff, a red counter-test, a dirty
  ## tree): "interactive" pauses the run there and then; "handoff"
  ## accumulates them — a blocked lot no longer blocks its dependants, so
  ## the campaign keeps landing what it still can — and presents everything
  ## once, at the end.
  escalation: string [enum: "handoff", "interactive"] = "handoff"
  ## Upper bound on child runs. The natural stops are the programme being
  ## exhausted or the stagnation rule; this is the belt over those braces.
  max_lots: int = 40
  ## Consecutive child runs without a single new commit that end the
  ## campaign. Two is the measured value: one still run can be a lot that
  ## legitimately blocked; two in a row means nothing eligible is landing.
  stagnation_stop: int = 2
  ## Forwarded to the child: bounded repair loop per lot.
  lot_max_passes: int = 4

  ## ── Phase 0: the campaign's own bootstrap ────────────────────────
  ## `preflight` refuses a campaign with no contract and no net — rightly,
  ## and it is UNCHANGED. What used to satisfy it was two manual gestures
  ## before anyone could launch: somebody wrote the plan, somebody built the
  ## net. Phase 0 is those gestures, run as three child bots BEFORE
  ## preflight, which still has the last word on what they produced.
  ##
  ## The supervisor stays deterministic through it: every phase-0 decision
  ## is a tool node reading FILES, and every child is judged in GIT — an
  ## artefact is landed when it is committed, never when a run says so.
  ##
  ## OFF by default, and the reason is a measured gap rather than caution.
  ## `pkg/runtime/engine_run.go` runs a `worktree: auto` child in the
  ## parent's tree only when the parent holds a SANDBOX; the docs child
  ## declares `worktree: auto`, so on a plain local `iterion run` it takes
  ## a worktree of its own, finalises its pages onto a branch, and
  ## `docs_landed` refuses — every time, on a product with no pages yet;
  ## on one that arrived documented that gate can only SAY it could not
  ## tell the two apart. Defaulting ON would break the repositories that
  ## already have a contract and a net and used to run straight through.
  ## Turn it on with `--var phase_zero=true` (a sandboxed run does not hit
  ## this gap); the default flips the day that condition asks "is this a
  ## subbot child" instead.
  ##
  ## false starts the campaign exactly where it started before, at
  ## preflight, which refuses whatever prerequisite is missing.
  phase_zero: bool = false
  ## The programme BRIEF the assessment child turns into `plan_path`. Its
  ## absence, when the contract has to be written, is a REFUSAL — the same
  ## refusal preflight makes and for the same reason: a campaign supervises
  ## a written programme, and a plan is never guessed.
  brief_path: string = ".modernize/brief.yaml"
  ## The net's location is deliberately NOT a var. Phase 0 reads it from the
  ## contract (`oracle.dir`, `oracle.verify`) the way preflight does, because
  ## preflight is where the campaign looks for the net afterwards: a second
  ## source for the same path would let phase 0 build a net nobody reads.
  ## The product documentation the docs child writes, in the target repo.
  docs_dir: string = "docs/client"
  ## The id the generated catalog gives the product and its single repo. It
  ## names an entry in a catalog THIS bot writes, so any stable slug does.
  docs_product_id: string = "product"
  ## Out-of-tree scratch holding that generated catalog. Keeping it out of
  ## the workspace is what stops phase 0 from dirtying the very tree
  ## preflight then refuses to supervise.
  scratch_dir: string = "${PROJECT_SCRATCH_DIR}/campaign"

## ─── Prompts (for the two HUMAN nodes — no LLM reads these) ─────────

prompt escalate_instructions:
  The campaign supervisor paused because the items under review need an
  operator. They are listed with their type and evidence.

  Anything that must change, change IN THE REPOSITORY — edit the plan,
  answer a ledger request by hand, clean the tree — and commit it. The
  supervisor re-reads reality from git on the next run; nothing you type
  here edits anything.

  Then answer: `continue` to resume the campaign, or `stop` to end it now
  and go straight to the final handoff.

prompt review_instructions:
  The campaign is over and its handoff is committed in the repository. It
  leads with every contract extension that was accepted in flight under the
  configured governance — review those first: they are decisions a bot took
  and the handoff exists so a human re-takes them. Below them: escalations
  and their answers, the steward's acts, the run journal, the final oracle
  verdict, and the requalification of blocked lots.

  Acknowledge to close the run.

## ─── Schemas ───────────────────────────────────────────────────────

## Phase 0. Each decision carries the NOTICE that names the artefact which
## caused it — a skip nobody can attribute is a skip nobody can audit.
schema phase_zero_state:
  disabled: bool
  run_assessment: bool
  head_before: string
  notice: string

## The net's location, derived ONCE from the contract and handed to every
## node and child that touches the net after this one.
schema net_state:
  run_net: bool
  head_before: string
  oracle_dir: string
  verify_path: string
  notice: string

schema net_landed_input:
  before: string
  oracle_dir: string
  verify_path: string

schema docs_state:
  mode: string
  catalog_path: string
  ## The page inventory BEFORE the child ran, so the gate after it can say
  ## what this run landed instead of counting what was already there.
  pages_before: int
  notice: string

schema docs_landed_input:
  pages_before: int

## The commit a child started from, so "did it land anything" is measured
## against a sha this graph captured, not against the child's word.
schema landed_input:
  before: string

schema landed_state:
  notice: string

schema preflight_state:
  campaign_base: string
  refs_dir: string
  verify_path: string
  ledger_path: string
  notice: string

schema observe_input:
  base: string
  ledger_path: string

schema observe_state:
  before: string
  moved: bool
  stagnant: int
  exhausted: bool
  extensions: json
  pending: json
  notice: string

schema steward_input:
  before: string
  moved: bool
  extensions: json
  pending: json
  ledger_path: string
  verify_path: string

## `pause_required` is computed from configuration and facts, in code the
## operator can read — not by a model, and not by the child being judged.
schema steward_state:
  acts: int
  escalations: json
  pause_required: bool
  notice: string

schema escalate_input:
  items: string
  context: string

schema escalate_answer:
  action: string [enum: "continue", "stop"]
  note: string

schema answer_state:
  stop: bool

schema loop_state:
  proceed: bool
  reason: string

schema finalize_input:
  verify_path: string

schema finalize_state:
  handoff_path: string
  oracle_green: bool
  lots_done: int
  lots_blocked: int
  requalified: int
  notice: string

schema review_input:
  handoff_path: string
  summary: string

schema review_ack:
  ack: string

## ─── Nodes ─────────────────────────────────────────────────────────

## ─── Phase 0 — produce what preflight requires, then let it judge ──
##
##   phase_zero → assessment → golden_master → product_docs → preflight
##
## The order is not a preference. Neither child has anything to work from
## until the contract is written, and documentation cannot be shown to
## cover a product against an inventory that does not exist yet — which is
## why the net's location is handed to the docs child, whose exhaustiveness
## gate reads the net's feature inventory and corpus there. A docs child
## that declares no `oracle_dir` drops the key without a word;
## TestCampaignPhaseZeroChildrenReadWhatTheyAreHanded holds phase 0 OFF by
## default for as long as the catalogue's docs child is one of those.
##
## Nothing here weakens preflight. Phase 0 produces artefacts; preflight
## still refuses the campaign if what came out is not what a supervisor can
## supervise — and a phase-0 child that commits nothing is refused HERE,
## by the same rule this bot applies to its lots: a run that did not move
## HEAD landed nothing, whatever it says of itself.

## phase_zero — the switch, and the first of three skip decisions.
##
## Reading files is the whole method: the contract either exists and parses,
## or it does not. `assessment` is skipped on the artefact, never on a
## remembered state. Two refusals, both of them preflight's, made here
## because here is hours earlier: a tree carrying work in flight, and no
## contract AND no brief to derive one from — a programme nobody wrote.
tool phase_zero:
  output: phase_zero_state
  language: py
  script: |
    import json
    import os
    import subprocess
    import sys

    # A bool var renders as a JSON literal (true/false/null), so the three
    # JSON atoms need their Python names before interpolation.
    true, false, null = True, False, None

    ws = {{vars.workspace_dir}}
    enabled = {{vars.phase_zero}}
    plan_rel = {{vars.plan_path}}
    brief_rel = {{vars.brief_path}}

    out = {"disabled": False, "run_assessment": False, "head_before": "",
           "notice": ""}

    def refuse(notice):
        out["notice"] = notice
        print(json.dumps(out))
        sys.stderr.write("campaign: %s\n" % notice)
        raise SystemExit(1)

    # Same lookup as preflight: the bundle's devbox.json says which yq should
    # serve, not that the environment was realised for this node.
    def find_yq():
        import shutil
        found = shutil.which("yq")
        if found:
            return found
        cand = os.path.join(ws, ".devbox", "nix", "profile", "default", "bin", "yq")
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
        return ""

    if not enabled:
        out["disabled"] = True
        out["notice"] = ("phase 0 OFF (phase_zero: false): no child bot is "
                         "launched and the campaign starts at preflight, which "
                         "refuses whichever prerequisite is missing.")
    else:
        rev = subprocess.run(["git", "-C", ws, "rev-parse", "HEAD"],
                             capture_output=True, text=True, timeout=30)
        if rev.returncode != 0:
            refuse("cannot read HEAD in %s: %s" % (ws, rev.stderr[-400:]))
        out["head_before"] = rev.stdout.strip()

        # preflight makes this same refusal — but AFTER phase 0, which is
        # hours of child runs too late. Every decision below reads the
        # CHECKOUT, deliberately: an operator's uncommitted draft contract
        # must SKIP the child rather than be overwritten by it. That only
        # holds while the checkout IS the commit, so this bot's own rule —
        # a supervisor acts between runs, on committed trees, and never
        # adopts work in flight — is enforced here first. The two
        # exclusions are preflight's: iterion's `.claude/` scaffold, laid by
        # the engine at run start, and the engine's own materialised node
        # script at the workspace root.
        st = subprocess.run(["git", "-C", ws, "status", "--porcelain"],
                            capture_output=True, text=True, timeout=60)
        if st.returncode != 0:
            refuse("cannot read git status in %s: %s" % (ws, st.stderr[-400:]))

        def is_scaffold(line):
            path = line[3:]
            if ' -> ' in path:
                path = path.split(' -> ', 1)[1]
            path = path.strip()
            if len(path) >= 2 and path[0] == chr(34) and path[-1] == chr(34):
                path = path[1:-1]
            return path.startswith('.claude/')

        dirty = [l for l in st.stdout.splitlines() if l.strip()
                 and not os.path.basename(
                     l[3:].strip().strip(chr(34))).startswith(".iterion-script-")
                 and not is_scaffold(l)]
        if dirty:
            refuse("the workspace has %d uncommitted change(s) before phase 0 "
                   "(e.g. %s). Phase 0 decides what to build by reading the "
                   "CHECKOUT and then launches child runs that commit into it: "
                   "on a tree carrying work in flight those decisions are taken "
                   "on files nobody landed, and preflight would refuse hours "
                   "later anyway. Commit or clean first."
                   % (len(dirty), "; ".join(dirty[:5])))

        # Every reader of the contract after this point needs yq: this node
        # when a contract is there, net_gate for where the net lives, and
        # preflight after the whole phase. Without it, whatever the children
        # built would be refused hours later, so it is refused here, first —
        # whether or not a contract exists yet.
        yq = find_yq()
        if not yq:
            refuse("yq is not on PATH and not in the workspace devbox profile. "
                   "Phase 0 reads the contract at %s to decide what to build "
                   "and where the net lives, and preflight reads it after: "
                   "without yq every child would run only to be refused. "
                   "Provide yq, or launch with phase_zero: false." % plan_rel)

        # "The contract is there" means it reads, not that a file of that
        # name exists: an unparseable plan is not a programme, and the child
        # that writes plans is exactly who repairs it.
        plan_abs = os.path.join(ws, plan_rel)
        reason = ""
        if not os.path.isfile(plan_abs):
            reason = "no programme contract at %s" % plan_rel
        else:
            raw = subprocess.run([yq, "-o=json", plan_abs], capture_output=True,
                                 text=True, timeout=60)
            if raw.returncode != 0:
                reason = ("the contract at %s does not parse (%s)"
                          % (plan_rel, " ".join(raw.stderr.split())[-200:]))

        if not reason:
            out["notice"] = ("assessment SKIPPED: the programme contract at %s "
                             "exists and parses." % plan_rel)
        elif not os.path.isfile(os.path.join(ws, brief_rel)):
            refuse("%s, and no brief at %s to derive one from. A campaign "
                   "supervises a WRITTEN programme: the assessment child turns "
                   "a brief into the contract, and a plan is never guessed. "
                   "Write %s, or write the contract yourself, or launch with "
                   "phase_zero: false." % (reason, brief_rel, brief_rel))
        else:
            out["run_assessment"] = True
            out["notice"] = ("assessment RUN: %s; the brief at %s is its input."
                             % (reason, brief_rel))

    print(json.dumps(out))

## assessment — the child that writes the programme contract.
##
## No `output:` is read from it, like every other child here: what it
## produced is measured in git by the next node. No `isolated:` either — it
## writes the contract into THIS checkout, which is the point.
subbot assessment:
  source: "../assessment/main.bot"
  with {
    workspace_dir: "{{vars.workspace_dir}}",
    brief_path:    "{{vars.brief_path}}",
    plan_path:     "{{vars.plan_path}}"
  }

## plan_landed — the contract, verified where the supervisor reads it: git.
tool plan_landed:
  input: landed_input
  output: landed_state
  language: py
  script: |
    import json
    import os
    import subprocess
    import sys

    ws = {{vars.workspace_dir}}
    plan_rel = {{vars.plan_path}}
    before = {{input.before}}

    out = {"notice": ""}

    def refuse(notice):
        out["notice"] = notice
        print(json.dumps(out))
        sys.stderr.write("campaign: %s\n" % notice)
        raise SystemExit(1)

    def git(*args, timeout=60):
        return subprocess.run(["git", "-C", ws] + list(args),
                              capture_output=True, text=True, timeout=timeout)

    rev = git("rev-parse", "HEAD", timeout=30)
    if rev.returncode != 0:
        refuse("cannot read HEAD in %s: %s" % (ws, rev.stderr[-400:]))
    head = rev.stdout.strip()

    if head == before:
        refuse("the assessment child left HEAD at %s: it committed nothing. A "
               "run that did not move HEAD landed nothing, whatever it says of "
               "itself — there is no contract to supervise."
               % (before[:12] or "(unknown)"))

    if git("cat-file", "-e", "HEAD:%s" % plan_rel).returncode != 0:
        refuse("the assessment child moved HEAD to %s, but the contract at %s "
               "is not in that commit. The supervisor reads the programme from "
               "git: a contract that is not committed does not exist."
               % (head[:12], plan_rel))

    st = git("status", "--porcelain", "--", plan_rel)
    if st.returncode != 0:
        refuse("cannot read git status for %s: %s" % (plan_rel, st.stderr[-400:]))
    if st.stdout.strip():
        refuse("the contract at %s carries uncommitted changes after the "
               "assessment child (%s). Phase 0 hands preflight a committed "
               "tree, because that is the only tree anything here judges."
               % (plan_rel, " ".join(st.stdout.split())[:200]))

    out["notice"] = ("assessment landed: %s is committed at %s."
                     % (plan_rel, head[:12]))
    print(json.dumps(out))

## net_gate — the second skip decision, and the one place phase 0 learns
## WHERE the net lives.
##
## The location is the contract's to say (`oracle.dir`, `oracle.verify`),
## read the way preflight reads it: preflight is where the campaign looks
## for the net once phase 0 is over, so a location derived any other way
## would build a net nobody reads. Every node and child after this one
## receives the location from here — one derivation, carried, never redone.
tool net_gate:
  output: net_state
  language: py
  script: |
    import json
    import os
    import subprocess
    import sys

    ws = {{vars.workspace_dir}}
    plan_rel = {{vars.plan_path}}

    out = {"run_net": False, "head_before": "", "oracle_dir": "",
           "verify_path": "", "notice": ""}

    def refuse(notice):
        out["notice"] = notice
        print(json.dumps(out))
        sys.stderr.write("campaign: %s\n" % notice)
        raise SystemExit(1)

    # Same lookup as preflight: the bundle's devbox.json says which yq should
    # serve, not that the environment was realised for this node.
    def find_yq():
        import shutil
        found = shutil.which("yq")
        if found:
            return found
        cand = os.path.join(ws, ".devbox", "nix", "profile", "default", "bin", "yq")
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
        return ""

    rev = subprocess.run(["git", "-C", ws, "rev-parse", "HEAD"],
                         capture_output=True, text=True, timeout=30)
    if rev.returncode != 0:
        refuse("cannot read HEAD in %s: %s" % (ws, rev.stderr[-400:]))
    out["head_before"] = rev.stdout.strip()

    # Both edges into this node guarantee a contract FILE — the skip that
    # found one parsing, or the child that just committed one. It is still
    # parsed here rather than believed, as preflight parses it.
    yq = find_yq()
    if not yq:
        refuse("yq is not on PATH and not in the workspace devbox profile, so "
               "the contract at %s cannot be read — and where the net lives "
               "cannot be decided." % plan_rel)
    raw = subprocess.run([yq, "-o=json", os.path.join(ws, plan_rel)],
                         capture_output=True, text=True, timeout=60)
    plan = None
    if raw.returncode == 0:
        try:
            plan = json.loads(raw.stdout)
        except ValueError:
            plan = None
    if not isinstance(plan, dict):
        refuse("the contract at %s does not read as a mapping (%s), so where "
               "the net lives cannot be taken from it."
               % (plan_rel, " ".join(raw.stderr.split())[-200:] or "not a mapping"))

    # preflight's derivation, term for term: `oracle.dir`, else the
    # default; `oracle.verify`, else the entry point inside that directory.
    oracle = plan.get("oracle") or {}
    if not isinstance(oracle, dict):
        refuse("the contract at %s carries an `oracle` that is not a mapping, "
               "so where the net lives cannot be taken from it." % plan_rel)
    oracle_rel = oracle.get("dir") or ".golden-master"
    default_verify = os.path.join(oracle_rel, "verify-oracle.sh") \
        if isinstance(oracle_rel, str) else ""
    verify_rel = oracle.get("verify") or default_verify
    if not isinstance(oracle_rel, str) or not isinstance(verify_rel, str):
        refuse("the contract at %s names the net with a non-string "
               "`oracle.dir` or `oracle.verify`." % plan_rel)
    origin = ("named by the contract" if oracle.get("dir")
              else "the default: the contract names no oracle.dir")

    # Phase 0 hands this directory to two children that resolve it inside
    # the workspace. Outside it, one would build where the other never
    # looks — so it is refused here, by name, before either is launched.
    # realpath and not normpath: the contract is repository content, and a
    # SYMLINK committed in the tree walks straight past a textual check —
    # the net would then be built, and judged, outside the repository the
    # campaign supervises.
    ws_real = os.path.realpath(ws)
    for rel in (oracle_rel, verify_rel):
        if os.path.isabs(rel) or ".." in os.path.normpath(rel).split(os.sep):
            refuse("the contract at %s puts the net at %s, outside the "
                   "workspace. Phase 0 hands the net's location to child bots "
                   "that resolve it inside the workspace; name a directory in "
                   "the repository, or launch with phase_zero: false."
                   % (plan_rel, rel))
        real = os.path.realpath(os.path.join(ws, rel))
        if real != ws_real and not real.startswith(ws_real.rstrip(os.sep) + os.sep):
            refuse("the contract at %s puts the net at %s, which resolves "
                   "through a symlink to %s — outside the workspace. Phase 0 "
                   "hands the net's location to child bots that resolve it "
                   "inside the workspace; name a directory in the repository, "
                   "or launch with phase_zero: false." % (plan_rel, rel, real))
    out["oracle_dir"] = oracle_rel
    out["verify_path"] = verify_rel

    # The SAME three files net_landed requires, for the same reason: a net
    # is its entry point, the corpus it compares, and the feature inventory
    # the docs gate reads. Skipping on the entry point alone would let an
    # aborted run's leftover script stand in for a net — skipping the child
    # that would repair it, and handing the campaign exactly the partial
    # net net_landed refuses on the other side of the branch.
    required = [verify_rel, os.path.join(oracle_rel, "corpus.json"),
                os.path.join(oracle_rel, "feature-coverage.json")]
    missing = [rel for rel in required
               if not os.path.isfile(os.path.join(ws, rel))]
    if not missing:
        out["notice"] = ("golden-master SKIPPED: the net at %s (%s) is "
                         "complete (%s)." % (oracle_rel, origin,
                                             ", ".join(required)))
    elif (verify_rel in missing
          and os.path.normpath(verify_rel) != os.path.normpath(default_verify)):
        # The child writes its entry point at <dir>/verify-oracle.sh and
        # nowhere else: a contract naming another one that is not there asks
        # for something no run of it produces, and preflight refuses on it.
        refuse("the contract at %s names the net's entry point %s, which is "
               "missing — and the golden-master child writes its entry point "
               "at %s, never where a contract chooses. Launching it would "
               "spend its run on a net preflight still refuses. Commit %s, or "
               "drop `oracle.verify` from the contract."
               % (plan_rel, verify_rel, default_verify, verify_rel))
    else:
        out["run_net"] = True
        out["notice"] = ("golden-master RUN: the net at %s (%s) is missing %s."
                         % (oracle_rel, origin, ", ".join(missing)))

    print(json.dumps(out))

## golden_master — the child that builds the behavioural net.
subbot golden_master:
  source: "../golden-master/main.bot"
  with {
    workspace_dir: "{{vars.workspace_dir}}",
    oracle_dir:    "{{outputs.net_gate.oracle_dir}}"
  }

## net_landed — the net, verified in git, by the three files that make it
## one: the entry point CI runs, the corpus it compares, and the feature
## inventory the docs child's gate reads next.
tool net_landed:
  input: net_landed_input
  output: landed_state
  language: py
  script: |
    import json
    import os
    import subprocess
    import sys

    ws = {{vars.workspace_dir}}
    before = {{input.before}}
    # net_gate's derivation, carried on the edge: this node judges the net
    # where the child was told to build it, not where it would guess.
    oracle_rel = {{input.oracle_dir}}
    verify_rel = {{input.verify_path}}

    out = {"notice": ""}

    def refuse(notice):
        out["notice"] = notice
        print(json.dumps(out))
        sys.stderr.write("campaign: %s\n" % notice)
        raise SystemExit(1)

    def git(*args, timeout=60):
        return subprocess.run(["git", "-C", ws] + list(args),
                              capture_output=True, text=True, timeout=timeout)

    if not str(oracle_rel).strip() or not str(verify_rel).strip():
        refuse("net_landed received no net location (oracle_dir %r, "
               "verify_path %r): the edge from golden_master must carry "
               "net_gate's derivation." % (oracle_rel, verify_rel))

    required = [verify_rel, os.path.join(oracle_rel, "corpus.json"),
                os.path.join(oracle_rel, "feature-coverage.json")]

    rev = git("rev-parse", "HEAD", timeout=30)
    if rev.returncode != 0:
        refuse("cannot read HEAD in %s: %s" % (ws, rev.stderr[-400:]))
    head = rev.stdout.strip()

    if head == before:
        refuse("the golden-master child left HEAD at %s: it committed nothing. "
               "A run that did not move HEAD landed nothing — there is no net "
               "to supervise lots against." % (before[:12] or "(unknown)"))

    missing = [rel for rel in required
               if git("cat-file", "-e", "HEAD:%s" % rel).returncode != 0]
    if missing:
        refuse("the golden-master child moved HEAD to %s, but the net is "
               "incomplete in that commit: %s not committed. Supervising lots "
               "against a partial net would report them done against nothing."
               % (head[:12], ", ".join(missing)))

    st = git("status", "--porcelain", "--", oracle_rel, verify_rel)
    if st.returncode != 0:
        refuse("cannot read git status for %s: %s" % (oracle_rel, st.stderr[-400:]))
    if st.stdout.strip():
        refuse("the net at %s carries uncommitted changes after the "
               "golden-master child (%s). Phase 0 hands preflight a committed "
               "tree." % (oracle_rel, " ".join(st.stdout.split())[:200]))

    out["notice"] = ("golden-master landed: %s is committed at %s."
                     % (", ".join(required), head[:12]))
    print(json.dumps(out))

## docs_gate — the docs child is ALWAYS launched; what this node decides is
## how much of the product it re-reads, and it writes the catalog naming
## what to read.
##
## The catalog is generated OUT OF TREE, in the run's scratch: a file
## written into the workspace would be an uncommitted change preflight then
## refuses. It names one source by `repos[].path` — this very checkout —
## so the child reads the product from disk and reaches no forge: the docs
## child's LOCAL-SOURCE form, which clones with the forge credentials
## stripped. A docs child without that form records the entry `degraded`
## and documents the product from nothing, which is why the generated
## catalog is fed to the real child's catalog_ingest in
## TestCampaignPhaseZeroChildrenReadWhatTheyAreHanded rather than only
## compared to the shape it was built to.
tool docs_gate:
  output: docs_state
  language: py
  script: |
    import json
    import os
    import sys

    ws = {{vars.workspace_dir}}
    docs_rel = {{vars.docs_dir}}
    product_id = {{vars.docs_product_id}}
    scratch = {{vars.scratch_dir}}

    out = {"mode": "full", "catalog_path": "", "pages_before": 0,
           "notice": ""}

    def refuse(notice):
        out["notice"] = notice
        print(json.dumps(out))
        sys.stderr.write("campaign: %s\n" % notice)
        raise SystemExit(1)

    if not str(product_id).strip():
        refuse("docs_product_id is empty: the generated catalog would name no "
               "product, and the docs child selects its entry by that id.")

    pages = []
    docs_abs = os.path.join(ws, docs_rel)
    for root, _dirs, files in os.walk(docs_abs):
        for name in files:
            if name.endswith(".md"):
                pages.append(os.path.join(root, name))
    out["mode"] = "incremental" if pages else "full"
    # Handed to the gate after the child: on an already-documented product
    # "there are pages at HEAD" is true before the child runs at all, so
    # the count taken HERE is what lets that gate speak about this run.
    out["pages_before"] = len(pages)

    # JSON scalars are valid YAML double-quoted scalars, so every value is
    # emitted through json.dumps rather than pasted: a product id or a path
    # carrying a colon cannot reshape the document.
    catalog = "\n".join([
        "## Generated by the campaign supervisor — do not edit.",
        "## One product, one local source: the campaign's own checkout.",
        "id: %s" % json.dumps(product_id),
        "docs:",
        "  product_dir: %s" % json.dumps(docs_rel),
        "repos:",
        "  - id: %s" % json.dumps(product_id),
        "    path: %s" % json.dumps("."),
        "",
    ])
    scratch_abs = os.path.abspath(scratch)
    try:
        os.makedirs(scratch_abs, exist_ok=True)
        catalog_abs = os.path.join(scratch_abs, "product-catalog.yml")
        with open(catalog_abs, "w", encoding="utf-8") as f:
            f.write(catalog)
    except OSError as e:
        refuse("cannot write the generated product catalog under %s: %s"
               % (scratch_abs, e))
    out["catalog_path"] = catalog_abs

    out["notice"] = ("product-docs RUN in %s mode: %s holds %d committed-or-"
                     "working page(s); catalog written to %s."
                     % (out["mode"], docs_rel, len(pages), catalog_abs))
    print(json.dumps(out))

## product_docs — the child that writes the product's functional
## documentation. Its own gate decides convergence; this graph only checks
## that what it claims to have written is in git.
##
## `oracle_dir` is net_gate's derivation — where the contract puts the net
## — so the child proves its coverage against the net preflight will read,
## not against its own default. An undeclared key would be dropped without
## a word; the test named above checks every key this graph hands a child
## against that child's declared vars.
subbot product_docs:
  source: "../product-docs/main.bot"
  with {
    workspace_dir: "{{vars.workspace_dir}}",
    catalog_path:  "{{outputs.docs_gate.catalog_path}}",
    product_id:    "{{vars.docs_product_id}}",
    oracle_dir:    "{{outputs.net_gate.oracle_dir}}",
    mode:          "{{outputs.docs_gate.mode}}"
  }

## docs_landed — pages, verified in git.
##
## HEAD is deliberately NOT required to move here: this child runs on every
## campaign, and an incremental pass over documentation nothing changed is
## entitled to commit nothing. What is required is the artefact — at least
## one page committed under the documentation directory — because that is
## what "the documentation exists" means to everything downstream.
##
## Say exactly what that proves, and no more. On a product that arrived
## already documented, pages at HEAD were there before the child ran, so
## this gate cannot tell a landed pass from a child that finalised
## elsewhere; the page count from BEFORE the run travels in so the notice
## states which of the two it is instead of implying the stronger one.
##
## It also carries the LAST word of phase 0 on the tree as a whole. The
## three landed gates each scope their dirt check to their own artefact —
## that is what makes their refusals name a child — so a child leaving a
## stray OUTSIDE its own paths passes all three, and preflight refuses the
## campaign after the whole bootstrap has been paid. One unscoped read
## here, with phase_zero's two exclusions, is the chokepoint for that.
tool docs_landed:
  input: docs_landed_input
  output: landed_state
  language: py
  script: |
    import json
    import os
    import subprocess
    import sys

    ws = {{vars.workspace_dir}}
    docs_rel = {{vars.docs_dir}}
    pages_before = {{input.pages_before}}

    out = {"notice": ""}

    def refuse(notice):
        out["notice"] = notice
        print(json.dumps(out))
        sys.stderr.write("campaign: %s\n" % notice)
        raise SystemExit(1)

    def git(*args, timeout=60):
        return subprocess.run(["git", "-C", ws] + list(args),
                              capture_output=True, text=True, timeout=timeout)

    rev = git("rev-parse", "HEAD", timeout=30)
    if rev.returncode != 0:
        refuse("cannot read HEAD in %s: %s" % (ws, rev.stderr[-400:]))
    head = rev.stdout.strip()

    tree = git("ls-tree", "-r", "--name-only", "HEAD", "--", docs_rel)
    if tree.returncode != 0:
        refuse("cannot list %s at HEAD: %s" % (docs_rel, tree.stderr[-400:]))
    pages = [p for p in tree.stdout.splitlines() if p.strip().endswith(".md")]

    if not pages:
        refuse("the product-docs child committed no page under %s at %s. The "
               "supervisor reads what a child landed from git: if the child "
               "finalised its series onto a branch instead of this checkout, "
               "the campaign never sees it." % (docs_rel, head[:12]))

    st = git("status", "--porcelain", "--", docs_rel)
    if st.returncode != 0:
        refuse("cannot read git status for %s: %s" % (docs_rel, st.stderr[-400:]))
    if st.stdout.strip():
        refuse("%s carries uncommitted changes after the product-docs child "
               "(%s). Phase 0 hands preflight a committed tree."
               % (docs_rel, " ".join(st.stdout.split())[:200]))

    # Phase 0's last word on the WHOLE tree — preflight's own refusal, made
    # before the bootstrap's cost is sunk rather than after. Same two
    # exclusions as phase_zero: iterion's `.claude/` scaffold and the
    # engine's materialised node script at the workspace root.
    def is_scaffold(line):
        path = line[3:]
        if ' -> ' in path:
            path = path.split(' -> ', 1)[1]
        path = path.strip()
        if len(path) >= 2 and path[0] == chr(34) and path[-1] == chr(34):
            path = path[1:-1]
        return path.startswith('.claude/')

    whole = git("status", "--porcelain")
    if whole.returncode != 0:
        refuse("cannot read git status in %s: %s" % (ws, whole.stderr[-400:]))
    dirty = [l for l in whole.stdout.splitlines() if l.strip()
             and not os.path.basename(
                 l[3:].strip().strip(chr(34))).startswith(".iterion-script-")
             and not is_scaffold(l)]
    if dirty:
        refuse("phase 0 leaves %d uncommitted change(s) outside the artefacts "
               "it checks (e.g. %s). A child wrote where no landed gate looks, "
               "and preflight would refuse the campaign on it — after the whole "
               "bootstrap had been paid. Phase 0 hands preflight a committed "
               "tree." % (len(dirty), "; ".join(dirty[:5])))

    # What this proves, stated as what it is.
    if pages_before == 0:
        landed = "%d page(s), where the product had none" % len(pages)
    elif len(pages) > pages_before:
        landed = ("%d page(s) more than the %d this run started from"
                  % (len(pages) - pages_before, pages_before))
    else:
        landed = ("the same %d page(s) it started from — this gate cannot "
                  "tell a pass that changed nothing from a child that "
                  "committed elsewhere" % len(pages))
    out["notice"] = ("product-docs landed: %s, committed under %s at %s."
                     % (landed, docs_rel, head[:12]))
    print(json.dumps(out))

## ─── The supervisor proper ─────────────────────────────────────────

## preflight — refuse early what would make every later verdict a lie.
##
## A campaign over no contract is nothing to supervise; a campaign with no
## behavioural net would report lots "done" against nothing; a dirty tree at
## start means somebody's work in flight, which a supervisor must never
## sweep into its own commits or judge as the child's progress. All three
## REFUSE rather than emit a clean no-op: a supervisor that finishes green
## having supervised nothing is the blind judge this whole family of bots
## exists to refuse.
tool preflight:
  output: preflight_state
  language: py
  script: |
    import json
    import os
    import subprocess
    import sys

    ws = {{vars.workspace_dir}}
    plan_path = os.path.join(ws, {{vars.plan_path}})

    out = {"campaign_base": "", "refs_dir": "", "verify_path": "",
           "ledger_path": "", "notice": ""}

    def refuse(notice):
        out["notice"] = notice
        print(json.dumps(out))
        sys.stderr.write("campaign: %s\n" % notice)
        raise SystemExit(1)

    # Same lookup as the worker: yq is declared in this bundle's devbox.json,
    # which says which version should serve, not that the environment was
    # realised for this node. The target repo's own profile is consulted
    # second, before refusing.
    def find_yq():
        import shutil
        found = shutil.which("yq")
        if found:
            return found
        cand = os.path.join(ws, ".devbox", "nix", "profile", "default", "bin", "yq")
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
        return ""

    if not os.path.isfile(plan_path):
        refuse("no programme contract at %s. A campaign supervises a written "
               "programme; write the plan first (see the modernize bot's "
               "plan-contract skill)." % plan_path)

    yq = find_yq()
    if not yq:
        refuse("yq is not on PATH and not in the workspace devbox profile, so "
               "the contract at %s cannot be read." % plan_path)
    raw = subprocess.run([yq, "-o=json", plan_path], capture_output=True,
                         text=True, timeout=60)
    if raw.returncode != 0:
        refuse("the contract at %s is not parseable: %s" % (plan_path, raw.stderr[-800:]))
    plan = json.loads(raw.stdout)

    oracle = plan.get("oracle") or {}
    out["refs_dir"] = oracle.get("refs_dir") or ""
    oracle_dir = oracle.get("dir") or ".golden-master"
    out["verify_path"] = oracle.get("verify") or os.path.join(oracle_dir, "verify-oracle.sh")
    out["ledger_path"] = os.path.join(oracle_dir, "REBASELINE.md")

    if not os.path.isfile(os.path.join(ws, out["verify_path"])):
        refuse("no behavioural oracle at %s. Supervising a programme without "
               "a net would report lots done against nothing; build the net "
               "first (golden-master bot)." % out["verify_path"])

    def is_scaffold(line):
        # iterion lays the bundle's skills (and plugin commands, agents,
        # settings) under <workspace>/.claude/ at run start: written by the
        # engine, never by a pass, never the run's work (#1364) -- the rule
        # finalize applies to the wip bank (runOutputPaths), tracked or not:
        # the engine rewrites a tracked settings.json to inject plugin hooks,
        # and a reader that refused on that write would stop every run on a
        # repository that commits it. A rename is judged on its destination;
        # a quoted path is unquoted.
        path = line[3:]
        if ' -> ' in path:
            path = path.split(' -> ', 1)[1]
        path = path.strip()
        if len(path) >= 2 and path[0] == chr(34) and path[-1] == chr(34):
            path = path[1:-1]
        return path.startswith('.claude/')
    st = subprocess.run(["git", "-C", ws, "status", "--porcelain"],
                        capture_output=True, text=True, timeout=60)
    if st.returncode != 0:
        refuse("cannot read git status in %s: %s" % (ws, st.stderr[-400:]))
    # The engine materialises the executing node's own script into the
    # workspace (.iterion-script-*.py) for the lifetime of the node, so a
    # script tool ALWAYS sees that one untracked path. Execution machinery,
    # not work in flight — the one exclusion every status read here carries.
    dirty = [l for l in st.stdout.splitlines() if l.strip()
             and not os.path.basename(l[3:].strip().strip('"')).startswith(".iterion-script-")
             and not is_scaffold(l)]
    if dirty:
        refuse("the workspace has %d uncommitted change(s) at campaign start "
               "(e.g. %s). A supervisor only ever acts between runs on "
               "committed trees, and it must not adopt work in flight. Commit "
               "or clean first." % (len(dirty), "; ".join(dirty[:5])))

    rev = subprocess.run(["git", "-C", ws, "rev-parse", "HEAD"],
                         capture_output=True, text=True, timeout=30)
    if rev.returncode != 0:
        refuse("cannot read HEAD in %s: %s" % (ws, rev.stderr[-400:]))
    out["campaign_base"] = rev.stdout.strip()

    print(json.dumps(out))

## run_lot — the worker, one lot per child run.
##
## No `output:` is read from the child ON PURPOSE: the supervisor believes
## nothing a run says about itself. Progress is measured in git by the next
## node, exactly as it would be measured by a third party. No `isolated:`
## either — the child works on THIS checkout; that is what it is for, and
## the workspace-safety guard is right to serialise it.
subbot run_lot:
  source: "../modernize/main.bot"
  with {
    workspace_dir: "{{vars.workspace_dir}}",
    plan_path:     "{{vars.plan_path}}",
    max_passes:    "{{vars.lot_max_passes}}"
  }

## observe — everything the supervisor knows, re-read from git and files.
##
## Cross-iteration state lives in the repository (journal, ledger, plan),
## never in loop-carried messages: a campaign interrupted anywhere can be
## resumed, or re-run, and re-derive exactly where it stood.
tool observe:
  input: observe_input
  output: observe_state
  language: py
  script: |
    import json
    import os
    import subprocess
    import tempfile

    ws = {{vars.workspace_dir}}
    plan_rel = {{vars.plan_path}}
    campaign_dir = os.path.join(ws, ".modernize", "campaign")
    journal = os.path.join(campaign_dir, "journal.tsv")

    out = {"before": "", "moved": False, "stagnant": 0, "exhausted": False,
           "extensions": [], "pending": [], "notice": ""}

    def refuse(notice):
        import sys
        out["notice"] = notice
        print(json.dumps(out))
        sys.stderr.write("campaign: %s\n" % notice)
        raise SystemExit(1)

    def find_yq():
        import shutil
        found = shutil.which("yq")
        if found:
            return found
        cand = os.path.join(ws, ".devbox", "nix", "profile", "default", "bin", "yq")
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
        return ""

    def git(*args, timeout=60):
        return subprocess.run(["git", "-C", ws] + list(args),
                              capture_output=True, text=True, timeout=timeout)

    yq = find_yq()
    if not yq:
        refuse("yq disappeared between preflight and observe")

    def read_plan(text):
        with tempfile.NamedTemporaryFile("w", suffix=".yaml", delete=False) as f:
            f.write(text)
            tmp = f.name
        try:
            raw = subprocess.run([yq, "-o=json", tmp], capture_output=True,
                                 text=True, timeout=60)
            if raw.returncode != 0:
                return None
            return json.loads(raw.stdout)
        finally:
            os.unlink(tmp)

    # The segment to judge: from the last supervised state to HEAD now.
    rows = []
    if os.path.isfile(journal):
        with open(journal, encoding="utf-8") as f:
            lines = [l.rstrip("\n") for l in f if l.strip()]
        rows = [l.split("\t") for l in lines[1:]]
    before = rows[-1][5] if rows else {{input.base}}
    out["before"] = before

    # "Moved" means the CHILD (or an operator intervening in the repo)
    # landed something — never the supervisor's own bookkeeping. The
    # journal, escalation-log and rebaseline-act commits carry fixed
    # prefixes precisely so this measurement can exclude them.
    seg = git("log", "--format=%s", "%s..HEAD" % before)
    if seg.returncode != 0:
        refuse("cannot read the commit segment %s..HEAD: %s"
               % (before[:12], seg.stderr[-400:]))
    child_commits = [s for s in seg.stdout.splitlines()
                     if s.strip()
                     and not s.startswith("campaign: ")
                     and not s.startswith("gm(rebaseline): ")]
    out["moved"] = bool(child_commits)

    # Stagnation counts CHILD segments only, read from the journal the
    # steward keeps — supervisor commits never count as progress.
    trailing = 0
    for r in reversed(rows):
        if len(r) > 3 and r[3] == "no":
            trailing += 1
        else:
            break
    out["stagnant"] = 0 if out["moved"] else trailing + 1

    # Eligibility mirrors the worker's plan_read: done AND blocked both land
    # and satisfy dependants — a blocked lot's debt belongs to the lots that
    # follow it, so it must not freeze the rest of the programme.
    cur_text = open(os.path.join(ws, plan_rel), encoding="utf-8").read()
    plan = read_plan(cur_text)
    if plan is None:
        refuse("the contract no longer parses at HEAD — a child run left an "
               "unreadable plan, which is a stop, not something to skip over")
    lots = plan.get("lots") or []
    landed = set(l.get("id") for l in lots if l.get("status") in ("done", "blocked"))
    eligible = False
    for lot in lots:
        if lot.get("status") in ("done", "blocked"):
            continue
        if all(d in landed for d in (lot.get("depends_on") or [])):
            eligible = True
            break
    out["exhausted"] = not eligible

    # Contract EXTENSIONS: any change to the plan in this child segment
    # beyond a lot flipping its own status. The worker is entitled to write
    # `status` and to add committed reports; adding or reshaping lots is an
    # act of programme AUTHORSHIP, and who approves that is a configured
    # policy, not a default.
    def normative(plan_obj):
        m = {}
        for l in (plan_obj or {}).get("lots") or []:
            m[l.get("id")] = {k: l.get(k) for k in
                              ("title", "intent", "exit_gate", "depends_on",
                               "rebaseline_allowed")}
        return m
    old_show = git("show", "%s:%s" % (before, plan_rel))
    old_plan = read_plan(old_show.stdout) if old_show.returncode == 0 else None
    old_lots, new_lots = normative(old_plan), normative(plan)
    exts = []
    for lid in new_lots:
        if lid not in old_lots:
            exts.append({"kind": "added", "lot": lid,
                         "title": (new_lots[lid].get("title") or "")})
        elif new_lots[lid] != old_lots[lid]:
            changed = [k for k in new_lots[lid] if new_lots[lid][k] != old_lots[lid][k]]
            exts.append({"kind": "modified", "lot": lid, "fields": changed})
    for lid in old_lots:
        if lid not in new_lots:
            exts.append({"kind": "removed", "lot": lid})
    out["extensions"] = exts

    # Pending ledger requests: machine-readable request blocks without a
    # matching act. A block that does not parse is NOT skipped — a request
    # the steward cannot read is an escalation, not a silence.
    ledger = os.path.join(ws, {{input.ledger_path}})
    requests, acts, failed = [], set(), set()
    if os.path.isfile(ledger):
        text = open(ledger, encoding="utf-8").read()
        for kind in ("request", "act"):
            marker = "<!-- iterion:rebaseline-%s" % kind
            pos = 0
            while True:
                start = text.find(marker, pos)
                if start < 0:
                    break
                end = text.find("-->", start)
                if end < 0:
                    break
                body = text[start + len(marker):end].strip()
                pos = end + 3
                try:
                    obj = json.loads(body)
                except ValueError as e:
                    if kind == "request":
                        requests.append({"id": "", "malformed": True,
                                         "error": str(e), "raw": body[:400]})
                    continue
                if kind == "request":
                    requests.append(obj)
                else:
                    acts.add(obj.get("id"))
    # Requests the steward already refused or failed on stay refused: acting
    # again would loop on the same wall. The record of refusal is committed.
    esc_log = os.path.join(campaign_dir, "escalations.jsonl")
    if os.path.isfile(esc_log):
        with open(esc_log, encoding="utf-8") as f:
            for line in f:
                try:
                    item = json.loads(line)
                except ValueError:
                    continue
                rid = item.get("request_id")
                if rid:
                    failed.add(rid)
    out["pending"] = [r for r in requests
                      if r.get("malformed") or
                      (r.get("id") and r["id"] not in acts and r["id"] not in failed)]

    print(json.dumps(out))

## steward — the OTHER authority, mechanised but still separate.
##
## It executes a re-record if and only if: the request is well-formed, the
## requesting lot's contract allows a re-baseline, the tree is clean, and —
## the criterion that carried an entire supervised campaign — the observed
## diff equals the announced set EXACTLY. Then the full counter-test replays
## on the committed tree, and a red there reverts the act. Everything else
## becomes an escalation item, written and committed before anyone is asked
## anything.
tool steward:
  input: steward_input
  output: steward_state
  language: py
  script: |
    import datetime
    import json
    import os
    import subprocess

    # bool and json input fields render as JSON literals (true/false/null),
    # so the three JSON atoms need their Python names before interpolation.
    true, false, null = True, False, None

    ws = {{vars.workspace_dir}}
    governance = {{vars.governance}}
    escalation = {{vars.escalation}}
    plan_rel = {{vars.plan_path}}
    ledger_rel = {{input.ledger_path}}
    verify_rel = {{input.verify_path}}
    before = {{input.before}}
    moved = {{input.moved}}
    extensions = list({{input.extensions}} or [])
    pending = list({{input.pending}} or [])

    campaign_rel = os.path.join(".modernize", "campaign")
    campaign_dir = os.path.join(ws, campaign_rel)
    journal_rel = os.path.join(campaign_rel, "journal.tsv")
    esc_rel = os.path.join(campaign_rel, "escalations.jsonl")
    os.makedirs(campaign_dir, exist_ok=True)

    out = {"acts": 0, "escalations": [], "pause_required": False, "notice": ""}
    items = []
    now = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")

    def git(*args, timeout=120):
        return subprocess.run(["git", "-C", ws] + list(args),
                              capture_output=True, text=True, timeout=timeout)

    def sh(cmd, timeout=3600):
        p = subprocess.run(cmd, shell=True, cwd=ws, capture_output=True,
                           text=True, timeout=timeout)
        return p.returncode, (p.stdout + p.stderr)[-4000:]

    def changed_paths():
        st = git("status", "--porcelain")
        paths = []
        for line in st.stdout.splitlines():
            if not line.strip():
                continue
            p = line[3:].strip()
            if " -> " in p:
                p = p.split(" -> ")[-1]
            p = p.strip('"')
            # The engine's own materialised node script (.iterion-script-*):
            # execution machinery, never part of an observed diff.
            if os.path.basename(p).startswith(".iterion-script-"):
                continue
            # iterion's own scaffold under .claude/ (skills, plugin files):
            # laid by the engine at run start, never the run's work (#1364).
            if p.startswith(".claude/"):
                continue
            paths.append(p)
        return sorted(set(paths))

    def restore_clean(observed):
        # Only the record's own writes exist: the tree was verified clean
        # before it ran. Tracked files go back to HEAD; files the record
        # CREATED are removed one by one — never a recursive clean.
        # iterion's own tree under .claude/ (skills, plugin files, the settings
        # hooks it injects) is never the record's write, and never reverted here.
        git("checkout", "--", ".", ":(exclude).claude")
        for p in observed:
            full = os.path.join(ws, p)
            ls = git("ls-files", "--error-unmatch", p)
            if ls.returncode != 0 and os.path.isfile(full):
                os.remove(full)

    head_after_child = git("rev-parse", "HEAD").stdout.strip()

    # ── Contract extensions, under the configured governance ──
    for ext in extensions:
        if governance == "bot":
            items.append({"ts": now, "type": "contract_extension",
                          "disposition": "accepted_in_flight",
                          "detail": ext,
                          "note": "listed at the head of the handoff for review"})
        else:
            items.append({"ts": now, "type": "contract_extension",
                          "disposition": "pending_approval", "detail": ext})

    # ── Pending ledger requests ──
    tree_dirty = bool(changed_paths())
    if pending and tree_dirty:
        items.append({"ts": now, "type": "dirty_tree",
                      "detail": changed_paths()[:20],
                      "note": "a child run left uncommitted changes; the "
                              "steward acts only on committed trees, so every "
                              "pending request is deferred"})
    elif pending:
        # The plan tells the steward which lots may request a re-baseline.
        plan_lots = {}
        try:
            import shutil
            yq = shutil.which("yq") or os.path.join(
                ws, ".devbox", "nix", "profile", "default", "bin", "yq")
            raw = subprocess.run([yq, "-o=json", os.path.join(ws, plan_rel)],
                                 capture_output=True, text=True, timeout=60)
            if raw.returncode == 0:
                for l in (json.loads(raw.stdout).get("lots") or []):
                    plan_lots[l.get("id")] = l
        except (OSError, ValueError, subprocess.SubprocessError) as e:
            items.append({"ts": now, "type": "plan_unreadable", "detail": str(e)})
            plan_lots = None

        for req in pending if plan_lots is not None else []:
            rid = req.get("id") or "?"
            if req.get("malformed") or not req.get("id"):
                items.append({"ts": now, "type": "malformed_request",
                              "request_id": rid, "detail": req})
                continue
            expected = sorted(set(req.get("expected_paths") or []))
            if not expected:
                items.append({"ts": now, "type": "malformed_request",
                              "request_id": rid,
                              "detail": "a request that announces no expected "
                                        "paths cannot be verified"})
                continue
            lot = plan_lots.get(req.get("lot"))
            if lot is None:
                items.append({"ts": now, "type": "refused_unknown_lot",
                              "request_id": rid, "detail": req.get("lot")})
                continue
            if not lot.get("rebaseline_allowed"):
                items.append({"ts": now, "type": "refused_by_contract",
                              "request_id": rid, "lot": req.get("lot"),
                              "note": "the lot declares rebaseline_allowed: "
                                      "false — that flag is the assertion "
                                      "being tested, and a request against it "
                                      "means the lot overflowed"})
                continue

            code, log = sh("%s --record" % verify_rel)
            observed = changed_paths()
            if code != 0:
                restore_clean(observed)
                items.append({"ts": now, "type": "record_failed",
                              "request_id": rid, "detail": log[-1500:]})
                continue
            if observed != expected:
                restore_clean(observed)
                items.append({"ts": now, "type": "diff_mismatch",
                              "request_id": rid,
                              "expected": expected, "observed": observed,
                              "note": "the observed diff is not the announced "
                                      "one — nothing was committed"})
                continue

            # Observed == announced: the act is committed, then judged.
            sha_before_act = git("rev-parse", "HEAD").stdout.strip()
            act = {"id": rid, "lot": req.get("lot"),
                   "recorded_paths": observed, "ts": now}
            with open(os.path.join(ws, ledger_rel), "a", encoding="utf-8") as f:
                f.write("\n<!-- iterion:rebaseline-act\n%s\n-->\n"
                        % json.dumps(act, ensure_ascii=False))
            git("add", "--", ledger_rel, *observed)
            git("commit", "-m",
                "gm(rebaseline): act %s — %d reference(s) re-recorded, "
                "observed diff matches the announcement" % (rid, len(observed)))

            gate_code, gate_log = sh(verify_rel)
            if gate_code == 0:
                verdict = {"id": rid, "gate": "green",
                           "sha": git("rev-parse", "HEAD").stdout.strip(), "ts": now}
                with open(os.path.join(ws, ledger_rel), "a", encoding="utf-8") as f:
                    f.write("\n<!-- iterion:rebaseline-verdict\n%s\n-->\n"
                            % json.dumps(verdict, ensure_ascii=False))
                git("add", "--", ledger_rel)
                git("commit", "-m",
                    "gm(rebaseline): full counter-test green after act %s" % rid)
                out["acts"] += 1
            else:
                # The act did not hold: the committed tree it produced fails
                # its own net. The act is unwound entirely — these commits
                # are the steward's own, on a tree verified clean before it
                # touched anything — and the failure is escalated.
                git("reset", "--hard", sha_before_act)
                items.append({"ts": now, "type": "gate_red_after_record",
                              "request_id": rid, "detail": gate_log[-1500:]})

    # ── Journal row + escalation log, committed as supervisor bookkeeping ──
    if items:
        with open(os.path.join(ws, esc_rel), "a", encoding="utf-8") as f:
            for item in items:
                f.write(json.dumps(item, ensure_ascii=False) + "\n")

    journal = os.path.join(ws, journal_rel)
    if not os.path.isfile(journal):
        with open(journal, "w", encoding="utf-8") as f:
            f.write("run\tts\tbefore\tmoved\tacts\tafter\n")
    with open(journal, encoding="utf-8") as f:
        run_n = sum(1 for l in f if l.strip()) # header counts as row 0's slot
    head_now = git("rev-parse", "HEAD").stdout.strip()
    with open(journal, "a", encoding="utf-8") as f:
        f.write("%d\t%s\t%s\t%s\t%d\t%s\n"
                % (run_n, now, before[:12], "yes" if moved else "no",
                   out["acts"], head_now[:12]))
    add = ["add", "--", journal_rel]
    if items:
        add.append(esc_rel)
    git(*add)
    git("commit", "-m", "campaign: run %d — child moved=%s, steward acts=%d, "
        "escalations=%d" % (run_n, "yes" if moved else "no", out["acts"], len(items)))

    # ── Pause policy — configuration applied to facts, in readable code ──
    needs_approval = any(i.get("disposition") == "pending_approval" for i in items)
    other_items = [i for i in items if i.get("type") != "contract_extension"]
    out["pause_required"] = bool(
        needs_approval or (escalation == "interactive" and other_items))
    out["escalations"] = items
    out["notice"] = ("%d act(s), %d escalation item(s)" % (out["acts"], len(items)))
    print(json.dumps(out))

## escalate — the in-flight window, when configuration asks for one.
##
## The answer edits nothing: an operator who wants to change the programme
## changes the repository and commits, exactly as a human supervisor did.
## The pause IS the window; git carries the intervention.
human escalate:
  description: "Campaign escalation — operator review during the run"
  input: escalate_input
  output: escalate_answer
  instructions: escalate_instructions
  interaction: human

## record_answer — the operator's answer goes where every other fact went:
## in the committed record, before the campaign moves again.
tool record_answer:
  input: escalate_answer
  output: answer_state
  language: py
  script: |
    import datetime
    import json
    import os
    import subprocess

    ws = {{vars.workspace_dir}}
    action = {{input.action}}
    note = {{input.note}}
    esc_rel = os.path.join(".modernize", "campaign", "escalations.jsonl")
    now = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")

    with open(os.path.join(ws, esc_rel), "a", encoding="utf-8") as f:
        f.write(json.dumps({"ts": now, "type": "operator_answer",
                            "action": action, "note": note},
                           ensure_ascii=False) + "\n")
    subprocess.run(["git", "-C", ws, "add", "--", esc_rel],
                   capture_output=True, text=True, timeout=60)
    subprocess.run(["git", "-C", ws, "commit", "-m",
                    "campaign: operator answered escalation — %s" % action],
                   capture_output=True, text=True, timeout=60)
    print(json.dumps({"stop": action == "stop"}))

## loop_gate — continue while something can still land. Pure conjunction of
## measured facts; the fall-through also serves loop and budget exhaustion.
compute loop_gate:
  output: loop_state
  expr:
    proceed: "!outputs.observe.exhausted && outputs.observe.stagnant < vars.stagnation_stop"
    reason: "if(outputs.observe.exhausted, 'programme exhausted: no eligible lot remains', if(outputs.observe.stagnant >= vars.stagnation_stop, 'stagnation: consecutive child runs landed nothing', 'continue'))"

## finalize — the campaign's verdict, computed the way a third party would.
##
## Final counter-test on the committed tree; requalification of blocked
## lots (each DISTINCT gate command played once on the final tree, the
## verdict projected per lot — a lot blocked mid-programme often blocks on
## a cause the finished tree has closed); handoff written and committed,
## extensions first.
tool finalize:
  input: finalize_input
  output: finalize_state
  language: py
  script: |
    import datetime
    import json
    import os
    import subprocess

    ws = {{vars.workspace_dir}}
    plan_rel = {{vars.plan_path}}
    verify_rel = {{input.verify_path}}
    campaign_rel = os.path.join(".modernize", "campaign")
    campaign_dir = os.path.join(ws, campaign_rel)
    handoff_rel = os.path.join(campaign_rel, "handoff.md")
    requal_rel = os.path.join(campaign_rel, "requalification.json")
    now = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")

    out = {"handoff_path": handoff_rel, "oracle_green": False,
           "lots_done": 0, "lots_blocked": 0, "requalified": 0, "notice": ""}

    def git(*args, timeout=120):
        return subprocess.run(["git", "-C", ws] + list(args),
                              capture_output=True, text=True, timeout=timeout)

    def sh(cmd, timeout=3600):
        p = subprocess.run(cmd, shell=True, cwd=ws, capture_output=True,
                           text=True, timeout=timeout)
        return p.returncode, (p.stdout + p.stderr)[-4000:]

    def find_yq():
        import shutil
        found = shutil.which("yq")
        if found:
            return found
        cand = os.path.join(ws, ".devbox", "nix", "profile", "default", "bin", "yq")
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
        return ""

    def is_scaffold(line):
        # iterion lays the bundle's skills (and plugin commands, agents,
        # settings) under <workspace>/.claude/ at run start: written by the
        # engine, never by a pass, never the run's work (#1364) -- the rule
        # finalize applies to the wip bank (runOutputPaths), tracked or not:
        # the engine rewrites a tracked settings.json to inject plugin hooks,
        # and a reader that refused on that write would stop every run on a
        # repository that commits it. A rename is judged on its destination;
        # a quoted path is unquoted.
        path = line[3:]
        if ' -> ' in path:
            path = path.split(' -> ', 1)[1]
        path = path.strip()
        if len(path) >= 2 and path[0] == chr(34) and path[-1] == chr(34):
            path = path[1:-1]
        return path.startswith('.claude/')
    head = git("rev-parse", "HEAD").stdout.strip()
    # Same exclusion as preflight: the engine's own materialised node script
    # is execution machinery, not an uncommitted change.
    dirty = [l for l in git("status", "--porcelain").stdout.splitlines() if l.strip()
             and not os.path.basename(l[3:].strip().strip('"')).startswith(".iterion-script-")
             and not is_scaffold(l)]

    plan = {}
    yq = find_yq()
    if yq:
        raw = subprocess.run([yq, "-o=json", os.path.join(ws, plan_rel)],
                             capture_output=True, text=True, timeout=60)
        if raw.returncode == 0:
            plan = json.loads(raw.stdout)
    lots = plan.get("lots") or []
    done = [l for l in lots if l.get("status") == "done"]
    blocked = [l for l in lots if l.get("status") == "blocked"]
    todo = [l for l in lots if l.get("status") not in ("done", "blocked")]
    out["lots_done"], out["lots_blocked"] = len(done), len(blocked)

    # The gate judges COMMITTED trees only. A dirty tree at the end is
    # reported as exactly that — a verdict over a tree that exists nowhere
    # would be worth nothing.
    verdict_line = ""
    if dirty:
        oracle_summary = ("NOT JUDGED: %d uncommitted change(s) at campaign "
                          "end — the counter-test only judges committed "
                          "trees. Files: %s" % (len(dirty), "; ".join(dirty[:10])))
    else:
        code, log = sh(verify_rel)
        out["oracle_green"] = code == 0
        for line in reversed((log or "").splitlines()):
            line = line.strip()
            if line.startswith("{") and line.endswith("}"):
                verdict_line = line
                break
        oracle_summary = ("GREEN (exit 0)" if code == 0
                          else "RED (exit %d) — tail:\n\n```\n%s\n```" % (code, log[-1500:]))

    # Requalification: distinct commands once each, verdicts projected.
    # Same contract surface as modernize's plan_read: a scalar exit_gate is
    # one command, a sequence several; any other shape is unreadable and the
    # lot carrying it is NOT requalifiable — iterating it raw would shell
    # out one command per character (or per mapping key) and manufacture a
    # verdict nobody's gate ever rendered.
    def gate_commands(l):
        """(commands, defect): commands is None when the gate is not
        requalifiable, and defect names WHICH refusal, verbatim for the
        committed verdict — the two causes are distinct diagnoses."""
        gates = l.get("exit_gate") or []
        if isinstance(gates, str):
            gates = [gates]
        if not isinstance(gates, list) or not all(isinstance(g, str) for g in gates):
            shape = (type(l.get("exit_gate")).__name__ if not isinstance(gates, list)
                     else "list holding %s" % type(next(
                         g for g in gates if not isinstance(g, str))).__name__)
            return None, "unreadable exit_gate (%s)" % shape
        # A command containing an INTERIOR newline is refused by modernize's
        # reader (its transport is newline-joined); accepting it here would
        # let this supervisor requalify a lot the executing bot cannot even
        # read. Strip first — yq hands every block/folded scalar with a
        # trailing newline, and a single-command block is legitimate.
        gates = [g.strip() for g in gates]
        gates = [g for g in gates if g]
        if any("\n" in g for g in gates):
            return None, "multi-line exit_gate command"
        return gates, ""

    requal = {"head": head[:12], "commands": {}, "lots": {}}
    if not dirty and blocked:
        cmds = []
        for l in blocked:
            for g in (gate_commands(l)[0] or []):
                if g not in cmds:
                    cmds.append(g)
        for c in cmds:
            code, log = sh(c)
            requal["commands"][c] = {"rc": code, "tail": log[-400:]}
        for l in blocked:
            gates, defect = gate_commands(l)
            if gates is None:
                requal["lots"][l.get("id")] = {"verdict": "%s — not "
                                               "requalifiable" % defect}
                continue
            if not gates:
                # Zero commands ran; "every gate command green" over an empty
                # set is the vacuous claim this report exists to refuse.
                requal["lots"][l.get("id")] = {"verdict": "no exit_gate "
                                               "declared — not requalifiable"}
                continue
            reds = [g for g in gates if requal["commands"][g]["rc"] != 0]
            if reds:
                requal["lots"][l.get("id")] = {"verdict": "still blocked",
                                               "red": reds[0]}
            else:
                requal["lots"][l.get("id")] = {"verdict": "REQUALIFIED — every "
                                               "gate command green on the final tree"}
        out["requalified"] = sum(1 for v in requal["lots"].values()
                                 if v["verdict"].startswith("REQUALIFIED"))
        with open(os.path.join(ws, requal_rel), "w", encoding="utf-8") as f:
            json.dump(requal, f, indent=1, ensure_ascii=False)

    # The handoff. Extensions FIRST: they are decisions a bot took in
    # flight, and this document exists so a human re-takes them.
    esc_items = []
    esc_path = os.path.join(campaign_dir, "escalations.jsonl")
    if os.path.isfile(esc_path):
        with open(esc_path, encoding="utf-8") as f:
            for line in f:
                try:
                    esc_items.append(json.loads(line))
                except ValueError:
                    esc_items.append({"type": "unparseable_log_line",
                                      "raw": line[:200]})
    exts = [i for i in esc_items if i.get("type") == "contract_extension"]
    others = [i for i in esc_items if i.get("type") != "contract_extension"]

    journal_rows = []
    jpath = os.path.join(campaign_dir, "journal.tsv")
    if os.path.isfile(jpath):
        with open(jpath, encoding="utf-8") as f:
            journal_rows = [l.rstrip("\n") for l in f if l.strip()]

    h = []
    h.append("# Campaign handoff — %s" % now)
    h.append("")
    h.append("Final tree: `%s`. Programme: %d done, %d blocked, %d not "
             "reached, of %d lots." % (head[:12], len(done), len(blocked),
                                       len(todo), len(lots)))
    h.append("")
    h.append("## 1. Contract extensions (%d) — review these first" % len(exts))
    h.append("")
    if exts:
        h.append("The worker changed the PROGRAMME itself during the "
                 "campaign. Under `governance: bot` each one was accepted in "
                 "flight and is listed here for a human to re-take; under "
                 "`governance: human` each one paused the campaign and its "
                 "approval is recorded below.")
        h.append("")
        for i in exts:
            h.append("- `%s` — %s (%s)" % (json.dumps(i.get("detail"),
                     ensure_ascii=False), i.get("disposition"), i.get("ts")))
    else:
        h.append("None: not one lot was added, reshaped or removed beyond "
                 "its own status field.")
    h.append("")
    h.append("## 2. Escalations and answers (%d)" % len(others))
    h.append("")
    for i in others:
        h.append("- `%s`" % json.dumps(i, ensure_ascii=False)[:500])
    if not others:
        h.append("None.")
    h.append("")
    h.append("## 3. Run journal")
    h.append("")
    h.append("```tsv")
    h.extend(journal_rows)
    h.append("```")
    h.append("")
    h.append("## 4. Final behavioural verdict")
    h.append("")
    h.append(oracle_summary)
    if verdict_line:
        h.append("")
        h.append("```json")
        h.append(verdict_line)
        h.append("```")
    h.append("")
    h.append("## 5. Requalification of blocked lots")
    h.append("")
    if requal["lots"]:
        for lid, v in requal["lots"].items():
            h.append("- **%s** — %s%s" % (lid, v["verdict"],
                     (" (red: `%s`)" % v.get("red")) if v.get("red") else ""))
        h.append("")
        h.append("Detail (every distinct command, rc and tail): `%s`." % requal_rel)
    elif dirty:
        h.append("Not run: the tree was not committed.")
    else:
        h.append("No blocked lot to requalify.")
    h.append("")

    os.makedirs(campaign_dir, exist_ok=True)
    with open(os.path.join(ws, handoff_rel), "w", encoding="utf-8") as f:
        f.write("\n".join(h))
    add = ["add", "--", handoff_rel]
    if requal["lots"]:
        add.append(requal_rel)
    git(*add)
    git("commit", "-m", "campaign: handoff — %d done, %d blocked, oracle %s"
        % (len(done), len(blocked),
           "green" if out["oracle_green"] else ("unjudged" if dirty else "red")))

    out["notice"] = ("%d done, %d blocked (%d requalify on the final tree), "
                     "oracle %s" % (len(done), len(blocked), out["requalified"],
                                    "green" if out["oracle_green"] else "not green"))
    print(json.dumps(out))

## handoff_review — both escalation modes end here: the campaign never
## closes without offering a human the decisions it took.
human handoff_review:
  description: "End-of-campaign handoff review"
  input: review_input
  output: review_ack
  instructions: review_instructions
  interaction: human

## ─── Workflow ──────────────────────────────────────────────────────

workflow campaign:
  entry: phase_zero

  ## No `sandbox:` block (ADR-082): the platform sandboxes by default, and
  ## the target's toolchain comes from ITS OWN devbox/devcontainer. This
  ## bundle declares only yq and python3 — the supervisor stays repo- and
  ## stack-agnostic; every judged command is declared by the target repo.

  ## The child budgets itself (a subbot's budget does not compose with the
  ## parent's): this budget bounds the SUPERVISOR — its records, gates and
  ## bookkeeping — plus the campaign's wall clock, which is the one axis
  ## that does contain the children.
  ##
  ## The wall clock has to hold phase 0 AND the lot loop. The children's
  ## own ceilings bound phase 0 at roughly fourteen hours (the net's four,
  ## the docs child's six, the assessment child's own), and a lot runs
  ## three to four; 48h held about twelve lots and would have spent a
  ## quarter of a first campaign on its bootstrap. 72h keeps the bootstrap
  ## from being paid out of the programme. Exceeding it is not a crash —
  ## the budget guard declines the loop's back-edge and the campaign leaves
  ## through its own handoff — but it is lots not landed.
  budget:
    max_parallel_branches: 1
    max_duration: "72h"
    max_cost_usd: 25

  ## ── Phase 0 ───────────────────────────────────────────────────────
  ## One switch, two skips, three children. Each `when` reads a bool a tool
  ## node computed from a FILE, and each fall-through is the "already
  ## there" case — so every pair is exhaustive on a fact, not on a default.
  ## The docs child has no skip: its own gate owns that decision.

  ## The switch, first: phase 0 off is the campaign as it was, entering at
  ## preflight.
  phase_zero -> preflight when disabled
  phase_zero -> assessment when run_assessment
  phase_zero -> net_gate

  assessment -> plan_landed with {
    before: "{{outputs.phase_zero.head_before}}"
  }
  plan_landed -> net_gate

  net_gate -> golden_master when run_net
  net_gate -> docs_gate

  golden_master -> net_landed with {
    before:      "{{outputs.net_gate.head_before}}",
    oracle_dir:  "{{outputs.net_gate.oracle_dir}}",
    verify_path: "{{outputs.net_gate.verify_path}}"
  }
  net_landed -> docs_gate

  ## Always launched: what the docs child does with an already-documented
  ## product is its own gate's decision, not this graph's.
  docs_gate -> product_docs
  product_docs -> docs_landed with {
    pages_before: "{{outputs.docs_gate.pages_before}}"
  }
  docs_landed -> preflight

  ## ── The supervisor proper, unchanged ──────────────────────────────

  preflight -> run_lot

  run_lot -> observe with {
    base:        "{{outputs.preflight.campaign_base}}",
    ledger_path: "{{outputs.preflight.ledger_path}}"
  }

  observe -> steward with {
    before:      "{{outputs.observe.before}}",
    moved:       "{{outputs.observe.moved}}",
    extensions:  "{{outputs.observe.extensions}}",
    pending:     "{{outputs.observe.pending}}",
    ledger_path: "{{outputs.preflight.ledger_path}}",
    verify_path: "{{outputs.preflight.verify_path}}"
  }

  ## Exhaustive pair on one bool: pause, or straight to the loop decision.
  steward -> escalate when pause_required with {
    items:   "{{outputs.steward.escalations}}",
    context: "{{outputs.steward.notice}}"
  }
  steward -> loop_gate when not pause_required

  escalate -> record_answer with {
    action: "{{outputs.escalate.action}}",
    note:   "{{outputs.escalate.note}}"
  }
  record_answer -> finalize when stop with {
    verify_path: "{{outputs.preflight.verify_path}}"
  }
  record_answer -> loop_gate when not stop

  ## Continue while something can still land; the unguarded fall-through
  ## also serves loop exhaustion and the budget guard's declined back-edge —
  ## the campaign always leaves through its own handoff.
  loop_gate -> finalize when not proceed with {
    verify_path: "{{outputs.preflight.verify_path}}"
  }
  loop_gate -> run_lot as campaign_loop("{{vars.max_lots}}")
  loop_gate -> finalize with {
    verify_path: "{{outputs.preflight.verify_path}}"
  }

  finalize -> handoff_review with {
    handoff_path: "{{outputs.finalize.handoff_path}}",
    summary:      "{{outputs.finalize.notice}}"
  }
  handoff_review -> done
