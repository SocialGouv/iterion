{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "iterion chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "backup": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "tiers": {
          "type": "array"
        },
        "checkArgs": {
          "type": "array"
        },
        "extraArgs": {
          "type": "array"
        }
      }
    },
    "config": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "devStack": {
      "type": "object"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "global": {
      "type": "object"
    },
    "image": {
      "type": "object"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "ingress": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "minio": {
      "type": "object",
      "description": "Retired sub-chart (4.4): accepted only in its off form so a values file that merely disabled it keeps rendering; anything else is refused.",
      "properties": {
        "enabled": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "mode": {
      "type": "string",
      "enum": [
        "local",
        "cloud"
      ]
    },
    "mongodb": {
      "type": "object",
      "description": "Retired sub-chart (4.4): accepted only in its off form so a values file that merely disabled it keeps rendering; anything else is refused.",
      "properties": {
        "enabled": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "nameOverride": {
      "type": "string"
    },
    "nats": {
      "type": "object"
    },
    "networkPolicy": {
      "type": "object"
    },
    "persistence": {
      "type": "object"
    },
    "probes": {
      "type": "object"
    },
    "runner": {
      "type": "object"
    },
    "runnerPools": {
      "type": "array"
    },
    "secrets": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "server": {
      "type": "object"
    },
    "service": {
      "type": "object"
    },
    "serviceAccount": {
      "type": "object"
    }
  }
}
