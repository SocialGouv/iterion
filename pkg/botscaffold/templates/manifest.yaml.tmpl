name: {{.Slug}}
{{- if .DisplayName}}
display_name: {{yquote .DisplayName}}
{{- end}}
{{- if .Icon}}
icon: {{yquote .Icon}}
{{- end}}
version: 0.1.0
{{- if .Description}}
description: {{yquote .Description}}
{{- end}}
{{- if .WhenToUse}}
# when_to_use is the orchestrator-facing "use when" guidance — Nexie
# reads it (via the generated bot catalog) to route tasks to this bot.
when_to_use: {{yquote .WhenToUse}}
{{- end}}
enabled: true
schema_version: 1
{{- if .EngineFloor}}
# The workflows are written in dsl profile 2, which this build reads from
# on; a runner older than that would fail at its first parse of a child.
requires:
  iterion: {{yquote (printf ">= %s" .EngineFloor)}}
{{- end}}
{{- if .ScheduleCron}}
# Typed routing contract: the studio bot home offers a one-click
# schedule trigger from this suggested cron (the operator confirms).
invocations:
  - kind: schedule
    schedule:
      suggested_cron: {{yquote .ScheduleCron}}
{{- end}}
