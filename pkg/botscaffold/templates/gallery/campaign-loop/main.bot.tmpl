## <%if .DisplayName%><%.DisplayName%><%else%><%.Slug%><%end%> — shape: campaign + deterministic gate + bounded loop + typed fail.
##
## One agent carries the mission in passes and commits in stride (git is
## the state between passes). A tool re-runs the repository's OWN checks
## on their real exit code — never an LLM judgment — and a compute folds
## the agent's termination flag and that verdict into `converged`. The
## loop is bounded; its exhaustion is a typed, resumable failure the
## operator can act on (raise the cap and resume). The verifier's output
## reaches the next pass through the back-edge's `with` mapping, and a
## deterministic entry node gives the first pass the same input shape —
## a prompt reference to a node that has not run yet would render as its
## literal placeholder. An entry gate refuses a run whose verifier is not
## configured: a `verify_command` left empty would make every verdict
## green, and a campaign that "converges" on a check that checks nothing
## is the façade the shape exists to prevent. Fill in: the mission,
## `verify_command`, `max_passes`. Read docs/workflow_authoring_pitfalls.md
## before pointing it at real code.
<%template "vars_block" .%>
schema check_out:
  configured: bool

schema pass_input:
  ## What the previous pass's verifier said; empty on the first pass.
  previous_verify: string

schema pass_report:
  ## The termination contract. Honest reporting: under-reporting
  ## work_complete costs one more pass, over-reporting lands you right
  ## back here with the verifier's output.
  summary: string
  work_complete: bool
  remaining: string

schema verify_out:
  ok: bool
  detail: string

schema gate_out:
  converged: bool
  ## The loop's cap: `as name(N)` allows N back-edge crossings, i.e. N+1
  ## executions of the body, so `max_passes` PASSES are the first one plus
  ## max_passes-1 re-entries. Derived HERE, in the node the back-edge
  ## leaves, because it re-executes on every pass and on a resume — a
  ## resume re-resolves the vars but never re-runs the entry, so a cap
  ## derived at the entry would be frozen in the checkpoint and "raise
  ## max_passes and resume" would change nothing.
  passes_after_first: int

prompt mission:
<%indent 2 .Instructions%>

prompt pass_user:
  Work on the mission now, in commit-sized units, and commit each one.
  Read `git log` first: an earlier pass may have landed work already.
  Report what is left in `remaining`, and set work_complete=true only
  when nothing is.

  Verifier output from the previous pass (empty on the first):
  {{input.previous_verify}}

## The entry gate, deterministic and before any LLM call: no verifier,
## no campaign. `!!` is the expression language's truthiness, which
## trims: an empty, blank or ABSENT verify_command is refused (so are the
## strings "false", "no" and "0", which nobody runs their tests with). A
## bound under 1 is refused too — it would end the run on
## PASSES_EXHAUSTED after one pass. A non-numeric `--var max_passes=…`
## does not reach the typed refusal: the resolver keeps a bad override
## as text, and the comparison then fails this node loudly
## (EXPRESSION_FAILED, before any pass) rather than silently.
compute check:
  output: check_out
  expr:
    configured: "!!vars.verify_command && vars.max_passes >= 1"

## The first pass has no verifier output yet: an empty one, so the
## campaign's input is the same shape on every pass.
compute first_pass:
  output: pass_input
  expr:
    previous_verify: "''"

agent campaign:<%template "llm_fields" .%>
  input: pass_input
  system: mission
  user: pass_user
  output: pass_report

## The truth oracle: the repository's own checks, on their exit code. A
## {{ref}} in a command is shell-escaped by the runtime, so
## `sh -c {{vars.verify_command}}` runs the whole string as one command.
## The entry gate is the ONE guard against an unset verifier: vars are
## resolved once per run, so this node reads the value the gate admitted
## (and an unresolved ref would render as its literal placeholder, never
## as an empty string — a second check here could not fire).
## The node's WHOLE stdout is parsed as one JSON object, so the checks'
## own output goes to stderr (`>&2`) and stdout carries nothing but the
## printf: `go test`'s log ahead of it would make the parse fail and the
## output collapse to `{"result": "<the log>"}` with no `ok` — the gate
## would then read nil and never converge. stderr still reaches the run
## log, which is what "see the run log" points at.
tool verify:
  command: `if sh -c {{vars.verify_command}} >&2; then printf '{"ok":true,"detail":"checks green"}'; else printf '{"ok":false,"detail":"checks red, see the run log"}'; fi`
  output: verify_out

## Deterministic convergence: the flag AND the verdict, no LLM in the loop.
## It also re-derives the loop's cap from the vars on every pass (see
## gate_out), so a resume with a raised max_passes takes the back-edge.
compute gate:
  output: gate_out
  expr:
    converged: "outputs.campaign.work_complete && outputs.verify.ok"
    passes_after_first: "vars.max_passes - 1"

fail misconfigured:
  description: "the campaign has no verifier, or no pass to run"
  code: CAMPAIGN_MISCONFIGURED
  message: "verify_command must name the repository's own checks (got '{{vars.verify_command}}') and max_passes must be at least 1 (got {{vars.max_passes}})"

fail passes_exhausted:
  description: "the bounded loop ran out before the gate turned green"
  code: PASSES_EXHAUSTED
  message: "{{vars.max_passes}} passes without convergence; remaining: {{outputs.campaign.remaining}}"
  resumable: true

workflow <%.WorkflowName%>:
  entry: check
  ## Commits land in a per-run git worktree; on success they are
  ## squash-merged into your checked-out branch (docs/dsl.md).
  worktree: auto<%template "dials" .%><%template "budget_block" .%>
  check -> misconfigured when not configured
  check -> first_pass when configured
  first_pass -> campaign with { previous_verify: "{{outputs.first_pass.previous_verify}}" }
  campaign -> verify
  verify -> gate
  gate -> done when converged
  ## The cap counts re-entries: max_passes passes in all (the gate derives
  ## max_passes-1 on every pass; the entry gate refuses a bound under 1).
  gate -> campaign when not converged as passes("{{outputs.gate.passes_after_first}}") with { previous_verify: "{{outputs.verify.detail}}" }
  ## The loop-exhaustion exit: taken when the back-edge is declined.
  gate -> passes_exhausted
