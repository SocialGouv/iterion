## Triage lint findings, fix them in a bounded loop, then summarize
## phase: Survey — Collect and classify lint findings
## phase: Fix — Fixer and checker alternate, max 4 rounds
## phase: Wrap — Summarize what changed

vars:
  target: string = ""   ## input derived from args in the source script
  hole_1: string = ""   ## IMPORT hole: dynamic fragment — JS: lastReport ? `\n\nChecker feedback from the previous round:\n${lastReport}` : ''

schema survey_schema:
  severity: string [enum: "none", "minor", "major"]
  summary: string   ## What the linter reports
  hotspots: string[]

schema check_schema:
  verdict: string [enum: "clean", "dirty"]
  remaining: int   ## Count of findings left

prompt surveyor_user:
  Run the linter on {{vars.target}} and classify the findings. Do not fix anything yet.

prompt fixer_user:
  Fix the lint findings on {{vars.target}}.

  Survey summary:
  {{outputs.surveyor.summary}}{{vars.hole_1}}

prompt checker_user:
  Re-run the linter and report the verdict.

prompt wrapper_user:
  Summarize the fixes applied to {{vars.target}} and commit them.

## Phase: Survey
agent surveyor:
  user: surveyor_user
  output: survey_schema

## Phase: Fix
agent fixer:
  user: fixer_user

agent checker:
  user: checker_user
  output: check_schema

## Phase: Wrap
agent wrapper:
  user: wrapper_user

workflow lint_fix_loop:
  entry: surveyor
  surveyor -> done when "severity == 'none'"
  fixer -> checker
  ## log: Round <round>: <check && check.verdict>
  surveyor -> fixer else
  checker -> fixer when "verdict != 'clean'" as loop_1(4)
  checker -> wrapper else
  wrapper -> done
