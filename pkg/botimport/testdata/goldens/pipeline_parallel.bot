## Fan a doc rewrite out over modules, then run two independent checks

schema plan_schema:
  modules: string[]   ## Module names to sweep

prompt planner_user:
  List the modules whose docs need a sweep.

prompt rewriter_user:
  Rewrite the docs for module {{outputs.fan_1.m}}. Keep code samples compiling.

prompt linkcheck_user:
  Check internal links across the rewritten docs.

prompt spellcheck_user:
  Check spelling and terminology consistency.

agent planner:
  user: planner_user
  output: plan_schema

router fan_1:
  mode: fan_out_each
  over: "{{outputs.planner.modules}}"
  as: m

agent rewriter:
  user: rewriter_user

tool join_1:
  command: "true"
  await: wait_all

router fan_2:
  mode: fan_out_all

tool join_2:
  command: "true"
  await: wait_all

agent linkcheck:
  user: linkcheck_user

agent spellcheck:
  user: spellcheck_user

workflow doc_sweep:
  entry: planner
  planner -> fan_1
  fan_1 -> rewriter
  rewriter -> join_1
  join_1 -> fan_2
  fan_2 -> linkcheck
  linkcheck -> join_2
  fan_2 -> spellcheck
  spellcheck -> join_2
  join_2 -> done
