      "TestAuthorityRecordKeepsConcreteSourcesPrivate",
      "TestAuthorityRecordRejectsAmbiguousOrUnaccountedCustody",
      "TestAuthorityRecordRejectsDuplicateJSONKeys",
      "TestAuthorityRecordPreservesCaseSensitiveSourceFiles",
      "TestAuthorityStaticAnalysisReconcilesEveryConfiguredPrincipal",
      "TestAuthorityStaticAnalysisRefusesUninventoriedOrPrivilegedAccess",
      "TestAuthorityStaticAnalysisRejectsBrokerPermissionDrift",
      "TestAuthorityStaticAnalysisIgnoresEquivalentACLRuleOrder",
      "TestKubernetesWorkloadSnapshotIncludesDormantControllersAndPodTemplates",
