{
  "scope": "Read-only bounded kubectl authority/credential Secret, standard workload and RBAC listing, strict versioned operator records, static NATS source/profile, broker Pod launch, per-broker system observation and explicit workload credential-reference reconciliation. Actual credential key bytes remain private. These are corroborating layers only; exhaustive custody, other authorizers, freshness and distributed activation remain unproved.",
  "packages": {
    "github.com/SocialGouv/iterion/pkg/portsactivation/authority": [
      "TestReadAuthoritySecretBindsNamedKubernetesSource",
      "TestReadAuthoritySecretRefusesUnboundNamesAndOversizedResponses",
      "TestReadAuthoritySecretBoundsActualKubectlPipe",
      "TestReadAuthoritySecretCancellationBoundsInheritedPipe",
      "TestAuthorityRecordKeepsConcreteSourcesPrivate",
      "TestAuthorityRecordRejectsAmbiguousOrUnaccountedCustody",
      "TestAuthorityRecordRejectsDuplicateJSONKeys",
      "TestAuthorityRecordPreservesCaseSensitiveSourceFiles",
      "TestAuthorityStaticAnalysisReconcilesEveryConfiguredPrincipal",
      "TestAuthorityStaticAnalysisRefusesUninventoriedOrPrivilegedAccess",
      "TestAuthorityStaticAnalysisRejectsBrokerPermissionDrift",
      "TestAuthorityStaticAnalysisIgnoresEquivalentACLRuleOrder",
      "TestKubernetesWorkloadSnapshotIncludesDormantControllersAndPodTemplates",
      "TestKubernetesWorkloadSnapshotRefusesMissingOrForeignObjects",
      "TestKubernetesWorkloadSnapshotBoundsActualKubectlPipe",
      "TestKubernetesWorkloadReconciliationBindsDeclaredAndRunningDescendants",
      "TestKubernetesWorkloadReconciliationRefusesDormantOrUnknownCredentialPaths",
      "TestKubernetesCredentialSecretBindsNamedKeyAndRedactsURL",
      "TestKubernetesCredentialSecretRefusesForeignOrUnsupportedMaterial",
      "TestKubernetesCredentialReconciliationBindsSecretRevisionsToPrincipals",
      "TestKubernetesCredentialReconciliationRefusesWrongIdentityAndChangingSecret",
      "TestKubernetesCredentialReconciliationKeepsExternalHoldersUnresolved",
      "TestKubernetesRBACSnapshotKeepsNamespacedAndClusterBindings",
      "TestKubernetesRBACSnapshotRefusesPartialOrUnsupportedEvidence",
      "TestKubernetesRBACBoundaryAcceptsSeparatedWorkerAndNamedWriters",
      "TestKubernetesRBACBoundaryRefusesCrossNamespaceAndWriterGrants",
      "TestKubernetesRBACBoundaryRefusesPodAndControllerSubresourceGrants",
      "TestNATSBrokerLaunchRequiresExactRunningPodAndConfigInvocation",
      "TestNATSBrokerLaunchRefusesAuthOverridesAndUnpinnedRuntime",
      "TestNATSSystemCorroborationBindsEveryDeclaredBrokerAndPrincipal",
      "TestNATSSystemCorroborationRefusesMissingForeignOrStaleBrokerEvidence"
    ]
  }
