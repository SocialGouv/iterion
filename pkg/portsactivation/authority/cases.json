      "TestKubernetesCredentialSecretBindsNamedKeyAndRedactsURL",
      "TestKubernetesCredentialSecretRefusesForeignOrUnsupportedMaterial",
      "TestKubernetesCredentialReconciliationBindsSecretRevisionsToPrincipals",
      "TestKubernetesCredentialReconciliationRefusesWrongIdentityAndChangingSecret",
