{
  "scope": "Read-only bounded kubectl Secret loading, strict versioned operator records and static NATS source/profile reconciliation. Every principal must map to named custody and protected ACL exposures are classified. This is not live broker, Kubernetes or distributed activation verification.",
  "packages": {
    "github.com/SocialGouv/iterion/pkg/portsactivation/authority": [
      "TestReadAuthoritySecretBindsNamedKubernetesSource",
      "TestReadAuthoritySecretRefusesUnboundNamesAndOversizedResponses",
      "TestReadAuthoritySecretBoundsActualKubectlPipe",
      "TestReadAuthoritySecretCancellationBoundsInheritedPipe",
      "TestAuthorityRecordKeepsConcreteSourcesPrivate",
      "TestAuthorityRecordRejectsAmbiguousOrUnaccountedCustody",
      "TestAuthorityRecordRejectsDuplicateJSONKeys",
      "TestAuthorityRecordPreservesCaseSensitiveSourceFiles",
      "TestAuthorityStaticAnalysisReconcilesEveryConfiguredPrincipal",
      "TestAuthorityStaticAnalysisRefusesUninventoriedOrPrivilegedAccess",
      "TestAuthorityStaticAnalysisRejectsBrokerPermissionDrift",
      "TestAuthorityStaticAnalysisIgnoresEquivalentACLRuleOrder"
    ]
  }
}
