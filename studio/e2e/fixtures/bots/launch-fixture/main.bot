## Launch-form fixture: declares one required var, one var with a
## default, and a single agent node so the Launch view renders its
## inputs, its per-node model overrides and its cost estimate. NEVER
## executed by the suite — only rendered, so no credential is needed.

vars:
  target_branch: string = "main"
  mission: string

schema verdict:
  ok: bool
  summary: string

agent survey:
  ## Qualified and curated-known on purpose: serve.mjs pins
  ## ITERION_MODEL_SPECS=off, so the spec aggregator contributes nothing and
  ## the model-capability caption can only render what the curated table
  ## carries. GLM-5.2 is the one family with a curated context window (1M),
  ## which makes the caption assertable without a network fetch.
  model: "anthropic/glm-5.2"
  system: "Survey {{vars.target_branch}} for {{vars.mission}}."
  output: verdict

workflow launch_fixture:
  worktree: none
  sandbox: none
  entry: survey

  survey -> done when ok
  survey -> fail
