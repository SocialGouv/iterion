## The writer has no multi-line form for this `command:` (#1612): a group
## member's value is indented after the fact, and this one ends without a
## newline — no block scalar strips it back and no raw string survives the
## indentation — so every render folds it to one escaped line, the file is
## refused, and the Source view shows it as stored.

dsl: 2

group probe:
  tool collect_facts:
    command: `echo iterion-ui-unit-fixture
echo second line`
    output: note
    publish: collected_facts
  collect_facts -> done
